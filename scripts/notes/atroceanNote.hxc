import funkin.play.notes.notekind.NoteKind;
import funkin.Paths;

class AtroceanNote extends NoteKind {
	public function new() {
		super('atroceanNote', 'Atrocean Note', null, [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	public override function onNoteIncoming(event:NoteScriptEvent):Void {
		if (!event.note.noteData.getMustHitNote()) return;

		event.note.x += -45;
		event.note.yOffset += -47;

		event.note.lowPriority = true;

		event.note.frames = Paths.getSparrowAtlas('notes/Atrocean_Note_Assets');
		event.note.animation.addByPrefix('purpleScroll', 'Left0');
		event.note.animation.addByPrefix('blueScroll', 'Down0');
		event.note.animation.addByPrefix('greenScroll', 'Up0');
		event.note.animation.addByPrefix('redScroll', 'Right0');

		var atroceanAnim:String;
		switch (event.note.noteData.data % 4) {
			case 0: atroceanAnim = 'purpleScroll';
			case 1: atroceanAnim = 'blueScroll';
			case 2: atroceanAnim = 'greenScroll';
			case 3: atroceanAnim = 'redScroll';
		}

		event.note.active = true;
		event.note.animation.play(atroceanAnim);
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.cancel();
		event.stopPropagation();
	}
}
