import funkin.audio.FunkinSound;
import funkin.play.notes.notekind.NoteKind;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.graphics.FunkinSprite;
import funkin.play.character.CharacterType;
import funkin.modding.events.HitNoteScriptEvent;
import funkin.util.HapticUtil;
import flixel.util.FlxTimer;
import funkin.FunkinMemory;
import flixel.FlxG;
import funkin.Paths;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;

import supereric.retrospecter.modules.RetroUtil;

class cashNote extends Module {
	public function new() {
		super("cashNote");
	}

	function onCreate(event:Dynamic) {
		super.onCreate(event);
		if (PlayState.instance == null) return;
	}

	public override function onNoteHit(event:HitNoteScriptEvent):Void {
		super.onNoteHit(event);
		if (PlayState.instance == null) return;
		if ((event.note.noteData.kind == "cashNote" || event.note.noteData.kind == "autoCash") && event.note.noteData.getMustHitNote()) {
			RetroUtil.spawnSplash(event.note, {
				atlas: 'notes/splash/coin',
				prefixes: ['splash0', 'splash0', 'splash0', 'splash0'],
				xOffset: -10,
				yOffset: -15,
			});
		}
	}

	public override function onNoteIncoming(event:NoteScriptEvent)
	{
		super.onNoteIncoming(event);
		if (event.note.noteData.kind == "cashNote" || event.note.noteData.kind == "autoCash") {
			event.note.x += 0;
			if (event.note.noteData.kind == "autoCash") event.note.yOffset -= 60;

			event.note.frames = Paths.getSparrowAtlas( 'notes/coin' );
			event.note.animation.addByPrefix('purpleScroll', 'idle0');
			event.note.animation.addByPrefix('blueScroll', 'idle0');
			event.note.animation.addByPrefix('greenScroll', 'idle0');
			event.note.animation.addByPrefix('redScroll', 'idle0');

			event.note.active = true; // so the anim always plays.
			event.note.animation.play(RetroUtil.SPLASH_ANIM_NAMES[event.note.noteData.data % 4]);
		}
	}

	public override function onNoteMiss(event:NoteScriptEvent)
	{
		super.onNoteMiss(event);
		if (event.note.noteData.kind == "cashNote") {
			event.cancel();
			event.stopPropagation();
		}
	}
}
