import funkin.play.notes.notekind.NoteKind;
import flixel.FlxG;
import funkin.Paths;
import funkin.Preferences;
import funkin.save.Save;
import funkin.mobile.input.ControlsHandler;

class HydraNote extends NoteKind {
	public function new() {
		super('Hydra', 'Hydra Note', 'hydraNote', [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	public override function onNoteIncoming(event:NoteScriptEvent):Void {
		if (!event.note.noteData.getMustHitNote()) return;
		if (!Save.instance.modOptions.get('retroMechanics')) {
			event.note.kill();
			event.note.active = false;
			event.cancelEvent();
			return;
		}

		var downscroll:Bool = Preferences.downscroll
			|| (FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice);

		var scale = 1.818182;
		event.note.scale.set(event.note.scale.x * scale, event.note.scale.y * scale);
		event.note.x += 2;
		event.note.yOffset += -77;

		event.note.lowPriority = true;
		event.note.active = true;

		//event.note.frames = Paths.getSparrowAtlas('notes/HydraNotes');
		if (!downscroll) {
			event.note.animation.addByPrefix('purpleScroll', 'Left(Up)0');
			event.note.animation.addByPrefix('blueScroll', 'Down(Up)0');
			event.note.animation.addByPrefix('greenScroll', 'Up(Up)0');
			event.note.animation.addByPrefix('redScroll', 'Right(Up)0');

			var hydraAnim:String;
			switch (event.note.noteData.data % 4) {
				case 0: hydraAnim = 'purpleScroll';
				case 1: hydraAnim = 'blueScroll';
				case 2: hydraAnim = 'greenScroll';
				case 3: hydraAnim = 'redScroll';
			}
			event.note.animation.play(hydraAnim);
		}
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.cancel();
		event.stopPropagation();
	}
}
