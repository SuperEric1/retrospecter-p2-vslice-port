import funkin.play.notes.notekind.NoteKind;

class RemoveNote extends NoteKind {
	public function new() {
		super('none', 'Remove Note', null, [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	// onNoteIncoming: cancelEvent + kill handled by RetroPlayState.

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.note.length = 0;
		event.note.kill();
		event.cancel();
		event.stopPropagation();
	}
}
