import funkin.play.notes.notekind.NoteKind;
import flixel.FlxG;
import funkin.Paths;
import funkin.Preferences;
import funkin.save.Save;
import funkin.mobile.input.ControlsHandler;

class HivelessNote extends NoteKind {
	public function new() {
		super('hivelessNote', 'Hiveless Note', 'hiveless', [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	public override function onNoteIncoming(event:NoteScriptEvent):Void {
		if (!Save.instance.modOptions.get('retroMechanics')) {
			event.note.kill();
			event.note.active = false;
			event.cancelEvent();
			return;
		}

		event.note.x += 2;
		event.note.yOffset += -28;

		switch (event.note.noteData.data % 4) {
			case 0: event.note.x += 2;
			case 1: event.note.x += 9;
			case 2: event.note.x += 12;
		}

		event.note.lowPriority = true;

		/*event.note.frames = Paths.getSparrowAtlas('notes/Hiveless_Note_Assets');
		event.note.animation.addByPrefix('purpleScroll', 'Left0');
		event.note.animation.addByPrefix('blueScroll', 'Down0');
		event.note.animation.addByPrefix('greenScroll', 'Up0');
		event.note.animation.addByPrefix('redScroll', 'Right0');

		var hivelessAnim:String;
		switch (event.note.noteData.data % 4) {
			case 0: hivelessAnim = 'purpleScroll';
			case 1: hivelessAnim = 'blueScroll';
			case 2: hivelessAnim = 'greenScroll';
			case 3: hivelessAnim = 'redScroll';
		}

		// a anim é de 1 frame, não precisa de active = true
		event.note.animation.play(hivelessAnim);*/
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.cancel();
		event.stopPropagation();
	}
}
