import funkin.play.notes.notekind.NoteKind;
import funkin.play.PlayState;
import funkin.modding.events.HitNoteScriptEvent;
import flixel.FlxG;
import funkin.Paths;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;

import supereric.retrospecter.modules.RetroUtil;

class SpectreNote extends NoteKind {
	public function new() {
		super('spectre', 'Spectre Note', null, [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	public override function onNoteHit(event:HitNoteScriptEvent):Void {
		if (PlayState.instance == null) return;
		if (event.eventCanceled) return;
		if (!event.note.noteData.getMustHitNote()) return;

		var downscroll:Bool = Preferences.downscroll || (FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice);
		RetroUtil.spawnSpectreSplash(event.note, downscroll);
	}

	public override function onNoteIncoming(event:NoteScriptEvent):Void {
		var downscroll:Bool = Preferences.downscroll
			|| (FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice);

		event.note.x += 15;
		event.note.yOffset += -68;

		event.note.frames = Paths.getSparrowAtlas('notes/Notes_Spectre');
		if (downscroll) {
			event.note.animation.addByPrefix('purpleScroll', 'Left(Down)0');
			event.note.animation.addByPrefix('blueScroll', 'Down(Down)0');
			event.note.animation.addByPrefix('greenScroll', 'Up(Down)0');
			event.note.animation.addByPrefix('redScroll', 'Right(Down)0');
		} else {
			event.note.animation.addByPrefix('purpleScroll', 'Left(Up)0');
			event.note.animation.addByPrefix('blueScroll', 'Down(Up)0');
			event.note.animation.addByPrefix('greenScroll', 'Up(Up)0');
			event.note.animation.addByPrefix('redScroll', 'Right(Up)0');
		}

		event.note.active = true;
		event.note.animation.play(RetroUtil.SPLASH_ANIM_NAMES[event.note.noteData.data % 4], true);
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.cancel();
		event.stopPropagation();
	}
}
