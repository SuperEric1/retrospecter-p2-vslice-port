import funkin.play.notes.notekind.NoteKind;
import funkin.play.PlayState;
import funkin.modding.events.HitNoteScriptEvent;
import funkin.Paths;
import funkin.save.Save;

import supereric.retrospecter.modules.RetroUtil;

class HivemoreNote extends NoteKind {
	public function new() {
		super('hivemoreNote', 'Hivemore Note', 'hivemore', [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	public override function onNoteHit(event:HitNoteScriptEvent):Void {
		if (PlayState.instance == null) return;
		if (event.eventCanceled) return;
		if (!event.note.noteData.getMustHitNote()) return;
		RetroUtil.spawnSplash(event.note, {
			atlas: 'notes/splash/bee',
			prefixes: ['note splash purple 1', 'note splash blue 1', 'note splash green 1', 'note splash red 1'],
			sizeMulti: 1.4,
			xOffset: -19,
			yOffset: -19,
		});
	}

	public override function onNoteIncoming(event:NoteScriptEvent):Void {
		if (!Save.instance.modOptions.get('retroMechanics')) {
			event.note.kill();
			event.note.active = false;
			event.cancelEvent();
			return;
		}

		event.note.x += 5;
		event.note.yOffset += -35;

		event.note.lowPriority = true;

		switch (event.note.noteData.data % 4) {
			case 0: event.note.x += -1;
			case 1: event.note.x += 1;
			case 2: event.note.x += 4;
			case 3: event.note.yOffset += 10;
		}

		/*event.note.frames = Paths.getSparrowAtlas('notes/Hivemore_Note_Assets');
		event.note.animation.addByPrefix('purpleScroll', 'Left0');
		event.note.animation.addByPrefix('blueScroll', 'Down0');
		event.note.animation.addByPrefix('greenScroll', 'Up0');
		event.note.animation.addByPrefix('redScroll', 'Right0');*/

		event.note.active = true;
		//event.note.animation.play(RetroUtil.SPLASH_ANIM_NAMES[event.note.noteData.data % 4]);
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.cancel();
		event.stopPropagation();
	}
}
