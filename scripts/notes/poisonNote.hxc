import funkin.play.notes.notekind.NoteKind;
import funkin.play.PlayState;
import funkin.modding.events.HitNoteScriptEvent;
import flixel.FlxG;
import funkin.Paths;
import funkin.Preferences;
import funkin.save.Save;
import funkin.mobile.input.ControlsHandler;

import supereric.retrospecter.modules.RetroUtil;

class PoisonNote extends NoteKind {
	public function new() {
		super('poison', 'Poison Note', 'poisonNote', [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	public override function onNoteHit(event:HitNoteScriptEvent):Void {
		if (PlayState.instance == null) return;
		if (event.eventCanceled) return;
		if (!event.note.noteData.getMustHitNote()) return;
		RetroUtil.spawnSplash(event.note, {
			atlas: 'notes/PoisonArrowHit',
			prefixes: ['Poison Arrow Hit Left0', 'Poison Arrow Hit Down0', 'Poison Arrow Hit Up0', 'Poison Arrow Hit Right0'],
			relativePos: true,
			xOffset: -170,
			yOffset: -140,
			antialiasing: true,
			sizeMulti: 0.65
		});
	}

	public override function onNoteIncoming(event:NoteScriptEvent):Void {
		if (!event.note.noteData.getMustHitNote()) return;
		if (!Save.instance.modOptions.get('retroMechanics')) {
			event.note.kill();
			event.note.active = false;
			event.cancelEvent();
			return;
		}

		var downscroll:Bool = Preferences.downscroll || (FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice);

		var scale = 1.538462;
		event.note.scale.set(event.note.scale.x * scale, event.note.scale.y * scale);
		event.note.x += 15;
		event.note.yOffset += -73;

		event.note.lowPriority = true;
		event.note.active = true;

		if (!downscroll) {
			event.note.animation.addByPrefix('purpleScroll', 'PoisonArrows Upscroll Left0');
			event.note.animation.addByPrefix('blueScroll', 'PoisonArrows Upscroll Down0');
			event.note.animation.addByPrefix('greenScroll', 'PoisonArrows Upscroll Up0');
			event.note.animation.addByPrefix('redScroll', 'PoisonArrows Upscroll Right0');

			event.note.animation.play(RetroUtil.SPLASH_ANIM_NAMES[event.note.noteData.data % 4]);
		}
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.cancel();
		event.stopPropagation();
	}
}
