import funkin.play.notes.notekind.NoteKind;
import funkin.modding.events.HitNoteScriptEvent;

class FakeNote extends NoteKind {
	public function new() {
		super('Fake Note', 'Fake Note', null, [], true); // id, description, styleId, params, noanim
		scoreable = false;
	}

	// onNoteIncoming: fade-out tween is handled by RetroPlayState.

	public override function onNoteHit(event:HitNoteScriptEvent):Void {
		if (!event.note.noteData.getMustHitNote()) return;
		event.cancel();
		event.stopPropagation();
	}

	public override function onNoteHoldDrop(event:HoldNoteScriptEvent):Void {
		if (!event.holdNote.noteData.getMustHitNote()) return;
		event.cancel();
		event.stopPropagation();
	}

	public override function onNoteMiss(event:NoteScriptEvent):Void {
		event.note.kill();
		event.cancel();
		event.stopPropagation();
	}
}
