import flixel.FlxG;
import funkin.play.PlayState;
import funkin.play.character.CharacterType;
import funkin.play.character.AnimateAtlasCharacter;
import StringTools;

class PhaseFourCharacter extends AnimateAtlasCharacter
{
  function new()
  {
    super('phase4');
  }

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    this.danceEvery = 0;
    this.antialiasing = true;

    this.playAnimation('idle', true, false);
    this.updateHitbox();
  }

  function onNoteHit(event:HitNoteScriptEvent) {
		if (PlayState.instance == null) return;

		if (!event.note.noteData.getMustHitNote() && characterType == CharacterType.DAD) {
			if (event.note.isHoldNote) {
				var durationInSeconds:Float = event.note.length / 1000;
				PlayState?.instance?.camHUD?.shake(0.001, durationInSeconds + 0.1);
				PlayState?.instance?.camGame?.shake(0.002, durationInSeconds + 0.1);
			} else {
				PlayState?.instance?.camHUD?.shake(0.001, 0.1);
				PlayState?.instance?.camGame?.shake(0.002, 0.1);
			}
		}
		super.onNoteHit(event);
	}

  /*override function onSongRetry()
  {
    super.onSongRetry();
    playIdleAnim();
  }

  override function onAnimationFinished(name:String)
  {
    super.onAnimationFinished(name);
  }

  override public function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reverse:Bool = false):Void
  {
    super.playAnimation(name, restart, ignoreOther, reverse);

  }

  function playIdleAnim()
  {
    this.playAnimation('idle', false, false);
  }*/
}
