import funkin.graphics.FunkinSprite;
import flixel.FlxG;
import funkin.audio.FunkinSound;
import funkin.play.character.MultiSparrowCharacter;
import funkin.play.GameOverSubState;
import funkin.play.PlayState;
import funkin.play.character.CharacterType;
import funkin.Preferences;
import funkin.util.Constants;
import funkin.util.HapticUtil;

class BFRetroCharacter extends MultiSparrowCharacter
{
  function new()
  {
    super('bf-retrospecter');
  }

  function onNoteHit(event:HitNoteScriptEvent):Void {

    if (PlayState.instance == null) return;
		if (event.note.noteData.getMustHitNote() && characterType == CharacterType.BF) {
      switch (event.note.noteData.kind)
      {
        case "hollowNotes":
          return;
        case "poison":
          return;
        case "izzyNote":
          return;
        case "insatianNote":
          return;
        case "No Animation":
          return;
        case "chain":
          return;
        case "autochain":
          return;
        case "Hydra":
          return;
        case "sakuNote":
          return;
        case "Fake Note":
          return;
        case "spectre":
          return;
        case "Hey!": // this is in some charts, it's an animation note
          this.animation.finished = true;
          this.playAnimation('hey', true, true);
          return;
        case "GF Sing": // this is in ectospasm, it's an animation note
          PlayState.instance.currentStage.getGirlfriend().animation.play('cheer');
          return;
      }
    }
    super.onNoteHit(event);
	}

  /*function onNoteMiss(event:NoteScriptEvent) {
    super.onNoteMiss(event);

    if (PlayState.instance == null) return;
		if (event.note.noteData.getMustHitNote() && characterType == CharacterType.BF) {
      switch (event.note.noteData.kind)
      {
        case "hollowNotes":
          return;
        case "No Animation":
          return;
      }
    }
  }*/

  function onAnimationFrame(name:String, frameNumber:Int, frameIndex:Int)
  {
    super.onAnimationFrame(name, frameNumber, frameIndex);

    if (!HapticUtil.hapticsAvailable) return;

    // BF's mic drops.
    if (name == 'firstDeath' && frameNumber == 27)
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }

    // BF's balls pulsating.
    if (name == 'deathLoop' && (frameNumber == 0 || frameNumber == 18))
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }
  }
}
