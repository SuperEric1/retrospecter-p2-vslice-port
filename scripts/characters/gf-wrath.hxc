import funkin.play.character.SparrowCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.FlxSprite;
import funkin.play.stage.Bopper;
import flixel.group.FlxTypedSpriteGroup;
import funkin.graphics.FunkinSprite;
import funkin.modding.base.ScriptedFlxAtlasSprite;
import funkin.modding.base.ScriptedFlxSprite;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import funkin.graphics.adobeanimate.FlxAtlasSprite;

class GirlfriendWrathCharacter extends SparrowCharacter
{
  function new()
  {
    super('gf-wrath');
  }

  var speaker:StageProp;
  var refreshed:Bool = false;

  var stageOffsets:haxe.ds.StringMap<String, Array<Float>> = [
    "wrath_phase1" => [-330, -45],
    "wrath_phase2" => [-330, -45],
    "wrath_phase3" => [-440, -230],
    "wrath_phase4" => [-365, -100],
  ];
  var defaultOffset:Array<Float> = [0, 0]; // Fallback

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);

    // dont add scrollfactor or it will bug and create a massive sprite when restarting the song for some reason
    speaker = FunkinSprite.create(0, 0);
    speaker.loadSparrow('girlfriends/speaker/wrath');
    speaker.animation.addByIndices('idle', 'GF Dancing Beat', [0, 1, 2, 3, 4, 5, 6, 7, 8, 5, 6, 7, 8, 5, 6, 7, 8, 5, 6, 7, 8, 5, 6, 7, 8], '', 24, false);
    speaker.scale = this.scale;
    speaker.antialiasing = this.antialiasing;
    speaker.x = this.x;
    speaker.y = this.y;
    speaker.updateHitbox();
  }

  function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    //synchronizeShader();

    speaker.visible = this.visible;
    speaker.alpha = this.alpha;
    var currentStage:String = PlayState.instance.currentStage.id.toLowerCase();
    var offset:Array<Float> = stageOffsets.exists(currentStage) ? stageOffsets.get(currentStage) : defaultOffset;

    speaker.x = this.x + offset[0];
    speaker.y = this.y + offset[1];

    if (!refreshed) {
      speaker.zIndex = this.zIndex - 5;
      PlayState.instance.currentStage.add(speaker);

      PlayState.instance.currentStage.refresh();
      refreshed = true;
    }
  }

  function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (event.beat % 2 == 0)
    {
        if (speaker != null) speaker.animation.play('idle', true);
    }
  }

  override function dance(force:Bool):Void
  {
    // Wait for 'hair' to play, preventing dancing from interrupting it.
    // Wait to finish, preventing dancing from interrupting it.
    if (!force && ['hair'].contains(getCurrentAnimation()) && !isAnimationFinished()) return;

    super.dance(force);
  }

  var currentShader = null;
  function synchronizeShader():Void
  {
    if (currentShader == this.shader) return;
    currentShader = this.shader;
    speaker.shader = currentShader;
    /*speaker.animation.onFrameChange.add(function() {
      currentShader.updateFrameInfo(speaker.frame);
    });*/
  }
}
