import flixel.FlxG;
import flixel.tweens.FlxEase;
import funkin.play.character.MultiSparrowCharacter;
import funkin.play.character.CharacterType;
import funkin.modding.module.ModuleHandler;
import funkin.mobile.input.ControlsHandler;
import funkin.play.PlayState;
import funkin.util.Constants;
import flixel.util.FlxTimer;

class PhaseTwoCharacter extends MultiSparrowCharacter {
	var isGfDoingAnim:Bool = false;

	function new() {
		super('phase2');
	}

	function onNoteHit(event:HitNoteScriptEvent) {
		if (PlayState.instance == null) return;
		if (!event.note.noteData.getMustHitNote() && characterType == CharacterType.DAD) {
			switch (event.note.noteData.kind)
			{
				case "hollowNotes":
					return;
				case "spectre":
					return;
				case "Fake Note":
					return;
			}

			if (event.note.noteData.getDirection() == 3 && event.note.isHoldNote && isGfDoingAnim == false) {
				PlayState.instance.currentStage.getGirlfriend().playAnimation('hair', true);
				isGfDoingAnim = true;
				new FlxTimer().start(1.2, function(tmr) {
					if (PlayState.instance == null) return;
					isGfDoingAnim = false;
				});
			}
		}
		super.onNoteHit(event);
	}

	// Load custom notestyle.
	// TODO: Move this somewhere else.
  function onSongLoaded(event:ScriptEvent):Void {
		super.onSongLoaded(event);

    var strum = (this.characterType == CharacterType.DAD) ? PlayState.instance.opponentStrumline : null;

    var downscroll = Preferences.downscroll;
    if (FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) downscroll = true;
    var strumStyle:String = 'poison_' + (downscroll ? 'down' : 'up');

    if (strum != null && strum.noteStyle.id == strumStyle) return; // already applied.

    ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('setStyle', [CharacterType.DAD, strumStyle]);
    ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('applyCustomNoteStyles', []);
	}

	override public function onUpdate(event):Void {
    super.onUpdate(event);
	}

  public function onSongRetry(event):Void {
    super.onSongRetry(event);
		isGfDoingAnim = false;
  }

  function onCreate(event) {
		super.onCreate(event);
	}

	public function onDestroy(event):Void {
		super.onDestroy(event);
		isGfDoingAnim = false;
	}

	public function onPause(event) {
		super.onPause(event);
	}

	public function onResume(event) {
		super.onResume(event);
	}
}
