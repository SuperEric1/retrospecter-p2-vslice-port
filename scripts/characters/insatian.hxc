import funkin.play.character.SparrowCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.util.Constants;
import flixel.util.FlxTimer;
import funkin.modding.module.ModuleHandler;

class InsatianCharacter extends SparrowCharacter {
	function new() {
		super('insatian');
	}

	override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);
    if (PlayState.instance == null) return;

    var eventKind = event.eventData.eventKind;
    var value = event.eventData.value;
    if (eventKind == "PlayAnimation") {
      this.animation.finished = true; // mark the animation as finished so the event's anim can play.
      this.playAnimation(value.anim, true, true); // then force play the animation.
    }
  }

	function onNoteHit(event:HitNoteScriptEvent) {
		if (!event.note.noteData.getMustHitNote() && this.characterType == CharacterType.DAD) {
			switch (event.note.noteData.kind)
			{
				case "No Animation":
					return;
			}
		}
		super.onNoteHit(event);
	}

	public function onUpdate(event:UpdateScriptEvent):Void {
    super.onUpdate(event);
		if (PlayState.instance == null) return;

		// this is now in the stage scripts for better accruacy
		/*for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;
      // If she is screaming and finishing a hold note OR she missed the note due to lag, play the idle anim again.
      if (this.animation.curAnim.name == 'scream' && holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength <= 3) {
				playIdleAnim();
      } else if (this.animation.curAnim.name == 'scream' && holdNote.missedNote) {
				playIdleAnim();
			}
    }*/
	}

	function playIdleAnim():Void {
		this.animation.finished = true;
		this.animation.play('idle');
	}

	// Load custom notestyle based on stage.
	// TODO: Move this somewhere else.
  function onSongLoaded(event:ScriptEvent):Void {
		super.onSongLoaded(event);
		var currentStage:String = PlayState.instance.currentStage.id.toLowerCase();
		var dadId:String = PlayState.instance.currentStage.getDad().characterId;
		var bfId:String = PlayState.instance.currentStage.getBoyfriend().characterId;
		var stageNoteStyleData:haxe.ds.StringMap<String, Array<String, String>> = [
			// STAGE | STYLE ID | CHARACTHER TYPE
			"gluttony" => ['insatian', 'opp'],
		];

		if (stageNoteStyleData.exists(currentStage)) {
			data = stageNoteStyleData.get(currentStage);
			var strum = (this.characterType == CharacterType.DAD) ? PlayState.instance.opponentStrumline : PlayState.instance.playerStrumline;

			if (strum.noteStyle.id == data[0]) return; // already applied.

			if (data[1].toLowerCase() == 'opp' && this.characterId == dadId)
				ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('setStyle', [CharacterType.DAD, data[0]]);
				ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('applyCustomNoteStyles', []);
			if (data[1].toLowerCase() == 'player' && this.characterId == bfId)
				ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('setStyle', [CharacterType.DAD, data[0]]);
				ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('applyCustomNoteStyles', []);
		}
	}

	function onCreate(event:ScriptEvent):Void {
		super.onCreate(event);
	}

	public function onDestroy(event):Void {
		super.onDestroy(event);
	}
}
