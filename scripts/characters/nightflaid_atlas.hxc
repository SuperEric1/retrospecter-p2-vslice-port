import flixel.FlxG;
import flixel.math.FlxMath;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.play.PlayState;
import funkin.util.Constants;
import funkin.play.character.CharacterType;
import funkin.play.character.AnimateAtlasCharacter;
import funkin.modding.module.ModuleHandler;
import StringTools;

//import supereric.retrospecter.modules.RetroGameUI;

class NightflaidCharacter extends AnimateAtlasCharacter
{
  function new()
  {
    super('nightflaid_atlas');
  }

  // Character color data
  var characterColors:haxe.ds.StringMap<String, CharacterColorData> = new haxe.ds.StringMap();

  // Animation tracking
  public var singSuffix:String = null;
  var singAnimations:Array<String> = ['singLEFT', 'singDOWN', 'singUP', 'singRIGHT'];
  var animsWithOwnIdles:Array<String> = ['DAD', 'SONIC'];
  var groundedAnims:Array<String> = ['WHITTY', 'RUV', 'TABI', 'POKEMON'];
  var aerialAnims:Array<String> = ['GARCELLO', 'TRICKY', 'SHAGGY'];
  public var lastIdleSuffix:String = '';
  public var savedColor:String = '';

  final HEALTH_DRAIN:Float = 1.8 / 100.0 * Constants.HEALTH_MAX; // -1.8%
  final HEALTH_HOLD_DRAIN_PER_SECOND = 7.5 / 100.0 * Constants.HEALTH_MAX; // -7.5% / second

  var digideathNoteDrain:Bool = null;
  var digideathScreenShake:Bool = null;
  var digideathShake:Bool = null;
  var digiMulti:Float = null;
  var hasFadenUI:Bool = false;

  var retroGameUI;

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);
    retroGameUI = ModuleHandler.getModule('RetroGameUI');

    singSuffix = null;
    lastIdleSuffix = '';
    savedColor = '';
    digideathNoteDrain = null;
    digideathScreenShake = null;
    digideathShake = null;
    digiMulti = null;
    hasFadenUI = false;

    initializeCharacterColors();
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);
    if (PlayState.instance == null) return;

    var eventKind = event.eventData.eventKind;
    var value = event.eventData.value;

    if (eventKind == "NightflaidEvents") {
      switch (Std.parseInt(value.eventType)) {
        case 5: // Set opp anim
          setOppAnimation(value.value1);
      }
    }
    if (eventKind == "PlayAnimation") {
      // this needs to be here otherwise the event animation won't play correctly
      //this.animation.finished = true; // mark the animation as finished so the event's anim can play.
      this.canPlayOtherAnims = true; // actually i think this works better?
      this.playAnimation(value.anim, true, true); // then force play the animation. (dude i spent so much time figuring this out why am i even doing this talvez eu endoide no meio do desenvolvimento)
    }
  }

  function setOppAnimation(anim:String):Void
  {

    if (anim == null) anim = '';

    // Get character configuration
    var colorData = characterColors.get(anim);
    if (colorData != null)
    {
      // Update health bar colors
      var iconColor:FlxColor = FlxColor.fromString(colorData.iconColor);
      var barColor:FlxColor = FlxColor.fromString(colorData.barColor);

      if (PlayState.instance.iconP2 != null)
      {
        FlxTween.cancelTweensOf(PlayState.instance.iconP2);
        FlxTween.color(PlayState.instance.iconP2, 1, PlayState.instance.iconP2.color, iconColor, {
            ease: FlxEase.circOut,
        });

        retroGameUI?.scriptCall('updateBarColor', [CharacterType.DAD, barColor, true]);
      }

      // Update health value
      PlayState.instance.health = colorData.health;

      // Apply special effects
      if (colorData.digideathShake != null) digideathShake = colorData.digideathShake;
      if (colorData.digideathScreenShake != null) digideathScreenShake = colorData.digideathScreenShake;
      if (colorData.digideathNoteDrain != null) digideathNoteDrain = colorData.digideathNoteDrain;
      if (colorData.digiMulti != null) digiMulti = colorData.digiMulti;
    }
    // Fade UI if garcello
    if (anim == 'GARCELLO' && !hasFadenUI)
    {
      hasFadenUI = true;
      FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 0.6}, 0.15, { ease: FlxEase.expoIn });
      FlxTween.tween(PlayState.instance.opponentStrumline, {alpha: 0.6}, 0.15, { ease: FlxEase.expoIn });
    } else if (anim != 'GARCELLO' && hasFadenUI)
    {
      hasFadenUI = false;
      FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 1}, 0.15, { ease: FlxEase.expoOut });
      FlxTween.tween(PlayState.instance.opponentStrumline, {alpha: 1}, 0.15, { ease: FlxEase.expoOut });
    }

    // Update animation suffix based on character type
    if (animsWithOwnIdles.contains(anim))
    {
      this.idleSuffix = '-' + anim;
      singSuffix = '-' + anim;
    }
    else if (groundedAnims.contains(anim))
    {
      this.idleSuffix = '-GENERAL';
      singSuffix = '-' + anim;
    }
    else if (aerialAnims.contains(anim))
    {
      this.idleSuffix = '';
      singSuffix = '-' + anim;
    }
    else
    {
      this.idleSuffix = '';
      singSuffix = null;
    }

    // Play animation if different idle suffix
    if (lastIdleSuffix != this.idleSuffix)
    {
      lastIdleSuffix = this.idleSuffix;
      if (this.animation != null)
      {
        this.dance();
      }
    }
  }

  public function onNoteHit(event:HitNoteScriptEvent) {
    super.onNoteHit(event);
		if (PlayState.instance == null) return;
		if (!event.note.noteData.getMustHitNote() && characterType == CharacterType.DAD) {
      if (singSuffix != null)
      {
        var dir = event.note.noteData.getDirection();
        this.holdTimer = 0;
        this.playSingAnimation(dir, singSuffix);
      }
      if (digideathNoteDrain == true && PlayState.instance.health > 0.3) {
        PlayState.instance.health -= HEALTH_DRAIN;
      }
      if (digideathShake == true) {
        PlayState.instance.camGame.shake((2.75 * 4.5) * 0.001, 0.05);
      }
      if (digideathScreenShake == true) {
        PlayState.instance.camHUD.shake(2.75 * 0.001, 0.05);
      }
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (digideathNoteDrain == true && PlayState.instance.health > 0.3) {
      // Process hold notes on the opp's side.
      for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
      {
        if (holdNote == null || !holdNote.alive) continue;
        // While the hold note is being hit, and there is length on the hold note...
        if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0)
        {
          // Take health.
          PlayState.instance.health -= HEALTH_HOLD_DRAIN_PER_SECOND * event.elapsed;
        }
      }
    }
  }

  override function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    if (PlayState.instance == null) return;

    singSuffix = null;
    lastIdleSuffix = '';
    savedColor = '';
    PlayState.instance.iconP2.color = -1; // reset icon color to default

    digideathNoteDrain = null;
    digideathScreenShake = null;
    digideathShake = null;
    digiMulti = null;
    hasFadenUI = false;
  }

  override function onAnimationFinished(name:String)
  {
    super.onAnimationFinished(name);

  }

  override public function playSingAnimation(dir:Int, ?suffix:String = ''):Void {
    var suffixString:String = (suffix != '') ? suffix : '';
    var anim:String = singAnimations[dir] + suffixString;
		this.playAnimation(anim, true, true);
	}

  function initializeCharacterColors():Void
  {
    characterColors.set('DAD', {iconColor: '0xFFB066CF', barColor: '0xFFFF0105', health: 1, digiMulti: null, digideathShake: null, digideathScreenShake: null, digideathNoteDrain: null});
    characterColors.set('WHITTY', {iconColor: '0xFFCE012C', barColor: '0xFFD70029', health: 1});
    characterColors.set('RUV', {iconColor: '0xFF968BA3', barColor: '0xFF796793', health: 1, digideathShake: true});
    characterColors.set('GARCELLO', {iconColor: '0xFF01FF93', barColor: '0xFF01FF93', health: 1, digideathShake: false});
    characterColors.set('TABI', {iconColor: '0xFF5C6A83', barColor: '0xFF5E6983', health: 2, digideathScreenShake: true, digideathShake: true, digideathNoteDrain: true});
    characterColors.set('TRICKY', {iconColor: '0xFFFF1904', barColor: '0xFFFD0002', health: 1.25, digideathScreenShake: false, digideathShake: false, digideathNoteDrain: false, digiMulti: 12});
    characterColors.set('SHAGGY', {iconColor: '0xFFD11B1D', barColor: '0xFFD31A1F', health: 1});
    characterColors.set('SONIC', {iconColor: '0xFF0058B4', barColor: '0xFF2B0572', health: 1});
    characterColors.set('POKEMON', {iconColor: '0xFF7D5D8E', barColor: '0xFF7D5D8E', health: 1});
  }

  /*function playIdleAnim()
  {
    this.playAnimation('idle', false, false);
  }*/
}
