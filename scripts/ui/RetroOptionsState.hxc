        description: RetroLanguage.t("options.mechanics.desc"),
      },
      {
        id: "retroNotesTransform",
        type: OptionType.CHECKBOX,
        defaultValue: false,
        name: RetroLanguage.t("options.transform_notes"),
        description: RetroLanguage.t("options.transform_notes.desc"),
      },
      {
        id: "retroCheckpoints",
        type: OptionType.CHECKBOX,
        defaultValue: true,
        name: RetroLanguage.t("options.checkpoints"),
        description: RetroLanguage.t("options.checkpoints.desc"),
      },
      /*{
        id: "retroDefaultNotes",
        type: OptionType.CHECKBOX,
        defaultValue: true,
        name: RetroLanguage.t("options.default_notes"),
        description: RetroLanguage.t("options.default_notes.desc"),
      },*/
      {
        id: "retroShaders",
        type: OptionType.CHECKBOX,
        defaultValue: true,
        name: RetroLanguage.t("options.shaders"),
        description: RetroLanguage.t("options.shaders.desc"),
      },
      {
        id: "retroShake",
        type: OptionType.CHECKBOX,
        defaultValue: true,
