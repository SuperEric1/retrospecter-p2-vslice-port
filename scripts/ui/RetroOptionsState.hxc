      },
      {
        id: "retroComboOffY",
        type: OptionType.NUMBER,
        defaultValue: 0,
        min: -50,
        max: 600,
        step: 2,
        precision: 2,
        name: RetroLanguage.t("options.combooffsety"),
        description: RetroLanguage.t("options.combooffsety.desc"),
      },
      {
        id: "retroComboOffX",
        type: OptionType.NUMBER,
