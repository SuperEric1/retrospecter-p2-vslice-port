}

typedef CustomOption = {
  var name:String;
  var description:String;
  var id:String;
  var type:OptionType;
  @:optional var defaultValue:Dynamic;
  @:optional var min:Float;
  @:optional var max:Float;
  @:optional var step:Float;
  @:optional var precision:Int;
  @:optional var enumValues:Map<String, Dynamic>;
  @:optional var defaultEnumKey:String;
  @:optional var available:Bool;
}

enum OptionType {
  CHECKBOX;
  NUMBER;
  PERCENTAGE;
  ENUM;
}
