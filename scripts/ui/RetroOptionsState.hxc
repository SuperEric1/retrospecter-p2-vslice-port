        max: 700,
        step: 2,
        precision: 2,
        name: RetroLanguage.t("options.combooffsetx"),
        description: RetroLanguage.t("options.combooffsetx.desc"),
      },
      {
        id: "retroCustomMenus",
        type: OptionType.CHECKBOX,
        defaultValue: true,
        name: RetroLanguage.t("options.custom_menus"),
        description: RetroLanguage.t("options.custom_menus.desc"),
      },


      /* Template options
      {
        name: "Note Splash Opacity",
        description: "Adjust note splash transparency",
        id: "noteSplashOpacity",
        type: OptionType.PERCENTAGE,
        defaultValue: 100,
        min: 0,
        max: 100
      },
      {
        name: "Scroll Speed",
        description: "Adjust note scroll speed",
        id: "scrollSpeed",
        type: OptionType.NUMBER,
        defaultValue: 1.0,
        min: 0.5,
        max: 3.0,
        step: 0.1,
        precision: 2
      },
      {
        name: "Note Hit Sound",
        description: "Sound effect when hitting notes",
        id: "noteHitSound",
        type: OptionType.ENUM,
        enumValues: [
          "None" => "none",
          "Ping Pong" => "pingpong",
          "Hitsound" => "hitsound"
        ],
        defaultEnumKey: "None"
      }*/
    ];
