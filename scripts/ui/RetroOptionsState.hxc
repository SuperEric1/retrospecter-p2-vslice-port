  var dozircX:Float = 0;
  var dozircY:Float = 0;
  var signTextY:Float = 0;
  var signArrowsY:Float = 0;

  public function new()
  {
    super("RetroOptionsState", 1000, {
      state: OptionsState
    });
    //setupSave(); // this is done in RetroSave.hxc
  }

  public function buildSprites():Void
  {
    windozBg = FunkinSprite.create(0, 0, bgPath);
    windozBg.setGraphicSize(1216);
    windozBg.scrollFactor.set(0, 0);
    windozBg.screenCenter(0x01);

    taskbar = new FlxSprite(0, 0).makeGraphic(FlxG.width * 1.1, 100, 0xFF2d3131);
    taskbar.screenCenter(0x01);
    taskbar.scrollFactor.set(0, 0);
    taskbar.y = FlxG.height - 80;
    buildApps();

    backBg = new FlxSprite(0, 0).makeGraphic(FlxG.width, FlxG.height, FlxColor.BLACK);
    backBg.screenCenter();
    backBg.alpha = backBgAlpha;
    backBg.scrollFactor.set(0, 0);
    backBg.visible = false;

    introBg = new FlxSprite(0, 0);
    introBg.makeGraphic(FlxG.width * 1.1, FlxG.height * 1.1, 0xFF60dee8);
    introBg.screenCenter();

    introWindozBg = new FlxSprite(0, 0);
    introWindozBg.loadGraphic(Paths.image(bgPath));
    introWindozBg.setGraphicSize(1320);
    introWindozBg.screenCenter();

    dozirc = new FlxAtlasSprite(0, 0, Paths.animateAtlas('ui/menu/options/dozirc', 'shared'));
    dozirc.setGraphicSize(Std.int(dozirc.width * 1));
    // dude
    dozirc.animation.addBySymbol('anims/default', 'anims/default', 24);
    dozirc.animation.addBySymbol('anims/black', 'anims/black', 24);
    dozirc.animation.addBySymbol('anims/oops', 'anims/oops', 24);
    dozirc.animation.addBySymbol('anims/controls', 'anims/controls', 24);
    dozirc.animation.addBySymbol('anims/cofused', 'anims/confused', 24);
    dozirc.animation.addBySymbol('anims/signAlone', 'anims/signAlone', 24);
    dozirc.animation.addBySymbol('anims/down', 'anims/down', 24);
    dozirc.animation.addBySymbol('anims/up', 'anims/up', 24);
    dozirc.animation.addBySymbol('anims/evil', 'anims/evil', 24);
    dozirc.animation.addBySymbol('anims/cpu', 'anims/cpu', 24);
    dozirc.animation.addBySymbol('anims/gpu', 'anims/gpu', 24);
    dozirc.animation.addBySymbol('anims/glasses', 'anims/glasses', 24);
    dozirc.animation.addBySymbol('anims/pause', 'anims/pause', 24);
    dozirc.animation.addBySymbol('anims/online', 'anims/online', 24);
    dozirc.animation.addBySymbol('anims/offline', 'anims/offline', 24);
    dozirc.animation.addBySymbol('anims/low', 'anims/low', 24);
    dozirc.animation.addBySymbol('anims/glow', 'anims/glow', 24);
    dozirc.animation.addBySymbol('anims/clock', 'anims/clock', 24);
    dozirc.animation.addBySymbol('anims/shake', 'anims/shake', 24);
    dozirc.animation.play('anims/default', false, false, true);
    dozirc.scrollFactor.set(0, 0);
    dozirc.visible = true;
    dozirc.x = FlxG.width - 930; // (FlxG.width / 2) - 180 /// (FlxG.width * 0.47)
    dozirc.y = FlxG.height - 500 - 105; //(FlxG.height / 2) - 130
    dozircX = dozirc.x;
    dozircY = dozirc.y;
    dozirc.updateHitbox();
    playMenuAnim('default');

    dozircShadow = new FlxAtlasSprite(0, 0, Paths.animateAtlas('ui/menu/options/dozirc', 'shared'));
    dozircShadow.setGraphicSize(Std.int(dozircShadow.width * 1));
    dozircShadow.animation.addBySymbol('anims/black', 'anims/black', 24);
    dozircShadow.animation.play('anims/black', false, false, true);
    dozircShadow.scrollFactor.set(0, 0);
    dozircShadow.visible = true;
    dozircShadow.x = dozirc.x;
    dozircShadow.y = dozirc.y;
    dozircShadow.alpha = 0;
    dozircShadow.updateHitbox();

    windozText = new FlxText(0, 0, 0, 'WinDOZ', 60);
    windozText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 60, 0xFFFFFFFF, 'center');
    windozText.fieldWidth = FlxG.width;
    windozText.screenCenter(0x01);
    windozText.y = 560;
    windozIntroText = windozText.clone();
    windozIntroText.y = windozText.y + 10;

    signText = new FlxText(0, 0, 0, 'TEST', 1);
    signText.setFormat(Paths.font('DS-DIGIB.TTF'), 150, 0xFF7df1ef, 'center');
    signText.scrollFactor.set(0, 0);
    signText.fieldWidth = 343;
    //signText.textField.background = true;
    signText.x = dozirc.x + 280;
    signText.y = dozirc.y + 405;
    signText.visible = false;
    signTextY = signText.y;

    signArrows = FunkinSprite.create(0, 0);
    signArrows.loadSparrow(imagePath + "anim");
    signArrows.animation.addByPrefix('idle', 'shakeDisabled0', 1, true);
    signArrows.animation.addByPrefix('shake', 'shakeEnabled0', 18, true);
    signArrows.animation.addByPrefix('hazard', 'scrollBadEnabled0', 50, true);
    signArrows.animation.addByPrefix('hazard-off', 'scrollBadDisabled0', 50, true);
    signArrows.animation.play('idle');
    signArrows.x = signText.x + (signText.fieldWidth / 2) - (signArrows.width / 2);
    signArrows.y = signText.y - 120;
    signArrows.scrollFactor.set(0, 0);
    signArrows.updateHitbox();
    signArrows.visible = false;
    signArrowsY = signArrows.y;

    browser = FunkinSprite.create(0, 0);
    browser.loadSparrow(imagePath + "browser");
    browser.setGraphicSize(896); // Std.int(FlxG.width * 0.7)
    browser.animation.addByPrefix('normal', '1', 1, true);
    browser.animation.addByPrefix('incognito', '2', 1, true);
    browser.animation.play('normal');
    browser.scrollFactor.set(0, 0);
    browser.screenCenter();
    browser.y -= 20;
    browser.visible = false;
    browserY = browser.y;

    browserIcon = FunkinSprite.create(0, 0);
    browserIcon.loadSparrow(imagePath + "browserIcon");
    browserIcon.animation.addByPrefix('idle', 'idle0', 3, true);
    browserIcon.animation.addByPrefix('hover', 'mouse0', 3, false);
    browserIcon.animation.play('idle');
    browserIcon.x = browser.x + browser.width - (browserIcon.width * 0.65);
    browserIcon.y = browser.y - 13;
    //browserIcon.color = 0xFF000000;
    browserIcon.scrollFactor.set(0, 0);
    browserIcon.updateHitbox();
    browserIcon.visible = false;
    browserIconY = browserIcon.y;
    // the visibility of the browserIcon is held in the open and close browser functions

    browserText = new FlxText(0, 0, 0, 'youtube.com/@super_eric', 1);
    browserText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFFFF, 'left'); // color is set in openBrowser()
    browserText.scrollFactor.set(0, 0);
    browserText.fieldWidth = browser.width - 100;
    //browserText.textField.background = true;
    browserText.x = browser.x + 90;
    browserText.y = browser.y + 18;
    browserText.visible = false;
    browserTextY = browserText.y;
    // the visibility of the browserText is held in the open and close browser functions

    frontBg = new FlxSprite(0, 0).makeGraphic(FlxG.width * 1.1, FlxG.height * 1.1, FlxColor.BLACK);
    frontBg.screenCenter();
    frontBg.alpha = 0;
    frontBg.alpha = 0.15;
    frontBg.scrollFactor.set(0, 0);

    fade = new FlxSprite(0, 0).makeGraphic(FlxG.width * 1.1, FlxG.height * 1.1, FlxColor.BLACK);
    fade.screenCenter();
    fade.alpha = 0;
    fade.scrollFactor.set(0, 0);

    overlay = new FlxSprite(0, 0).loadGraphic(Paths.image(imagePath + "overlay"));
    overlay.setGraphicSize(Std.int(FlxG.width * 1.1), Std.int(FlxG.height * 1.09));
    overlay.scrollFactor.set(0, 0);
    overlay.visible = true;
    overlay.screenCenter();

    RetroAchievements.deleteToasts();
  }

  function buildApps():Void {
    var path = imagePath + "apps";
    var size = 60;
    var gap = 0; // the gap increases as we add apps
    var y = taskbar.y + 2;
    var appAnims = [ "dozirc", "retro", "hivemine", "insatian", "atrocean", "izzy", "saku", "config" ];

    for (appAnim in appAnims)
    {
      var app:FunkinSprite = FunkinSprite.create(0, 0);
      app.loadSparrow(path);
      app.animation.addByPrefix('idle', appAnim + '0', 3, true);
      app.animation.addByPrefix('press', "mouse" + appAnim + '0', 3, true);
      app.animation.addByPrefix('hover', "press" + appAnim + '0', 3, true);
      app.animation.play('idle');
      app.setGraphicSize(size);
      app.scrollFactor.set(0, 0);
      app.x = 90 + gap + (appAnim == "config" ? 5 : 0);
      app.y = y;
      app.updateHitbox();
      taskBarApps.push(app);
      gap += size + 20; // the actual gap is here
    }
  }

  function openBrowser(appIndex:Int):Void
  {
    if (browser == null || browserText == null) return;
    if (appIndex == 0 || appIndex == 7) {
      FunkinSound.playOnce(Paths.soundRandom('chartingSounds/keyboard', 1, 3));
      return; // first and last app don't open browser (shutdown & settings)
    }

    browserOpenForApp = appIndex;
    browser.visible = true;
    browser.animation.play(appIndex == 6 ? 'incognito' : 'normal');
    browserIcon.visible = browser.visible;
    browserText.visible = browser.visible;
    browserText.color = appIndex == 6 ? 0xFFFFFFFF : 0xFF3c4f7f; // white for incognito, blue for normal
    FunkinSound.playOnce(Paths.sound('chartingSounds/openWindow'));

    tweenBrowser();

    if (appIndex == 6) {
      dozirc.animation.play('anims/oops', false, false, true);
      RetroAchievements.grantAc('misc-incognito', true, true);
    } else if (appIndex != 6 && dozirc.animation.curAnim.name == 'anims/oops') {
      dozirc.animation.play('anims/default', false, false, true);
    }

    if (appURLs.exists(appIndex)) {
      browserText.text = appURLs.get(appIndex);
    } else browserText.text = "youtube.com/@super_eric"; // default url in case of error
  }

  function closeBrowser():Void
  {
    if (browserOpenForApp == -1) return; // browser already closed before

    if (browserOpenForApp == 6) {
      new FlxTimer().start(0.3, function(tmr:FlxTimer) { //ao completar o timer
        if (dozirc == null) return;
        if (dozirc.animation.curAnim.name != 'anims/oops') return;
        if (browser.visible) return;
        dozirc.animation.play('anims/default', false, false, true);
      });
    }

    // this is here so if the player enters a category while the browser is open, the app doesn't stay in 'press' state
    taskBarApps[browserOpenForApp]?.animation?.play('idle', false);

    browserOpenForApp = -1;
    FunkinSound.playOnce(Paths.sound('chartingSounds/exitWindow'));
    if (browser != null) {
      browser.visible = false;
      browserIcon.visible = browser.visible;
      browserText.visible = browser.visible;
    }
  }

  public function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    if (Std.isOfType(event.targetState, OptionsState))
    {
      initRetroOptions(); // refresh the options (for the translations to work)
      hasAddedOptions = false; // add the options again!
      hasUpdatedBgSprite = false;
      canUpdate = Save.instance.modOptions.get('retroCustomMenus'); // to determine if the menu will build/update. we update this variable once the state changes to not cause any bugs with onUpdate.

      if (!event.targetState.members.contains(dozirc) && canUpdate)
      {
        var state = event.targetState;
        //loadDebugElements();
        var z:Int = 0;
        taskBarApps = []; // delete the previous apps to prevent errors
        buildSprites();
        state.insert(1, windozBg);
        state.insert(2, windozText);
        state.insert(3, backBg);
        state.insert(4, dozirc);
        state.insert(5, dozircShadow);
        state.insert(6, signText);
        state.insert(7, signArrows);
        state.insert(8, taskbar);
        for (app in taskBarApps) { if (app != null) state.insert(9, app); }
        state.insert(10, frontBg);
        FlxTween.tween(frontBg, {alpha: 0}, 1, { type: 4, ease: FlxEase.quadInOut });
        state.add(browser);
        state.add(browserText);
        state.add(browserIcon);
        state.add(overlay);
        state.add(introBg);
        state.add(introWindozBg);
        introBg.kill();
        introWindozBg.kill();
        state.add(windozIntroText);
        windozIntroText.kill();
        state.add(fade);
        if (debugText != null) state.add(debugText);
        FlxG.mouse.visible = true;
        if (FlxG.mouse.cursor != null) FlxG.mouse.load(Paths.image('ui/menu/options/cursor'), FlxG.onMobile ? 1.7 : 1);
        adjustButtons(state);
        if (FlxG.onMobile) {
          var backButton = ReflectUtil.getProperty(state.optionsCodex.currentPage, "backButton");
          backButton?.alpha = 0.25;
        }
        fade.alpha = 1;
        FlxTween.tween(fade, {alpha: 0}, 1, { ease: FlxEase.quadOut });
        if (!Save.instance.modOptions.get('retroOptionsIntroPlayed')) {
          doIntro();
        } else {
          playMenuMusic();
        }
        hasBuilt = true;
        isShuttingDown = false;
      }
    }
  }

  function doIntro():Void {
    var delay:Float = 1.5;
    var easeType:FlxEase = FlxEase.quadInOut;

    if (!introBg.alive) introBg.revive();
    if (!introWindozBg.alive) introWindozBg.revive();
    if (!windozIntroText.alive) windozIntroText.revive();

    FlxG.mouse.visible = false;
    Save.instance.modOptions.set('retroOptionsIntroPlayed', true);
    if (FlxG.sound.music != null) FlxG.sound.music.stop();
    FunkinSound.playOnce(Paths.sound('menus/boot'), 1);

    FlxTween.tween(introWindozBg, {alpha: 0}, 1, {startDelay: delay, ease: easeType, onComplete: _ -> {
      playMenuMusic();
      FlxG.mouse.visible = true;
      introWindozBg.kill();
    }});
    FlxTween.tween(introBg, {alpha: 0}, 1, {startDelay: delay, ease: easeType, onComplete: _ -> {
      introBg.kill();
    }});
    FlxTween.tween(windozIntroText, {alpha: 0}, 1, {startDelay: delay, ease: easeType, onComplete: _ -> {
      windozIntroText.kill();
    }});
  }

  function createPreferences(state:OptionsState):Void {
    hasAddedOptions = true;
    var preferences = state.optionsCodex.pages.get("preferences");

    for (option in retroOptions) {
      switch (option.type) {
        case OptionType.CHECKBOX:
          preferences.createPrefItemCheckbox(
            option.name,
            option.description,
            function(value:Bool) {
              Save.instance.modOptions.set(option.id, value);
              Save.instance.flush();

              if (option.id == "retroCustomMenus" && value == false) FlxG.mouse.visible = false;
            },
            Save.instance.modOptions.get(option.id, option.defaultValue),
            option.available != null ? option.available : true
          );

        case OptionType.NUMBER:
          preferences.createPrefItemNumber(
            option.name,
            option.description,
            function(value:Float) {
              Save.instance.modOptions.set(option.id, value);
              Save.instance.flush();
            },
            null, // valueFormatter (você pode adicionar se quiser)
            Save.instance.modOptions.get(option.id, option.defaultValue),
            option.min != null ? option.min : 0.0,
            option.max != null ? option.max : 10.0,
            option.step != null ? option.step : 0.1,
            option.precision != null ? option.precision : 2
          );

        case OptionType.PERCENTAGE:
          preferences.createPrefItemPercentage(
            option.name,
            option.description,
            function(value:Int) {
              Save.instance.modOptions.set(option.id, value);
              Save.instance.flush();
            },
            Save.instance.modOptions.get(option.id, option.defaultValue),
            option.min != null ? Std.int(option.min) : 0,
            option.max != null ? Std.int(option.max) : 100
          );

        case OptionType.ENUM:
          preferences.createPrefItemEnum(
            option.name,
            option.description,
            option.enumValues,
            function(key:String, value:Dynamic) {
              Save.instance.modOptions.set(option.id, value);
              Save.instance.flush();

              if (option.id == "retroLanguage") RetroLanguage.updateLanguage(value);
            },
            option.defaultEnumKey != null ? option.defaultEnumKey : "None"
          );
      }
    }
  }

  function playMenuMusic():Void
  {
    var shouldFadeIn:Bool = (FlxG.sound.music == null);
    // Load music. Includes logic to handle BPM changes.
    FunkinSound.playMusic('optionsMenu',
      {
        startingVolume: 0.0,
        overrideExisting: true,
        restartTrack: false,
        // Continue playing this music between states, until a different music track gets played.
        persist: false
      });
    // Fade from 0.0 to 1 over 4 seconds
    if (shouldFadeIn) FlxG.sound.music.fadeIn(4.0, 0.0, 1.0);
  }

  override function onUpdate(event:ScriptEvent):Void
  {
    super.onUpdate(event);
    if (FlxG.state == null) return;
    if (Std.isOfType(FlxG.state, OptionsState))
    {
      var optionsState:OptionsState = FlxG.state;
      if (!hasAddedOptions) createPreferences(optionsState);
      if (!hasBuilt || !canUpdate) return;

      // Isso permite acessar tudo dentro de OptionsState mesmo sendo privado
      @:privateAccess {
        var bg = optionsState.members[0];
        if (bg != null && Std.isOfType(bg, FlxSprite)) {
          var bgSprite:FlxSprite = bg;
          if (!hasUpdatedBgSprite /*bgSprite.graphic != null && bgSprite.graphic.key != Paths.image(bgPath)*/) {
            hasUpdatedBgSprite = true;
            //bgSprite.loadGraphic(Paths.image(bgPath));
            // bgSprite.setGraphicSize(Std.int(FlxG.width * 0.95));
            bgSprite.makeGraphic(FlxG.width * 1.1, FlxG.height * 1.1, 0xFF60dee8);
            bgSprite.shader = null;
          }
        }

        if (FlxG.onMobile) {
          for (member in optionsState.members)
          {
            if (Std.isOfType(member, FunkinBackButton))
            {
              member.alpha = 0.4;
              break;
            }
          }
        }

        var codex = optionsState.optionsCodex;
        var currentPageName:String = codex.currentName;

        if (currentPageName != curPage)
        {
          trace('Mudou para página: ' + currentPageName);
          curPage = currentPageName;
          curAnim = '';
        }

        var settingsApp = taskBarApps[7];
        if (currentPageName == 'options') {
          if (!isShuttingDown) { // handle animations only if the shutdown button isn't pressed, so the shutdown animation can play properly
            handleOptionsPage(optionsState);
          }
        } else if (currentPageName == 'preferences') {
          if (settingsApp != null) settingsApp?.animation?.play('press');
          isShuttingDown = false; // cancel shutdown!
          handlePreferencesPage(optionsState);
        } else if (currentPageName == 'controls') {
          if (settingsApp != null) settingsApp?.animation?.play('press');
          isShuttingDown = false; // cancel shutdown!
          handleControlsPage(optionsState);
        } else if (currentPageName == 'offsets') {
          if (settingsApp != null) settingsApp?.animation?.play('press');
          isShuttingDown = false; // cancel shutdown!
          handleOffsetsPage(optionsState);
        } else {
          if (dozirc != null) playMenuAnim('default');
        }
      }
    }
  }

  function handleOptionsPage(optionsState:OptionsState):Void
  {
    // Usamos @:privateAccess novamente para garantir acesso aos internos
    @:privateAccess {
      if (backBg != null) { backBg.visible = false; backBg.alpha = backBgAlpha; }
      var codex = optionsState.optionsCodex;
      var pages = codex.pages;

      var optionsPage = pages.get('options');

      if (optionsPage == null) return;

      var items = optionsPage.items;
      if (items == null) return;
      var exitItemIndex:Int = -1;

      for (i in 0...items.length)
      {
        var item = items.members[i];
        if (item != null && item.label.text == "EXIT" && taskbar != null)
        {
          exitItemIndex = i;
          var x = FlxG.width - 300;
          var y = taskbar.y - 10;
          item.x = x;
          item.y = y;
          item.label.x = x + 50;
          item.label.y = y;
          item.label.scrollFactor.set(0, 0);
          item.kill();
          break; // we found the exit button, stop!!
        }
      }
      var controls = PlayerSettings.player1.controls;
      if (((!FlxG.onMobile && !ControlsHandler.usingExternalInputDevice) || (FlxG.onMobile && ControlsHandler.usingExternalInputDevice)) && items.selectedIndex >= items.length - 1)
      {
        var index:Int = 0;
        if (controls.UI_UP_P) index = items.length - 2;
        items.selectItem(index); // Wrap around so we never reach the exit button
      }

      var goingBack:Bool = (FlxG.onMobile) ? ReflectUtil.getProperty(codex.currentPage, "goingBack") : false;
      if (goingBack && !isShuttingDown) {
        isShuttingDown = true;
        taskBarApps = [];
        playAnimIfDifferent('anims/signAlone', true);
        signText.visible = true;
        signText.text = "BYE";
        FlxG.sound.music.fadeOut(1.0);
        FlxG.keys.enabled = false;
        FlxG.mouse.visible = false;
        FlxTween.tween(fade, {alpha: 1}, 0.15, {
          startDelay: 0.4,
          ease: FlxEase.quadInOut,
          onComplete: function(twn:FlxTween) {
            if (!isShuttingDown && fade != null) {
              fade.alpha = 0;
            }
          }
        });
        return;
      }

      var selectedItem = items.selectedItem;
      if (selectedItem == null) return;

      var itemName:String = selectedItem.name;

      if (debugText != null) debugText.text = 'OPTIONS: ' + itemName;

      FlxG.camera.follow(null);
      FlxG.camera.scroll.set(0, 0);

      playMenuAnim(itemName);

      // Animate taskbar apps. play animation when the mouse is hovering over them.
      var justPressed = FlxG.mouse.justPressed;
      var justReleased = FlxG.mouse.justReleased;
      if (FlxG.onMobile && TouchUtil != null) justPressed = TouchUtil.justPressed;
      if (FlxG.onMobile && TouchUtil != null) justReleased = TouchUtil.justReleased;
      for (i in 0...taskBarApps.length)
      {
        var app = taskBarApps[i];
        if (app == null) continue;

        var isBrowserOpen = (browserOpenForApp == i);

        var isOverlapping:Bool = app.overlapsPoint(FlxG.mouse.getWorldPosition());
        if (FlxG.onMobile && TouchUtil != null && !ControlsHandler.usingExternalInputDevice) isOverlapping = TouchUtil.overlapsComplex(app) || app.overlapsPoint(FlxG.mouse.getWorldPosition());

        if (isOverlapping)
        {
          if (justPressed)
          {
            if (i == 0) FunkinSound.playOnce(Paths.sound("chartingSounds/noteLay"));
            //FunkinSound.playOnce(Paths.sound(i == 0 ? "chartingSounds/noteLay" : "chartingSounds/ClickDown"));
            if (isBrowserOpen)
            {
              closeBrowser(); // close browser if we click on the app again
            }
            else
            {
              closeBrowser();
              openBrowser(i);
            }
            if (i == 0 && !isShuttingDown) { // shutdown button
              isShuttingDown = true;
              playAnimIfDifferent('anims/signAlone', true);
              signText.visible = true;
              signText.text = "BYE";
              FlxG.sound.music.fadeOut(1.0);
              new FlxTimer().start(1.0, function(tmr:FlxTimer) {
                if (!isShuttingDown) return; // return if shutdown was cancelled for any reason before
                cancelTweens();
                taskBarApps = []; // delete the previous apps to prevent errors
                codex.currentPage.enabled = false;
                FlxG.keys.enabled = false;
                FlxG.mouse.visible = false;
                FlxG.switchState(() -> new MainMenuState());
              });
              FlxTween.tween(fade, {alpha: 1}, 0.2, {
                startDelay: 0.8,
                ease: FlxEase.quadInOut,
                onComplete: function(twn:FlxTween) {
                  if (!isShuttingDown && fade != null) {
                    fade.alpha = 0;
                  }
                }
              });
            }
          } else if (justReleased) {
            //if (i != 0) FunkinSound.playOnce(Paths.sound("chartingSounds/ClickUp"));
          }

          if (isBrowserOpen)
          {
            if (app.animation.curAnim.name != 'press')
            {
              app.animation.play('press', false);
            }
          }
          // hover
          else
          {
            if (i == 0 && isShuttingDown && !app.animation.isPlaying) { // shutdown button
              app.animation.play('press', false);
              app.color = 0xFF266ca2; // #266ca2ff
              continue;
            }

            if (!app.animation.isPlaying || app.animation.curAnim.name != 'hover' && app.animation.curAnim.name != 'press')
            {
              app.animation.play('hover', false);
              if (i == 0) { // shutdown button
                app.color = 0xFF266ca2; // #266ca2ff
              }
            }
          }
        }
        else
        {
          // if browser is open
          if (isBrowserOpen)
          {
            if (app.animation.curAnim.name != 'press')
            {
              app.animation.play('press', false);
            }
          }
          else
          {
            if (!app?.animation?.isPlaying && app?.animation?.curAnim?.name != 'idle')
            {
              app.animation.play('idle', false);
              if (i == 0) { // shutdown button
                // reset app color
                app.color = 0xFFFFFFFF;
              }
            }
            // settings app
            if (i == 7) {
              app.animation.play('hover', false);
            }
          }
        }
      }
      if (browserIcon != null) {
        var isOverlapping:Bool = browserIcon.overlapsPoint(FlxG.mouse.getWorldPosition());
        if (FlxG.onMobile && TouchUtil != null && !ControlsHandler.usingExternalInputDevice) isOverlapping = TouchUtil.overlapsComplex(browserIcon);

        if (isOverlapping)
        {
          // Fecha o browser ao clicar no ícone X
          if (justPressed)
          {
            FunkinSound.playOnce(Paths.sound("chartingSounds/exitWindow"));
            closeBrowser();
          }

          if (!browserIcon.animation.isPlaying || browserIcon.animation.curAnim.name != 'hover')
          {
            browserIcon.animation.play('hover', false);
          }
        }
        else
        {
          if (!browserIcon.animation.isPlaying || browserIcon.animation.curAnim.name != 'idle')
          {
            browserIcon.animation.play('idle', false);
          }
        }
      }

      if (justPressed) FunkinSound.playOnce(Paths.sound("menus/click"));

      // Animate the alpha of the front BG, making it seem like it's fading in and out
      // This is now done with a tween in onCreate
      if (frontBg == null) return;
      /*var fadeTime:Float = 1.3;
      if (frontBg.alpha <= 0) {
        isFrontBgFadingIn = true;
        FlxTween.tween(frontBg, {alpha: 0.2}, fadeTime, { ease: FlxEase.quadInOut,
          onComplete: function(twn:FlxTween) {
            isFrontBgFadingIn = false;
            FlxTween.tween(frontBg, {alpha: 0}, fadeTime, { ease: FlxEase.quadInOut });
          }
        });
      }*/
    }
  }

  // this only runs after the state is loaded so the original position dont mess with the new one
  function adjustButtons(optionsState:OptionsState):Void
  {
    @:privateAccess {
      var codex = optionsState.optionsCodex;
      var pages = codex.pages;

      var optionsPage = pages.get('options');

      if (optionsPage == null) return;

      var items = optionsPage.items;
      if (items == null) return;

      var members:Array<Dynamic> = items.members;
      if (members != null)
      {
        for (item in members)
        {
          if (item != null)
          {
            item.y += buttonOffsetY;
            item.label.y += buttonOffsetY;
            item.x = buttonPosX;
            item.label.x = buttonPosX;
            //item.updateHitbox(); // don't update hitbox or it breaks on mobile
          }
        }
      }
    }
  }

  function handlePreferencesPage(optionsState:OptionsState):Void
  {
    closeBrowser();
    @:privateAccess {
      if (backBg != null) { backBg.visible = true; backBg.alpha = backBgAlpha; }
      var codex = optionsState.optionsCodex;
      var pages = codex.pages;
      var preferencesPage = pages.get('preferences');

      if (preferencesPage == null) return;

      var prefItems = preferencesPage.items;
      if (prefItems == null) return;
      // mod preferences title
      for (i in 0...prefItems.length)
      {
        var item = prefItems.members[i];
        if (item != null && item.label.text == retroOptions[0].name)
        {
          item.label.alpha = 0.8;
          item.label.color = 0xFF7df1ef;
          break; // we found the button, stop!!
        }
      }

      var selectedItem = prefItems.selectedItem;
      if (selectedItem == null) return;

      var itemName:String = selectedItem.name;

      if (debugText != null) debugText.text = 'PREFS: ' + itemName;

      if (itemName != curAnim)
      {
        if (dozircShadow != null) dozircShadow.alpha = 0;
        if (signText != null) signText.visible = false;
        if (signArrows != null) signArrows.visible = false;
        playPreferencesAnim(itemName);
      }
    }
  }

  function handleControlsPage(optionsState:OptionsState):Void
  {
    closeBrowser();
    if (backBg != null) { backBg.visible = true; backBg.alpha = backBgAlpha + 0.3; }
    if (dozirc != null && curAnim != 'controls-page')
    {
      if (dozircShadow != null) dozircShadow.alpha = 0.6;
      if (signText != null) signText.visible = false;
      curAnim = 'controls-page';
      dozirc.animation.play('anims/controls', false, false, true);
    }
    if (debugText != null) debugText.text = 'CONTROLS PAGE';
  }
  function handleOffsetsPage(optionsState:OptionsState):Void
  {
    closeBrowser();
    if (dozirc != null && curAnim != 'offsets-page')
    {
      if (dozircShadow != null) dozircShadow.alpha = 0;
      if (signText != null) signText.visible = false;
      curAnim = 'offsets-page';
      dozirc.animation.play('anims/confused', false, false, true);
    }
    if (debugText != null) debugText.text = 'OFFSET PAGE';
  }

  function playMenuAnim(name:String):Void
  {
    if (dozirc == null) return;

    var nameUpper:String = name.toUpperCase();
    var animName:String = 'anims/default';

    switch(nameUpper) {
      case 'CONTROLS': animName = 'anims/controls';
      case 'LAG ADJUSTMENT': animName = 'anims/confused';
      case 'EXIT':
        animName = 'anims/signAlone';
        signText.visible = true;
        signText.text = "BYE";
      case 'CLEAR SAVE DATA':
        animName = 'anims/signAlone';
        signText.visible = true;
        signText.text = "DEL";
      //case 'PREFERENCES': animName = 'anims/signAlone';
    }

    playAnimIfDifferent(animName, true);
  }

  function playPreferencesAnim(itemName:String):Void
  {
    if (dozirc == null || dozircShadow == null) return;
    var nameUpper:String = itemName.toUpperCase();
    var animName:String = 'anims/default';
    var doesTextChangeBop:Bool = true; // desativar se o texto muda de acordo com a opção, para não ficar boppando
    var save:Save = Save.instance.modOptions;

    var currentID:String = "";

    for (opt in retroOptions) { // for the custom options
      if (opt.name.toUpperCase() == nameUpper) {
        currentID = opt.id;
        break;
      }
    }

    if (nameUpper == 'DOWNSCROLL') animName = Preferences.downscroll ? 'anims/down' : 'anims/up';
    else if (nameUpper == 'NAUGHTYNESS' && Preferences.naughtyness) animName = 'anims/evil';
    else if (nameUpper == 'STRUMLINE BACKGROUND') dozircShadow.alpha = Preferences.strumlineBackgroundOpacity / 100;
    else if (nameUpper == 'DEBUG DISPLAY BG') dozircShadow.alpha = Preferences.debugDisplayBGOpacity / 100;
    else if (nameUpper == 'DEBUG DISPLAY') {
      switch (Preferences.debugDisplay) {
        case "Simple": animName = 'anims/cpu';
        case "Advanced": animName = 'anims/gpu';
      }
    }
    else if (nameUpper == 'SUBTITLES' && Preferences.subtitles) {
      animName = 'anims/signAlone';
      signText.visible = true;
      signText.text = RetroLanguage.t("options.language.signText", "HI");
    }
    else if (nameUpper == 'FPS') {
      doesTextChangeBop = false;
      animName = 'anims/signAlone';
      signText.visible = true;
      signText.text = Std.string(Preferences.framerate);
    }
    else if (nameUpper == 'FLASHING LIGHTS' && Preferences.flashingLights) animName = 'anims/glasses';
    else if (nameUpper == 'LAUNCH IN FULLSCREEN') animName = Preferences.autoFullscreen ? 'anims/signAlone' : 'anims/signSmol';
    else if (nameUpper == 'PAUSE ON UNFOCUS' && Preferences.autoPause) animName = 'anims/pause';

    // custom
    else if (currentID == 'retroLanguage') {
      animName = 'anims/signAlone';
      signText.visible = true;
      signText.text = RetroLanguage.t("options.language.signText", "HI");
    }
    else if (currentID == 'retroMechanics') animName = save.get("retroMechanics") ? 'anims/online' : 'anims/offline';
    else if (currentID == 'retroShaders') animName = save.get("retroShaders") ? 'anims/glow' : 'anims/low';
    else if (currentID == 'retroShake' && save.get("retroShake")) {
      animName = 'anims/shake';
    }
    else if (currentID == 'retroSongLength') animName = save.get("retroSongLength") ? 'anims/booba' : 'anims/clock';
    else if (currentID == 'retroSuggestive' && save.get("retroSuggestive")) animName = 'anims/oops';

    else if (currentID == 'retroModcharts') {
      animName = 'anims/signAlone';
      signArrows.visible = true;
      if (save.get("retroModcharts")) {
          signArrows.animation.play("shake");
      } else signArrows.animation.play("idle");
    }
    else if (currentID == 'retroNotesTransform') {
      animName = 'anims/signAlone';
      signArrows.visible = true;
      if (save.get("retroNotesTransform")) {
          signArrows.animation.play("hazard-off");
      } else signArrows.animation.play("hazard");
    }

    playAnimIfDifferent(animName, doesTextChangeBop);
    if (dozircShake && !IntervalShake.isShaking(dozirc)) {
      final intensity = Preferences.flashingLights ? 0.005 : 0.0012;
      IntervalShake.shake(dozirc, 60, 0, intensity, intensity, FlxEase.linear);
    }
  }

  /*
  * Plays the given animation if it's different from the current one.
  * @param animName The name of the animation to play.
  * @param doesTextChangeBop Whether the text change should trigger a bop animation. (not working as intended idk)
  */
  function playAnimIfDifferent(animName:String, doesTextChangeBop:Bool = true):Void
  {
    if (dozirc == null || signText == null) return;

    if (animName != curAnim || signText.text != curText)
    {
      if (dozircShake) {
        dozircShake = false;
        IntervalShake.stopShaking(dozirc);
      }
      dozirc.x = dozircX;
      if (dozircShadow != null) dozircShadow.alpha = 0;
      if (signText != null) signText.visible = false;
      if (doesTextChangeBop == true) tweenDozirc();
      curAnim = animName;
      curText = signText.text;
      dozirc.animation.play(animName, false, false, true);

      // offsets & configs
      // do not mess with those (i hate offsets)
      var defaultOffsetX:Float = 83;
      switch (animName) {
        case 'anims/default': signArrows.visible = false; // Force so it doesn't stay after leaving the page
        case 'anims/pause': dozirc.x = dozircX + defaultOffsetX + 9;
        case 'anims/cpu': dozirc.x = dozircX + defaultOffsetX + 50;
        case 'anims/gpu': dozirc.x = dozircX + defaultOffsetX + 74;
        case 'anims/glow': dozirc.x = dozircX + defaultOffsetX + 207;
        case 'anims/shake': dozircShake = true;
      }
    }
  }

  function tweenDozirc():Void
  {
    if (dozirc == null || dozircShadow == null) return;
    cancelTweens();

    var targetY:Float = 10;
    var time:Float = 0.05;
    dozirc.y = dozircY;
    dozircShadow.y = dozircY;
    signText.y = signTextY;
    var objects = [dozirc, dozircShadow, signText, signArrows];
    var ogPositions = [dozircY, dozircY, signTextY, signArrowsY];
    for (obj in objects) {
      dozircTweens.push(
        FlxTween.tween(obj, {y: ogPositions[objects.indexOf(obj)] + targetY}, time, {
          ease: FlxEase.quartOut,
          onComplete: function(twn:FlxTween) {
            dozircTweens.push(
              FlxTween.tween(obj, {y: ogPositions[objects.indexOf(obj)]}, time, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );
    }
  }

  function tweenBrowser():Void
  {
    if (browser == null) return;
    cancelTweens();

    var targetY:Float = 3;
    var time:Float = 0.03;
    browser.y -= targetY;
    var objects = [browser, browserIcon, browserText];
    var ogPositions = [browserY, browserIconY, browserTextY];
    for (obj in objects) {
      browserTweens.push(
        FlxTween.tween(obj, {y: ogPositions[objects.indexOf(obj)] + targetY}, time, {
          ease: FlxEase.quartOut,
          onComplete: function(twn:FlxTween) {
            browserTweens.push(
              FlxTween.tween(obj, {y: ogPositions[objects.indexOf(obj)]}, time, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );
    }
  }

  function cancelTweens():Void
  {
    for (tween in dozircTweens)
    {
      if (tween != null) tween.cancel();
    }
    dozircTweens = [];
    for (tween in browserTweens)
    {
      if (tween != null) tween.cancel();
    }
    browserTweens = [];
  }

  function loadDebugElements():Void
  {
    if (debugText != null) return;

    debugText = new FlxText(0, 0, 0, '', 30);
    debugText.setFormat(Paths.font('vcr.ttf'), 30, 0xFFFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    debugText.borderSize = 3;
    debugText.fieldWidth = FlxG.width;
    debugText.screenCenter(0x01);
    debugText.y = 670;
    debugText.scrollFactor.set(0, 0);
    debugText.visible = true;
  }

  var retroOptions:Array<CustomOption> = [];
  function initRetroOptions():Void
  {
    RetroLanguage.updateLanguage(Save.instance.modOptions.get("retroLanguage") ?? "en_US"); // update the language in case the menu loads before the language module (which happens when we hot reload the menu)
    retroOptions = [
      {
        name: "Vs. RetroSpecter",
        description: RetroLanguage.t("options.mod_desc"),
        id: "retroPrefsTitle",
        type: OptionType.ENUM,
        enumValues: [" " => null],
        defaultEnumKey: " "
      },
      {
        id: "retroLanguage",
        type: OptionType.ENUM,
        name: RetroLanguage.t("options.language"),
        description: RetroLanguage.t("options.language.desc"),
        enumValues: [
          "en_US" => "en_US",
          "pt_BR" => "pt_BR",
          "it_IT" => "it_IT",
        ],
        defaultValue: Save.instance.modOptions.get("retroLanguage") ?? "en_US",
        defaultEnumKey: Save.instance.modOptions.get("retroLanguage") ?? "en_US"
      },
      {
        id: "retroModcharts",
        type: OptionType.CHECKBOX,
        defaultValue: true,
        name: RetroLanguage.t("options.modcharts"),
