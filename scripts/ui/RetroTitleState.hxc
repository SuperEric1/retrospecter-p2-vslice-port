    var face = new FlxSprite(startPoint + -30, 360);
    face.frames = Paths.getSparrowAtlas('Phase4/titlestate/faces');
    face.scale.set(0.5, 0.5);
    face.animation.addByPrefix("idle", "Final_DozircYard", 24, true);
    face.animation.play("idle");
    face.y += toAdd;
    addBg(face);

    var lll = new FlxSprite(startPoint + -190, 450);
    lll.frames = Paths.getSparrowAtlas('Phase4/titlestate/lake');
    lll.scale.set(0.666, 0.666);
    lll.animation.addByPrefix("idle", "Final_SoulRiver", 24, true);
    lll.animation.play("idle");
    lll.y += toAdd;
    addBg(lll);

    var s = new FlxSprite(0, 300).loadGraphic(Paths.image('Phase4/titlestate/s1'));
    s.scale.set(0.666, 0.666);
    s.updateHitbox();
    s.screenCenter(0x01);
    s.scrollFactor.set(0, 0);
    s.y += toAdd;
    addBg(s);

    var s2 = new FlxSprite(0, 385).loadGraphic(Paths.image('Phase4/titlestate/builds'));
    s2.scale.set(0.666, 0.666);
    s2.updateHitbox();
    s2.screenCenter(0x01);
    s2.scrollFactor.set(0, 0);
    s2.y += toAdd;
    addBg(s2);

    // Luzes animadas
    phase4_s3 = new FlxSprite(0, 385).loadGraphic(Paths.image('Phase4/titlestate/lights'));
    phase4_s3.scale.set(0.666, 0.666);
    phase4_s3.updateHitbox();
    phase4_s3.screenCenter(0x01);
    phase4_s3.scrollFactor.set(0, 0);
    phase4_s3.y += toAdd;
    addBg(phase4_s3);

    var a = new FlxSprite(0, 90).loadGraphic(Paths.image('Phase4/titlestate/sakutower'));
    a.scale.set(0.666, 0.666);
    a.updateHitbox();
    a.screenCenter(0x01);
    a.scrollFactor.set(0, 0);
    a.y += toAdd;
    addBg(a);

    try {
      var spotlight = new FlxAtlasSprite(90, 150 + toAdd, Paths.animateAtlas('Phase4/titlestate/spot'));
      if (spotlight != null) {
        spotlight.anim.play('SpotLight Animation', true, false, true);
        spotlight.scrollFactor.set(0, 0);
        spotlight.scale.set(0.34, 0.34);
        spotlight.updateHitbox();
        spotlight.alpha = 0.6;
        spotlight.blend = 0;
        addBg(spotlight);
      }
    } catch (e:Dynamic) {
      trace("Spotlight asset não encontrado: " + e);
    }

    // Cores para as luzes
    phase4_colors = [0xFF31A2FD, 0xFF31FD8C, 0xFFFB33F5, 0xFFFD4531, 0xFFFBA633];

    var cd = new FlxSprite(0, 440).loadGraphic(Paths.image('Phase4/titlestate/b'));
    cd.scale.set(0.666, 0.666);
    cd.updateHitbox();
    cd.screenCenter(0x01);
    cd.scrollFactor.set(0, 0);
    cd.y += toAdd;
    addBg(cd);

    phase4_cdd = new FlxSprite(0, 440).loadGraphic(Paths.image('Phase4/titlestate/b1'));
    phase4_cdd.scale.set(0.666, 0.666);
    phase4_cdd.updateHitbox();
    phase4_cdd.screenCenter(0x01);
    phase4_cdd.scrollFactor.set(0, 0);
    phase4_cdd.y += toAdd;
    addBg(phase4_cdd);

    var beee = new FlxSprite(startPoint + 270, -200);
    beee.frames = Paths.getSparrowAtlas('Phase4/titlestate/bee');
    beee.scale.set(0.666, 0.666);
    beee.animation.addByPrefix("idle", "Symbol 1", 24, true);
    beee.animation.play("idle");
    beee.y += toAdd;
    addBg(beee);

    var w = new FlxSprite(0, 540).loadGraphic(Paths.image('Phase4/titlestate/d'));
    w.scale.set(0.666, 0.666);
    w.updateHitbox();
    w.screenCenter(0x01);
    w.scrollFactor.set(0, 0);
    w.y += toAdd;
    addBg(w);

    var c = new FlxSprite(0, 620).loadGraphic(Paths.image('Phase4/titlestate/fore'));
    c.scale.set(0.666, 0.666);
    c.updateHitbox();
    c.screenCenter(0x01);
    c.scrollFactor.set(0, 0);
    c.y += toAdd;
    addBg(c);
  }

  function loadNightflaidBackground():Void
  {
    // Helper function para criar sprites
    var createNightflaidSprite = function(spr:String):FlxSprite {
      var bg = new FlxSprite(startPoint + -112, 0);
      if (spr != '') {
        bg.loadGraphic(Paths.image('nightflaid/' + spr));
        bg.scale.set(0.27, 0.27);
        bg.updateHitbox();
      } else {
        bg.x += 51;
        bg.makeGraphic(1388, 720, 0xFFFFFFFF);
      }
      addBg(bg);
      return bg;
    };

    // Camadas do background
    createNightflaidSprite('highlights');
    createNightflaidSprite('darklayer');

    var bgWidth:Float = 2760;
    var bgHeight:Float = 1429;
    var darkColor = 0xFF0D0D0D;

    // Camada de cor esquerda
    nightflaid_leftColor = new FlxSprite(0, 0);
    nightflaid_leftColor.makeGraphic(1, 1, FlxColor.WHITE);
    nightflaid_leftColor.setGraphicSize(Std.int(bgWidth / 3), bgHeight);
    nightflaid_leftColor.updateHitbox();
    nightflaid_leftColor.screenCenter(0x01);
    nightflaid_leftColor.x -= 300;
    nightflaid_leftColor.color = darkColor;
    nightflaid_leftColor.alpha = 0.5;
    addBg(nightflaid_leftColor);

    // Camada de cor direita
    nightflaid_rightColor = new FlxSprite(0, 0);
    nightflaid_rightColor.makeGraphic(1, 1, FlxColor.WHITE);
    nightflaid_rightColor.setGraphicSize(Std.int(bgWidth / 3), bgHeight);
    nightflaid_rightColor.updateHitbox();
    nightflaid_rightColor.screenCenter(0x01);
    nightflaid_rightColor.x += 454;
    nightflaid_rightColor.color = darkColor;
    nightflaid_rightColor.alpha = 0.5;
    addBg(nightflaid_rightColor);

    createNightflaidSprite('toplayer');
    createNightflaidSprite('glow');

    // Raios de luz
    nightflaid_leftRay = new FlxSprite(startPoint + -68, 110);
    nightflaid_leftRay.loadGraphic(Paths.image('nightflaid/lightray'));
    addBg(nightflaid_leftRay);

    nightflaid_rightRay = new FlxSprite(startPoint + 1122, 110);
    nightflaid_rightRay.loadGraphic(Paths.image('nightflaid/lightray'));
    nightflaid_rightRay.flipX = true;
    addBg(nightflaid_rightRay);

    // Luzes vermelhas
    nightflaid_redlights = createNightflaidSprite('redlights');
    nightflaid_redlights.x += 88;
    nightflaid_redlights.y += 172;
    nightflaid_redlights.scale.x *= 2.65;
    nightflaid_redlights.scale.y *= 2.65;
    nightflaid_redlights.updateHitbox();
  }

  function loadPrideShader():Void {
    var godrays = ScriptedFlxRuntimeShader.init('RetroGodraysShader');

    mainCamera.filters = [new ShaderFilter(godrays)];

    godrays.lightPos = [0.5, 0.3];
  }

  function loadPrideBackground() {
    var xAdjust = 470;
    var offR = -2;

    var bg = new FlxSprite(startPoint + xAdjust + -1600, -1000, Paths.image("pride/background"));
