import funkin.ui.title.TitleState;

typedef BackgroundConfig =
{
  var id:String;
  var musicTrack:String;
  var flameColor:Int;
  var bgZoom:Float;
}

class RetroTitleState extends MusicBeatState
{
  public static var initialized:Bool = false; // to determine if we created the sprites
  var hasPlayedIntro:Bool; // to actually check if the intro has played before
  var hasIntroStarted:Bool = false;

  var blackScreen:FlxSprite;
  var team:FlxSprite;

  var textSprites:Array<AtlasText> = [];
  var curWacky:Array<String> = [];
  var lastBeat:Int = 0;
  var swagShader:ColorSwap;

  var logoTweens:Array<FlxTween> = [];
  var teamLogoTweens:Array<FlxTween> = [];

  // Câmeras
  var bgCam:FlxCamera;
  var mainCamera:FlxCamera;

  // Background system
  var bgSprites:Array<FlxSprite> = [];
  var currentBgConfig:BackgroundConfig = null;
  var backgrounds:Array<BackgroundConfig> = [];
  // Phase4 specific
  var phase4_s3:FlxSprite;
  var phase4_cdd:FlxSprite;
  var phase4_colors:Array<Int> = [];
  var phase4_curLight:Int = -1;
  // Wrath specific
  var wrath_groundGlow:FlxSprite;
  var wrath_glowsSpots:Array<FlxSprite> = [];
  // Nightflaid specific
  var nightflaid_redlights:FlxSprite;
  var nightflaid_leftRay:FlxSprite;
  var nightflaid_rightRay:FlxSprite;
  var nightflaid_redLightTime:Float = 0.0;
  var nightflaid_leftColor:FlxSprite;
  var nightflaid_rightColor:FlxSprite;

  override public function create():Void
  {
    super.create();

    // Criar câmeras
    bgCam = new FlxCamera();
    bgCam.bgColor = FlxColor.BLACK;
    mainCamera = new FlxCamera();
    mainCamera.bgColor = FlxColor.TRANSPARENT;
    FlxG.cameras.reset(bgCam);
    FlxG.cameras.add(mainCamera, false);
    FlxG.cameras.setDefaultDrawTarget(mainCamera, true);

    registerBackgrounds();

    if (backgrounds.length > 0) {
      currentBgConfig = backgrounds[FlxG.random.int(0, backgrounds.length - 1)];
    }

    var texts = getIntroTextShit();
    curWacky = texts[FlxG.random.int(0, texts.length - 1)];

    lastBeat = 0;
    skippedIntro = false;
    transitioning = false;
    hasIntroStarted = false;

    Conductor.instance.update(0);

    hasPlayedIntro = Save.instance.modOptions.get('retroTitleIntroPlayed') == true;

    if (!hasPlayedIntro)
    {
      new FlxTimer().start(1, function(tmr:FlxTimer) {
        startIntro();
      });
    }
    else
    {
      startIntro();
      skipIntro();
    }
  }

  function registerBackgrounds():Void
  {
    // Wrath/Satisfracture
    backgrounds.push({
      id: "wrath",
      musicTrack: "Wrath",
      flameColor: 0x61FF88,
      bgZoom: 0.685
    });

    // Phase 4
    backgrounds.push({
      id: "phase4",
      musicTrack: "freakyMenu",
      flameColor: 0x61FF88,
      bgZoom: 1.001
    });

    // Nightflaid
    backgrounds.push({
      id: "nightflaid",
      musicTrack: "Nightflaid",
      flameColor: 0xFF001F,
      bgZoom: 1.0
    });
  }

  var logoRetro:FlxSprite;
  var upFire:FlxSprite;
  var backFire:FlxSprite;
  var glow:FlxSprite;
  var hasShownShadow:Bool = false;
  var outlineShaderShit:TitleOutline;

  var titleText:FlxSprite;
  var maskShader = new LeftMaskShader();

  var attractTimer:FlxTimer;

  function startIntro():Void
  {
    FullScreenScaleMode.addCutouts();

    persistentUpdate = true;

    if (currentBgConfig != null)
    {
      switch (currentBgConfig.id)
      {
        case "wrath":
          loadWrathBackground();
        case "phase4":
          loadPhase4Background();
        case "nightflaid":
          loadNightflaidBackground();
      }
    }

    var bg:FunkinSprite = new FunkinSprite(-1).makeSolidColor(FlxG.width + 2, FlxG.height, FlxColor.BLACK);
    bg.screenCenter();
    bg.visible = false;
    bg.cameras = [mainCamera];
    //add(bg);

    var logoYOff = -30;
    logoRetro = new FlxSprite(0, 0);
    logoRetro.frames = Paths.getSparrowAtlas('ui/logo');
    logoRetro.animation.addByPrefix('loop', 'logo0', 24);
    logoRetro.animation.play('loop');
    logoRetro.screenCenter();
    logoRetro.y += logoYOff;
    logoRetro.x = (FlxG.width / 2) - (logoRetro.width / 2);
    logoRetro.updateHitbox();
    logoRetro.visible = false;
    logoRetro.cameras = [mainCamera];

    var color = currentBgConfig != null ? currentBgConfig.flameColor : 0x61FF88;

    upFire = new FlxSprite(0, 0);
    upFire.frames = Paths.getSparrowAtlas('ui/flames');
    upFire.animation.addByPrefix('loop', 'upFire0', 24);
    upFire.animation.play('loop');
    upFire.screenCenter();
    upFire.y += logoYOff;
    upFire.x = (FlxG.width / 2) - (logoRetro.width / 2) - 2;
    upFire.updateHitbox();
    upFire.color = 0x61FF88; // Cor do upfire muda depois de pular a intro e mostrar o bg.
    upFire.visible = false;
    upFire.cameras = [mainCamera];

    backFire = upFire.clone();
    backFire.animation.addByPrefix('loop', 'backFire0', 24);
    backFire.animation.play('loop');
    backFire.screenCenter();
    backFire.y += logoYOff;
    backFire.x = (FlxG.width / 2) - (logoRetro.width / 2);
    backFire.updateHitbox();
    backFire.color = color;
    backFire.visible = false;
    backFire.cameras = [mainCamera];

    glow = logoRetro.clone();
    glow.animation.addByPrefix('loop', 'glow0', 1);
    glow.animation.play('loop');
    glow.screenCenter();
    glow.y += logoYOff;
    glow.x = (FlxG.width / 2) - (logoRetro.width / 2);
    glow.updateHitbox();
    glow.alpha = 0;
    glow.visible = false;
    glow.cameras = [mainCamera];

    add(backFire);
    add(logoRetro);

    titleText = new FlxSprite((FlxG.onMobile ? 50 : 100) + (FullScreenScaleMode.gameCutoutSize.x / 2), FlxG.height * 0.8);
    titleText.frames = Paths.getSparrowAtlas('titleEnter' + (FlxG.onMobile ? '_mobile' : ''));
    titleText.animation.addByPrefix('idle', "Press Enter to Begin", 24);
    titleText.animation.addByPrefix('press', "ENTER PRESSED", 24);
    titleText.animation.play('idle');
    titleText.updateHitbox();
    titleText.visible = false;
    titleText.cameras = [mainCamera];
    add(titleText);

    blackScreen = bg.clone();
    blackScreen.color = FlxColor.BLACK;
    blackScreen.cameras = [mainCamera];
    add(blackScreen);

    // These are added later so it appears in front of the black screen, making the shadow effect.
    add(upFire);
    add(glow);

    team = new FlxSprite(0, FlxG.height * 0.3);
    team.loadGraphic(Paths.image('ui/team'));
    team.scale.x = 0.2;
    team.scale.y = 0.2;
    team.alpha = 0;
    team.visible = false;
    team.screenCenter(0x01);
    team.cameras = [mainCamera];
    add(team);

    FlxG.mouse.visible = false;

    // A música precisa ser tocada depois do stage ser criado para evitar que beats sejam pulados no beatHit.
    var isFreakyMenu:Bool = (currentBgConfig == null || currentBgConfig.musicTrack == 'freakyMenu');
    if (isFreakyMenu)
    {
      if (!hasPlayedIntro || FlxG.sound.music == null) playMenuMusic('freakyMenu');
    }
    else
    {
      if (!hasPlayedIntro && currentBgConfig != null) {
        playMenuMusic(currentBgConfig.musicTrack, true);
      }
    }

    if (!initialized) initialized = true;
    hasIntroStarted = true;
  }

  function addBg(obj:Dynamic):Void
  {
    if (obj == null) return;
    obj.cameras = [bgCam];
    if (Std.isOfType(obj, FlxSprite)) {
      bgSprites.push(obj);
    }
    add(obj);
  }

  function playMenuMusic(name:String = 'freakyMenu', ?intro = false):Void
  {
    var path:String = name;
    if (name != 'freakyMenu') path = !intro ? 'Menu_' + name : 'Intro_' + name;

    var shouldFadeIn:Bool = FlxG.sound.music == null && !intro && !hasPlayedIntro;

    FunkinSound.playMusic(path,
    {
      startingVolume: (shouldFadeIn) ? 0.0 : 1.0,
      overrideExisting: true,
      restartTrack: false,
      persist: true,
      //loop: !intro
      //suffix: intro ? '_Intro' : ''
    });
    if (shouldFadeIn) FlxG.sound.music.fadeIn(4.0, 0.0, 1.0);
  }

  function getIntroTextShit():Array<Array<String>>
  {
    var fullText:String = Assets.getText(Paths.txt('introText'));
    var firstArray:Array<String> = fullText.split('\n').filter(function(s:String) return s != '');
    var swagGoodArray:Array<Array<String>> = [];

    for (i in firstArray)
    {
      swagGoodArray.push(i.split('--'));
    }

    return swagGoodArray;
  }

  var transitioning:Bool = false;

  override function update(elapsed:Float):Void
  {
    var crochet = (Conductor.instance.stepLengthMs * 4) / 1000;

    if (FlxG.sound.music != null) Conductor.instance.update(FlxG.sound.music.time);

    var pressedEnter:Bool = FlxG.keys.justPressed.ENTER;
    if (FlxG.onMobile) {
      if (TouchUtil.justReleased && !SwipeUtil.justSwipedAny) pressedEnter = true;
    }
    var gamepad:FlxGamepad = FlxG.gamepads.lastActive;
    if (gamepad != null) {
      if (gamepad.justPressed.START || gamepad.justPressed.ACCEPT) pressedEnter = true;
    }

    if (pressedEnter && transitioning && skippedIntro) {
      moveToMainMenu();
    }

    if (pressedEnter && !transitioning && skippedIntro)
    {
      if (FlxG.sound.music != null) FlxG.sound.music.onComplete = null;
      titleText.animation.play('press');
      mainCamera.flash(FlxColor.WHITE, 1.8);
      FunkinSound.playOnce(Paths.sound('confirmMenu'), 0.7);
      transitioning = true;
      bumpLogo();

      new FlxTimer().start(2, function(tmr:FlxTimer) {
        moveToMainMenu();
      });
    }
    if (pressedEnter && !skippedIntro && initialized) skipIntro();

    /*if ((FlxG.sound.music?.volume ?? 1.0) < 0.8 && initialized) {
      FlxG.sound.music.volume += 0.5 * elapsed;
    }*/

    // STAGES

    // Zoom da câmera do background (faz voltar pro zoom padrão)
    if (currentBgConfig != null && bgCam != null) {
      var lerpSpeed:Float = FlxMath.bound(elapsed * 3.125, 0, 1);
      bgCam.zoom = FlxMath.lerp(bgCam.zoom, currentBgConfig.bgZoom, lerpSpeed);
    }

    // Phase4 - Fade das janelas
    if (currentBgConfig != null && currentBgConfig.id == "phase4")
    {
      if (phase4_s3 != null)
        phase4_s3.alpha -= crochet * elapsed * 1.5;
      if (phase4_cdd != null)
        phase4_cdd.alpha -= crochet * elapsed * 1.5;
    }

    // Nightflaid - Luzes
    if (currentBgConfig != null && currentBgConfig.id == "nightflaid" && nightflaid_redlights != null)
    {
      nightflaid_redLightTime += elapsed;
      nightflaid_redlights.alpha = Math.sin(Math.PI * nightflaid_redLightTime) * 0.25 + 0.85;
    }

    super.update(elapsed);
  }

  function moveToMainMenu():Void
  {
    if (attractTimer != null)
    {
      attractTimer.cancel();
      attractTimer = null;
    }

    FunkinMemory.purgeCache();
    FlxG.switchState(ScriptedMusicBeatState.init("RetroMainMenu")); // Precisa ser RetroMainMenu para que a música acompanhe junto, se não o main menu padrão do fnf vai substituir a música
  }

  override function draw()
  {
    super.draw();
  }

  function createCoolText(textArray:Array<String>):Void
  {
    for (i in 0...textArray.length)
    {
      var t:FlxText = new FlxText(0,0,0, textArray[i].toUpperCase());
      t.setFormat(Paths.font('Kenyan Coffee Rg.otf'), 60, 0xFFFFFF, 'center', FlxTextBorderStyle.NONE);
      t.screenCenter(0x01);
      t.y += (textSprites.length*60)+200;
      t.cameras = [mainCamera];
      add(t);
      textSprites.push(t);
    }
  }

  function addMoreText(text:String):Void
  {
    var t:FlxText = new FlxText(0,0,0, text.toUpperCase());
    t.setFormat(Paths.font('Kenyan Coffee Rg.otf'), 60, 0xFFFFFF, 'center', FlxTextBorderStyle.NONE);
    t.screenCenter(0x01);
    t.y += (textSprites.length*60)+200;
    t.cameras = [mainCamera];
    add(t);
    textSprites.push(t);
  }

  function deleteCoolText():Void
  {
    for (t in textSprites) remove(t);
    textSprites = [];
  }

  var isRainbow:Bool = false;
  var skippedIntro:Bool = false;

  override function beatHit():Bool
  {
    if (!super.beatHit()) return false;
    var crochet = (Conductor.instance.stepLengthMs * 3.4) / 1000;

    if (!skippedIntro)
    {
      if (Conductor.instance.currentBeat < lastBeat) {
        // If the intro song has just replayed, we skip the intro to make sure it goes well
        // This if need to be before we check for the intro beats.
        lastBeat = 0;
        if (!skippedIntro) skipIntro();
        return true;
      }
      if (Conductor.instance.currentBeat > lastBeat) {
        for (i in lastBeat...Conductor.instance.currentBeat)
        {
          switch (i + 1)
          {
            case 1:
              createCoolText(['Vs. RetroSpecter', 'Part 2: Infernadise']);
            case 2:
              addMoreText('V-Slice Port');
            case 3:
              deleteCoolText();
            case 4:
              createCoolText(['Not associated', 'with']);
              if (team != null) {
                team.angle = 180;
                team.visible = true;
                teamLogoTweens.push(
                  FlxTween.tween(team, {alpha: 1}, 0.4, { ease: FlxEase.quintOut })
                );
                teamLogoTweens.push(
                  FlxTween.tween(team.scale, {x: 0.7, y: 0.7}, 1.2, { ease: FlxEase.backOut })
                );
                teamLogoTweens.push(
                  FlxTween.tween(team, {angle: 0}, 0.8, { ease: FlxEase.quintOut })
                );
              }
            case 7:
              deleteCoolText();
              if (team != null) team.visible = false;
            case 8:
              createCoolText([curWacky[0]]);
            case 9:
              addMoreText(curWacky[1]);
            case 12:
              deleteCoolText();
              shadowLogo();
            case 15:
              // timer here cuz if we are playing an intro song the beat 16 will be skipped,
              new FlxTimer().start(crochet, function(tmr:FlxTimer) {
                skipIntro();
              });
            /*case 16:
              if (!skippedIntro) skipIntro();*/
          }
        }
      }
      lastBeat = Conductor.instance.currentBeat;
    }

    if ((skippedIntro && !transitioning) || hasShownShadow)
    {
      bumpLogo();
    }

    // STAGES

    // Zoom do stage (descartado por não ter no original)
    //if (bgCam != null && currentBgConfig != null) bgCam.zoom += 0.0025; // 0.015

    // Phase4 - Luzes coloridas
    if (currentBgConfig != null && currentBgConfig.id == "phase4" && skippedIntro)
    {
      if (Conductor.instance.currentBeat % 1 == 0)
      {
        phase4_curLight = FlxG.random.int(0, phase4_colors.length - 1, [phase4_curLight]);
        if (phase4_s3 != null)
        {
          phase4_s3.color = phase4_colors[phase4_curLight];
          phase4_s3.alpha = 1;
        }
        if (phase4_cdd != null)
        {
          phase4_cdd.color = phase4_colors[phase4_curLight];
          phase4_cdd.alpha = 1;
        }
      }
    }

    // Wrath - Glows pulsando
    if (currentBgConfig != null && currentBgConfig.id == "wrath" && skippedIntro) {
      handleWrathGlows(1);
    }

    // Nightflaid - Alternância de cores e raios de luz
    if (currentBgConfig != null && currentBgConfig.id == "nightflaid" && skippedIntro)
    {
      if (Conductor.instance.currentBeat % 2 == 0)
      {
        // Beat par - esquerda vermelha, direita escura
        if (nightflaid_leftColor != null)
          FlxTween.color(nightflaid_leftColor, 0.15, nightflaid_leftColor.color, 0xFFFB002D);
        if (nightflaid_rightColor != null)
          FlxTween.color(nightflaid_rightColor, 0.15, nightflaid_rightColor.color, 0xFF0D0D0D);
        if (nightflaid_leftRay != null)
          FlxTween.tween(nightflaid_leftRay, {alpha: 1}, 0.15);
        if (nightflaid_rightRay != null)
          FlxTween.tween(nightflaid_rightRay, {alpha: 0}, 0.15);
      }
      else
      {
        // Beat ímpar - direita vermelha, esquerda escura
        if (nightflaid_leftColor != null)
          FlxTween.color(nightflaid_leftColor, 0.15, nightflaid_leftColor.color, 0xFF0D0D0D);
        if (nightflaid_rightColor != null)
          FlxTween.color(nightflaid_rightColor, 0.15, nightflaid_rightColor.color, 0xFFFB002D);
        if (nightflaid_rightRay != null)
          FlxTween.tween(nightflaid_rightRay, {alpha: 1}, 0.15);
        if (nightflaid_leftRay != null)
          FlxTween.tween(nightflaid_leftRay, {alpha: 0}, 0.15);
      }
    }

    return true;
  }

  function handleWrathGlows(?multiplier:Float = 1):Void
  {
    for (g in wrath_glowsSpots)
    {
      g.alpha = 0.5 * multiplier;
      FlxTween.cancelTweensOf(g);
      FlxTween.tween(g, {alpha: 0}, 0.5);
    }
  }

  function bumpLogo():Void {
    cancelTweens();
    var backDelay = transitioning ? 0.35 : 0;
    var crochet = (Conductor.instance.stepLengthMs * 4) / 1000;
    var objects:Array<FlxSprite> = [logoRetro, backFire, upFire, glow];
    var baseScale:Float = 0.85;
    var bumpScale:Float = 0.87;
    for (obj in objects) {
      obj.scale.x = baseScale;
      obj.scale.y = baseScale;
      logoTweens.push(
        FlxTween.tween(obj.scale, {x: bumpScale, y: bumpScale}, 0.005, { // 0.05
          ease: FlxEase.quartOut,
          onComplete: function(twn:FlxTween) {
            logoTweens.push(
              FlxTween.tween(obj.scale, {x: baseScale, y: baseScale}, crochet + backDelay, { // 0.3
                ease: FlxEase.cubicOut
              })
            );
          }
        })
      );
    }
    if (hasShownShadow) return;
    /*logoTweens.push(
      FlxTween.tween(glow, {alpha: 1}, 0.03, {
        ease: FlxEase.quartOut,
        onComplete: function(twn:FlxTween) {
          if (transitioning) return;
          logoTweens.push(
            FlxTween.tween(glow, {alpha: 0}, 0.6 + backDelay, {
              ease: FlxEase.quadOut
            })
          );
        }
      })
    );*/
  }

  function shadowLogo(hide = false):Void {
    if (!initialized) return;
    if (!hide) {
      hasShownShadow = true;
      glow.alpha = 1;
      glow.visible = true;
      upFire.visible = true;
    } else {
      hasShownShadow = false;
      glow.alpha = 0;
      glow.visible = false;
      upFire.visible = false;
    }
  }

  function skipIntro():Void
  {
    if (!skippedIntro && initialized)
    {
      if (currentBgConfig != null && currentBgConfig.musicTrack != 'freakyMenu') {
        playMenuMusic(currentBgConfig.musicTrack, false);
      }
      if (hasPlayedIntro && currentBgConfig.musicTrack == 'freakyMenu') { // this is necessary
        playMenuMusic(currentBgConfig.musicTrack, false);
      }

      deleteCoolText();
      cancelTweens();
      shadowLogo(true);
      remove(team);
      team.visible = false;
      logoRetro.visible = true;
      upFire.color = currentBgConfig != null ? currentBgConfig.flameColor : 0x61FF88;
      upFire.visible = true;
      backFire.visible = true;
      glow.visible = true;
      titleText.visible = true;
      blackScreen.visible = false;

      mainCamera.flash(FlxColor.WHITE, 3);
      bumpLogo();
      skippedIntro = true;

      Save.instance.modOptions.set('retroTitleIntroPlayed', true);
      Save.instance.flush();
    }
  }

  function cancelTweens():Void {
    for (tween in logoTweens) {
      if (tween != null) tween.cancel();
    }
    logoTweens = [];

    for (tween in teamLogoTweens) {
      if (tween != null) tween.cancel();
    }
    teamLogoTweens = [];
  }

  override public function closeSubstate():Void {
    if (event.eventCanceled) return;
    FullScreenScaleMode.removeCutouts;

    super.closeSubState();
  }

  // BACKGROUND LOADERS

  function loadWrathBackground():Void
  {
    var bg = new FlxSprite().loadGraphic(Paths.image('wrath/wrath_sky'));
    bg.screenCenter();
    bg.scrollFactor.set(0.5, 0.5);
    addBg(bg);

    var gates = new FlxSprite(0, 0);
    gates.loadGraphic(Paths.image('wrath/wrath_gates'));
    gates.screenCenter();
    gates.scrollFactor.set(0.55, 0.55);
    gates.x += 75;
    gates.y += 50;
    addBg(gates);

    var r = new FlxSprite(600, -200);
    r.loadGraphic(Paths.image('wrath/wrath_backrocks_02'));
    r.scale.set(0.5, 0.5);
    addBg(r);

    var l = new FlxSprite(-900, -200);
    l.loadGraphic(Paths.image('wrath/wrath_backrocks_01'));
    l.scale.set(0.5, 0.5);
    addBg(l);

    var caveL = new FlxSprite(0, 0);
    caveL.loadGraphic(Paths.image('wrath/wrath_cave'));
    caveL.screenCenter();
    caveL.scrollFactor.set(0.8, 0.8);
    caveL.x += -150;
    caveL.y += 20;
    caveL.flipX = true;
    caveL.scale.set(0.75, 0.75);
    addBg(caveL);

    var caveR = new FlxSprite(0, 0);
    caveR.loadGraphic(Paths.image('wrath/wrath_cave'));
    caveR.screenCenter();
    caveR.scrollFactor.set(0.8, 0.8);
    caveR.x += 150;
    caveR.y = caveL.y;
    caveR.scale.set(0.75, 0.75);
    addBg(caveR);

    var ground = new FlxSprite(0, 0);
    ground.frames = Paths.getSparrowAtlas('wrath/ground');
    ground.screenCenter();
    ground.animation.addByPrefix('green', "green", 0, false);
    ground.animation.play('green');
    ground.x += 0;
    ground.y += 450;
    ground.scale.set(0.6, 0.6);
    addBg(ground);

    // Ground Glow
    wrath_groundGlow = new FlxSprite(0, 0);
    wrath_groundGlow.frames = Paths.getSparrowAtlas('wrath/ground');
    wrath_groundGlow.screenCenter();
    wrath_groundGlow.animation.addByPrefix('green', "green", 0, false);
    wrath_groundGlow.animation.addByPrefix('cyan', "cyan", 0, false);
    wrath_groundGlow.x += 0;
    wrath_groundGlow.y += 450;
    wrath_groundGlow.scale.set(0.6, 0.6);
    wrath_groundGlow.animation.play('cyan');
    wrath_groundGlow.alpha = 0;
    addBg(wrath_groundGlow);

    // Add glows
    addWrathGlow(975-20, 135-20+5, wrath_groundGlow, 2);
    addWrathGlow(975 + 1100, 135-20+5+10+10, wrath_groundGlow, 2);
    addWrathGlow(1515-300-10, 135-20+5+10+10+200+10, wrath_groundGlow, 2);
    addWrathGlow(975 + 1250+10+10, 135-20+5+10+10+10, wrath_groundGlow, 1.5);
  }

  function addWrathGlow(x:Float, y:Float, reference:FlxSprite, ?size:Float = 1):Void
  {
    var scrollX:Float = 1;
    var scrollY:Float = 1;
    var offsetX:Float = 0;
    var offsetY:Float = 0;

    if (reference != null) {
      scrollX = reference.scrollFactor.x;
      scrollY = reference.scrollFactor.y;
      offsetX = reference.x;
      offsetY = reference.y;
    }

    var glow = new FlxSprite();
    glow.frames = Paths.getSparrowAtlas('CrystalGlow');
    glow.scrollFactor.set(scrollX, scrollY);
    glow.animation.addByPrefix('green', "green", 0, false);
    glow.scale.set(size, size);
    glow.setPosition(x + offsetX, y + offsetY);
    glow.animation.play('green');
    glow.alpha = 0.5;
    addBg(glow);

    var glowGlow = new FlxSprite();
    glowGlow.frames = Paths.getSparrowAtlas('CrystalGlow');
    glowGlow.scrollFactor.set(scrollX, scrollY);
    glowGlow.animation.addByPrefix('cyan', "cyan", 0, false);
    glowGlow.scale.set(size, size);
    glowGlow.setPosition(x + offsetX, y + offsetY);
    glowGlow.animation.play('cyan');
    glowGlow.alpha = 0;
    addBg(glowGlow);

    wrath_glowsSpots.push(glowGlow);
  }

