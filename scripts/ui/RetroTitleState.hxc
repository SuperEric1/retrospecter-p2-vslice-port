  function loadGluttonyBackground():Void
  {
    var xOff:Float = -1500;
    var yOff:Float = -700;

    glut_glow = 0.0;
    glut_portalGlow = 1.0;
    glut_castlePhases = [];
    glut_castles = [];
    glut_castleRays = [];
    glut_clouds = [];

    var sky = new FlxSprite(startPoint + xOff, yOff).loadGraphic(Paths.image('gluttony/sky'));
    sky.scrollFactor.set(0.5, 0.5);
    sky.antialiasing = false;
    addBg(sky);

    var cloudPattern:Array<Int> = [2, 7, 3, 9, 5, 4, 1, 8, 10, 6];
    for (i in 0...cloudPattern.length)
    {
      var cloud = new FlxSprite(startPoint + -1300 + i * 1200, -400);
      cloud.frames = Paths.getSparrowAtlas('gluttony/cloud');
      cloud.animation.addByPrefix('idle', 'cloud' + cloudPattern[i], 24, true);
      cloud.animation.play('idle');
      cloud.scrollFactor.set(0.5, 0.5);
      cloud.antialiasing = false;
      addBg(cloud);
      glut_clouds.push(cloud);
    }

    glut_initY = -850;
    for (i in 0...8)
    {
      glut_castlePhases.push(FlxG.random.float(0, Math.PI));
      var castle = new FlxSprite(startPoint + xOff, glut_initY);
      castle.frames = Paths.getSparrowAtlas('gluttony/castle_master');
      castle.animation.addByPrefix('castle', 'castle_' + i + '.png', 1, true);
      castle.animation.play('castle');
      castle.scrollFactor.set(0.8, 0.8);
      castle.active = false;
      addBg(castle);
      glut_castles.push(castle);
    }

    for (i in 3...8)
    {
      var ray = new FlxSprite(startPoint + xOff, glut_initY);
      ray.frames = Paths.getSparrowAtlas('gluttony/castle_ray_master');
      ray.animation.addByPrefix('ray', 'castle_' + i + '_ray', 1, true);
      ray.animation.play('ray');
      ray.scrollFactor.set(0.8, 0.8);
      ray.alpha = 0;
      ray.antialiasing = false;
      ray.active = false;
      addBg(ray);
      glut_castleRays.push(ray);
    }

    var voidR = new FlxSprite(startPoint + 1700, -48);
    voidR.frames = Paths.getSparrowAtlas('gluttony/Gluttony_void_righttree');
    voidR.animation.addByPrefix('idle', 'RightTreeVoid instance 1', 24, true);
    voidR.animation.play('idle');
    addBg(voidR);

    var voidG = new FlxSprite(startPoint + -1120, 900);
    voidG.frames = Paths.getSparrowAtlas('gluttony/Gluttony_voidground');
    voidG.animation.addByPrefix('idle', 'GroundVoid instance 1', 24, true);
    voidG.animation.play('idle');
    addBg(voidG);

    var voidL = new FlxSprite(startPoint + -750, -275);
    voidL.frames = Paths.getSparrowAtlas('gluttony/Gluttony_voidlefttree');
    voidL.animation.addByPrefix('idle', 'LeftTreeVoid instance 1', 24, true);
    voidL.animation.play('idle');
    addBg(voidL);

    var stage = new FlxSprite(startPoint + xOff, yOff).loadGraphic(Paths.image('gluttony/stage'));
    addBg(stage);

    var trees = new FlxSprite(startPoint + xOff, yOff).loadGraphic(Paths.image('gluttony/trees'));
