  function loadGreedBackground():Void
  {
    var xOff:Float = -1400;
    var yOff:Float = -1000;

    greed_glitters = [];

    var bg = new FlxSprite(startPoint + xOff, yOff, Paths.image("greed/hivemine_bg"));
    bg.scrollFactor.set(1, 1);
    addBg(bg);

    var glitterSpots = [[465, 1833], [2299, 1811], [2890, 1800], [3546, 2200]];
    var glitterNames = ['FarLeft', 'Center', 'Table', 'FarRight'];

    for (i in 0...glitterNames.length)
    {
      var glitter = new FlxSprite(startPoint + xOff + glitterSpots[i][0], yOff + glitterSpots[i][1]);
      glitter.frames = Paths.getSparrowAtlas('greed/Hivemine_GlitterPatch_' + glitterNames[i]);
      glitter.animation.addByPrefix('idle', 'Hivemine_GlitterPatch_' + glitterNames[i], 24, true);
      glitter.animation.play('idle');
      glitter.scrollFactor.set(1, 1);
      glitter.antialiasing = false;
      addBg(glitter);
      greed_glitters.push(glitter);
    }

    var fg = new FlxSprite(startPoint + xOff, yOff, Paths.image("greed/hivemine_fg"));
    fg.scrollFactor.set(1, 1);
    fg.antialiasing = false;
    addBg(fg);
  }

  function loadEnvyBackground():Void
  {
    if (useShaders) {
      envy_waterShader = ScriptedFlxRuntimeShader.init('RetroWaterShader');
      bgCam.filters = [new ShaderFilter(envy_waterShader)];
    }

    envy_soulsLeft = new FlxSprite(0, 5000);
    envy_soulsLeft.frames = Paths.getSparrowAtlas('envy/soulsMid');
    envy_soulsLeft.animation.addByPrefix('idle', 'soulsmid', 24, true);
    envy_soulsLeft.animation.play('idle');
    envy_soulsLeft.scale.set(0.5, 0.5);
    addBg(envy_soulsLeft);

    var back = new FlxSprite().loadGraphic(Paths.image('envy/title/back'));
    back.setGraphicSize(1280);
    back.updateHitbox();
    back.screenCenter();
    addBg(back);

    var spooky1 = new FlxSprite().loadGraphic(Paths.image('envy/title/1'));
    spooky1.setGraphicSize(1500);
    spooky1.updateHitbox();
    spooky1.screenCenter();
    spooky1.alpha = 0;
    addBg(spooky1);
    FlxTween.tween(spooky1, {alpha: 1}, 4, {ease: FlxEase.quadOut});

    var spooky2 = new FlxSprite().loadGraphic(Paths.image('envy/title/2'));
    spooky2.setGraphicSize(1500);
    spooky2.updateHitbox();
    spooky2.screenCenter();
    spooky2.alpha = 0;
    addBg(spooky2);
    new FlxTimer().start(2, function(tmr:FlxTimer) {
      FlxTween.tween(spooky2, {alpha: 1}, 4, {ease: FlxEase.quadOut});
    });

    var front = new FlxSprite().loadGraphic(Paths.image('envy/title/front'));
    front.setGraphicSize(1280);
    front.updateHitbox();
    front.screenCenter();
    addBg(front);

    var gg = new FlxSprite(55, 160).loadGraphic(Paths.image('envy/title/g'));
    gg.scale.set(0.66666, 0.66666);
    gg.updateHitbox();
    gg.alpha = 0;
    addBg(gg);
    FlxTween.tween(gg, {alpha: 0.5}, 1, {ease: FlxEase.quadOut});

    envy_soulsMid = new FlxSprite(250, 4000);
    envy_soulsMid.frames = Paths.getSparrowAtlas('envy/soulsMid');
    envy_soulsMid.animation.addByPrefix('idle', 'soulsmid', 24, true);
    envy_soulsMid.animation.play('idle');
    envy_soulsMid.scale.set(0.5, 0.5);
    addBg(envy_soulsMid);

    envy_souls = new FlxSprite(500, 2000);
    envy_souls.frames = Paths.getSparrowAtlas('envy/soulsClose');
    envy_souls.animation.addByPrefix('idle', 'souls_close', 24, true);
    envy_souls.animation.play('idle');
    envy_souls.scale.set(0.5, 0.5);
    addBg(envy_souls);
  }
