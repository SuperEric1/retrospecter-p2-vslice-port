  function loadNightflaidBackground():Void
  {
    // Helper function para criar sprites
    var createNightflaidSprite = function(spr:String):FlxSprite {
      var bg = new FlxSprite(-112, 0);
      if (spr != '') {
        bg.loadGraphic(Paths.image('nightflaid/' + spr));
        bg.scale.set(0.27, 0.27);
        bg.updateHitbox();
      } else {
        bg.x += 51;
        bg.makeGraphic(1388, 720, 0xFFFFFFFF);
      }
      addBg(bg);
      return bg;
    };

    // Camadas do background
    createNightflaidSprite('highlights');
    createNightflaidSprite('darklayer');

    var bgWidth:Float = 2760;
    var bgHeight:Float = 1429;
    var darkColor = 0xFF0D0D0D;

    // Camada de cor esquerda
    nightflaid_leftColor = new FlxSprite(0, 0);
    nightflaid_leftColor.makeGraphic(1, 1, FlxColor.WHITE);
    nightflaid_leftColor.setGraphicSize(Std.int(bgWidth / 3), bgHeight);
    nightflaid_leftColor.updateHitbox();
    nightflaid_leftColor.screenCenter(0x01);
    nightflaid_leftColor.x -= 300;
    nightflaid_leftColor.color = darkColor;
    nightflaid_leftColor.alpha = 0.5;
    addBg(nightflaid_leftColor);

    // Camada de cor direita
    nightflaid_rightColor = new FlxSprite(0, 0);
    nightflaid_rightColor.makeGraphic(1, 1, FlxColor.WHITE);
    nightflaid_rightColor.setGraphicSize(Std.int(bgWidth / 3), bgHeight);
    nightflaid_rightColor.updateHitbox();
    nightflaid_rightColor.screenCenter(0x01);
    nightflaid_rightColor.x += 454;
    nightflaid_rightColor.color = darkColor;
    nightflaid_rightColor.alpha = 0.5;
    addBg(nightflaid_rightColor);

    createNightflaidSprite('toplayer');
    createNightflaidSprite('glow');

    // Raios de luz
    nightflaid_leftRay = new FlxSprite(-68, 110);
    nightflaid_leftRay.loadGraphic(Paths.image('nightflaid/lightray'));
    addBg(nightflaid_leftRay);

    nightflaid_rightRay = new FlxSprite(1122, 110);
    nightflaid_rightRay.loadGraphic(Paths.image('nightflaid/lightray'));
    nightflaid_rightRay.flipX = true;
    addBg(nightflaid_rightRay);

    // Luzes vermelhas
    nightflaid_redlights = createNightflaidSprite('redlights');
    nightflaid_redlights.x += 88;
    nightflaid_redlights.y += 172;
    nightflaid_redlights.scale.x *= 2.65;
    nightflaid_redlights.scale.y *= 2.65;
    nightflaid_redlights.updateHitbox();
  }
}
