  var mixter_animNum:Int = 0;
  // Lust specific
  var lust_df:FlxSprite;
  var lust_ht:FlxSprite;
  var lust_heartFrame:Array<Int> = [0, 1, 2, 3, 4, 0, 4, 0];
  var lust_fogShader:ScriptedFlxRuntimeShader;
