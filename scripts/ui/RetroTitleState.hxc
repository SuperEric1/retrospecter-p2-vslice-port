  function loadPatienceBackground():Void
  {
    patience_backClouds = [];
    patience_frontClouds = [];
    patience_stageClouds = [];

    var sky = patienceSprite('sky', 0, 0);
    sky.setGraphicSize(5144 * patience_globalScale);
    sky.antialiasing = false;
    sky.updateHitbox();

    var scale:Float = 8877.0 / 6624.0 * patience_globalScale;
    for (i in 0...3)
    {
      var bg = patienceSprite('back_clouds', 8000, 0);
      bg.scale.set(scale, scale);
      bg.updateHitbox();
      bg.scrollFactor.x = 0.5;
      bg.antialiasing = false;
      patience_backClouds.push(bg);
    }
    patience_backClouds[1].x = patience_backClouds[0].x + patience_backClouds[0].width;
    patience_backClouds[2].x = patience_backClouds[1].x + patience_backClouds[1].width;

    var clock = FunkinSprite.create(startPoint + -30, -530, 'virtue/clock');
    clock.loadTextureAtlas('virtue/clock', 'shared', { applyStageMatrix: true });
    clock.animation.addBySymbol('anim', 'clocktower', 24, true);
    clock.animation.play('anim', true);
    clock.scrollFactor.set(0.8, 0.95);
    clock.scale.set(0.3, 0.3);
    clock.zIndex = 30;
    clock.antialiasing = false;
    addBg(clock);

    var rightSpr = patienceSprite('right', 3030, 320);
    rightSpr.scrollFactor.set(0.8, 0.95);

    for (i in 0...3)
    {
      var bg1 = patienceSprite('front_clouds', 8000, 700);
      bg1.scrollFactor.set(0.8, 1.0);
      bg1.antialiasing = false;
      patience_frontClouds.push(bg1);

      var bg2 = patienceSprite('front_clouds', 9200, 1200);
      bg2.flipX = true;
      bg2.scrollFactor.set(0.9, 1.0);
      bg2.antialiasing = false;
      patience_stageClouds.push(bg2);
    }
    patience_frontClouds[1].x = patience_frontClouds[0].x + patience_frontClouds[0].width;
    patience_frontClouds[2].x = patience_frontClouds[1].x + patience_frontClouds[1].width;

    patience_stageClouds[1].x = patience_stageClouds[0].x + patience_stageClouds[0].width;
    patience_stageClouds[2].x = patience_stageClouds[1].x + patience_stageClouds[1].width;

    patienceSprite('Heaven Gate', 0, 0);

    var fore = patienceSprite('fore', 0, 1529);
    fore.setGraphicSize(5144 * patience_globalScale);
    fore.updateHitbox();
  }

  function patienceSprite(img:String, px:Float, py:Float):FlxSprite
  {
    var spr = new FlxSprite(startPoint + ((px - 300.0) * patience_globalScale), py * patience_globalScale).loadGraphic(Paths.image('virtue/' + img));
    spr.scale.set(patience_globalScale, patience_globalScale);
    spr.updateHitbox();
    spr.active = false;
    addBg(spr);
    return spr;
  }

  function movePatienceBackdrop(spr:FlxSprite, speed:Float, limit:Float, elapsed:Float):Void
  {
    if (spr == null) return;
    spr.x += speed * patience_globalScale * elapsed;
    while (spr.x > limit * patience_globalScale)
    {
      spr.x -= spr.width * 3.0;
    }
  }

  function loadLustInteriorBackground():Void
  {
    var xOff:Float = -1450;
    var yOff:Float = -950;

    var bg = new FlxSprite(startPoint + xOff, yOff, Paths.image("lust/Background"));
    bg.scrollFactor.set(1, 1);
    addBg(bg);

    var suggestiveEnabled = Save.instance.modOptions.get('retroSuggestive');
    lustMast(xOff, yOff, suggestiveEnabled ? 'Sex toys' : 'SFW hooks');
    lustMast(xOff, yOff, "BG chairs");
    lustMast(xOff, yOff, "BG tables");
    lustMast(xOff, yOff, "Barr");
    lustMast(xOff, yOff, "Bar stools");

    lust_df = new FlxSprite(startPoint + xOff, yOff);
    lust_df.frames = Paths.getSparrowAtlas('lust/saku-master');
    lust_df.animation.addByPrefix("idle", "Dance floor", 0, false);
    lust_df.animation.play("idle");
    addBg(lust_df);

    lust_ht = new FlxSprite(startPoint + xOff, yOff);
    lust_ht.frames = Paths.getSparrowAtlas('lust/saku-master');
    lust_ht.animation.addByPrefix("idle", "Heart", 0, false);
    lust_ht.animation.play("idle");
    addBg(lust_ht);

    lustMast(xOff, yOff, "FG_Bottom");
    lustMast(xOff, yOff, "FG_cages");
    lustMast(xOff, yOff, "FG_curtains");
    lustMast(xOff, yOff, "FG_LeftTable");
    lustMast(xOff, yOff, "FG_RightTable");
  }

  function lustMast(xOff:Float, yOff:Float, path:String):FlxSprite
  {
    var sprite = new FlxSprite(startPoint + xOff, yOff);
    sprite.frames = Paths.getSparrowAtlas('lust/saku-master');
    sprite.animation.addByPrefix(path, path, 0, false);
    sprite.animation.play(path);
    addBg(sprite);
    return sprite;
  }

