  override public function create():Void
  {
    super.create();

    // Criar câmeras
    bgCam = new FlxCamera();
    bgCam.bgColor = FlxColor.BLACK;
    dozircCam = new FlxCamera();
    dozircCam.bgColor = FlxColor.TRANSPARENT;
    mainCamera = new FlxCamera();
    mainCamera.bgColor = FlxColor.TRANSPARENT;
    FlxG.cameras.reset(bgCam);
    FlxG.cameras.add(dozircCam, false);
    FlxG.cameras.add(mainCamera, false);
    FlxG.cameras.setDefaultDrawTarget(mainCamera, true);

    registerBackgrounds();

    useShaders = Save.instance.modOptions.get('retroShaders') ?? true;

    if (backgrounds.length > 0) {
      currentBgConfig = backgrounds[FlxG.random.int(0, backgrounds.length - 1)];
    }

    var texts = getIntroTextShit();
    curWacky = texts[FlxG.random.int(0, texts.length - 1)];

    lastBeat = 0;
    skippedIntro = false;
    transitioning = false;
    hasIntroStarted = false;

    Conductor.instance.update(0);

    hasPlayedIntro = Save.instance.modOptions.get('retroTitleIntroPlayed') == true;

    if (!hasPlayedIntro)
    {
      new FlxTimer().start(1, function(tmr:FlxTimer) {
        startIntro();
      });
    }
    else
    {
      startIntro();
      skipIntro();
    }
  }

  function registerBackgrounds():Void
  {
    // Phase 2
    backgrounds.push({
      id: "phase2",
      musicTrack: RetroUtil.hasBeatenWrath() ? "Wrath" : "freakyMenu",
      flameColorR: defaultFlameColorR,
      flameColorG: defaultFlameColorG,
      flameColorB: defaultFlameColor,
      bgZoom: 0.685
    });

    if (RetroUtil.hasBeatenWrath()) {
      // Wrath/Satisfracture
      backgrounds.push({
        id: "wrath",
        musicTrack: "Wrath",
        flameColorR: defaultFlameColorR,
        flameColorG: defaultFlameColorG,
        flameColorB: defaultFlameColor,
        bgZoom: 0.685
      });

      // Phase 3
      backgrounds.push({
        id: "phase3",
        musicTrack: "freakyMenu",
        flameColorR: defaultFlameColorR,
        flameColorG: defaultFlameColorG,
        flameColorB: defaultFlameColor,
        bgZoom: 1.0
      });

      // Phase 4
      backgrounds.push({
        id: "phase4",
        musicTrack: "freakyMenu",
        flameColorR: defaultFlameColorR,
        flameColorG: defaultFlameColorG,
        flameColorB: defaultFlameColor,
        bgZoom: 1.001
      });
    }

    if (RetroUtil.hasBeatenLevel('80-finale')) {
      // Nightflaid
      backgrounds.push({
        id: "nightflaid",
        musicTrack: "Nightflaid",
        flameColorR: 0xFF001F,
        flameColorG: 0x000000,
        flameColorB: 0xFF001F,
        bgZoom: 1.0
      });

      // Pendulumbra
      backgrounds.push({
        id: "patience",
        musicTrack: "Patience",
        flameColorR: 0xFEFFC4,
        flameColorG: 0xF3C378,
        flameColorB: 0xC78B48,
        bgZoom: 1.0
      });

      // Mixter
      backgrounds.push({
        id: "mixter",
        musicTrack: "Mixter",
        flameColorR: 0x8F43FF,
        flameColorG: 0x4317C6,
        flameColorB: 0x000067,
        bgZoom: 0.7
      });
    }

    if (RetroUtil.hasBeatenLevel('20-pride')) {
      // Pride
      backgrounds.push({
        id: "pride",
        musicTrack: "Pride",
        flameColorR: 0xEFFFFD,
        flameColorG: 0x86FFF2,
        flameColorB: 0x36FFE9,
        bgZoom: 0.45
      });
    }

    if (RetroUtil.hasBeatenLevel('30-gluttony')) {
      // Gluttony
      backgrounds.push({
        id: "gluttony",
        musicTrack: "Gluttony",
        flameColorR: 0xEA588D,
        flameColorG: 0xDB3153,
        flameColorB: 0xAE1E3B,
        bgZoom: 0.4
      });
    }

    if (RetroUtil.hasBeatenLevel('40-greed')) {
      // Greed
      backgrounds.push({
        id: "greed",
        musicTrack: "Greed",
        flameColorR: 0xEBCDFF,
        flameColorG: 0xBE7EF9,
        flameColorB: 0x962DF9,
        bgZoom: 0.4
      });
    }

    if (RetroUtil.hasBeatenLevel('50-envy')) {
      // Envy
      backgrounds.push({
        id: "envy",
        musicTrack: "Envy",
        flameColorR: 0xE7FFED,
        flameColorG: 0x69FCBF,
        flameColorB: 0x01FC94,
        bgZoom: 1.0
      });
    }

    if (RetroUtil.hasBeatenLevel('60-sloth')) {
      // Sloth
      backgrounds.push({
        id: "sloth",
