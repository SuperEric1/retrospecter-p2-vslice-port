  public override function onFreeplayIntroDone(event:FreeplayScriptEvent):Void {
    super.onFreeplayIntroDone(event);
    var freeplay:FreeplayState = FlxG.state.subState;
    if (freeplay.currentCharacterId != "bf") return;
    isInFreeplay = true;
    cacheDefaultTexts();
    new FlxTimer().start(colorCacheDelay, function(_) {
      cacheOriginalColors();
    });
    trace('Freeplay intro done');

    // initial update
    prevSongId = '';
    prevWeekId = '';
    curBgImage = '';
    if (freeplay.currentCapsule.freeplayData == null) {
      updateBackingCardTexts('', '', '');
      return;
    }

    var data = freeplay?.currentCapsule?.freeplayData?.idAndVariation?.split(':') ?? null;
    var curSongId:String = data[0] ?? '';
    var curVariation:String = data[1] ?? '';
    var curWeekId:String = freeplay?.currentCapsule?.freeplayData?.levelId ?? '';

    if (curSongId != prevSongId) {
      updateBackingCardTexts(curSongId, curWeekId, curVariation);
      prevSongId = curSongId;
      prevWeekId = curWeekId;
    }
  }

  public override function onFreeplayClose(event:FreeplayScriptEvent):Void {
    super.onFreeplayClose(event);
    isInFreeplay = false;
    prevSongId = '';
    prevWeekId = '';
    curBgImage = '';
    defaultTexts = null;
    defaultAlbumAngle = 0.0;

    targetCardColor = DEFAULT_CARD_COLOR;
    targetMoreWaysColor = FlxColor.WHITE;
    targetFunnyScrollColor = FlxColor.WHITE;
    targetFunnyScroll2Color = FlxColor.WHITE;
    targetFunnyScroll3Color = FlxColor.WHITE;
    targetOrangeColor = DEFAULT_ORANGE_COLOR;
    currentOrangeColor = DEFAULT_ORANGE_COLOR;
    originalColorsCached = false;
    lastConfiguredColor = null;
  }

  function cacheDefaultTexts():Void {
    if (defaultTexts != null) return;
    //if (FlxG.state == null || !Std.isOfType(FlxG.state, FreeplayState)) return;

    var freeplayState:FreeplayState = FlxG.state.subState;

    try {
      @:privateAccess {
        var backingCard = freeplayState.backingCard;
        if (backingCard == null) return;
        if (freeplayState.backingImage != null && backingImagePos[0] == null) backingImagePos = [freeplayState.backingImage.x, freeplayState.backingImage.y];
        var styleData = freeplayState.styleData;

        var funnyScroll = backingCard.funnyScroll;

        if (funnyScroll != null && funnyScroll.text != 'SPECIAL SPECIAL') {
          defaultTexts = {
            bgColor: -1,
            bgImage: styleData == null ? 'freeplay/freeplayBGweek1-bf' : styleData.getBgAssetKey(),
            funnyScroll: funnyScroll.text,
            moreWays: backingCard.moreWays?.text,
            txtNuts: backingCard.txtNuts?.text,
            funnyScroll2: backingCard.funnyScroll2?.text,
            moreWays2: backingCard.moreWays2?.text,
            funnyScroll3: backingCard.funnyScroll3?.text
          };
        }

        //defaultAlbumAngle = freeplayState.albumRoll.angle;
      }
    } catch (e:Dynamic) {
      trace('[RetroFreeplay] Error caching default texts: ' + e);
    }
  }

  function cacheOriginalColors():Void {
    if (originalColorsCached) return;
    var freeplayState:FreeplayState = FlxG.state.subState;

    try {
      @:privateAccess {
        var backingCard = freeplayState.backingCard;
        if (backingCard == null) return;

        if (backingCard.pinkBack != null) originalCardColor = backingCard.pinkBack.color;
        if (backingCard.moreWays != null) originalMoreWaysColor = backingCard.moreWays.color;
        if (backingCard.funnyScroll != null) originalFunnyScrollColor = backingCard.funnyScroll.color;
        if (backingCard.funnyScroll2 != null) originalFunnyScroll2Color = backingCard.funnyScroll2.color;
        if (backingCard.funnyScroll3 != null) originalFunnyScroll3Color = backingCard.funnyScroll3.color;
        originalColorsCached = true;

        updateCardColorTargets(lastConfiguredColor);
      }
    } catch (e:Dynamic) {
      trace('[RetroFreeplay] Error caching original colors: ' + e);
    }
  }

  public override function onCapsuleSelected(event:CapsuleScriptEvent):Void {
    super.onCapsuleSelected(event);
    var freeplay:FreeplayState = FlxG.state.subState;
    if (freeplay.currentCharacterId != "bf") return;
    if (!isInFreeplay) return;
    if (event.capsule.freeplayData == null) {
      updateBackingCardTexts('', '', '');
      prevSongId = '';
      prevWeekId = '';
      return;
    }

    var data = event.capsule?.freeplayData?.idAndVariation?.split(':') ?? null;
    var curSongId:String = data[0] ?? '';
    var curVariation:String = data[1] ?? '';
    var curWeekId:String = event.capsule?.freeplayData?.levelId ?? '';

    //trace(curSongId + ' - ' + curVariation + ' - ' + curWeekId);
    //trace(prevSongId + ' - ' + prevWeekId);

    if (curSongId != prevSongId) {
      updateBackingCardTexts(curSongId, curWeekId, curVariation);
      prevSongId = curSongId;
      prevWeekId = curWeekId;
    }
  }

  public override function onUpdate(event:ScriptEvent):Void {
    super.onUpdate(event);
    var freeplayState:FreeplayState = FlxG.state.subState;
    if (freeplayState.currentCharacterId != "bf") return;
    if (!isInFreeplay) return;

    // This is so the title gets updated if it is doing the intro anim
    var isRetroBg = curBgImage != '' && curBgImage != defaultTexts.bgImage;
    var titleScale = isRetroBg ? ALBUM_SCALE : 1;
    var targetAngle = isRetroBg ? ALBUM_ANGLE : 0;
    if (!freeplayState.albumRoll.albumTitle.visible) {
      freeplayState.albumRoll.albumTitle.scale.set(titleScale, titleScale);
      freeplayState.albumRoll.albumTitle.angle = isRetroBg ? 10 : 0;
      freeplayState.albumRoll.albumTitle.updateHitbox();
    }

    updateCardColors(freeplayState, FlxG.elapsed);
  }

  function updateCardColorTargets(baseColor:Null<Int>):Void {
    if (baseColor == null) {
      targetCardColor = originalCardColor;
      targetMoreWaysColor = originalMoreWaysColor;
      targetFunnyScrollColor = originalFunnyScrollColor;
      targetFunnyScroll2Color = originalFunnyScroll2Color;
      targetFunnyScroll3Color = originalFunnyScroll3Color;
      targetOrangeColor = DEFAULT_ORANGE_COLOR;
      return;
    }

    var base:FlxColor = baseColor;

    targetCardColor = base;
    targetMoreWaysColor = FlxColor.interpolate(base, FlxColor.WHITE, moreWaysBlend);
    targetFunnyScrollColor = FlxColor.interpolate(base, FlxColor.BLACK, funnyScrollBlend);
    targetFunnyScroll2Color = base.lightness > lightnessSplit ? FlxColor.interpolate(base, FlxColor.BLACK, funnyScroll2LightBlend) : FlxColor.interpolate(base, FlxColor.WHITE, funnyScroll2DarkBlend);
    targetFunnyScroll3Color = FlxColor.interpolate(base, FlxColor.BLACK, funnyScroll3Blend);
    targetOrangeColor = FlxColor.interpolate(base, FlxColor.BLACK, orangeBlend);
  }

  function updateCardColors(freeplayState:FreeplayState, elapsed:Float):Void {
    if (!originalColorsCached) return;

    @:privateAccess {
      var card = freeplayState.backingCard;
      if (card == null) return;

      var lerpAmount:Float = elapsed * colorLerpSpeed;

      try {
        if (card.pinkBack != null) card.pinkBack.color = FlxColor.interpolate(card.pinkBack.color, targetCardColor, lerpAmount);

        if (card.moreWays != null) card.moreWays.color = FlxColor.interpolate(card.moreWays.color, targetMoreWaysColor, lerpAmount);

        if (card.moreWays2 != null) card.moreWays2.color = FlxColor.interpolate(card.moreWays2.color, targetMoreWaysColor, lerpAmount);

        if (card.funnyScroll != null) card.funnyScroll.color = FlxColor.interpolate(card.funnyScroll.color, targetFunnyScrollColor, lerpAmount);

        if (card.funnyScroll2 != null) card.funnyScroll2.color = FlxColor.interpolate(card.funnyScroll2.color, targetFunnyScroll2Color, lerpAmount);

        if (card.funnyScroll3 != null) card.funnyScroll3.color = FlxColor.interpolate(card.funnyScroll3.color, targetFunnyScroll3Color, lerpAmount);

        if (currentOrangeColor != targetOrangeColor) {
          currentOrangeColor = FlxColor.interpolate(currentOrangeColor, targetOrangeColor, lerpAmount);

          var barWidth:Int = card.pinkBack != null ? Std.int(card.pinkBack.width) : 1280;
          if (card.orangeBackShit != null) card.orangeBackShit.makeSolidColor(barWidth, 75, currentOrangeColor);
          if (card.alsoOrangeLOL != null && card.orangeBackShit != null) card.alsoOrangeLOL.makeSolidColor(100, Std.int(card.orangeBackShit.height), currentOrangeColor);
        }
      } catch (e:Dynamic) {}
    }
  }

  function getSongCharacterId(curSongId:String, ?variation:String):Null<String> {
    if (curSongId == null || curSongId == '') return null;

    try {
      var freeplayState:FreeplayState = FlxG.state.subState;
      var curDifficulty:String = null;
      @:privateAccess curDifficulty = freeplayState.currentDifficulty;

      var song:Null<Song> = SongRegistry.instance.fetchEntry(curSongId, {variation: variation});
      if (song == null) return null;

      return song.getDifficulty(curDifficulty, variation)?.characters.opponent;
    } catch (e:Dynamic) {
      trace('[RetroFreeplay] Error getting song character id: ' + e);
      return null;
    }
  }

  function resolveCharacterBackingId(characterId:String):String {
    return characterBackingAliases.get(characterId) ?? characterId;
  }

  function getCharacterBackingCardImage(?characterId:String):Null<String> {
    if (characterId == null || characterId == '') return null;

    var resolvedId:String = resolveCharacterBackingId(characterId);
    var path:String = CHARACTER_BACKING_PATH + resolvedId;

    return Assets.exists(Paths.image(path)) ? path : null;
  }

  function updateBackingCardTexts(curSongId:String, curWeekId:String, ?variation:String):Void {
    //if (FlxG.state == null || !Std.isOfType(FlxG.state, FreeplayState)) return;

    var freeplayState:FreeplayState = FlxG.state.subState;

    try {
      @:privateAccess {
        var backingCard = freeplayState.backingCard;
        if (backingCard == null) return;
        var styleData = freeplayState.styleData;

        var customTexts:BackingCardTexts = songConfig.get(curSongId);
        var weekTexts:BackingCardTexts = (curWeekId != '' && curWeekId != null) ? songConfig.get(curWeekId) : null;
        if (customTexts == null) customTexts = weekTexts;

        var characterBgImage:Null<String> = getCharacterBackingCardImage(getSongCharacterId(curSongId, variation));

        lastConfiguredColor = customTexts?.color;
        updateCardColorTargets(lastConfiguredColor);

        var textsToApply:BackingCardTexts;
        var usingDefault:Bool = false;

        if (characterBgImage != null || customTexts != null) {
          textsToApply = {
            bgColor: customTexts?.bgColor ?? -1,
            bgImage: characterBgImage ?? customTexts?.bgImage ?? (styleData == null ? 'freeplay/freeplayBGweek1-bf' : styleData.getBgAssetKey()),
            funnyScroll: customTexts?.funnyScroll ?? weekTexts?.funnyScroll ?? defaultTexts?.funnyScroll,
            moreWays: customTexts?.moreWays ?? weekTexts?.moreWays ?? defaultTexts?.moreWays,
            txtNuts: customTexts?.txtNuts ?? weekTexts?.txtNuts ?? defaultTexts?.txtNuts,
            funnyScroll2: customTexts?.funnyScroll2 ?? weekTexts?.funnyScroll2 ?? defaultTexts?.funnyScroll2,
            moreWays2: customTexts?.moreWays2 ?? weekTexts?.moreWays2 ?? defaultTexts?.moreWays2,
            funnyScroll3: customTexts?.funnyScroll3 ?? weekTexts?.funnyScroll3 ?? defaultTexts?.funnyScroll3
          };
        } else {
          // Voltar totalmente ao padrão
          cacheDefaultTexts(); // tentar cachear novamente caso ainda não tenhamos conseguido antes
          textsToApply = defaultTexts;
          usingDefault = true;
        }
        //trace(customTexts);
        //trace(textsToApply);

        if (textsToApply != null) {
          if (textsToApply.funnyScroll != null && backingCard.funnyScroll != null && backingCard.funnyScroll.text != textsToApply.funnyScroll) backingCard.funnyScroll.updateText(textsToApply.funnyScroll);
          if (textsToApply.moreWays != null && backingCard.moreWays != null && backingCard.moreWays.text != textsToApply.moreWays) backingCard.moreWays.updateText(textsToApply.moreWays);
          if (textsToApply.txtNuts != null && backingCard.txtNuts != null && backingCard.txtNuts.text != textsToApply.txtNuts) backingCard.txtNuts.updateText(textsToApply.txtNuts);
          if (textsToApply.funnyScroll2 != null && backingCard.funnyScroll2 != null && backingCard.funnyScroll2.text != textsToApply.funnyScroll2) backingCard.funnyScroll2.updateText(textsToApply.funnyScroll2);
          if (textsToApply.moreWays2 != null && backingCard.moreWays2 != null && backingCard.moreWays2.text != textsToApply.moreWays2) backingCard.moreWays2.updateText(textsToApply.moreWays2);
          if (textsToApply.funnyScroll3 != null && backingCard.funnyScroll3 != null && backingCard.funnyScroll3.text != textsToApply.funnyScroll3) backingCard.funnyScroll3.updateText(textsToApply.funnyScroll3);

          if (isFirstTime) {
            FlxTween.cancelTweensOf(freeplayState.backingImage);
            freeplayState.backingImage.color = -1;
            freeplayState.angleMaskShader.extraColor = freeplayState.backingImage.color;

            /*new FlxTimer().start(0.1, function(tmr:FlxTimer) {
              freeplayState.albumRoll.skipIntro();
              freeplayState.albumRoll.showStars();
              defaultAlbumAngle = freeplayState.albumRoll.angle;
            });*/
          }

          /*if (!usingDefault) {
            freeplayState.albumRoll.angle = -10;
          } else freeplayState.albumRoll.angle = defaultAlbumAngle;*/

          /*var targetColor:Int = (textsToApply.bgColor != null && textsToApply.bgColor != -1) ? textsToApply.bgColor : -1;
          if (targetColor != freeplayState.backingImage.color) {
            FlxTween.cancelTweensOf(freeplayState.backingImage);
            FlxTween.color(freeplayState.backingImage, 0.33, freeplayState.backingImage.color, targetColor, {ease: FlxEase.quadOut,
              onUpdate: function(_) {
                freeplayState.angleMaskShader.extraColor = freeplayState.backingImage.color;
              },
            });
          }*/

          if (defaultTexts == null) return;

          var targetImg:String = textsToApply.bgImage;
          //trace('targetImg: ' + targetImg);
          //trace('curBgImage: ' + curBgImage);
          var isRetroBg = targetImg != defaultTexts.bgImage;
          var titleScale = isRetroBg ? ALBUM_SCALE : 1;
          var targetAngle = isRetroBg ? ALBUM_ANGLE : 0;
          freeplayState.albumRoll.albumTitle.scale.set(titleScale, titleScale);
          freeplayState.albumRoll.albumTitle.angle = isRetroBg ? 10 : 0;
          freeplayState.albumRoll.albumTitle.updateHitbox();
          if (targetImg != null && targetImg != curBgImage) {
            curBgImage = targetImg;
            freeplayState.backingImage.loadGraphic(Paths.image(targetImg));
            FlxTween.cancelTweensOf(freeplayState.backingImage);

            if (characterBgImage != null) {
              FunkinMemory.cacheTexture(Paths.image(targetImg));
              freeplayState.backingImage.color = -1;
              freeplayState.angleMaskShader.extraColor = freeplayState.backingImage.color;
            } else if (targetImg != styleData.getBgAssetKey()) {
              //freeplayState.backingImage.setGraphicSize(0, FlxG.height + 1);
              FunkinMemory.cacheTexture(Paths.image(targetImg));

              if (Preferences.flashingLights) {
                freeplayState.backingImage.color = -1;
                freeplayState.angleMaskShader.extraColor = freeplayState.backingImage.color;
              }
              FlxTween.color(freeplayState.backingImage, 0.25, freeplayState.backingImage.color, FlxColor.fromString('#d1d1d1'), {ease: FlxEase.quadOut,
                onUpdate: function(_) {
                  freeplayState.angleMaskShader.extraColor = freeplayState.backingImage.color;
                },
              });
            } else {
              FlxTween.color(freeplayState.backingImage, 0.25, freeplayState.backingImage.color, -1, {ease: FlxEase.quadOut,
                onUpdate: function(_) {
                  freeplayState.angleMaskShader.extraColor = freeplayState.backingImage.color;
                },
              });
            }

            // For some reason, the backing image breaks when you return from the char select screen so we do this to fix it
            freeplayState.backingImage.x = backingImagePos[0];
            freeplayState.backingImage.y = backingImagePos[1];
          }
        }
      }
      isFirstTime = false;
    } catch (e:Dynamic) {
      throw('[RetroFreeplay] Error updating texts: ' + e);
    }
  }
}

typedef BackingCardTexts = {
  @:optional var bgColor:Int;
  @:optional var bgImage:String;
  @:optional var color:Int;
  @:optional var funnyScroll:String;
  @:optional var moreWays:String;
  @:optional var txtNuts:String;
  @:optional var funnyScroll2:String;
  @:optional var moreWays2:String;
  @:optional var funnyScroll3:String;
}
