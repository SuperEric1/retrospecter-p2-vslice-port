class RetroMainMenu extends MusicBeatState
{
  public var retroV:String = '1.0';

  var bg:FlxSprite;
  var bgFront:FlxSprite;
  var camFollow:FlxObject;
  var titleText:FlxText;
  var label1:FunkinSprite;
  var label2:FunkinSprite;
  var bgCurtainBorders:Array<FunkinSprite>;

  // Menu (referências para a página ativa)
  var menuItems:Array<FunkinSprite>;
  var menuCallbacks:Array<Dynamic>;
  var menuHitboxes:Array<FlxObject>;
  var menuNames:Array<String>;
  var menuUsesShaders:Array<Bool>;
  var menuShaders:Array<Dynamic>;
  var menuBorders:Array<FunkinSprite>;
  var menuClips:Array<FlxRect>;
  var menuSpacingWidths:Array<Float>; // largura normalizada para cálculo de spread
  var menuStartIndex:Int = -1;
  var minCamX:Float = 0;
  var maxCamX:Float = 0;
  var isSpreading:Bool = false;
  var angleMaskValue:Array<Float> = [80, 160];
  var isWideScreen:Bool = false;

  // Menu (dados de todas as páginas; index 0 = principal, index 1 = extras)
  var pagesMenuItems:Array<Array<FunkinSprite>> = [[], []];
  var pagesMenuCallbacks:Array<Array<Dynamic>> = [[], []];
  var pagesMenuHitboxes:Array<Array<FlxObject>> = [[], []];
  var pagesMenuNames:Array<Array<String>> = [[], []];
  var pagesMenuUsesShaders:Array<Array<Bool>> = [[], []];
  var pagesMenuShaders:Array<Array<Dynamic>> = [[], []];
  var pagesMenuBorders:Array<Array<FunkinSprite>> = [[], []];
  var pagesMenuClips:Array<Array<FlxRect>> = [[], []];
  var pagesMenuSpacingWidths:Array<Array<Float>> = [[], []];
  var pagesMenuOriginalX:Array<Array<Float>> = [[], []];
  var pagesMenuBorderOriginalX:Array<Array<Float>> = [[], []];
  var pagesMenuFullScale:Array<Array<Float>> = [[], []];
  var pagesMenuStartIndex:Array<Int> = [-1, -1];
  var pagesMinCamX:Array<Float> = [0, 0];
  var pagesMaxCamX:Array<Float> = [0, 0];
  var pagesIsSpreading:Array<Bool> = [false, false];

  var currentPage:Int = 0;
  var camFollowExtras:FlxObject;
  var camExtras:FunkinCamera;
  var camMain:FunkinCamera;
  var pageSlideDistance:Float;
  var pageTransitionTime:Float = 0.35;

  // Estado
  var selectedIndex:Int = 0;
  var canNavigate:Bool = false;
  var isBusy:Bool = false;
  var isExiting:Bool = false;
  var hasSelection:Bool = false;

  var idleTimer:FlxTimer;
  var idleTimeoutSeconds:Float = 3.0;

  // Mouse/Touch
  var backBtn:FunkinBackButton = null;
  var lastMousePos:FlxPoint;
  var _totalScreenMovedX:Float = 0;
  var _totalScreenMovedY:Float = 0;
  var blockMouse:Bool = false;
  var mouseMovementThreshold:Float = 10; // Pixels que o mouse precisa mover para reconhecer movimento
  var mouseHasMoved:Bool = false;
  var lastTouchedIndex:Int = -1; // Para touch: primeiro toque seleciona, segundo confirma

  // Config
  var overrideMusic:Bool = false;
  var horizontalSpacing:Float = 30;
  var baseY:Float = 360;
  var camMinOffset = -10;
  var camMaxOffset = 150;
  var backZIndex:Float = 1;
  var frontZIndex:Float = 50;
  var itemScrollFactor = [0.1, 0];

  static var rememberedSelectedIndex:Int = 0;

  public function new(?_overrideMusic:Bool)
  {
    super('RetroMainMenu');

    if (_overrideMusic != null) overrideMusic = _overrideMusic;

    for (page in 0...2) {
      pagesMenuItems[page] = [];
      pagesMenuCallbacks[page] = [];
      pagesMenuHitboxes[page] = [];
      pagesMenuNames[page] = [];
      pagesMenuClips[page] = [];
      pagesMenuShaders[page] = [];
      pagesMenuUsesShaders[page] = [];
      pagesMenuBorders[page] = [];
      pagesMenuSpacingWidths[page] = [];
      pagesMenuOriginalX[page] = [];
      pagesMenuBorderOriginalX[page] = [];
      pagesMenuFullScale[page] = [];
    }

    bgCurtainBorders = [];

    camFollow = new FlxObject(0, 0, 1, 1);
    camFollowExtras = new FlxObject(0, 0, 1, 1);
    idleTimer = new FlxTimer();
    lastMousePos = FlxPoint.get(0, 0);

    FlxG.keys.enabled = true;

    var data:ModMetadata = null;

    /*for (name in RetroSave.folderNames) {
      if (data != null) continue;*/
      data = PolymodHandler.modFileSystem.getMetadataById('retrospecter-p2-port');
    //}

    if (data != null) {
      retroV = data.modVersion.version?.join(".")?.substr(0, 3) ?? '1.0';
    }
  }

  override function create():Void
  {
    transIn = FlxTransitionableState.defaultTransIn;
    transOut = FlxTransitionableState.defaultTransOut;

    FlxG.camera.bgColor = FlxColor.BLACK;

    if (!overrideMusic) playMenuMusic();

    if (FlxG.onMobile) {
      backBtn = addBackButton(FlxG.width - 230, FlxG.height - 200, FlxColor.WHITE, goBack, 0.25);
      /*backBtn.onConfirmStart.add(function() {
        canNavigate = false;
        backBtn.active = true;
      });*/
    }

    persistentUpdate = true;
    persistentDraw = true;

    if (bgFront != null) bgFront.destroy();

    bg = new FlxSprite();
    bg.makeGraphic(Std.int(FlxG.width * 1.2), Std.int(FlxG.height * 1.1), FlxColor.BLACK);
    bg.scrollFactor.set(0, 0);
    bg.updateHitbox();
    bg.screenCenter();
    add(bg);

    var curtain1 = new FlxSprite(-FlxG.width * 0.1, 0);
    curtain1.makeGraphic(Std.int(FlxG.width * 0.6), Std.int(FlxG.height * 1.1), FlxColor.BLACK);
    curtain1.scrollFactor.set(0, 0);
    curtain1.updateHitbox();
    add(curtain1);

    var curtain2 = new FlxSprite(FlxG.width / 2, 0);
    curtain2.makeGraphic(Std.int(FlxG.width * 0.6), Std.int(FlxG.height * 1.1), FlxColor.BLACK);
    curtain2.scrollFactor.set(0, 0);
    curtain2.updateHitbox();
    add(curtain2);

    bgCurtainBorders.push(curtain1);
    bgCurtainBorders.push(curtain2);

    add(camFollow);
    add(camFollowExtras);

    pageSlideDistance = FlxG.width * 0.95;

    camExtras = new FunkinCamera('mainMenuExtras');
    camExtras.bgColor = FlxColor.TRANSPARENT;
    camExtras.zoom = 0.9;
    camExtras.visible = false;
    FlxG.cameras.add(camExtras, false);

    camMain = new FunkinCamera('mainMenuMain');
    camMain.bgColor = FlxColor.TRANSPARENT;
    FlxG.cameras.add(camMain, false);

    curtain1.cameras = [camMain];
    curtain2.cameras = [camMain];

    var path = 'ui/mainmenu/';

    isWideScreen = FlxG.width > 1280;

    // Página 2 (extras) é criada primeiro: fica atrás dos botões principais,
    // na mesma posição/layout, mas em escala reduzida (0.9) até a transição.
    pagesMenuStartIndex[1] = members.length;
    createMenuItem('trophies', path + 'trophies', openTrophyState, 0.87, 1);
    createMenuItem('side', path + 'side', goToFreeplay, 0.87, 1);
    createMenuItem('credits', path + 'credits', goToCredits, 1, 1);
    createMenuItem('gallery', path + 'gallerylocked', interactLocked, 0.75, 1);

    pagesMenuStartIndex[0] = members.length;
    createMenuItem('story', path + 'story', goToStory, 0.87, 0);
    createMenuItem('freeplay', path + 'firstfreeplay', interactLocked, 0.87, 0);
    createMenuItem('extras', path + 'extras', goToExtras, 1, 0);
    createMenuItem('options', path + 'options', goToOptions, 0.75, 0);

    if (isWideScreen) {
      camMaxOffset += 400;
    }

    positionMenuItems(0);
    positionMenuItems(1);

    for (i in 0...pagesMenuItems[1].length) {
      var extraItem = pagesMenuItems[1][i];
      var extraHitbox = pagesMenuHitboxes[1][i];
      var extraBorder = pagesMenuBorders[1][i];

      extraItem.cameras = [camExtras];
      if (extraBorder != null) extraBorder.cameras = [camExtras];
      extraHitbox.cameras = [camExtras];
      extraHitbox.exists = false;
    }

    for (i in 0...pagesMenuItems[0].length) {
      var mainItem = pagesMenuItems[0][i];
      var mainHitbox = pagesMenuHitboxes[0][i];
      var mainBorder = pagesMenuBorders[0][i];

      mainItem.cameras = [camMain];
      if (mainBorder != null) mainBorder.cameras = [camMain];
      mainHitbox.cameras = [camMain];
    }

    menuItems = pagesMenuItems[0];
    menuCallbacks = pagesMenuCallbacks[0];
    menuHitboxes = pagesMenuHitboxes[0];
    menuNames = pagesMenuNames[0];
    menuClips = pagesMenuClips[0];
    menuShaders = pagesMenuShaders[0];
    menuUsesShaders = pagesMenuUsesShaders[0];
    menuBorders = pagesMenuBorders[0];
    menuSpacingWidths = pagesMenuSpacingWidths[0];
    menuStartIndex = pagesMenuStartIndex[0];
    minCamX = pagesMinCamX[0];
    maxCamX = pagesMaxCamX[0];
    isSpreading = pagesIsSpreading[0];

    var labelSize = Std.int(FlxG.height * 0.75);
    label1 = FunkinSprite.create(0, 0);
    label1.frames = Paths.getSparrowAtlas(path + 'logosFirst');
    label1.animation.addByPrefix('nothing', 'nothing', 1, true);
    label1.animation.addByPrefix('story', 'story', 1, true);
    label1.animation.addByPrefix('freeplay', 'freeplay', 1, true);
    label1.animation.addByPrefix('extras', 'extras', 1, true);
    label1.animation.addByPrefix('options', 'options', 1, true);
    label1.animation.play('story');
    label1.cameras = [camMain];
    label1.setGraphicSize(labelSize);
    label1.updateHitbox();
    //label1.y = baseY - (label1.height / 2);
    label1.scrollFactor.set(itemScrollFactor[0], itemScrollFactor[1]);
    label1.alpha = 0;
    add(label1);

    label2 = FunkinSprite.create(0, 0);
    label2.frames = Paths.getSparrowAtlas(path + 'logosExtra');
    label2.animation.addByPrefix('nothing', 'nothing', 1, true);
    label2.animation.addByPrefix('credits', 'credits', 1, true);
    label2.animation.addByPrefix('side', 'side', 1, true);
    label2.animation.addByPrefix('trophies', 'trophies', 1, true);
    label2.animation.addByPrefix('gallery', 'gallery', 1, true);
    label2.animation.addByPrefix('options', 'options', 1, true);
    label2.animation.play('side');
    label2.cameras = [camMain];
    label2.setGraphicSize(labelSize);
    label2.updateHitbox();
    //label2.y = label1.y;
    label2.scrollFactor.set(itemScrollFactor[0], itemScrollFactor[1]);
    label2.alpha = label1.alpha;
    add(label2);

    selectedIndex = rememberedSelectedIndex;
    if (selectedIndex >= menuItems.length) selectedIndex = 0;

    setIdleState(false);

    // FlxG.width * 0.7
    camFollow.setPosition(FlxG.width / 2 + camMinOffset, baseY);
    camFollowExtras.setPosition(FlxG.width / 2 + camMinOffset, baseY);
    resetCamera(isSpreading ? true : false, camMain, camFollow);
    resetCamera(pagesIsSpreading[1] ? true : false, camExtras, camFollowExtras);

    var closeCallback:Dynamic = function(_:Dynamic) {
      resetCurrentCamera();
    };
    subStateClosed.add(closeCallback);

    FullScreenScaleMode.removeCutouts();

    super.create();

    if ((!FlxG.onMobile) || (FlxG.onMobile && ControlsHandler.usingExternalInputDevice) && FlxG.mouse.cursor != null) {
      FlxG.mouse.visible = true;
      FlxG.mouse.load(Paths.image('ui/cursor'), FlxG.onMobile ? 1.7 : 1);
    }

    var state = FlxG.state;
    var waterMarkText = "Vs. RetroSpecter - Part Two: Infernadise (V-SLICE)\nFan Port v" + retroV + " | FNF " + Constants.VERSION;
    if (state.leftWatermarkText != null && !StringTools.startsWith(FlxG.state.leftWatermarkText.text, waterMarkText)) {
      //var ogText = FlxG.state.leftWatermarkText.text;
      state.leftWatermarkText.font = Paths.font('Kenyan Coffee Rg.otf');
      state.leftWatermarkText.size = FlxG.onMobile ? 30 : 25;
      state.leftWatermarkText.text = waterMarkText;
      state.leftWatermarkText.cameras = [camMain];
      state.leftWatermarkText.y = FlxG.height - state.leftWatermarkText.fieldHeight - (FlxG.onMobile ? 57 : 45);
    }
    if (state.rightWatermarkText != null && RetroSave.isDebug()) {
      state.rightWatermarkText.font = Paths.font('Kenyan Coffee Rg.otf');
      state.rightWatermarkText.size = 40;
      state.rightWatermarkText.text = 'DEBUG BUILD';
      state.rightWatermarkText.color = FlxColor.YELLOW;
      state.rightWatermarkText.x = FlxG.width - state.rightWatermarkText.width - 5;
      state.rightWatermarkText.y = FlxG.height - state.rightWatermarkText.height - 5;
      state.rightWatermarkText.visible = true;
      state.rightWatermarkText.cameras = [camMain];
    }

    lastMousePos.set(FlxG.mouse.screenX, FlxG.mouse.screenY);

    var save:Save = Save.instance;
    if (save.modOptions.get('retroWasInExtrasMenu', false)) {
      startPageTransition(1, true);
    };

    if (FlxG.onMobile) {
      backBtn = new FunkinBackButton(FlxG.width - 230, FlxG.height - 200, FlxColor.WHITE, goBack, 0.5);
      add(backBtn);
      backBtn.scale.set(0.75, 0.75);
      backBtn.updateHitbox();
      backBtn.cameras = [camMain];
      if (!save.modOptions.get('retroWasInExtrasMenu', false)) {
        backBtn.x = FlxG.width;
        FlxTween.tween(backBtn, {x: FlxG.width - 230}, 1, {ease: FlxEase.expoOut});
      }
    }

    // Habilitar navegação
    new FlxTimer().start(0.6, function(_:FlxTimer) {
      canNavigate = true;
    });
    
    RetroAchievements.checkAllCategories();
    RetroAchievements.showQueuedToasts(0.3);
  }

  function createMenuItem(name:String, atlasPath:String, callback:Dynamic, sizeMult:Int, page:Int):Void
  {
    var item:FunkinSprite = FunkinSprite.create(0, 0);

    item.frames = Paths.getSparrowAtlas(atlasPath);

    var upperName:String = name.toUpperCase();
    item.animation.addByPrefix('bright', upperName + 'BRIGHT', 24, false);
    item.animation.addByPrefix('dark', upperName + 'DARK', 24, false);
    item.animation.play('bright');
    item.setGraphicSize(Std.int(sizeMult * FlxG.height), Std.int(sizeMult * FlxG.height));
    item.updateHitbox();

    pagesMenuFullScale[page].push(item.scale.x);

    var cutLeft:Float = item.frameWidth / (isWideScreen ? 4.5 : 4);
    var cutRight:Float = cutLeft;
    var shaderOffset:Float = 0;
    var shaderEndOffset:Float = 0;

    switch (name) {
      case 'story':
        cutLeft = 20;
        cutRight += 50;
      case 'options':
        cutRight = 70;
        shaderOffset += 0;
        shaderEndOffset += 5;
      case 'gallery':
        cutRight = 70;
        shaderOffset += 50;
      case 'credits':
        cutLeft -= 10;
        cutRight += 69;
        shaderOffset -= 20;
      case 'extras':
        cutLeft -= 50;
        cutRight += 50;
        shaderOffset += 10;
      case 'side':
        cutLeft -= 20;
        cutRight += 43;
      case 'freeplay':
        cutLeft -= 20;
        cutRight += 100;
      default:
    }

    var clipX:Float = cutLeft;
    var clipY:Float = 0;
    var clipW:Float = item.frameWidth - cutLeft - cutRight;
    var clipH:Float = item.frameHeight;

    var shaderButtons:Array<String> = ['freeplay', 'extras', 'side', 'credits', 'options', 'gallery'];
    var usesShader:Bool = shaderButtons.contains(name);
    pagesMenuUsesShaders[page].push(usesShader);

    var border = FunkinSprite.create(0, 0).makeSolidColor(item.frameWidth / 2, item.frameHeight * 1.5, FlxColor.BLACK);
    border.angle = -11;
    border.scrollFactor.set(itemScrollFactor[0], itemScrollFactor[1]);
    pagesMenuBorders[page].push(border);

    if (usesShader) {
      var shader = new RetroAngleMaskShader();
      shader.setStartOffset(angleMaskValue[0] + shaderOffset);
      shader.setEndX(angleMaskValue[0] + angleMaskValue[1] + shaderOffset + shaderEndOffset);

      item.shader = shader;
      shader.attachedSprite = item;

      pagesMenuShaders[page].push(shader);
    } else {
      pagesMenuShaders[page].push(null);
    }

    //item.clipRect = new FlxRect(clipX, clipY, clipW, clipH);
    pagesMenuClips[page].push(new FlxRect(clipX, clipY, clipW, clipH));

    // spacingWidth: teto em frameWidth - 2*defaultCut (tamanho de um item padrão).
    // Itens com cutLeft pequeno (story) não inflam o cálculo de spread.
    var defaultCut:Float = item.frameWidth / (FlxG.onMobile ? 4.5 : 4);
    pagesMenuSpacingWidths[page].push(Math.min(clipW, item.frameWidth - 2 * defaultCut));

    item.ID = pagesMenuItems[page].length;
    item.scrollFactor.set(itemScrollFactor[0], itemScrollFactor[1]);

    var hitboxBaseWidth:Float = (item.frameWidth * 0.65);
    var finalHitboxWidth:Float = hitboxBaseWidth * item.scale.x;
    var finalHitboxHeight:Float = clipH * item.scale.y;

    var hitbox:FlxObject = new FlxObject(0, 0, finalHitboxWidth, finalHitboxHeight);
    hitbox.scrollFactor.set(itemScrollFactor[0], itemScrollFactor[1]);
    pagesMenuHitboxes[page].push(hitbox);
    add(hitbox);

    pagesMenuItems[page].push(item);
    pagesMenuCallbacks[page].push(callback);
    pagesMenuNames[page].push(name);

    add(item);
    add(border);
    if (name == 'options' || name == 'gallery') {
      border.destroy();
      pagesMenuBorders[page][pagesMenuBorders[page].length - 1] = null;
    }
  }

  function positionMenuItems(page:Int):Void
  {
    var items = pagesMenuItems[page];
    var hitboxes = pagesMenuHitboxes[page];
    var borders = pagesMenuBorders[page];
    var clips = pagesMenuClips[page];

    var totalItems:Int = items.length;
    if (totalItems == 0) return;

    var totalSpriteWidth:Float = 0;
    var screenWidths:Array<Float> = [];

    for (i in 0...totalItems) {
      var sx:Float = items[i].scale.x;
      var w:Float = clips[i].width * sx;
      screenWidths.push(w);
      totalSpriteWidth += w;
    }

    var sidePadding:Float = -30; //FlxG.onMobile ? 40 : 85
    var availableWidth:Float = FlxG.width - (sidePadding * 2);

    var naturalWidth:Float = totalSpriteWidth + (horizontalSpacing * (totalItems - 1));
    var spreading:Bool = naturalWidth <= availableWidth;
    pagesIsSpreading[page] = spreading;

    var finalSpacing:Float = horizontalSpacing;
    var currentX:Float = page == 0 ? -100 : -35;

    if (spreading) {
      if (totalItems > 1) {
        finalSpacing = Math.max(horizontalSpacing, (availableWidth - totalSpriteWidth) / (totalItems - 1));
      }
      currentX = sidePadding;
    }

    for (i in 0...totalItems)
    {
      var item:FunkinSprite = items[i];
      var hitbox:FlxObject = hitboxes[i];
      var border:FunkinSprite = borders[i];
      var clip:FlxRect = clips[i];
      var sx:Float = item.scale.x;
      var sy:Float = item.scale.y;
      var borderOffset:Float = 0;
      var hitboxOffsets:Array<Float> = [!spreading ? -155 : 20, -30];
      var hitboxAdjustment:Float = 0;

      item.x = currentX - clip.x * sx;
      item.y = baseY - (item.height / 2);

      // Ajustar posições (MEU DEUSSSS)
      switch (i) {
        case 0:
          if (page == 0) {
            item.x += 13;
            borderOffset = 25;
          } else {
            item.x += 55;
            borderOffset = -13;
          }
        case 1:
          if (page == 0) {
            item.x += 7;
            borderOffset = 25;
          } else {
            borderOffset = 25;
          }
        case 2:
          if (page == 0) {
            item.x += 38;
            hitboxAdjustment -= 140;
          } else {
            item.x += 30;
            hitboxAdjustment -= 40;
          }
          borderOffset = 57;
        case 3:
          if (page == 1) {
            item.x += 40;
          } else {
            item.x += 60;
          }
      }

      if (border != null) {
        border.x = item.x + item.frameWidth - (border.width / 1.5) + borderOffset;
        border.screenCenter(0x10);
      }


      var scaledItemWidth:Float = item.frameWidth * sx;
      var itemCenterX:Float = item.x + (scaledItemWidth / 2);

      hitbox.width = ((item.frameWidth * 0.65) * sx) + hitboxAdjustment;
      hitbox.height = clip.height * sy;

      hitbox.x = itemCenterX - (hitbox.width / 2) + hitboxOffsets[page];
      hitbox.y = item.y + (clip.y * sy); // Mantém a mesma altura/Y original

      pagesMenuOriginalX[page][i] = item.x;
      pagesMenuBorderOriginalX[page][i] = border != null ? border.x : 0;

      currentX += screenWidths[i] + finalSpacing;
    }

    if (totalItems > 0)
    {
      if (spreading) {
        var screenCenter:Float = FlxG.width / 2;
        pagesMinCamX[page] = screenCenter;
        pagesMaxCamX[page] = screenCenter;
      } else {
        var lastItem = items[totalItems - 1];
        var lastClip = clips[totalItems - 1];

        pagesMinCamX[page] = (FlxG.width / 2) + camMinOffset;

        var lastItemRight:Float = lastItem.x + ((lastClip.x + lastClip.width) * lastItem.scale.x);
        pagesMaxCamX[page] = lastItemRight - (FlxG.width / 2) + camMaxOffset;

        if (pagesMaxCamX[page] < pagesMinCamX[page]) pagesMaxCamX[page] = pagesMinCamX[page];
      }
    }
  }

  function setIdleState(?doTween:Bool = true):Void
  {
    lastMousePos.set(FlxG.mouse.x, FlxG.mouse.y);
    blockMouse = false;
    hasSelection = false;

    for (i in 0...menuItems.length)
    {
      menuItems[i].animation.play('bright');
      updateItemClip(i, false, doTween);
    }

    updateLabel(null);
    idleTimer.cancel();
    if (lastTouchedIndex != -1) HapticUtil.vibrate(0, 0.03, 0.005, 0);
    lastTouchedIndex = -1; // Reset touch state
  }

  function updateItemClip(index:Int, isSelected:Bool, ?doTween:Bool):Void
  {
    if (menuItems[index] == null || menuClips[index] == null) return;

    var item = menuItems[index];
    var border = menuBorders[index];

    var targetScale:Float = isSelected ? 1.015 : 1.0;
    FlxTween.cancelTweensOf(item.scale);
    if (doTween) {
      FlxTween.tween(item.scale, {x: targetScale, y: targetScale}, 0.4, {ease: FlxEase.circOut});
    } else {
      item.scale.set(targetScale, targetScale);
    }

    if (isSelected) {
      if (menuUsesShaders[index]) item.shader = null;
      remove(item);
      //remove(border);
      insert(menuStartIndex + menuItems.length * 2 - 2, item);
      //insert(menuStartIndex + menuItems.length * 2 - 1, border);
    } else {
      if (menuUsesShaders[index]) {
        item.shader = menuShaders[index];
        menuShaders[index].updateFrameInfo(item.frame);
      }
      remove(item);
      insert(menuStartIndex + index * 2, item);
      if (border != null) {
        remove(border);
        var itemPos:Int = members.indexOf(item);
        insert(itemPos + 1, border);
      }
    }
  }

  function selectItem(index:Int, playSound:Bool = true, ?moveCam:Bool = false):Void
  {
    if (index < 0 || index >= menuItems.length) return;

    hasSelection = true;
    selectedIndex = index;

    for (i in 0...menuItems.length)
    {
      var isThisSelected = (i == selectedIndex);
      menuItems[i].animation.play(isThisSelected ? 'bright' : 'dark');
      if (isThisSelected) updateLabel(menuNames[i]);
      updateItemClip(i, isThisSelected, true);
      HapticUtil.vibrate(0, 0.03, 0.005, 0);
    }

    var selected = menuItems[selectedIndex];
    var clipData = menuClips[selectedIndex];

    if (moveCam) { // Only change the camera pos if we clicked/touched. The camera should follow the mouse by default.
      // Espelhar a lógica do mouse. Mapeia a posição do item proporcionalmente dentro do conteúdo (primeiro..último) para o mesmo range [minCamX, maxCamX].
      // Assim o primeiro item = minCamX, o último = maxCamX, e os do meio são proporcionais.
      var firstClip = menuClips[0];
      var lastClip = menuClips[menuItems.length - 1];
      var fs0:Float = menuItems[0].scale.x;
      var fsN:Float = menuItems[menuItems.length - 1].scale.x;
      var fsSel:Float = selected.scale.x;
      var firstCenter:Float = menuItems[0].x + firstClip.x * fs0 + firstClip.width * fs0 / 2;
      var lastCenter:Float = menuItems[menuItems.length - 1].x + lastClip.x * fsN + lastClip.width * fsN / 2;
      var selectedCenter:Float = selected.x + clipData.x * fsSel + clipData.width * fsSel / 2;

      var t:Float = (lastCenter != firstCenter) ? (selectedCenter - firstCenter) / (lastCenter - firstCenter) : 0;
      var targetX:Float = FlxMath.lerp(minCamX, maxCamX, FlxMath.bound(t, 0, 1));

      activeCamFollow().setPosition(targetX, baseY);

      /* OLD
      var targetX:Float = selected.x + clipData.x + (clipData.width);
      targetX = FlxMath.bound(targetX, minCamX, maxCamX);

      camFollow.setPosition(targetX, baseY);*/
    }

    if (playSound) FunkinSound.playOnce(Paths.sound('scrollMenu'), 1);

    resetIdleTimer();
  }

  function updateLabel(name:String):Void {
    if (name == null) {
      FlxTween.cancelTweensOf(label1);
      FlxTween.cancelTweensOf(label2);
      FlxTween.tween(label1, {alpha: 0}, 0.2, {ease: FlxEase.quadOut});
      FlxTween.tween(label2, {alpha: 0}, 0.2, {ease: FlxEase.quadOut});
      return;
    }

    var isExtra:Bool = (name == 'side' || name == 'credits' || name == 'trophies' || name == 'gallery');
    var activeLabel = isExtra ? label2 : label1;
    var inactiveLabel = isExtra ? label1 : label2;

    inactiveLabel.animation.play('nothing');

    activeLabel.animation.play(name);
    FlxTween.cancelTweensOf(activeLabel);
    FlxTween.tween(activeLabel, {alpha: 1}, 0.2, {ease: FlxEase.quadOut});

    var targetItem = menuItems[selectedIndex];
    var clipData = menuClips[selectedIndex];

    var itemCenterX:Float = targetItem.x + clipData.x * targetItem.scale.x + (clipData.width * targetItem.scale.x / 2);

    var distance:Float = 500;
    var offsetExtra:Float = 0;
    var offsetExtraY:Float = 0;

    var side:Float = 1.0;

    switch(name) {
      case 'story':
        side = 1.0;
        offsetExtra = 150;
        offsetExtraY = -40;
      case 'side':
        side = 1.0;
        offsetExtra = 100;
      case 'freeplay':
        side = 1.0;
        offsetExtra = 50;
        offsetExtraY = -5;
      case 'credits':
        side = -1.0;
        offsetExtra = -40;
      case 'extras':
        side = -1.0;
        offsetExtra = 55;
      case 'options':
        side = -1.0;
        offsetExtra = 200;
      case 'trophies':
        side = 1.0;
        offsetExtra = 70;
        offsetExtraY = -5;
      case 'gallery':
        side = -1.0;
        offsetExtra = 50;
        offsetExtraY = 15;
    }

    activeLabel.y = baseY - (activeLabel.height / 2) + offsetExtraY;
    activeLabel.x = itemCenterX + (distance * side) + (offsetExtra * side) - (activeLabel.width / 2);
  }

  function resetIdleTimer():Void
  {
    idleTimer.cancel();

    var timeoutCallback:Dynamic = function(_:FlxTimer) {
      setIdleState(true);
    };

    idleTimer.start(idleTimeoutSeconds, timeoutCallback);
  }

  function confirmSelection():Void
  {
    if (!hasSelection || isBusy || isExiting) return;
    if (selectedIndex < 0 || selectedIndex >= menuItems.length) return;

    isBusy = true;
    canNavigate = false;
    idleTimer.cancel();

    var selected:FlxSprite = menuItems[selectedIndex];
    var callback:Dynamic = menuCallbacks[selectedIndex];

    //FunkinSound.playOnce(Paths.sound('confirmMenu'));
    HapticUtil.vibrate(0, 0.045, 0.005, 0);

    var alwaysDoTimer:Bool = true;

    var timerType = (Preferences.flashingLights && !alwaysDoTimer) ? FlxFlicker : FlxTimer;
    var timerCallback:Dynamic = function(_:timerType) {
      isBusy = false;
      rememberedSelectedIndex = selectedIndex;
      if (callback != null) callback();
    };

    var flickerTime:Float = 0.1;
    if (Preferences.flashingLights && !alwaysDoTimer) FlxFlicker.flicker(selected, flickerTime, 0.1, true, false, timerCallback);
    else new FlxTimer().start(flickerTime, timerCallback);
  }

  // Callbacks de navegação
  function goToStory():Void
  {
    var stateFunc:Dynamic = function():FlxState {
      return new StoryMenuState();
    };
    FlxG.signals.preStateSwitch.addOnce(() -> {
      FunkinMemory.clearFreeplay();
      FunkinMemory.purgeCache();
    });
    startExitState(stateFunc, false);
  }

  function goToFreeplay():Void
  {
    var stateFunc:Dynamic = function():Void {
      openSubState(new FreeplayState());
    };
    FlxTransitionableState.skipNextTransIn = false;

    FreeplayState.CUTOUT_WIDTH = FullScreenScaleMode.gameCutoutSize.x / 1.5;

    startExitState(stateFunc, true);
  }

  function goToOptions():Void
  {
    var stateFunc:Dynamic = function():FlxState {
      return new funkin.ui.options.OptionsState();
    };

    FunkinMemory.cacheSound(Paths.sound('menus/boot'));
    FlxTransitionableState.skipNextTransIn = true;

    startExitState(stateFunc, false, !Save.instance.modOptions.get('retroOptionsIntroPlayed') ? 1 : 0.15);
  }

  function goToCredits():Void
  {
    var stateFunc:Dynamic = function():FlxState {
      return new CreditsState();
    };
    startExitState(stateFunc, false);
  }

  function goToExtras():Void
  {
    if (isBusy || isExiting || currentPage != 0) return;
    setIdleState(true);
    startPageTransition(1);
  }

  function goBackToMain():Void
  {
    if (isBusy || isExiting || currentPage != 1) return;
    setIdleState(false);
    startPageTransition(0);
  }

  function startPageTransition(toPage:Int, ?instant:Bool):Void
  {
    isBusy = true;
    canNavigate = false;
    idleTimer.cancel();

    var save:Save = Save.instance;
    save.modOptions.set('retroWasInExtrasMenu', toPage == 1);
    save.flush();

    if (toPage == 1) camExtras.visible = true;

    var goingForward:Bool = toPage == 1;
    var camera:FlxCamera = goingForward ? camExtras : camMain;

    var hiddenPage:Int = goingForward ? 0 : 1;
    var revealedPage:Int = toPage;

    var hiddenItems = pagesMenuItems[hiddenPage];
    var hiddenHitboxes = pagesMenuHitboxes[hiddenPage];
    var hiddenBorders = pagesMenuBorders[hiddenPage];

    var revealedItems = pagesMenuItems[revealedPage];
    var revealedBorders = pagesMenuBorders[revealedPage];

    //FunkinSound.playOnce(Paths.sound(goingForward ? 'scrollMenu' : 'cancelMenu'), 1);

    var c1StartX:Float = -FlxG.width * 0.1;
    var c2StartX:Float = FlxG.width / 2;

    var curtainMoveDist:Float = FlxG.width * 0.6;

    var c1TargetX:Float = goingForward ? (c1StartX - curtainMoveDist) : c1StartX;
    var c2TargetX:Float = goingForward ? (c2StartX + curtainMoveDist) : c2StartX;

    var easeCurtain = goingForward ? FlxEase.expoOut : FlxEase.expoIn;
    FlxTween.tween(bgCurtainBorders[0], {x: c1TargetX}, pageTransitionTime, {ease: easeCurtain});
    FlxTween.tween(bgCurtainBorders[1], {x: c2TargetX}, pageTransitionTime, {ease: easeCurtain});

    for (i in 0...hiddenItems.length)
    {
      var targetX:Float = pagesMenuOriginalX[hiddenPage][i];
      var targetBorderX:Float = pagesMenuBorderOriginalX[hiddenPage][i];
      if (goingForward) {
        var offset:Float = (i < 2 ? -1 : 1) * pageSlideDistance;
        targetX += offset;
        targetBorderX += offset;
      }

      var hiddenFullScale:Float = pagesMenuFullScale[hiddenPage][i];
      var hiddenTargetScale:Float = goingForward ? hiddenFullScale : hiddenFullScale * 0.9;
      var camZoom:Float = goingForward ? 1 : 0.9;

      slideItemSet(hiddenItems[i], hiddenHitboxes[i], hiddenBorders[i], targetX, targetBorderX, FlxEase.quintIn, instant);
      zoomItemSet(camExtras, camZoom, goingForward ? FlxEase.quintIn : FlxEase.expoOut, instant);
      //zoomItemSet(hiddenItems[i], hiddenBorders[i], hiddenTargetScale, goingForward ? FlxEase.expoIn : FlxEase.expoOut);
      hiddenHitboxes[i].exists = false;
    }

    for (i in 0...revealedItems.length)
    {
      var targetX:Float = pagesMenuOriginalX[revealedPage][i];
      var targetBorderX:Float = pagesMenuBorderOriginalX[revealedPage][i];
      var fullScale:Float = pagesMenuFullScale[revealedPage][i];
      var targetScale:Float = fullScale;
      var camZoom:Float = 1;

      slideItemSet(revealedItems[i], pagesMenuHitboxes[revealedPage][i], revealedBorders[i], targetX, targetBorderX, FlxEase.expoOut, instant);
      //zoomItemSet(camera, targetScale, goingForward ? FlxEase.expoOut : FlxEase.expoIn);
      //zoomItemSet(revealedItems[i], revealedBorders[i], targetScale, goingForward ? FlxEase.expoOut : FlxEase.expoIn);
    }

    new FlxTimer().start(pageTransitionTime, function(_:FlxTimer) {
      finishPageTransition(toPage);
    });
  }

  function slideItemSet(item:FunkinSprite, hitbox:FlxObject, border:FunkinSprite, targetX:Float, targetBorderX:Float, ease:Dynamic, ?instant:Bool):Void
  {
    var deltaX:Float = targetX - item.x;

    if (!instant) {
      FlxTween.tween(item, {x: targetX}, pageTransitionTime, {ease: ease});
      //FlxTween.tween(hitbox, {x: hitbox.x + deltaX}, pageTransitionTime, {ease: ease});
      if (border != null) FlxTween.tween(border, {x: targetBorderX}, pageTransitionTime, {ease: ease});
    } else {
      item.x = targetX;
      if (border != null) border.x = targetBorderX;
    }
  }

  function zoomItemSet(camera:FlxCamera, targetScale:Float, ease:Dynamic, ?instant:Bool):Void
  {
    if (!instant) {
      FlxTween.tween(camera, {zoom: targetScale}, pageTransitionTime, {ease: ease});
    } else {
      camera.zoom = targetScale;
    }
    //FlxTween.tween(item.scale, {x: targetScale, y: targetScale}, pageTransitionTime, {ease: ease});
    //if (border != null) FlxTween.tween(border.scale, {x: targetScale, y: targetScale}, pageTransitionTime, {ease: ease});
  }

  function finishPageTransition(toPage:Int):Void
  {
    currentPage = toPage;

    if (currentPage == 0) camExtras.visible = false;

    menuItems = pagesMenuItems[toPage];
    menuCallbacks = pagesMenuCallbacks[toPage];
    menuHitboxes = pagesMenuHitboxes[toPage];
    menuNames = pagesMenuNames[toPage];
    menuClips = pagesMenuClips[toPage];
    menuShaders = pagesMenuShaders[toPage];
    menuUsesShaders = pagesMenuUsesShaders[toPage];
    menuBorders = pagesMenuBorders[toPage];
    menuSpacingWidths = pagesMenuSpacingWidths[toPage];
    menuStartIndex = pagesMenuStartIndex[toPage];
    minCamX = pagesMinCamX[toPage];
    maxCamX = pagesMaxCamX[toPage];
    isSpreading = pagesIsSpreading[toPage];

    for (hitbox in menuHitboxes) hitbox.exists = true;

    selectedIndex = 0;
    activeCamFollow().setPosition(FlxG.width / 2 + camMinOffset, baseY);
    resetCurrentCamera(isSpreading);
    setIdleState(false);

    isBusy = false;
    canNavigate = true;
  }

  function startExitState(state:Dynamic, customFunction:Bool, ?transitionTime:Float = 0.15):Void
  {
    if (isExiting) return;

    isExiting = true;
    canNavigate = false;
    idleTimer.cancel();
    persistentUpdate = false;
    persistentDraw = false;

    var targetState = state;
    var isCustomFunction:Bool = customFunction;
    var tweenCallback:Dynamic = function(_:FlxTween) {
      if (FlxG.mouse.cursor != null) FlxG.mouse.visible = false;
      if (!isCustomFunction) {
        FlxG.switchState(targetState);
      } else {
        targetState();
      }
    };

    bgFront = new FlxSprite();
    bgFront.makeGraphic(Std.int(FlxG.width * 1.1), Std.int(FlxG.height * 1.1), FlxColor.BLACK);
    bgFront.scrollFactor.set(0, 0);
    bgFront.screenCenter();
    bgFront.alpha = 0;
    bgFront.cameras = [camMain];
    bgFront.updateHitbox();
    insert(1000, bgFront);

    //if (!isCustomFunction) {
      FlxG.sound.music.fadeOut(transitionTime, 0);
      FlxTween.tween(bgFront, {alpha: 1}, transitionTime, {
        ease: FlxEase.cubicIn,
        onComplete: tweenCallback
      });
    /*} else {
      new FlxTimer().start(transitionTime, tweenCallback);
    }*/
  }

  function playMenuMusic():Void
  {
    if (FlxG.sound.music != null) return;
    FunkinSound.playMusic('freakyMenu', {
      overrideExisting: true,
      restartTrack: false,
      persist: true
    });
  }

  function resetCamera(snap:Bool = true, ?cam:FlxCamera, ?follow:FlxObject):Void
  {
    if (cam == null) cam = FlxG.camera;
    if (follow == null) follow = camFollow;

    cam.follow(follow, null, 0.3); // 0.06

    if (snap) cam.snapToTarget();
  }

  function resetCurrentCamera(snap:Bool = true):Void
  {
    resetCamera(snap, activeCamera(), activeCamFollow());
  }

  function activeCamera():FlxCamera
  {
    return currentPage == 0 ? camMain : camExtras;
  }

  function activeCamFollow():FlxObject
  {
    return currentPage == 0 ? camFollow : camFollowExtras;
  }

  override function closeSubState():Void
  {
    super.closeSubState();
  }

  override function update(elapsed:Float):Void
  {
    super.update(elapsed);

    if (!canNavigate || isBusy || isExiting || !FlxG.keys.enabled) return;

    var hadInput:Bool = false;

    // MOUSE/TOUCH HANDLING

    var camMoving:Bool = (Math.abs(activeCamera().scroll.x - (activeCamFollow().x - FlxG.width / 2)) > 1);

    var isTouching:Bool = TouchUtil.justPressed || TouchUtil.justReleased || SwipeUtil.swipeAny;
    var currentMouseX:Float = FlxG.mouse.x;
    var currentMouseY:Float = FlxG.mouse.y;
    if (!isTouching && !blockMouse && FlxG.mouse.justMoved) {
      var t:Float = FlxMath.bound(currentMouseX / FlxG.width, 0, 1);
      var targetX:Float = FlxMath.lerp(minCamX, maxCamX, t);

      activeCamFollow().setPosition(targetX, baseY);
    }

    if (lastMousePos == null) lastMousePos = FlxPoint.get(currentMouseX, currentMouseY);

    // Calcular distância
    var dx:Float = currentMouseX - lastMousePos.x;
    var dy:Float = currentMouseY - lastMousePos.y;
    var mouseDist:Float = Math.sqrt(dx * dx + dy * dy);

    if (FlxG.mouse.justMoved && !isTouching) {
      if (mouseDist > mouseMovementThreshold && !blockMouse) {
        resetIdleTimer();
        mouseHasMoved = true;
      }
      lastMousePos.set(currentMouseX, currentMouseY);
    }

    var justPressed:Bool = (TouchUtil.justPressed || FlxG.mouse.justPressed) && !SwipeUtil.justSwipedAny;
    var justReleased:Bool = TouchUtil.justReleased || FlxG.mouse.justReleased;

    /*if (FlxG.onMobile && TouchUtil != null && !ControlsHandler.usingExternalInputDevice)
    {
      justPressed = TouchUtil.justPressed;
      justReleased = TouchUtil.justReleased;
    }*/

    // Detectar hover/click
    for (i in 0...menuHitboxes.length)
    {
      var hitbox = menuHitboxes[i];

      var isOverlapping:Bool = (FlxG.isMobile && TouchUtil.overlapsComplex(hitbox)) || FlxG.mouse.overlaps(hitbox);

      if (isOverlapping)
      {
        // Aqui usamos FlxG.mouse.justMoved para ter certeza que não vai ter um falso positivo, assim o menu pode voltar para idle normalmente.
        if (!isTouching && mouseHasMoved && FlxG.mouse.justMoved && (i != selectedIndex || !hasSelection))
        {
          selectItem(i, true, false);
          mouseHasMoved = false;
          hadInput = true;
        }

        if (justPressed)
        {
          blockMouse = false; // Mouse teve um input, desbloquear.
          hadInput = true;
          // Se o menu estiver em IDLE (sem seleção) OU o clique for em um item DIFERENTE
          if (!hasSelection || i != selectedIndex) {
            selectItem(i, true, true);
            lastTouchedIndex = i; // Registra qual item recebeu o primeiro toque
          } else {
            // Se já estava selecionado E clicou no MESMO item: CONFIRMA
            confirmSelection();
          }

          // Após um clique, paramos de processar outras hitboxes e inputs globais.
          return;
        }
        break;
      }
    }

    // KEYBOARD/SWIPE HANDLING
    var controls = PlayerSettings.player1.controls;

    var goLEFT = SwipeUtil.justSwipedLeft || controls.UI_LEFT_P || controls.UI_UP_P;
    var goRIGHT = SwipeUtil.justSwipedRight || controls.UI_RIGHT_P || controls.UI_DOWN_P;

    var doSELECT = controls.ACCEPT_P; // also select if we press enter
    var goBACK = controls.BACK_P;
    var goMENU = controls.DEBUG_MENU ?? false;
    var doIDLE = controls.RESET_P;

    if (goLEFT || goRIGHT) {
      blockMouse = true; // Bloquear movimentos do mouse para não interferir.
      hadInput = true;

      // Bloqueia a seleção por hover do mouse até que o usuário mova o mouse de novo.
      mouseHasMoved = false;
      lastMousePos.set(FlxG.mouse.x, FlxG.mouse.y);

      var dir = goLEFT ? -1 : 1;
      var next = selectedIndex + dir;

      if (!hasSelection) {
        selectItem(selectedIndex, true, false);
      } else {
        if (next < 0) next = menuItems.length - 1;
        if (next >= menuItems.length) next = 0;
        selectItem(next, true, false);
      }
    }

    if (doSELECT && hasSelection) {
      hadInput = true;
      confirmSelection();
    }

    if (doIDLE && !camMoving) setIdleState();

    if ((FlxG.keys.justPressed.TAB || SwipeUtil.justSwipedLeft) && RetroSave.isDebug()) openTrophyState();

    if (goBACK) goBack();

    if (!FlxG.onMobile && goMENU) {
      persistentUpdate = false;
      FlxG.state.openSubState(new funkin.ui.debug.DebugMenuSubState());
    }

    // Resetar timer se teve input
    if (hadInput && hasSelection && !isBusy) {
      resetIdleTimer();
    }

  }

  function openTrophyState():Void
  {
    if (isBusy || isExiting) return;
    var time:Float = 0.15;
    FlxTransitionableState.skipNextTransIn = true;
    FlxTransitionableState.skipNextTransOut = true;
    canNavigate = false;
    isBusy = true;
    FlxG.sound.music.fadeOut(time, 0);
    camMain.fade(0xFF262a34, time, false, function() {
      FlxG.switchState(() -> new RetroTrophyState());
    }, true);
  }

  function interactLocked():Void {
    if (isBusy || isExiting) return;
    FunkinSound.playOnce(Paths.sound('menus/no'));
    camMain.shake(0.003, 0.1, null, true);
    camExtras.shake(0.003, 0.1, null, true);
    RetroAchievements.award('misc-nolock', true, true, RetroSave.isDebug());
    isBusy = false;
    canNavigate = true;
    isExiting = false;
  }

  function goBack():Void
  {
    if (isBusy || isExiting || !canNavigate) return;
    if (currentPage == 1) {
      goBackToMain();
      return;
    }

    exitToTitle();
  }

  function exitToTitle():Void
  {
    canNavigate = false;
    rememberedSelectedIndex = selectedIndex;
    FunkinSound.playOnce(Paths.sound('cancelMenu'));

    TitleState.initialized = false; // TitleState does a flash when it is initialized, making the screen appear white when going to the custom title (because it takes a while to load the sprites). So we disable this.
    var fallbackFunc:Dynamic = function():Void {
      FlxG.switchState(() -> new TitleState());
    };

    if (backBtn != null) {
      FlxTween.tween(backBtn, {x: FlxG.width}, 0.1, {ease: FlxEase.expoOut});
    }

    camMain.fade(0xFF000000, 0.1, false, fallbackFunc, true);
  }

  override function destroy():Void
  {
    super.destroy();

    if (lastMousePos != null)
    {
      lastMousePos.put();
      lastMousePos = null;
    }
  }
}
