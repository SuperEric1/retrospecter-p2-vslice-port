import funkin.ui.story.Level;
import funkin.save.Save;
import funkin.ui.freeplay.FreeplayState;

import supereric.retrospecter.modules.RetroUtil;

class GluttonyLevel extends Level
{
  function new()
  {
    super('30-gluttony');
  }

  override function isUnlocked():Bool
  {
    return RetroUtil.hasBeatenWrath();
  }

  override function getSongs():Array<String>
  {
    var list:Array<String> = super.getSongs();

    if (Std.isOfType(FlxG.state.subState, FreeplayState) && !hasBeatenThis())
    {
      list.remove("glunisher");
      list.remove("gutlery");
    }

    return list;
  }

  override function getSongDisplayNames(difficultyId:String):Array<String>
  {
    var list:Array<String> = super.getSongDisplayNames(difficultyId);

    if (!hasBeatenThis())
    {
      list.remove("Gutlery");
      list.push("???");
    }


    return list;
  }

  private function hasBeatenThis():Bool
  {
    for (diff in Constants.DEFAULT_DIFFICULTY_LIST)
    {
      if ((Save.instance.getLevelScore('30-gluttony', diff)?.score ?? 0) > 0) return true;
    }

    return false;
  }
}
