import funkin.ui.story.Level;
import funkin.save.Save;
import funkin.ui.freeplay.FreeplayState;

import supereric.retrospecter.modules.RetroUtil;
import supereric.retrospecter.modules.RetroSave;

class WrathLevelExtras extends Level
{
  function new()
  {
    super('11-wrath_extras');
  }

  override function isUnlocked():Bool
  {
    return true;
  }

  override function getSongs():Array<String>
  {
    var list:Array<String> = super.getSongs();

    if (!RetroSave.isUnlockSongs() && Std.isOfType(FlxG.state.subState, FreeplayState) && !RetroUtil.hasBeatenWrath())
    {
      list.remove("ectospasm");
    }

    return list;
  }
}
