import funkin.ui.story.Level;
import funkin.save.Save;
import funkin.ui.freeplay.FreeplayState;

import supereric.retrospecter.modules.RetroUtil;

class WrathLevel extends Level
{
  function new()
  {
    super('10-wrath');
  }

  override function isUnlocked():Bool
  {
    return true;
  }

  override function getSongs():Array<String>
  {
    var list:Array<String> = super.getSongs();

    if (Std.isOfType(FlxG.state.subState, FreeplayState) && !RetroUtil.hasBeatenWrath())
    {
      list.remove("spectral");
      list.remove("apocalyptro");
      list.remove("catastrofiend");
    }

    return list;
  }

  override function getSongDisplayNames(difficultyId:String):Array<String>
  {
    if (RetroUtil.hasBeatenWrath()) {
      return ["Satisfracture", "Spectral", "Apocalyptro", "Catastrofiend"];
    }
    else {
      return ["Satisfracture", "???"];
    }
  }
}
