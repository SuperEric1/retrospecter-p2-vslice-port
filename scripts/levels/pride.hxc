import funkin.ui.story.Level;
import funkin.save.Save;

class PrideLevel extends Level
{
  function new()
  {
    super('20-pride');
  }

  override function isUnlocked():Bool
  {
    return Save.instance.hasBeatenLevel('10-wrath');
  }

  override function getSongDisplayNames(difficultyId:String):Array<String>
  {
    if (Save.instance.hasBeatenLevel('20-pride'))
    {
      return ["Egobrainiac", "Superbio"];
    }
    else
    {
      return ["?"];
    }
  }
}
