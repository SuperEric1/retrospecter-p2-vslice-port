import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxBasePoint;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.Conductor;
import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.effects.IntervalShake;
import funkin.audio.FunkinSound;
import funkin.play.GameOverSubState;
import funkin.util.ReflectUtil;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;
import funkin.data.song.SongRegistry;
import funkin.play.cutscene.CutsceneType;
import funkin.play.cutscene.VideoCutscene;
import funkin.graphics.shaders.DropShadowShader;
import funkin.play.stage.Stage;
import funkin.play.stage.StageProp;
import funkin.play.PlayStatePlaylist;
import funkin.modding.module.ModuleHandler;
import funkin.graphics.FunkinSprite;
import funkin.util.Constants;
import funkin.ui.FullScreenScaleMode;

import supereric.retrospecter.modules.RetroUtil;

class SpectralSong extends Song
{
  var tweens = [];
  var pausedTweens = [];

  var hasPlayedInGameCutscene:Bool;
  var hasPlayedEndCutscene:Bool;
  var hasStoredStrums:Bool = false;

  var modcharts:Bool = false;
  var isMobile:Bool = false;

  var shakeNoteStrums:Bool = false;
  var shakeHorizontal:Bool = false;
  var shakeHorizontalWeak:Bool = false;
  var shakeHud:Bool = false;
  var sway:Bool = false;
  var crazy:Bool = false;

  var defaultOpponentStrumX:Float = 0;
  var defaultOpponentStrumY:Float = 0;
  var defaultPlayerStrumX:Float = 0;
  var defaultPlayerStrumY:Float = 0;

  public function new()
  {
    super('spectral');
    hasPlayedInGameCutscene = false;
    hasPlayedEndCutscene = false;
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (!PlayStatePlaylist.isStoryMode || playState.isChartingMode) hasPlayedInGameCutscene = true;

    if (!hasPlayedInGameCutscene) {
      hasPlayedInGameCutscene = true;
      event.cancel();

      playState.camHUD.visible = false;

      //buildProps(true);
      //loadSounds();
    }
  }

  override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    if (!hasStoredStrums) {
      hasStoredStrums = true;
      defaultOpponentStrumX = playState.opponentStrumline.x;
      defaultOpponentStrumY = playState.opponentStrumline.y;
      defaultPlayerStrumX = playState.playerStrumline.x;
      defaultPlayerStrumY = playState.playerStrumline.y;
    }
  }

  public function onStepHit(event):Void
  {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGameOverState) return;

    if (!modcharts || !hasStoredStrums) return;

    var step = event.step;

    shakeNoteStrums = (step >= 128 && step < 640) || (step >= 1024 && step < 1528);

    shakeHorizontal = (step >= 640 && step < 768);

    shakeHorizontalWeak = (step >= 768 && step < 1024);

    shakeHud = (step >= 128 && step < 132) || (step >= 1024 && step < 1028);

    sway = (step >= 1536 && step < 1856);
    crazy = sway;

    if (step >= 1528 && step < 1532) {
      tweens.push(FlxTween.tween(PlayState.instance.opponentStrumline, {alpha: 0.1}, (Conductor.instance.stepLengthMs * 5) / 1000, {ease: FlxEase.circOut}));
    }

    if (step == 1857) resetStrumlinePositions();

    if (step == 132 || step == 1028) {
      playState.camHUD.x = 0;
      playState.camHUD.y = 0;
      playState.camGame.x = 0;
      playState.camGame.y = 0;
    }
  }

  public function onUpdate(event):Void
  {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (!modcharts || !hasStoredStrums) return;

    var songPos = Conductor.instance.songPosition;
    var bpm = Conductor.instance.bpm;
    var currentBeat = (songPos / 1000) * (bpm / 60);

    if (shakeHud) {
      playState.camHUD.x = 20 * Math.sin((currentBeat * 10) * Math.PI);
      playState.camHUD.y = 20 * Math.cos((currentBeat * 10) * Math.PI);
      playState.camGame.x = -20 * Math.sin((currentBeat * 10) * Math.PI);
      playState.camGame.y = -20 * Math.cos((currentBeat * 10) * Math.PI);
    }

    if (shakeNoteStrums) {
      playState.opponentStrumline.x = defaultOpponentStrumX + 3 * Math.sin((currentBeat * 10) * Math.PI);
      playState.opponentStrumline.y = defaultOpponentStrumY + 3 * Math.cos((currentBeat * 10) * Math.PI);
      playState.playerStrumline.x = defaultPlayerStrumX + 3 * Math.sin((currentBeat * 10) * Math.PI);
      playState.playerStrumline.y = defaultPlayerStrumY + 3 * Math.cos((currentBeat * 10) * Math.PI);
    }

    if (shakeHorizontal) {
      playState.camHUD.x = 6 * Math.sin((currentBeat * 10) * Math.PI);
      playState.camHUD.y = 0;
      playState.camGame.x = 6 * Math.sin((currentBeat * 10) * Math.PI);
      playState.camGame.y = 0;
    }

    if (shakeHorizontalWeak) {
      playState.camHUD.x = 3 * Math.sin((currentBeat * 10) * Math.PI);
      playState.camHUD.y = 0;
      playState.camGame.x = 3 * Math.sin((currentBeat * 10) * Math.PI);
      playState.camGame.y = 0;
    }

    if (sway) {
      playState.camHUD.angle = 3 * Math.sin(currentBeat);
    }

    if (crazy) {
      playState.opponentStrumline.x = defaultOpponentStrumX - 256 * Math.sin(currentBeat / 5) + 275;
      playState.opponentStrumline.y = defaultOpponentStrumY - 50 * Math.cos(currentBeat);
      if (!isMobile) playState.playerStrumline.x = defaultPlayerStrumX + 256 * Math.sin(currentBeat / 5) - 275;
      playState.playerStrumline.y = defaultPlayerStrumY - (!isMobile ? 50 : 25) * Math.cos(currentBeat);
    }
  }

  override function onDestroy(event):Void
  {
    super.onDestroy(event);
    resetTweens();
    shakeNoteStrums = false;
    shakeHorizontal = false;
    shakeHorizontalWeak = false;
    shakeHud = false;
    hasStoredStrums = false;
    sway = false;
    crazy = false;
  }

  private function resetTweens():Void
  {
    for (tween in tweens)
    {
      if (tween != null) tween.cancel();
    }
    tweens = [];
    pausedTweens = [];
  }

  override function onResume(event):Void
  {
    super.onResume(event);
    for (tween in pausedTweens)
    {
      if (tween != null && !tween.finished) tween.active = true;
    }
    pausedTweens = [];
  }

  override function onPause(event):Void
  {
    super.onPause(event);
    pausedTweens = [];
    for (tween in tweens)
    {
      if (tween != null && !tween.finished)
      {
        tween.active = false;
        pausedTweens.push(tween);
      }
    }
  }

  function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);
    hasPlayedInGameCutscene = true;
    hasPlayedEndCutscene = false;
    shakeNoteStrums = false;
    shakeHorizontal = false;
    shakeHorizontalWeak = false;
    shakeHud = false;
    sway = false;
    crazy = false;
    playState.camHUD.angle = 0;
    playState.camHUD.x = 0;
    playState.camHUD.y = 0;
    playState.camGame.x = 0;
    playState.camGame.y = 0;
    resetStrumlinePositions();
    PlayState.instance.opponentStrumline.alpha = 1;
    resetTweens();
  }

  private function resetStrumlinePositions():Void
  {
    playState.opponentStrumline.x = defaultOpponentStrumX;
    playState.opponentStrumline.y = defaultOpponentStrumY;
    playState.playerStrumline.x = defaultPlayerStrumX;
    playState.playerStrumline.y = defaultPlayerStrumY;
    playState.camHUD.angle = 0;
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    isMobile = true || RetroUtil.isMobileScheme();
    modcharts = Save.instance.modOptions.get('retroModcharts') ?? true;
    hasPlayedInGameCutscene = false;
    hasPlayedEndCutscene = false;
    playState = PlayState.instance;
    playStage = PlayState.instance.currentStage;
    ModuleHandler.getModule('RetroTitle')?.scriptCall('load', ['retro/p2']);
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
