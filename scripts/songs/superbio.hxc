import flixel.addons.display.FlxRuntimeShader;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxBasePoint;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.Conductor;
import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.play.GameOverSubState;
import funkin.util.ReflectUtil;
import funkin.audio.FunkinSound;
import funkin.data.song.SongRegistry;
import funkin.play.cutscene.CutsceneType;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.stage.StageProp;
import funkin.play.PlayStatePlaylist;
import funkin.graphics.FunkinSprite;
import funkin.util.Constants;
import funkin.play.character.CharacterType;
import funkin.modding.module.ModuleHandler;
import funkin.mobile.input.ControlsHandler;
import funkin.ui.FullScreenScaleMode;

import supereric.retrospecter.modules.RetroTransformCutscene;
import supereric.retrospecter.modules.RetroAchievements;
import supereric.retrospecter.modules.RetroUtil;

class SuperbioSong extends Song
{
  var tweens = [];
  var pausedTweens = [];
  var hasPlayedDialogue:Bool = false;
  var hasPlayedCutscene:Bool = false;

  var bgSprite:FunkinSprite;

  public function new()
  {
    super('superbio');
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    izzyPercent = 14;
    didLastThing = false;

    if (!hasPlayedDialogue && PlayStatePlaylist.isStoryMode)
    {
      hasPlayedDialogue = true;
      event.cancel();

      PlayState.instance.camHUD.alpha = 0;

      var rd = ModuleHandler.getModule('RetroDialogue');
      rd.scriptCall('startDialogue', ['superbio story', 'pre', function() {
        PlayState.instance.startCountdown();
        FlxTween.tween(PlayState.instance.camHUD, { alpha: 1 }, 0.5, { ease: FlxEase.quadIn });
      }]);
    }
  }

  public function onStepHit(event) {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
		if (PlayState.instance.isGameOverState) return;

    if (event.step == 400) {
      FlxG.camera.flash(0xFFFFFFFF, 1.2);
    }
  }

  override function onDestroy(event)
	{
		super.onDestroy(event);
		resetTweens();
    hasPlayedDialogue = false;
    hasPlayedCutscene = false;
	}

	private function resetTweens()
	{
		for (tween in tweens)
		{
			if (tween != null)
				tween.cancel();
		}
		tweens = [];
		pausedTweens = [];
	}

	override function onResume(event)
	{
		super.onResume(event);
		for (tween in pausedTweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = true;
			}
		}
		pausedTweens = [];
	}

	override function onPause(event)
	{
		super.onPause(event);
		pausedTweens = [];
		for (tween in tweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
	}
  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);

    if (!PlayStatePlaylist.isStoryMode) hasPlayedCutscene = true;

    if (!hasPlayedCutscene) {
      RetroTransformCutscene.play([playStage.getBoyfriend(), playStage.getGirlfriend()], 0xFF6ef9e2, true, true, function() {
        var rd = ModuleHandler.getModule('RetroDialogue');
        rd.scriptCall('startDialogue', ['superbio story', 'finish', function() {
          PlayState.instance.mayPauseGame = true;
          PlayState.instance.endSong(true);
        }]);
      });

      hasPlayedCutscene = true;
      event.cancel();
      return;
    }

    if (PlayStatePlaylist.isStoryMode) {
      var diff = PlayState.instance.currentDifficulty.toLowerCase();
      if (diff == 'hard') {
        RetroAchievements.grantAc('pride-hell');
      }

      if (diff == 'normal' || diff == 'hard') {
        RetroAchievements.grantAc('pride-hard');
      }

      RetroAchievements.grantAc('pride-normal');
    }
  }

  // Load custom notestyle.
	// TODO: Move this somewhere else.
  public override function onSongLoaded(event:ScriptEvent):Void {
		super.onSongLoaded(event);

    var strum = PlayState.instance.opponentStrumline;

    /*var downscroll = Preferences.downscroll;
    if (RetroUtil.isMobileScheme()) downscroll = true;*/
    var strumStyle:String = 'pride' /*+ (downscroll ? 'down' : 'up')*/;

    if (strum != null && strum.noteStyle.id == strumStyle) return; // already applied.

    ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('setStyle', [CharacterType.DAD, strumStyle]);
    ModuleHandler.getModule('RetroNoteStyles')?.scriptCall('applyCustomNoteStyles', []);
	}

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    playState = PlayState.instance;
    playStage = PlayState.instance.currentStage;
  }

	public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
