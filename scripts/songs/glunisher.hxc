import flixel.FlxG;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.modding.module.ModuleHandler;
import funkin.save.Save;

import supereric.retrospecter.modules.RetroTransformCutscene;

class GlunisherSong extends Song
{
  var hasPlayedInGameCutscene:Bool;
  var hasPlayedCutscene:Bool;
  var showLogo:Bool = false;

  public function new()
  {
    super('glunisher');

    hasPlayedInGameCutscene = false;
    hasPlayedCutscene = false;
    showLogo = false;
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    hasPlayedInGameCutscene = false;
    hasPlayedCutscene = false;
    showLogo = false;
    ModuleHandler.getModule('RetroTitle')?.scriptCall('load', ['insatian', true]);
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (!PlayStatePlaylist.isStoryMode || PlayState.instance.isChartingMode) hasPlayedInGameCutscene = true;

    if (!hasPlayedInGameCutscene) {
      hasPlayedInGameCutscene = true;
      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camHUD.alpha = 0;

      var rd = ModuleHandler.getModule('RetroDialogue');
      rd.scriptCall('startDialogue', ['glunisher story', 'pre', function() {
        PlayState.instance.startCountdown();
        FlxTween.tween(PlayState.instance.camHUD, { alpha: 1 }, 0.5, { ease: FlxEase.quadIn });
      }]);
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var curStep = event.step;

    // Start enemy title animation (story mode)
    if (curStep >= 144 && !showLogo) {
      showLogo = true;
      ModuleHandler.getModule('RetroTitle')?.scriptCall('play', []);
    }
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);

    if (!PlayStatePlaylist.isStoryMode) hasPlayedCutscene = true;

    if (!hasPlayedCutscene) {
      RetroTransformCutscene.play([PlayState.instance.currentStage.getBoyfriend(), PlayState.instance.currentStage.getGirlfriend()], 0xFFab164a, true);
      hasPlayedCutscene = true;
      event.cancel();
    }
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
