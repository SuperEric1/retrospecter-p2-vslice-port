class EgobrainiacSong extends Song
{
  var tweens = [];
  var pausedTweens = [];

  var isMobile:Bool;
  var ogStrumsX:Array<Float> = [];
  var ogStrumsY:Array<Float> = [];
  var ogOppStrumsX:Array<Float> = [];
  var ogOppStrumsY:Array<Float> = [];
  var ogLaneX:Float;
  var ogOppLaneX:Float;
  var ogOppLaneY:Float;

  var izzyPercent = 14;
  var didLastThing:Bool = false;

  var transformationSprite:FunkinSprite;

  // Beats para interrupções
  var interruptionBeatsStart:Array<Int> = [544, 560, 570, 581, 591, 599];
  var interruptionBeatsRetry:Array<Int> = [551, 567, 577, 588, 596, 605];

  public function new()
  {
    super('egobrainiac');
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    izzyPercent = 14;
    didLastThing = false;

  }

  public override function onNoteGhostMiss(event:GhostMissNoteScriptEvent):Void {
    super('onNoteGhostMiss');
    if (izzyPercent > 15 || didLastThing) {
      event.cancel();
      event.stopPropagation();
      return;
    }
  }

  public override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance == null) return;

    var curBeat = event.beat;

    cleanFinishedTweens();

    // Verifica se o beat atual está no array de beats de start
    if (interruptionBeatsStart.contains(curBeat)) {
      if (curBeat == 544) {
        // Define a câmera como forçada no boyfriend
        playState.cameraFollowPoint.setPosition(playStage.getBoyfriend().cameraFocusPoint.x, playStage.getBoyfriend().cameraFocusPoint.y);
      }
      doThing();
    }

    if (interruptionBeatsRetry.contains(curBeat)) {
      undoThing();
    }
  }

  public function onStepHit(event) {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    var downscroll = Preferences.downscroll;
    if(isMobile) downscroll = true;
    final amplification:Float = (FlxG.width / FlxG.height) / (FlxG.initialWidth / FlxG.initialHeight);
    final playerStrumlineScale:Float = ((FlxG.height / FlxG.width) * 1.95) * amplification;
    final playerNoteSpacing:Float = ((FlxG.height / FlxG.width) * 2.8) * amplification;

    if (event.step == 2178) {
      playStage.getBoyfriend().danceEvery = 0;
    }
    if (event.step == 2242) {
      playStage.getBoyfriend().idleSuffix = '-alt';
      playStage.getBoyfriend().danceEvery = 1;
    }

    // ultimo
    if (event.step >= 2432 && didLastThing == false) {
      didLastThing = true;
      izzyPercent = 101;
      doThing();

      FlxG.camera.flash(0xFF9CFFF7, 1);
      //playState.opponentStrumline.visible = true;
      playStage.getBoyfriend().idleSuffix = '-angry';

      tweens.push(FlxTween.tween(playState.playerStrumline, {alpha: 0}, 2, {ease: FlxEase.linear}));
      if (downscroll) {
        tweens.push(FlxTween.tween(playState.playerStrumline, {y: FlxG.height + 100}, 1.5, {ease: FlxEase.quadInOut}));
      } else {
        tweens.push(FlxTween.tween(playState.playerStrumline, {y: playState.playerStrumline.y - 100}, 1.5, {ease: FlxEase.quadInOut}));
      }

      // notas
      var izzy = izzyPercent / 100;
      if (isMobile) {
        tweens.push(FlxTween.tween(playState.opponentStrumline, {x: ogOppLaneX + 256 * izzy}, 2, {ease: FlxEase.backOut}));
        tweens.push(FlxTween.tween(playState.playerStrumline, {x: ogLaneX + (150 + FlxG.random.int(-50,50))}, 0.75, {ease: FlxEase.cubeOut}));
      }
      for (i in 0...4) {
        var note = playState.playerStrumline.strumlineNotes.members[i];
        if (note == null) continue;

        if (!isMobile) tweens.push(FlxTween.tween(note, {x: ogStrumsX[i] + (200 + FlxG.random.int(10,50))}, 0.75, {ease: FlxEase.cubeOut}));
        tweens.push(FlxTween.tween(note, {y: ogStrumsY[i] + 72 + FlxG.random.int(-80,80)}, 0.75, {ease: FlxEase.cubeOut}));
        tweens.push(FlxTween.tween(note, {alpha: 0}, 0.6, {ease: FlxEase.quadOut}));
        tweens.push(FlxTween.tween(note, {angle: FlxG.random.int(-180,180)}, 0.9, {ease: FlxEase.cubeOut}));
        tweens.push(FlxTween.tween(note.scale, {x: 0.4, y: 0.4}, 0.75, {ease: FlxEase.cubeOut}));
      }
    }
  }

  function doThing() {
    if (playState == null || playState.playerStrumline == null || playState.opponentStrumline == null) return;

    var izzy = izzyPercent / 100;
    tweens.push(FlxTween.tween(playState.playerStrumline, {alpha: 0}, 0.7, {ease: FlxEase.backOut}));

    if (isMobile) {
      tweens.push(FlxTween.tween(playState.opponentStrumline, {y: ogOppLaneY + 326 * izzy}, 0.5, {ease: FlxEase.backOut}));
    } else {
      tweens.push(FlxTween.tween(playState.opponentStrumline, {x: ogOppLaneX + 316 * izzy}, 0.5, {ease: FlxEase.backOut}));
    }
    izzyPercent += 16;

    // ---- ANTIGO ----
    /*for (i in 0...4) {
      // jogador
      if (izzyPercent != 101) {
        tweens.push(FlxTween.tween(playState.playerStrumline, {alpha: 0.1}, 0.7, {ease: FlxEase.backOut}));

        // Removido pq tava dando problema, mas funciona praticamente igual o mod original
        var note = playState.playerStrumline.strumlineNotes.members[i];
        if (note == null) continue;

        tweens.push(FlxTween.tween(note, {x: ogStrumsX[i] + (180 + i * -30) * izzy}, 0.5, {ease: FlxEase.backOut}));
        tweens.push(FlxTween.tween(note, {y: ogStrumsY[i] + 64 * izzy}, 0.5, {ease: FlxEase.backOut}));
        tweens.push(FlxTween.tween(note, {alpha: 0}, 0.5, {ease: FlxEase.backOut}));
        tweens.push(FlxTween.tween(note.scale, {x: 0.7 - 0.2 * izzy, y: 0.7 - 0.2 * izzy}, 0.5, {ease: FlxEase.backOut}));
      }
      // oponente
      var oppNote = playState.opponentStrumline.strumlineNotes.members[i];
      if (oppNote == null) continue;

      tweens.push(FlxTween.tween(oppNote, {x: ogOppStrumsX[i] + 316 * izzy}, 0.5, {ease: FlxEase.backOut}));
    }*/
  }

  function undoThing() {
    if (playState == null || playState.playerStrumline == null || playState.opponentStrumline == null) return;

    var izzy = izzyPercent / 50;

    tweens.push(FlxTween.tween(playState.playerStrumline, {alpha: 1}, 0.5, {ease: FlxEase.quadOut}));
    if (isMobile) {
      tweens.push(FlxTween.tween(playState.opponentStrumline, {y: ogOppLaneY}, 0.5, {ease: FlxEase.quadOut}));
    } else {
      tweens.push(FlxTween.tween(playState.opponentStrumline, {x: ogOppLaneX}, 0.5, {ease: FlxEase.quadOut}));
    }

    // Removido pq tava dando problema, mas funciona igual o mod original
    /*for (i in 0...4) {
      // Jogador - volta para posições originais
      var note = playState.playerStrumline.strumlineNotes.members[i];
      if (note == null) continue;

      tweens.push(FlxTween.tween(note, {x: ogStrumsX[i]}, 0.5 + izzy, {ease: FlxEase.quadOut}));
      tweens.push(FlxTween.tween(note, {y: ogStrumsY[i]}, 0.5 + izzy, {ease: FlxEase.quadOut}));
      tweens.push(FlxTween.tween(note, {alpha: 1}, 0.5, {ease: FlxEase.quadOut}));
      tweens.push(FlxTween.tween(note.scale, {x: 0.7, y: 0.7}, 0.5 + izzy, {ease: FlxEase.quadOut}));

      // Oponente - volta para posições originais
      var oppNote = playState.opponentStrumline.strumlineNotes.members[i];
      if (oppNote == null) continue;

      tweens.push(FlxTween.tween(oppNote, {x: ogOppStrumsX[i]}, 0.5 + izzy, {ease: FlxEase.quadOut}));
    }*/
  }

  override function onDestroy(event)
	{
		super.onDestroy(event);
		resetTweens();
		didLastThing = false;
	}

	private function resetTweens()
	{
		for (tween in tweens)
		{
			if (tween != null)
				tween.cancel();
		}
		tweens = [];
		pausedTweens = [];
	}

	private function cleanFinishedTweens()
	{
		// Remove tweens finalizados do array
		var i = tweens.length - 1;
		while (i >= 0)
		{
			if (tweens[i] == null || tweens[i].finished)
			{
				tweens.splice(i, 1);
			}
			i--;
		}
	}

	override function onResume(event)
	{
		super.onResume(event);
		for (tween in pausedTweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = true;
			}
		}
		pausedTweens = [];
	}

	override function onPause(event)
	{
		super.onPause(event);
		// Limpa tweens finalizados antes de pausar
		cleanFinishedTweens();
		pausedTweens = [];
		for (tween in tweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
	}
  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    resetTweens();
    izzyPercent = 14;

    if (didLastThing == true) FlxG.resetState(); // resetar tudo de uma vez caso num tenha mais oq fazer pra resetar

    //playState.playerStrumline.x = ogLaneX;
    //playStage.getBoyfriend().idleSuffix = '-alt';
    //playStage.getBoyfriend().danceEvery = 1;
    //playState.playerStrumline.alpha = 1;
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    didLastThing = false;
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
    if (PlayState.instance == null) return;
    isMobile = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;

    // salvar posicao real dos strums para os efeitos.
    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
      if (ogStrumsX[i] == null && ogStrumsY[i] == null) {
        ogStrumsX.push(strum.x);
        ogStrumsY.push(strum.y);
      }

      strum = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
      ogLaneX = PlayState.instance.playerStrumline.x;
      ogOppLaneX = PlayState.instance.opponentStrumline.x;
      ogOppLaneY = PlayState.instance.opponentStrumline.y;
      if (ogOppStrumsX[i] == null && ogOppStrumsY[i] == null) {
        ogOppStrumsX.push(strum.x);
        ogOppStrumsY.push(strum.y);
      }
    }
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    playState = PlayState.instance;
    playStage = PlayState.instance.currentStage;
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
