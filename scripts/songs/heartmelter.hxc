import flixel.FlxG;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.graphics.FunkinSprite;
import funkin.modding.module.ModuleHandler;
import funkin.save.Save;

class HeartmelterSong extends Song
{
  var hasPlayedDialogue:Bool = false;
  var hasPlayedCutscene:Bool = true;

  var smokeColor = 0xFF90126b;

  var smoke:FunkinSprite;
  var smokeBlend:FunkinSprite;

  public function new()
  {
    super('heartmelter');
    hasPlayedDialogue = false;
    hasPlayedCutscene = true;
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    hasPlayedDialogue = false;
    hasPlayedCutscene = true;

    if (PlayStatePlaylist.isStoryMode) {
      hasPlayedCutscene = false;

      smoke = FunkinSprite.create(-1000, -700).makeSolidColor(5000, 3300, smokeColor);
      smoke.scrollFactor.set(0, 0);
      smoke.alpha = 0;
      smoke.zIndex = 600;
      PlayState.instance.currentStage.add(smoke);

      smokeBlend = FunkinSprite.create(-1000, -700).makeSolidColor(5000, 3300, smokeColor);
      smokeBlend.scrollFactor.set(0, 0);
      smokeBlend.alpha = 0;
      smokeBlend.blend = 0;
      smokeBlend.zIndex = smoke.zIndex - 1;
      PlayState.instance.currentStage.add(smokeBlend);

      PlayState.instance.camGame.bgColor = smokeColor;
    }
  }

  override function onCountdownStart(event:ScriptEvent):Void
  {
    super.onCountdownStart(event);
    if (!PlayStatePlaylist.isStoryMode) hasPlayedDialogue = true;

    if (!hasPlayedDialogue)
    {
      hasPlayedDialogue = true;
      event.cancel();

      PlayState.instance.camHUD.alpha = 0;

      var rd = ModuleHandler.getModule('RetroDialogue');
      rd.scriptCall('startDialogue', ['heartmelter story', 'pre', function() {
        PlayState.instance.startCountdown();
        PlayState.instance.cameraFollowPoint.setPosition(PlayState.instance.currentStage.getDad().cameraFocusPoint.x, PlayState.instance.currentStage.getDad().cameraFocusPoint.y);
        FlxTween.tween(PlayState.instance.camHUD, { alpha: 1 }, 0.5, { ease: FlxEase.quadIn });
        PlayState.instance.tweenCameraZoom(PlayState.instance.stageZoom, 0.5, true, FlxEase.circOut);
      }]);
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var step:Int = event.step;

    if (!hasPlayedCutscene && step >= 1344) {
      hasPlayedCutscene = true;
      PlayState.instance.mayPauseGame = false;
      PlayState.instance.isInCutscene = true;

      FlxTween.tween(smoke, { alpha: 1 }, 3, { onComplete: function(t:FlxTween) {
        PlayState.instance.mayPauseGame = true;
        PlayState.instance.isInCutscene = false;
        PlayState.instance.endSong(true);
      }});
      FlxTween.tween(smokeBlend, { alpha: 1 }, 3);

      if (PlayState.instance.camControls != null) PlayState.instance.camControls.visible = false;
    }

  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    hasPlayedDialogue = false;
    hasPlayedCutscene = false;
    FlxG.camera.bgColor = 0xFF000000;
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
