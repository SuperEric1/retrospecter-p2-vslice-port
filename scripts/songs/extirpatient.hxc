import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxMath;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.Conductor;
import funkin.Preferences;
import funkin.FunkinMemory;
import funkin.mobile.input.ControlsHandler;
import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.graphics.FunkinSprite;
import funkin.save.Save;

class ExtirpatientSong extends Song
{
  var tweens = [];
  var pausedTweens = [];

  // Flags
  var f:Bool = false;
  var q:Bool = false;
  var qe:Bool = false;
  var qt:Bool = false;
  var qtt:Bool = false;
  var aq:Bool = false;
  var ae:Bool = false;
  var b:Bool = false;
  var p:Bool = false;
  var g:Bool = false;
  var c:Bool = false;
  var d:Bool = false;

  var toggledShove:Bool = false;
  var isDownScroll:Bool = false;
  var isMobile:Bool = false;
  var trulyBeats:Int = 0;
  var shakeTime:Float = 0;
  var negativity:Int = 1;
  var toggledToll:Bool = false;
  var testValue:Float = -0.25;
  var songEnded:Bool = false;
  var modcharts:Bool = true;
  var flashingLights:Bool = true;
  var flash:FunkinSprite;
  var hasStoredStrums = false;

  var flashyBits:Array<Int> = [79, 143, 171, 199, 279, 311, 339, 367];
  var zoomBeats:Array<Int> = [415, 447, 479, 511, 543, 575, 607, 639, 671];

  var savedValOverlay:Float = 167.5;
  var savedValBars:Float = 210.5;

  // Red pulse intensity
  var redPulseIntensity:Float = 0.0;

  // Store default strum positions
  var defaultOpponentStrumX:Array<Float> = [];
  var defaultOpponentStrumY:Array<Float> = [];
  var defaultPlayerStrumX:Array<Float> = [];
  var defaultPlayerStrumY:Array<Float> = [];
  var ogPlayerStrumScales:Array<Float> = [];
  var ogOppStrumScales:Array<Float> = [];

  // lesserModchart variables
  var easingValueX:Float = 1;
  var easingValueY:Float = 1;
  var arrowIndex:Int = 0;
  var arrowX:Float = 0;
  var arrowY:Float = 0;
  var arrowFlipped:Bool = false;
  var pulseNumber:Int = 1;
  var pulseDir:Int = 1;
  var warningArrows:Array<FlxSprite> = [];

  // Scythe variables (tricky mechanic)
  var scythe:FunkinSprite;
  var scythe2:FunkinSprite;
  var draining:Bool = false;
  var scytheActive:Bool = false;
  var scythePushed:Bool = false;
  var scytheActive2:Bool = false;
  var scytheIncrease:Float = 0;
  var toting:Bool = false;

  public function new()
  {
    super('extirpatient');
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    hasStoredStrums = false;

    playState = PlayState.instance;
    playStage = PlayState.instance.currentStage;
    modcharts = Save.instance.modOptions.get('retroModcharts');
    flashingLights = Preferences.flashingLights;

    // For testing purposes
    /*if (FlxG.onMobile) {
      // jump to tricky
      playState.startTimestamp = 263000;
    }*/

    // Check if downscroll
    isDownScroll = Preferences.downscroll;
    if (FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) isDownScroll = true;

    isMobile = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;

    negativity = isDownScroll ? -1 : 1;

    flash = FunkinSprite.create();
    flash.makeGraphic(5000, 3000, 0xFFFFFFFF);
    flash.scrollFactor.set(0, 0);
    flash.screenCenter();
    flash.cameras = [PlayState.instance.camGame];
    flash.visible = false;
    flash.active = false;
    PlayState.instance.add(flash, 'customFlash');

    // Build scythe elements
    setupScytheElements();

    PlayState.instance.refresh();

    // Reset flags
    resetFlags();

    // Cache 80sNightflaid character
    FunkinMemory.cacheTexture(Paths.image('characters/others/80sNightflaid', "shared"));
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);

    // Store default strum positions
    if (!hasStoredStrums) storeDefaultStrumPositions();
  }

  public override function onCountdownStart(event:ScriptEvent):Void
  {
    super.onCountdownStart(event);

    // Initial camera position if song just started
    if (Conductor.instance.songPosition < 100) {
      var dad = PlayState.instance.currentStage.getDad();
      PlayState.instance.currentCameraZoom = 0.6;
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 300, dad.cameraFocusPoint.y - 200);
      // PlayState.instance.camHUD.alpha = 0;
      PlayState.instance.healthBar.alpha = 0;
      PlayState.instance.iconP1.alpha = 0;
      PlayState.instance.iconP2.alpha = 0;
      PlayState.instance.playerStrumline.alpha = 0;
      PlayState.instance.opponentStrumline.alpha = 0;
    }
  }

  function storeDefaultStrumPositions():Void
  {
    if (PlayState.instance == null) return;
    hasStoredStrums = true;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        defaultOpponentStrumX.push(strum.x);
        defaultOpponentStrumY.push(strum.y);
        ogOppStrumScales.push(strum.scale.x);
        ogOppStrumScales.push(strum.scale.y);
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        defaultPlayerStrumX.push(strum.x);
        defaultPlayerStrumY.push(strum.y);
        ogPlayerStrumScales.push(strum.scale.x);
        ogPlayerStrumScales.push(strum.scale.y);
      }
    }
    defaultPlayerStrumX.push(playerStrums.x);
    defaultPlayerStrumY.push(playerStrums.y);
    defaultOpponentStrumX.push(opponentStrums.x);
    defaultOpponentStrumY.push(opponentStrums.y);
  }

  public override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    if (!hasStoredStrums) return;

    trulyBeats++;
    var curBeat = event.beat;
    var crochet = Conductor.instance.stepLengthMs * 4;

    // Ajustes de beat
    if (curBeat == 144 || curBeat == 172 || curBeat == 312 || curBeat == 340 || curBeat == 368) {
      trulyBeats = curBeat;
    }

    // Commits de beat
    if (curBeat >= 16 && curBeat < 864) {
      commitABeat(trulyBeats);
    }

    // Flashy bits
    for (v in flashyBits) {
      if (curBeat == v) {
        playState.camHUD.zoom = 1;
        playState.camGame.zoom = 0.34;
        tweens.push(FlxTween.tween(playState.camHUD, {zoom: 1.08}, crochet / 1000, {ease: FlxEase.expoIn}));
        tweens.push(FlxTween.tween(playState.camGame, {zoom: 0.36}, crochet / 1000, {ease: FlxEase.expoIn}));
      }
      if (curBeat == v + 1) {
        // Cancel tweens
        for (tween in tweens) {
          if (tween != null && !tween.finished) tween.cancel();
        }

        // Add camera zoom
        playState.camGame.zoom += 0.025;
        playState.camHUD.zoom += 0.025;

        // Flash effect
        if (flashingLights) {
          createFlash(0xFFFF0000, 0.3);
        }
      }
    }

    if (curBeat == 1) {
      var dad = playStage.getDad();
      playState.tweenCameraZoom(0.55, 1, true, FlxEase.expoOut);

      var markiplier = isDownScroll ? 1 : -1;
      for (i in 0...4) {
        var strum = playState.playerStrumline.strumlineNotes.members[i];
        strum.y = FlxG.height + 300 * markiplier;

        strum = playState.opponentStrumline.strumlineNotes.members[i];
        strum.y = !isMobile ? FlxG.height + 300 * markiplier : -300;
      }
      playState.playerStrumline.alpha = 1;
      playState.opponentStrumline.alpha = 1;
    }

    if (curBeat == 6) {
      var dad = playStage.getDad();
      playState.tweenCameraZoom(0.5, crochet / 250, true, FlxEase.sineOut);
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x + 100, playStage.getBoyfriend().cameraFocusPoint.y);
    }

    if (curBeat == 12) {
      var dad = playStage.getDad();
      playState.tweenCameraZoom(playState.stageZoom, crochet / 250, true, FlxEase.quartIn);
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x + 170, playStage.getBoyfriend().cameraFocusPoint.y);

      for (i in 0...4) {
        new FlxTimer().start(0.4 * i, function(tmr) {
          animateStrumUp(i);
        });
      }
    }

    if (curBeat == 15) {
      FlxTween.tween(playState.camHUD, {zoom: 1.1}, crochet / 1000, {ease: FlxEase.expoIn});
      FlxTween.tween(playState.healthBar, {alpha: 1}, crochet / 1000, {ease: FlxEase.expoIn});
      FlxTween.tween(playState.iconP1, {alpha: 1}, crochet / 1000, {ease: FlxEase.expoIn});
      FlxTween.tween(playState.iconP2, {alpha: 1}, crochet / 1000, {ease: FlxEase.expoIn});
    }

    if (curBeat == 16) {
      for (tween in tweens) {
        if (tween != null && !tween.finished) tween.cancel();
      }

      playState.camGame.zoom += 0.05;
      playState.camHUD.zoom += 0.05;

      if (flashingLights) {
        createFlash(0xFFFF0000, 0.5);
      }
    }

    // LESSERMODCHART BEAT EVENTS

    // Setas de aviso
    /*if (curBeat == 642 || curBeat == 650) {
      if (PlayState.instance.playerStrumline != null) {
        var playerStrums = PlayState.instance.playerStrumline.strumlineNotes.members;
        createFunnyWarning(playerStrums[3].x, playerStrums[0].y - 50 * negativity, false);
      }
    } else if (curBeat == 646) {
      if (PlayState.instance.playerStrumline != null) {
        var playerStrums = PlayState.instance.playerStrumline.strumlineNotes.members;
        createFunnyWarning(playerStrums[3].x - 50, playerStrums[0].y + 75 * negativity, true);
      }
    }*/

    // Easing values
    if (curBeat == 200 || curBeat == 368) {
      tweenEasingValue('easingValueX', 0, 1);
    }

    if (curBeat == 224 || curBeat == 392) {
      tweenEasingValue('easingValueY', 0, 0.75);
      var bf = playStage.getBoyfriend();
      playState.cameraFollowPoint.setPosition(bf.cameraFocusPoint.x - 200, bf.cameraFocusPoint.y - 400);
    }

    // Zooms progressivos de câmera
    if (curBeat == 224 || curBeat == 227 || curBeat == 230 || curBeat == 233 ||
        curBeat == 395 || curBeat == 398 || curBeat == 401) {
      var followPoint = playState.cameraFollowPoint;
      followPoint.setPosition(followPoint.x + 15, followPoint.y + 15);

      var newZoom = playState.currentCameraZoom + 0.02;
      playState.tweenCameraZoom(newZoom, 0.5, true, FlxEase.cubeOut);
    }

    if (curBeat == 236 || curBeat == 404) {
      var followPoint = playState.cameraFollowPoint;
      followPoint.setPosition(followPoint.x + 15, followPoint.y + 15);

      var newZoom = playState.currentCameraZoom + 0.06;
      playState.tweenCameraZoom(newZoom, crochet / 1000 * 6, true, FlxEase.quadOut);
    }

    if (curBeat == 242 || curBeat == 410) {
      var followPoint = playState.cameraFollowPoint;
      followPoint.setPosition(followPoint.x - 50, followPoint.y - 50);

      var newZoom = playState.currentCameraZoom - 0.05;
      playState.tweenCameraZoom(newZoom, crochet / 1000 * 3, true, FlxEase.quadOut);
    }

    if (curBeat == 245) {
      tweenEasingValue('easingValueX', 1, 2);
      tweenEasingValue('easingValueY', 1, 2);

      playState.tweenCameraZoom(0.34, crochet / 332, true, FlxEase.quartIn);
    }

    if (curBeat == 247 || curBeat == 415) {
      FlxTween.tween(playState.camHUD, {zoom: 1.1}, crochet / 1000, {ease: FlxEase.expoIn});
    }

    if (curBeat == 248) {
      if (flashingLights) {
        createFlash(0xFFFF0000, 0.3);
      }
      playState.camGame.zoom += 0.1;
      playState.camHUD.zoom += 0.05;
    }

    if (curBeat == 413) {
      tweenEasingValue('easingValueX', 1, 2);
      tweenEasingValue('easingValueY', 1, 2);

      var dad = playStage.getDad();
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x, dad.cameraFocusPoint.y);

      playState.tweenCameraZoom(0.34, crochet / 332, true, FlxEase.quartIn);
    }

    if (curBeat == 416) {
      playState.camGame.zoom += 0.1;
      playState.camHUD.zoom += 0.06;
    }
    // END LESSERMODCHART BEAT EVENTS

    // Beat 580: Start scythe2 movement
    if (curBeat == 580) {
      scytheActive = true;
      if (!scythe2.alive) scythe2.revive();
      scythe2.visible = true;
    }

    // Stop scythe2 movement
    if (curBeat == 586) {
      scytheActive = false;
      if (scythe2 != null) {
        FlxTween.tween(scythe2, {x: FlxG.width + (scythe2.width / 2)}, 0.5, {ease: FlxEase.backOut});
        if (scythe2.colorTransform != null) {
          FlxTween.tween(scythe2.colorTransform, {
            redOffset: 200,
            greenOffset: -255,
            blueOffset: -255
          }, 0.5, {ease: FlxEase.quadOut});
        }
      }
    }

    // Beat 580-586: Oscillate scythe2
    if (scytheActive && scythe2 != null) {
      scythePushed = !scythePushed;
      FlxTween.tween(scythe2, {x: scythePushed ? (playState.playerStrumline.x + 100) : (defaultPlayerStrumX[3] + 20)}, 0.5, {ease: FlxEase.backOut});
    }

    // Scythe appears and clashes
    if (curBeat == 588 && scythe != null) {
      if (!scythe.alive) scythe.revive();
      scythe.visible = true;
      FlxTween.tween(scythe, {
        y: isDownScroll ? playState.healthBar.y + 70 : playState.healthBar.y - 160,
        angle: isDownScroll ? -205 : 25,
        alpha: 1
      }, 1, {
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          scytheClash();
        }
      });

      if (scythe.colorTransform != null) {
        FlxTween.tween(scythe.colorTransform, {
          redOffset: 0,
          greenOffset: 0,
          blueOffset: 0
        }, 1.5, {ease: FlxEase.quadOut});
      }
    }

    // Scythe2 spin effect
    if (curBeat == 594 && scythe2 != null) {
      var isM = false;
      scytheActive2 = true;
      scythe2.angle = 0;
      scythe2.x = playState.playerStrumline.x - 50; // 700
      if (isM) scythe2.screenCenter(0x01);
      scythe2.y = isDownScroll ? -350 : 600;

      if (isDownScroll) {
        scythe2.origin.y = 0;
        scythe2.flipY = true;
      }

      scythe2.scale.set((!isM) ? 0.8 : 1, (!isM) ? 0.8: 1);
      scythe2.updateHitbox();

      FlxTween.tween(scythe2, {y: isDownScroll ? -100 : 330}, 1, {
        ease: FlxEase.backOut,
        onComplete: function(twn:FlxTween) {
          toggleScytheSpin();
        }
      });

      if (scythe2.colorTransform != null) {
        FlxTween.tween(scythe2.colorTransform, {
          redOffset: 0,
          greenOffset: 0,
          blueOffset: 0
        }, 0.5, {ease: FlxEase.quadOut});
      }
    }

    // Remove scythes
    if (curBeat == 606) {
      scytheActive2 = false;
      toting = false;

      if (scythe2 != null) {
        FlxTween.tween(scythe2, {
          y: isDownScroll ? -150 : 400,
          alpha: -0.1
        }, 0.75, {ease: FlxEase.sineOut, onComplete: function (_) {
          scythe2.kill();
        }});

        if (scythe2.colorTransform != null) {
          FlxTween.tween(scythe2.colorTransform, {
            redOffset: 200,
            greenOffset: -255,
            blueOffset: -255
          }, 0.5, {ease: FlxEase.quadOut});
        }
      }

      if (scythe != null) {
        FlxTween.tween(scythe, {
          y: playState.healthBar.y + (isDownScroll ? -260 : -70),
          alpha: -0.1,
          angle: isDownScroll ? -95 : -85
        }, 0.75, {ease: FlxEase.sineOut, onComplete: function (_) {
          scythe2.kill();
        }});

        scythe.offset.x = -25;

        if (scythe.colorTransform != null) {
          FlxTween.tween(scythe.colorTransform, {
            redOffset: 200,
            greenOffset: -255,
            blueOffset: -255
          }, 0.5, {ease: FlxEase.quadOut});
        }
      }

      draining = false;
    }
    // END SCYTHE EFFECTS

    if (curBeat == 448) {
      // Camera shake adjustments would go here
    }

    // Flip mechanics (beats 607-608)
    if (curBeat == 607 && modcharts) {
      //flipStrumlines(true);
    }

    if (curBeat == 608 && modcharts) {
      //applyFlipTransform();
    }

    // Unflip mechanics (beats 639-640)
    if (curBeat == 639 && modcharts) {
      //flipStrumlines(false);
    }

    if (curBeat == 640 && modcharts) {
      //revertFlipTransform();
    }

    if (curBeat == 512 && modcharts) {
      resetStrumPositions();
    }

    if (curBeat == 543 && modcharts) {
      toggledShove = true;
      //shoveStrumsInitial();
    }

    handleSwap(curBeat);
  }

  public override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    if (!hasStoredStrums) return;

    var curStep = event.step;
    var curBeat = Conductor.instance.currentBeat;

    // Red pulses
    var redPulseSteps = [50, 53, 56, 306, 309, 312, 562, 565, 568, 980, 984, 1652, 1656, 3442, 3445, 3448];
    for (step in redPulseSteps) {
      if (curStep == step) {
        redPulse();
      }
    }

    // Piano pulse effect
    if (curStep % 2 == 0 && ((curBeat >= 200 && curBeat < 224) || (curBeat >= 368 && curBeat < 392))) {
      doPulsePiano();
    }

    // Subtitle events
    if (curStep >= 5 && !qe) {
      qe = true;
      // setSubtitle("Hahahaha...");
    }

    if (curStep >= 26 && !qt) {
      qt = true;
      // setSubtitle("Well well, look at you.");
    }

    if (curStep >= 48 && !qtt) {
      qtt = true;
      // setSubtitle("Very interesting.");
    }

    if (curStep >= 64 && !b) {
      b = true;
      // setSubtitle(" ");
    }

    if (curStep >= 3481 && !aq) {
      aq = true;
      // setSubtitle("Results conclusive.");
    }

    if (curStep >= 3494 && !ae) {
      ae = true;
      // setSubtitle("Ta-ta!");
    }

    if (curStep >= 2304 && !q) {
      q = true;
      // Tween healthbar positions back
      //tweens.push(FlxTween.tween(playState.healthBar, {x: savedValBars}, 0.2, {ease: FlxEase.quadOut}));
    }

    if (curStep >= 2420 && !p) {
      p = true;
      handleZoom('normal');
    }

    if (curStep >= 2432 && !g) {
      g = true;
      handleZoom('reset');
    }

    if (curStep >= 2612 && !c) {
      c = true;
      handleZoom('sonic');
    }

    if (curStep >= 2624 && !d) {
      d = true;
      handleZoom('reset');
    }

    if (curStep >= 3200 && !f) {
      playState.health = 1;
      f = true;
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    if (!hasStoredStrums) return;

    var elapsed = event.elapsed;
    var curBeat = Conductor.instance.currentBeat;

    if (!modcharts) return;

    // Update red pulse note color
    updateRedPulse();

    // LESSERMODCHART UPDATE EFFECTS

    var songPos = Conductor.instance.songPosition;

    // Efeito de ondulação horizontal (beats 200-250 e 368-416)
    if ((curBeat >= 200 && curBeat < 250) || (curBeat >= 368 && curBeat < 416)) {
      var add = 20 * Math.sin(songPos / 500) * (1 - easingValueX);

      for (i in 0...4) {
        var oppStrum = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
        var playerStrum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

        oppStrum.x = defaultOpponentStrumX[i] + add;
        playerStrum.x = defaultPlayerStrumX[i] + add;
      }
    }

    // Efeito de ondulação vertical (beats 224-250 e 392-416)
    if ((curBeat >= 224 && curBeat < 250) || (curBeat >= 392 && curBeat < 416)) {
      for (i in 0...4) {
        var oppStrum = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
        var playerStrum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

        oppStrum.y = defaultOpponentStrumY[i] + 20 * Math.cos(songPos / 1000 + i) * (1 - easingValueY);
        playerStrum.y = defaultPlayerStrumY[i] + 20 * Math.cos(songPos / 1000 + i + 4) * (1 - easingValueY);
      }
    }

    // END LESSERMODCHART UPDATE EFFECTS

    // Wavy note movement (beats 641-654, 656-670)
    if ((curBeat >= 641 && curBeat < 654) || (curBeat >= 656 && Conductor.instance.songPosition < 324188)) {
      //updateWavyNotes();
    }

    // Shake notes (beats 448-480)
    if (curBeat >= 448 && curBeat < 480) {
      shakeTime += elapsed;
      if (shakeTime > elapsed * 6) {
        shakeNotes();
        shakeTime = 0;
      }
    }

    // Toll effect
    if (toggledToll && curBeat < 700) {
      var addition = elapsed / -1.5;
      testValue = Math.max(testValue + addition, -0.25);
    } else {
      testValue = Math.max(testValue - elapsed * 1.5, -0.25);
    }

    if (toggledToll) {
      applyTollEffect();
    }

    // Update scythe positions and effects
    if (scythe != null && PlayState.instance.iconP1 != null) {
      // not draining
      if (!draining && curBeat < 606) scythe.x = PlayState.instance.iconP1.x + (isDownScroll ? -33 : -15);

      if (draining) {
        scythe.x = PlayState.instance.iconP1.x - scythe.width + 17;
        scythe.y = PlayState.instance.healthBar.y + (isDownScroll ? -160 : -260);

        if (playState.health > 0.7) {
          playState.health -= elapsed / 5;
        }

        if (scythe.colorTransform != null) {
          scythe.colorTransform.redOffset = 70 + 50 * Math.sin(Conductor.instance.songPosition / 100);
        }

        scythe.offset.y = FlxG.random.float(-1, 1);
        scythe.offset.x = FlxG.random.float(-2, 2);
      }
    }

    if (scythe2 != null && scytheActive2) {
      scythe2.offset.x = 75 * Math.cos(Conductor.instance.songPosition / 500);
    }

    if (scythe2 != null && toting) {
      scytheIncrease += elapsed * 7.5;
      scythe2.angle = scytheIncrease * Math.sin(Conductor.instance.songPosition / 1000 - scytheIncrease * 2);
      scythe2.offset.y = -scytheIncrease * Math.sin(Conductor.instance.songPosition / 500 - scytheIncrease * 2);
    }
  }

  function onNoteHit(event:HitNoteScriptEvent):Void {
    super.onNoteHit(event);
    if (PlayState.instance == null) return;
    var curBeat = Conductor.instance.currentBeat;

    if (!event.note.noteData.getMustHitNote()) {
      if (curBeat >= 544 && curBeat < 576) {
        //shoveNotes(17.5);
      }

      if (curBeat >= 480 && curBeat < 512) {
        addShake(2.75 * 4); // 2.75
      }

      if (curBeat >= 479 && curBeat < 496 && modcharts) {
        shakeNotesRandom();
      }
    } else {
      if (curBeat >= 544 && curBeat < 576) {
        //shoveNotes(-12.5);
      }
    }
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);

    var eventKind = event.eventData.eventKind;
    var value = event.eventData.value;

    if (eventKind == "NightflaidEvents") {
      switch (Std.parseInt(value.eventType)) {
        case 5: // Set opp anim
          //if (value.value1.toLowerCase() == 'pokemon') toggledToll = true;
      }
    }
  }

  // HELPER FUNCTIONS

  function createFlash(color:Int, alpha:Float):Void
  {
    flash.active = true;
    flash.color = color;
    flash.alpha = alpha;
    flash.visible = true;
    FlxTween.tween(flash, {alpha: 0}, 0.5, {
      ease: FlxEase.quadOut,
      onComplete: function(t) {
        if (PlayState.instance != null && flash != null) {
          flash.visible = false;
          flash.active = false;
        }
      }
    });
  }

  function animateStrumUp(index:Int):Void
  {
    if (PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var crochet = Conductor.instance.stepLengthMs * 4;

    // don't add the tweens to the tween list or else it will be misaligned sei lá como escreve KKKKKKKKKKKKK
    if (opponentStrums != null && index < opponentStrums.strumlineNotes.members.length) {
      var strum = opponentStrums.strumlineNotes.members[index];
      FlxTween.tween(strum, {y: defaultOpponentStrumY[index]},
        crochet / 600, {ease: FlxEase.quadOut});
    }

    if (playerStrums != null && index < playerStrums.strumlineNotes.members.length) {
      var reversedIndex = 3 - index;
      var strum = playerStrums.strumlineNotes.members[reversedIndex];
      FlxTween.tween(strum, {y: defaultPlayerStrumY[reversedIndex]},
        crochet / 600, {ease: FlxEase.quadOut});
    }
  }

  // LESSERMODCHART FUNCTIONS

  function createFunnyWarning(x:Float, y:Float, flipped:Bool):Void
  {
    if (!modcharts || PlayState.instance == null) return;

    arrowX = x;
    arrowY = y;
    arrowFlipped = flipped;
    arrowIndex = flipped ? 2 : 0;

    createWarningArrow(x, y, flipped);
    arrowIndex += arrowFlipped ? -1 : 1;

    new FlxTimer().start(0.125, function(tmr:FlxTimer) {
      createWarningArrow(arrowX, arrowY, arrowFlipped);
      arrowIndex += arrowFlipped ? -1 : 1;
    }, 2);
  }

  function createWarningArrow(x:Float, y:Float, flipped:Bool):Void
  {
    if (PlayState.instance == null) return;

    var arrow = new FlxSprite(x + 135 * -arrowIndex + (flipped ? -40 : 40), y);
    arrow.loadGraphic(Paths.image('nightflaid/arrow'));
    arrow.alpha = 0;
    arrow.scale.set(0.5, 0.5);
    arrow.flipX = flipped;
    arrow.cameras = [PlayState.instance.camHUD];
    arrow.updateHitbox();

    PlayState.instance.add(arrow);
    warningArrows.push(arrow);

    var targetX = x + 135 * -arrowIndex + (flipped ? 60 : -60);

    FlxTween.tween(arrow, {alpha: 1}, 0.225, {
      ease: FlxEase.quadOut,
      onComplete: function(twn:FlxTween) {
        FlxTween.tween(arrow, {alpha: 0}, 0.175, {
          ease: FlxEase.quadIn,
          onComplete: function(t:FlxTween) {
            warningArrows.remove(arrow);
            arrow.destroy();
          }
        });
      }
    });

    FlxTween.tween(arrow, {x: targetX}, 0.6, {ease: FlxEase.cubeOut});
  }

  function doPulsePiano():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var crochet = Conductor.instance.stepLengthMs * 4;

    var oppIndex = pulseNumber - 1;
    var playerIndex = 4 - pulseNumber;

    var pulseMult:Float = 1.15; // Size multiplier

    if (opponentStrums != null && oppIndex >= 0 && oppIndex < 4) {
      var strum = opponentStrums.strumlineNotes.members[oppIndex];
      FlxTween.cancelTweensOf(strum);
      FlxTween.cancelTweensOf(strum.scale);

      var baseScaleX = ogOppStrumScales[oppIndex * 2];
      var baseScaleY = ogOppStrumScales[(oppIndex * 2) + 1];

      strum.scale.set(baseScaleX * pulseMult, baseScaleY * pulseMult);
      strum.y = defaultOpponentStrumY[oppIndex] - 10;

      FlxTween.tween(strum.scale, {x: baseScaleX, y: baseScaleY}, crochet / 1000, {ease: FlxEase.quadOut});
      FlxTween.tween(strum, {y: defaultOpponentStrumY[oppIndex]}, crochet / 1000, {ease: FlxEase.quadOut});
    }

    if (playerStrums != null && playerIndex >= 0 && playerIndex < 4) {
      var strum = playerStrums.strumlineNotes.members[playerIndex];
      FlxTween.cancelTweensOf(strum);
      FlxTween.cancelTweensOf(strum.scale);

      var baseScaleX = ogPlayerStrumScales[oppIndex * 2];
      var baseScaleY = ogPlayerStrumScales[(oppIndex * 2) + 1];

      strum.scale.set(baseScaleX * pulseMult, baseScaleY * pulseMult);
      strum.y = defaultPlayerStrumY[playerIndex] - 10;

      FlxTween.tween(strum.scale, {x: baseScaleX, y: baseScaleY}, crochet / 1000, {ease: FlxEase.quadOut});
      FlxTween.tween(strum, {y: defaultPlayerStrumY[playerIndex]}, crochet / 1000, {ease: FlxEase.quadOut});
    }

    pulseNumber += pulseDir;
    if (pulseNumber == 4) {
        pulseDir = -1;
    } else if (pulseNumber == 1) {
        pulseDir = 1;
    }
  }

  function tweenEasingValue(varNamee:String, target:Float, duration:Float):Void
  {
    var varName = varNamee;
    FlxTween.num(varName == 'easingValueX' ? easingValueX : easingValueY, target, duration, {ease: FlxEase.quadOut}, function(num:Float) {
      if (varName == 'easingValueX') {
        easingValueX = num;
      } else {
        easingValueY = num;
      }
    });
  }

  // SCYTHE MECHANIC FUNCTIONS
  function setupScytheElements():Void
  {
    if (!modcharts || PlayState.instance == null) return;
    var isMobile = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;
    //var isMobile = true;

    scythe = FunkinSprite.create(0, isDownScroll ? 0 : PlayState.instance.healthBar.y + 100); // isDownScroll ? -550 : 200
    scythe.loadTexture('nightflaid/scythe');
    scythe.camera = PlayState.instance.camHUD;
    scythe.scale.set(0.4, 0.4);
    scythe.flipX = !isDownScroll;
    scythe.angle = isDownScroll ? -105 : -90;
    scythe.alpha = 0;
    scythe.updateHitbox();
    scythe.origin.y = scythe.height;
    scythe.zIndex = playState.iconP1.zIndex + 5;
    scythe.antialiasing = false;
    PlayState.instance.add(scythe);
    scythe.kill();

    // Initial color tween
    if (scythe.colorTransform != null) {
      FlxTween.tween(scythe.colorTransform, {
        redOffset: 255,
        greenOffset: -200,
        blueOffset: -200
      }, 1, {ease: FlxEase.quadOut});
    }

    var mult = isDownScroll ? 1 : -1;
    scythe2 = FunkinSprite.create(FlxG.width + 100, PlayState.instance.playerStrumline.height / 2);
    scythe2.loadTexture('nightflaid/scythe');
    scythe2.camera = PlayState.instance.camHUD;
    scythe2.origin.y = scythe.height;
    scythe2.y += ((!isMobile) ? 230 : 205) * mult - (!isDownScroll ? 50 : 0);
    scythe2.scale.set((!isMobile) ? 0.9 : 1, (!isMobile) ? 1.1 : 1.2);
    scythe2.updateHitbox();
    scythe2.flipX = !isDownScroll;
    scythe2.angle = -90;
    scythe2.zIndex = 10000;
    scythe2.antialiasing = false;
    PlayState.instance.add(scythe2);
    scythe2.kill();
  }

