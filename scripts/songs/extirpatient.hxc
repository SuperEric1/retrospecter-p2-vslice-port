  // ========== HELPER FUNCTIONS ==========

  function createFlash(color:Int, alpha:Float):Void
  {
    flash.active = true;
    flash.color = color;
    flash.alpha = alpha;
    flash.visible = true;
    FlxTween.tween(flash, {alpha: 0}, 0.5, {
      ease: FlxEase.quadOut,
      onComplete: function(t) {
        if (PlayState.instance != null && flash != null) {
          flash.visible = false;
          flash.active = false;
          //flash.destroy();
        }
      }
    });
  }

  function animateStrumUp(index:Int):Void
  {
    if (PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var crochet = Conductor.instance.stepLengthMs * 4;

    // don't add the tweens to the tween list or else it will be misaligned sei lá como escreve KKKKKKKKKKKKK
    if (opponentStrums != null && index < opponentStrums.strumlineNotes.members.length) {
      var strum = opponentStrums.strumlineNotes.members[index];
      FlxTween.tween(strum, {y: defaultOpponentStrumY[index]},
        crochet / 600, {ease: FlxEase.quadOut});
    }

    if (playerStrums != null && index < playerStrums.strumlineNotes.members.length) {
      var reversedIndex = 3 - index;
      var strum = playerStrums.strumlineNotes.members[reversedIndex];
      FlxTween.tween(strum, {y: defaultPlayerStrumY[reversedIndex]},
        crochet / 600, {ease: FlxEase.quadOut});
    }
  }

  function handleSwap(curBeat:Int):Void
  {
    if (!modcharts) return;

    var crochet = Conductor.instance.stepLengthMs * 4;

    if (curBeat == 643 || curBeat == 651) {
      swapStrumPositions(true);
    }

    if (curBeat == 647) {
      swapStrumPositions(false);
    }
  }

  function swapStrumPositions(swap:Bool):Void
  {
    if (PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var crochet = Conductor.instance.stepLengthMs * 4;

    for (i in 0...4) {
      if (swap) {
        if (opponentStrums != null) {
          var strum = opponentStrums.strumlineNotes.members[i];
          tweens.push(FlxTween.tween(strum, {x: defaultOpponentStrumX[i] + 312 * 2},
            crochet / 450, {ease: FlxEase.quadInOut}));
        }
        if (playerStrums != null) {
          var strum = playerStrums.strumlineNotes.members[i];
          tweens.push(FlxTween.tween(strum, {x: defaultPlayerStrumX[i] - 312 * 2},
            crochet / 450, {ease: FlxEase.quadInOut}));
        }
      } else {
        if (opponentStrums != null) {
          var strum = opponentStrums.strumlineNotes.members[i];
          tweens.push(FlxTween.tween(strum, {x: defaultOpponentStrumX[i]},
            crochet / 450, {ease: FlxEase.quadInOut}));
        }
        if (playerStrums != null) {
          var strum = playerStrums.strumlineNotes.members[i];
          tweens.push(FlxTween.tween(strum, {x: defaultPlayerStrumX[i]},
            crochet / 450, {ease: FlxEase.quadInOut}));
        }
      }
    }
  }

  function shoveStrumsInitial():Void
  {
    if (PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var crochet = Conductor.instance.stepLengthMs * 4;
    var offset = 85;

    for (i in 0...4) {
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {x: strum.x - offset},
          crochet / 1000, {ease: FlxEase.backIn}));
      }
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {x: strum.x + offset},
          crochet / 1000, {ease: FlxEase.backIn}));
      }
    }
  }

  function shoveNotes(amount:Float):Void
  {
    if (!modcharts || !toggledShove || PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        var progress = Math.min(1 - ((strum.x - 850) / (1400 - 850)), 1);
        tweens.push(FlxTween.tween(strum, {x: strum.x + amount * progress},
          0.2, {ease: FlxEase.backOut}));
      }
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        var progress = Math.min(1 - ((strum.x - 850) / (1400 - 850)), 1);
        tweens.push(FlxTween.tween(strum, {x: strum.x + amount * progress},
          0.2, {ease: FlxEase.backOut}));
      }
    }
  }

  function shakeNotes():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var x = FlxG.random.float(-5, 5);
    var y = FlxG.random.float(-5, 5);

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        strum.x = defaultOpponentStrumX[i] + x;
        strum.y = defaultOpponentStrumY[i] + y;
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        strum.x = defaultPlayerStrumX[i] + x * -0.5;
        strum.y = defaultPlayerStrumY[i] + y * -0.5;
      }
    }
  }

  function shakeNotesRandom():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultOpponentStrumX[i] + FlxG.random.int(-8, 8),
          y: defaultOpponentStrumY[i] + FlxG.random.int(-8, 8),
          angle: FlxG.random.int(-5, 5)
        }, 0.1, {ease: FlxEase.elasticOut}));
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultPlayerStrumX[i] + FlxG.random.float(-15, 15),
          y: defaultPlayerStrumY[i] + FlxG.random.float(-15, 15),
          angle: FlxG.random.int(-12, 12)
        }, 0.1, {ease: FlxEase.elasticOut}));
      }
    }
  }

  function addShake(amount:Float):Void
  {
    // Camera shake implementation would go here
    playState.camGame.shake(amount * 0.001, 0.05);
  }

  function updateWavyNotes():Void
  {
    if (PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs;
    var songPos = Conductor.instance.songPosition;
    var beat = songPos / (crochet * 4);
    var offset = Math.cos(beat * Math.PI / 4);
    var beat2 = (songPos + crochet * 8) / (crochet * 4);
    var offset2 = Math.sin(beat2 * Math.PI / 3.5);

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var curBeat = Conductor.instance.currentBeat;

    if (playerStrums != null) {
      var strum = playerStrums;
      strum.y = defaultPlayerStrumY[4] + (90 - 80 * offset) * negativity;

      /*if (curBeat >= 656 && curBeat < 670) {
        strum.x = defaultPlayerStrumX[4] - 320 + 100 * offset;
      }*/
    }
    if (opponentStrums != null) {
      var strum = opponentStrums;
      strum.y = defaultOpponentStrumY[4] + (90 + 80 * offset) * negativity;

      /*if (curBeat >= 656 && curBeat < 670) {
        strum.x = defaultOpponentStrumX[4] + 306 + 100 * offset2;
      }*/
    }

    /*for (i in 0...4) {
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        strum.y = defaultPlayerStrumY[i] + (90 - 80 * offset) * negativity;

        if (curBeat >= 656 && curBeat < 670) {
          strum.x = defaultPlayerStrumX[i] - 320 + 100 * offset;
        }
      }
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        strum.y = defaultOpponentStrumY[i] + (90 + 80 * offset) * negativity;

        if (curBeat >= 656 && curBeat < 670) {
          strum.x = defaultOpponentStrumX[i] + 306 + 100 * offset2;
        }
      }
    }*/
  }

  function applyTollEffect():Void
  {
    if (PlayState.instance == null) return;

    var songPos = Conductor.instance.songPosition;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      var val = defaultOpponentStrumX[i] + 300 + 2.5 * i;
      var val2 = val + 60;

      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        strum.x = val + Math.min(testValue * 10 + 3, 13) * Math.sin(songPos / 100);
        strum.alpha = Math.min(testValue / 2 + 0.15, 0.7) - 0.1 * Math.sin(songPos / 42);
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        strum.x = val2 - Math.min(testValue * 8 + 2, 10) * Math.sin(songPos / 79);
        strum.alpha = (1 - Math.min(testValue / 2, 0.3)) + 0.1 * Math.cos(songPos / 69);
      }
    }
  }

  function flipStrumlines(flip:Bool):Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var multiplier = isDownScroll ? -1 : 1;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultOpponentStrumY[i] + 525 * multiplier},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultPlayerStrumY[i] + 525 * multiplier},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
    }

    // Color transforms would go here
    applyColorTransform(-200, -200, 100, -200);
  }

  function applyFlipTransform():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    // Apply actual downscroll flip here
    // Color transform reset
    applyColorTransform(0, 0, 0, 0);
  }

  function revertFlipTransform():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultOpponentStrumY[i] + (90 + 80 * 0.708) * negativity},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultPlayerStrumY[i] + (90 - 80 * 0.708) * negativity},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
    }

    applyColorTransform(-200, -200, 100, -225);
  }

  function applyColorTransform(green:Int, blue:Int, red:Int, alpha:Int):Void
  {
    if (PlayState.instance == null) return;

    // Apply color transform to HUD elements
    // This would need access to healthBar, icons, etc.
  }

  function resetStrumPositions():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultOpponentStrumX[i],
          y: defaultOpponentStrumY[i],
          angle: 0
        }, 0.4, {ease: FlxEase.cubeOut}));

        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultPlayerStrumX[i],
          y: defaultPlayerStrumY[i],
          angle: 0
        }, 0.4, {ease: FlxEase.cubeOut}));
    }
  }

  function redPulse():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    // Set intensity to maximum - the update function will handle the fade
    redPulseIntensity = 1.0;
  }

  function updateRedPulse():Void
  {
    // Se a intensidade for maior que 0, precisamos atualizar a cor
    if (redPulseIntensity > 0.001)
    {
      // Velocidade do decay - ajuste entre 2.0 (lento) e 5.0 (rápido)
      var decaySpeed:Float = 2.5;

      // Lerp suave de volta para 0
      redPulseIntensity = FlxMath.lerp(redPulseIntensity, 0, FlxG.elapsed * decaySpeed);

      // Aplicar cor vermelha em todas as strumlines
      var opponentStrums = PlayState.instance.opponentStrumline;
      var playerStrums = PlayState.instance.playerStrumline;

      for (i in 0...4) {
        // Opponent strums
        if (opponentStrums != null) {
          var strum = opponentStrums.strumlineNotes.members[i];
          if (strum != null && strum.colorTransform != null) {
            // Lerp da cor normal (0) para a cor vermelha (red: 50, green/blue: -100)
            strum.colorTransform.redOffset = FlxMath.lerp(0, 50, redPulseIntensity);
            strum.colorTransform.greenOffset = FlxMath.lerp(0, -100, redPulseIntensity);
            strum.colorTransform.blueOffset = FlxMath.lerp(0, -100, redPulseIntensity);
          }
        }

        // Player strums
        if (playerStrums != null) {
          var strum = playerStrums.strumlineNotes.members[i];
          if (strum != null && strum.colorTransform != null) {
            strum.colorTransform.redOffset = FlxMath.lerp(0, 50, redPulseIntensity);
            strum.colorTransform.greenOffset = FlxMath.lerp(0, -100, redPulseIntensity);
            strum.colorTransform.blueOffset = FlxMath.lerp(0, -100, redPulseIntensity);
          }
        }
      }
    }
    else
    {
      // Força o valor para 0 quando muito baixo
      redPulseIntensity = 0;
    }
  }

  function commitABeat(beats:Int):Void
  {
    var curBeat = Conductor.instance.currentBeat;

    // Skip ranges
    if (curBeat < 16) return;
    if (curBeat >= 200 && curBeat < 248) return;
    if (curBeat >= 368 && curBeat < 416) return;
    if (curBeat >= 736 && curBeat < 800) return;

    // Special beats
    var specialBeats = [151, 158, 165, 319, 326, 333, 347, 354, 361];
    for (beat in specialBeats) {
      if (curBeat == beat) {
        trulyBeats++;
        playState.camGame.zoom += 0.01;
        playState.camHUD.zoom += 0.015;
        return;
      }
    }

    // Check zoom beats
    for (i in 0...zoomBeats.length) {
      if (curBeat == zoomBeats[i]) {
        zoomBeats.splice(i, 1);
        return;
      }
    }

    // Normal zoom
    if (beats % 2 == 0) {
      playState.camGame.zoom += 0.0075;
      playState.camHUD.zoom += 0.0125;
    } else {
      playState.camGame.zoom += 0.02;
      playState.camHUD.zoom += 0.025;
    }
  }

  function handleZoom(kind:String):Void
  {
    if (PlayState.instance == null) return;

    var dad = playStage.getDad();
    var bf = playStage.getBoyfriend();

    switch (kind) {
      // TODO: tween the zooms
      case 'normal':
        //playState.defaultCameraZoom = 0.65;
        playState.tweenCameraZoom(0.65, 1, true, FlxEase.expoOut);
        playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 250, dad.cameraFocusPoint.y - 200);

      case 'sonic':
        //playState.defaultCameraZoom = 0.65;
        playState.tweenCameraZoom(0.65, 1, true, FlxEase.expoOut);
        playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 100, dad.cameraFocusPoint.y + 400);

      case 'reset':
        //playState.defaultCameraZoom = 0.34;
        playState.tweenCameraZoom(playState.stageZoom, 1, true, FlxEase.expoOut);
        playState.cameraFollowPoint.setPosition((dad.cameraFocusPoint.x + bf.cameraFocusPoint.x) / 2, dad.cameraFocusPoint.y);
    }
  }

  function resetFlags():Void
  {
    f = false;
    q = false;
    qe = false;
    qt = false;
    qtt = false;
    aq = false;
    ae = false;
    b = false;
    p = false;
    g = false;
    c = false;
    d = false;
    toggledShove = false;
    toggledToll = false;
    trulyBeats = 0;
    shakeTime = 0;
    songEnded = false;
    testValue = -0.25;
    hasStoredStrums = false;
    defaultPlayerStrumX = [];
    defaultPlayerStrumY = [];
    defaultOpponentStrumX = [];
    defaultOpponentStrumY = [];
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    resetTweens();
  }

  private function resetTweens():Void
  {
    for (tween in tweens) {
      if (tween != null)
        tween.cancel();
    }
    tweens = [];
    pausedTweens = [];
  }

  override function onResume(event:ScriptEvent):Void
  {
    super.onResume(event);
    for (tween in pausedTweens) {
      if (tween != null && !tween.finished) {
        tween.active = true;
      }
    }
    pausedTweens = [];
  }

  override function onPause(event:ScriptEvent):Void
  {
    super.onPause(event);
    pausedTweens = [];
    for (tween in tweens) {
      if (tween != null && !tween.finished) {
        tween.active = false;
        pausedTweens.push(tween);
      }
    }
  }

  function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);

    resetFlags();

    // Reset strumlines
    if (PlayState.instance != null) {
      if (PlayState.instance.playerStrumline != null)
        PlayState.instance.playerStrumline.alpha = 1;
      if (PlayState.instance.opponentStrumline != null)
        PlayState.instance.opponentStrumline.alpha = 1;
    }
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    songEnded = true;
  }
}
