import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxMath;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.Conductor;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;
import funkin.play.song.Song;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.graphics.FunkinSprite;
import funkin.save.Save;
import funkin.Preferences;

class ExtirpatientSong extends Song
{
  var tweens = [];
  var pausedTweens = [];

  // Flags
  var f:Bool = false;
  var q:Bool = false;
  var qe:Bool = false;
  var qt:Bool = false;
  var qtt:Bool = false;
  var aq:Bool = false;
  var ae:Bool = false;
  var b:Bool = false;
  var p:Bool = false;
  var g:Bool = false;
  var c:Bool = false;
  var d:Bool = false;

  var toggledShove:Bool = false;
  var isDownScroll:Bool = false;
  var trulyBeats:Int = 0;
  var shakeTime:Float = 0;
  var negativity:Int = 1;
  var toggledToll:Bool = false;
  var testValue:Float = -0.25;
  var songEnded:Bool = false;
  var modcharts:Bool = true;
  var flashingLights:Bool = true;
  var flash:FunkinSprite;
  var hasStoredStrums = false;

  var flashyBits:Array<Int> = [79, 143, 171, 199, 279, 311, 339, 367];
  var zoomBeats:Array<Int> = [415, 447, 479, 511, 543, 575, 607, 639, 671];

  var savedValOverlay:Float = 167.5;
  var savedValBars:Float = 210.5;

  // Red pulse intensity
  var redPulseIntensity:Float = 0.0;

  // Store default strum positions
  var defaultOpponentStrumX:Array<Float> = [];
  var defaultOpponentStrumY:Array<Float> = [];
  var defaultPlayerStrumX:Array<Float> = [];
  var defaultPlayerStrumY:Array<Float> = [];

  public function new()
  {
    super('extirpatient');
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    playState = PlayState.instance;
    playStage = PlayState.instance.currentStage;
    modcharts = Save.instance.modOptions.get('retroModcharts');
    flashingLights = Preferences.flashingLights;

    // Check if downscroll
    isDownScroll = Preferences.downscroll;
    if(FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice)
      isDownScroll = true;

    negativity = isDownScroll ? -1 : 1;

    flash = FunkinSprite.create();
    flash.makeGraphic(5000, 3000, 0xFFFFFFFF);
    flash.scrollFactor.set(0, 0);
    flash.screenCenter();
    flash.cameras = [PlayState.instance.camGame];
    flash.visible = false;
    flash.active = false;
    PlayState.instance.add(flash);
    PlayState.instance.refresh();

    // Reset flags
    resetFlags();
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);

    // Store default strum positions
    if (!hasStoredStrums) storeDefaultStrumPositions();
  }

  public override function onCountdownStart(event:ScriptEvent):Void
  {
    super.onCountdownStart(event);

    // Initial camera position if song just started
    if (Conductor.instance.songPosition < 100) {
      var dad = PlayState.instance.currentStage.getDad();
      PlayState.instance.currentCameraZoom = 0.6;
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 300, dad.cameraFocusPoint.y - 200);
      // PlayState.instance.camHUD.alpha = 0;
      PlayState.instance.healthBar.alpha = 0;
      PlayState.instance.iconP1.alpha = 0;
      PlayState.instance.iconP2.alpha = 0;
      PlayState.instance.playerStrumline.alpha = 0;
      PlayState.instance.opponentStrumline.alpha = 0;
    }
  }

  function storeDefaultStrumPositions():Void
  {
    if (PlayState.instance == null) return;
    hasStoredStrums = true;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        defaultOpponentStrumX.push(strum.x);
        defaultOpponentStrumY.push(strum.y);
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        defaultPlayerStrumX.push(strum.x);
        defaultPlayerStrumY.push(strum.y);
      }
    }
    defaultPlayerStrumX.push(playerStrums.x);
    defaultPlayerStrumY.push(playerStrums.y);
    defaultOpponentStrumX.push(opponentStrums.x);
    defaultOpponentStrumY.push(opponentStrums.y);
  }

  public override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    trulyBeats++;
    var curBeat = event.beat;
    var crochet = Conductor.instance.stepLengthMs * 4;

    // Ajustes de beat
    if (curBeat == 144 || curBeat == 172 || curBeat == 312 || curBeat == 340 || curBeat == 368) {
      trulyBeats = curBeat;
    }

    // Commits de beat
    if (curBeat >= 16 && curBeat < 864) {
      commitABeat(trulyBeats);
    }

    // Flashy bits
    for (v in flashyBits) {
      if (curBeat == v) {
        playState.camHUD.zoom = 1;
        playState.camGame.zoom = 0.34;
        tweens.push(FlxTween.tween(playState.camHUD, {zoom: 1.08}, crochet / 1000, {ease: FlxEase.expoIn}));
        tweens.push(FlxTween.tween(playState.camGame, {zoom: 0.36}, crochet / 1000, {ease: FlxEase.expoIn, /*onComplete: function(twn:FlxTween) {
            tweens.push(FlxTween.tween(playState.camGame, {zoom: playState.stageZoom}, crochet, {ease: FlxEase.expoIn}));
          }*/
        }));
        // playState.tweenCameraZoom(0.36, crochet, true, FlxEase.expoIn);
      }
      if (curBeat == v + 1) {
        // Cancel tweens
        for (tween in tweens) {
          if (tween != null && !tween.finished) tween.cancel();
        }

        // Add camera zoom
        playState.camGame.zoom += 0.025;
        playState.camHUD.zoom += 0.025;

        // Flash effect
        if (flashingLights) {
          createFlash(0xFFFF0000, 0.3);
        }
      }
    }

    if (curBeat == 1) {
      var dad = playStage.getDad();
      playState.tweenCameraZoom(0.55, 1, true, FlxEase.expoOut);

      var markiplier = isDownScroll ? 1 : -1;
      for (i in 0...4) {
        var strum = playState.opponentStrumline.strumlineNotes.members[i];
        strum.y = (FlxG.height + 100) * markiplier;

        strum = playState.playerStrumline.strumlineNotes.members[i];
        strum.y = (FlxG.height + 100) * markiplier;
      }
      playState.playerStrumline.alpha = 1;
      playState.opponentStrumline.alpha = 1;
      //playState.camGame.visible = true;
      // tweens.push(FlxTween.tween(playState.camGame, {zoom: 0.55}, 1, {ease: FlxEase.expoOut}));
    }

    if (curBeat == 6) {
      var dad = playStage.getDad();
      playState.tweenCameraZoom(0.5, crochet / 250, true, FlxEase.sineOut);
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x + 100, playStage.getBoyfriend().cameraFocusPoint.y);
      // tweens.push(FlxTween.tween(playState.camGame, {zoom: 0.5}, Conductor.instance.stepCrochet / 250, {ease: FlxEase.sineOut}));
    }

    if (curBeat == 12) {
      var dad = playStage.getDad();
      // tweens.push(FlxTween.tween(playState.camHUD, {alpha: 1}, crochet / 1000, {ease: FlxEase.quartIn}));
      playState.tweenCameraZoom(playState.stageZoom, crochet / 250, true, FlxEase.quartIn);
      playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x + 170, playStage.getBoyfriend().cameraFocusPoint.y);
      // tweens.push(FlxTween.tween(playState.camGame, {zoom: 0.34}, Conductor.instance.stepCrochet / 250, {ease: FlxEase.quartIn}));

      for (i in 0...4) {
        new FlxTimer().start(0.4 * i, function(tmr) {
          animateStrumUp(i);
        });
      }
    }

    if (curBeat == 15) {
      FlxTween.tween(playState.camHUD, {zoom: 1.1}, crochet / 1000, {ease: FlxEase.expoIn});
      FlxTween.tween(playState.healthBar, {alpha: 1}, crochet / 1000, {ease: FlxEase.expoIn});
      FlxTween.tween(playState.iconP1, {alpha: 1}, crochet / 1000, {ease: FlxEase.expoIn});
      FlxTween.tween(playState.iconP2, {alpha: 1}, crochet / 1000, {ease: FlxEase.expoIn});
    }

    if (curBeat == 16) {
      for (tween in tweens) {
        if (tween != null && !tween.finished) tween.cancel();
      }

      playState.camGame.zoom += 0.05;
      playState.camHUD.zoom += 0.05;

      if (flashingLights) {
        createFlash(0xFFFF0000, 0.5);
      }
    }

    if (curBeat == 448) {
      // Camera shake adjustments would go here
    }

    // Flip mechanics (beats 607-608)
    if (curBeat == 607 && modcharts) {
      //flipStrumlines(true);
    }

    if (curBeat == 608 && modcharts) {
      //applyFlipTransform();
    }

    // Unflip mechanics (beats 639-640)
    if (curBeat == 639 && modcharts) {
      //flipStrumlines(false);
    }

    if (curBeat == 640 && modcharts) {
      //revertFlipTransform();
    }

    if (curBeat == 512 && modcharts) {
      resetStrumPositions();
    }

    if (curBeat == 543 && modcharts) {
      toggledShove = true;
      //shoveStrumsInitial();
    }

    handleSwap(curBeat);
  }

  public override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var curStep = event.step;

    // Red pulses
    var redPulseSteps = [50, 53, 56, 306, 309, 312, 562, 565, 568, 980, 984, 1652, 1656, 3442, 3445, 3448];
    for (step in redPulseSteps) {
      if (curStep == step) {
        redPulse();
      }
    }

    // Subtitle events
    if (curStep >= 5 && !qe) {
      qe = true;
      // setSubtitle("Hahahaha...");
    }

    if (curStep >= 26 && !qt) {
      qt = true;
      // setSubtitle("Well well, look at you.");
    }

    if (curStep >= 48 && !qtt) {
      qtt = true;
      // setSubtitle("Very interesting.");
    }

    if (curStep >= 64 && !b) {
      b = true;
      // setSubtitle(" ");
    }

    if (curStep >= 3481 && !aq) {
      aq = true;
      // setSubtitle("Results conclusive.");
    }

    if (curStep >= 3494 && !ae) {
      ae = true;
      // setSubtitle("Ta-ta!");
    }

    if (curStep >= 2304 && !q) {
      q = true;
      // Tween healthbar positions back
      //tweens.push(FlxTween.tween(playState.healthBar, {x: savedValBars}, 0.2, {ease: FlxEase.quadOut}));
    }

    if (curStep >= 2420 && !p) {
      p = true;
      handleZoom('normal');
    }

    if (curStep >= 2432 && !g) {
      g = true;
      handleZoom('reset');
    }

    if (curStep >= 2612 && !c) {
      c = true;
      handleZoom('sonic');
    }

    if (curStep >= 2624 && !d) {
      d = true;
      handleZoom('reset');
    }

    if (curStep >= 3200 && !f) {
      playState.health = 1;
      f = true;
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var elapsed = event.elapsed;
    var curBeat = Conductor.instance.currentBeat;

    if (!modcharts) return;

    // Update red pulse note color
    updateRedPulse();

    // Wavy note movement (beats 641-654, 656-670)
    if ((curBeat >= 641 && curBeat < 654) || (curBeat >= 656 && Conductor.instance.songPosition < 324188)) {
      //updateWavyNotes();
    }

    // Shake notes (beats 448-480)
    if (curBeat >= 448 && curBeat < 480) {
      shakeTime += elapsed;
      if (shakeTime > elapsed * 6) {
        shakeNotes();
        shakeTime = 0;
      }
    }

    // Toll effect
    if (toggledToll && curBeat < 700) {
      var addition = elapsed / -1.5;
      testValue = Math.max(testValue + addition, -0.25);
    } else {
      testValue = Math.max(testValue - elapsed * 1.5, -0.25);
    }

    if (toggledToll) {
      applyTollEffect();
    }
  }

  function onNoteHit(event:HitNoteScriptEvent):Void {
    super.onNoteHit(event);
    if (PlayState.instance == null) return;
    var curBeat = Conductor.instance.currentBeat;

    if (!event.note.noteData.getMustHitNote()) {
      if (curBeat >= 544 && curBeat < 576) {
        //shoveNotes(17.5);
      }

      if (curBeat >= 480 && curBeat < 512) {
        addShake(2.75);
      }

      if (curBeat >= 479 && curBeat < 496 && modcharts) {
        shakeNotesRandom();
      }
    } else {
      if (curBeat >= 544 && curBeat < 576) {
        //shoveNotes(-12.5);
      }
    }
  }

