  function shoveNotes(amount:Float):Void
  {
    if (!modcharts || !toggledShove || PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        var progress = Math.min(1 - ((strum.x - 850) / (1400 - 850)), 1);
        tweens.push(FlxTween.tween(strum, {x: strum.x + amount * progress},
          0.2, {ease: FlxEase.backOut}));
      }
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        var progress = Math.min(1 - ((strum.x - 850) / (1400 - 850)), 1);
        tweens.push(FlxTween.tween(strum, {x: strum.x + amount * progress},
          0.2, {ease: FlxEase.backOut}));
      }
    }
  }

  function shakeNotes():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var x = FlxG.random.float(-5, 5);
    var y = FlxG.random.float(-5, 5);

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        strum.x = defaultOpponentStrumX[i] + x;
        strum.y = defaultOpponentStrumY[i] + y;
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        strum.x = defaultPlayerStrumX[i] + x * -0.5;
        strum.y = defaultPlayerStrumY[i] + y * -0.5;
      }
    }
  }

  function shakeNotesRandom():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultOpponentStrumX[i] + FlxG.random.int(-8, 8),
          y: defaultOpponentStrumY[i] + FlxG.random.int(-8, 8),
          angle: FlxG.random.int(-5, 5)
        }, 0.1, {ease: FlxEase.elasticOut}));
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultPlayerStrumX[i] + FlxG.random.float(-15, 15),
          y: defaultPlayerStrumY[i] + FlxG.random.float(-15, 15),
          angle: FlxG.random.int(-12, 12)
        }, 0.1, {ease: FlxEase.elasticOut}));
      }
    }
  }

  function addShake(amount:Float):Void
  {
    playState.camGame.shake(amount * 0.001, 0.05);
  }

  function updateWavyNotes():Void
  {
    if (PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs;
    var songPos = Conductor.instance.songPosition;
    var beat = songPos / (crochet * 4);
    var offset = Math.cos(beat * Math.PI / 4);
    var beat2 = (songPos + crochet * 8) / (crochet * 4);
    var offset2 = Math.sin(beat2 * Math.PI / 3.5);

    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var curBeat = Conductor.instance.currentBeat;

    if (playerStrums != null) {
      var strum = playerStrums;
      strum.y = defaultPlayerStrumY[4] + (90 - 80 * offset) * negativity;
    }
    if (opponentStrums != null) {
      var strum = opponentStrums;
      strum.y = defaultOpponentStrumY[4] + (90 + 80 * offset) * negativity;
    }
  }

  function applyTollEffect():Void
  {
    if (PlayState.instance == null) return;

    var songPos = Conductor.instance.songPosition;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      var val = defaultOpponentStrumX[i] + 300 + 2.5 * i;
      var val2 = val + 60;

      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        strum.x = val + Math.min(testValue * 10 + 3, 13) * Math.sin(songPos / 100);
        strum.alpha = Math.min(testValue / 2 + 0.15, 0.7) - 0.1 * Math.sin(songPos / 42);
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        strum.x = val2 - Math.min(testValue * 8 + 2, 10) * Math.sin(songPos / 79);
        strum.alpha = (1 - Math.min(testValue / 2, 0.3)) + 0.1 * Math.cos(songPos / 69);
      }
    }
  }

  function flipStrumlines(flip:Bool):Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;
    var multiplier = isDownScroll ? -1 : 1;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultOpponentStrumY[i] + 525 * multiplier},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultPlayerStrumY[i] + 525 * multiplier},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
    }

    applyColorTransform(-200, -200, 100, -200);
  }

  function applyFlipTransform():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    applyColorTransform(0, 0, 0, 0);
  }

  function revertFlipTransform():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
      if (opponentStrums != null) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultOpponentStrumY[i] + (90 + 80 * 0.708) * negativity},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
      if (playerStrums != null) {
        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {y: defaultPlayerStrumY[i] + (90 - 80 * 0.708) * negativity},
          crochet / 500, {ease: FlxEase.expoInOut}));
      }
    }

    applyColorTransform(-200, -200, 100, -225);
  }

