  {
    FlxTween.tween(scythe, {
      y: isDownScroll ? playState.healthBar.y : playState.healthBar.y - 80,
      angle: isDownScroll ? -105 : -75
    }, 0.25, {
      ease: FlxEase.backInOut,
      onComplete: function(twn:FlxTween) {
        draining = true;
      }
    });
  }

