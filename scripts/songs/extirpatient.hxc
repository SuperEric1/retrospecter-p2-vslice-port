  function resetStrumPositions():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;
    var opponentStrums = PlayState.instance.opponentStrumline;
    var playerStrums = PlayState.instance.playerStrumline;

    for (i in 0...4) {
        var strum = opponentStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultOpponentStrumX[i],
          y: defaultOpponentStrumY[i],
          angle: 0
        }, 0.4, {ease: FlxEase.cubeOut}));

        var strum = playerStrums.strumlineNotes.members[i];
        tweens.push(FlxTween.tween(strum, {
          x: defaultPlayerStrumX[i],
          y: defaultPlayerStrumY[i],
          angle: 0
        }, 0.4, {ease: FlxEase.cubeOut}));
    }
  }

  function redPulse():Void
  {
    if (!modcharts || PlayState.instance == null) return;

    redPulseIntensity = 1.0;
  }

  function updateRedPulse():Void
  {
    if (redPulseIntensity > 0.001)
    {
      var decaySpeed:Float = 2.5;
      redPulseIntensity = FlxMath.lerp(redPulseIntensity, 0, FlxG.elapsed * decaySpeed);

      var opponentStrums = PlayState.instance.opponentStrumline;
      var playerStrums = PlayState.instance.playerStrumline;

      for (i in 0...4) {
        if (opponentStrums != null) {
          var strum = opponentStrums.strumlineNotes.members[i];
          if (strum != null && strum.colorTransform != null) {
            strum.colorTransform.redOffset = FlxMath.lerp(0, 50, redPulseIntensity);
            strum.colorTransform.greenOffset = FlxMath.lerp(0, -100, redPulseIntensity);
            strum.colorTransform.blueOffset = FlxMath.lerp(0, -100, redPulseIntensity);
          }
        }

        if (playerStrums != null) {
          var strum = playerStrums.strumlineNotes.members[i];
          if (strum != null && strum.colorTransform != null) {
            strum.colorTransform.redOffset = FlxMath.lerp(0, 50, redPulseIntensity);
            strum.colorTransform.greenOffset = FlxMath.lerp(0, -100, redPulseIntensity);
            strum.colorTransform.blueOffset = FlxMath.lerp(0, -100, redPulseIntensity);
          }
        }
      }
    }
    else
    {
      redPulseIntensity = 0;
    }
  }

  function commitABeat(beats:Int):Void
  {
    var curBeat = Conductor.instance.currentBeat;

    // Skip ranges
    if (curBeat < 16) return;
    if (curBeat >= 200 && curBeat < 248) return;
    if (curBeat >= 368 && curBeat < 416) return;
    if (curBeat >= 736 && curBeat < 800) return;

    // Special beats
    var specialBeats = [151, 158, 165, 319, 326, 333, 347, 354, 361];
    for (beat in specialBeats) {
      if (curBeat == beat) {
        trulyBeats++;
        playState.camGame.zoom += 0.01;
        playState.camHUD.zoom += 0.015;
        return;
      }
    }

    // Check zoom beats
    for (i in 0...zoomBeats.length) {
      if (curBeat == zoomBeats[i]) {
        zoomBeats.splice(i, 1);
        return;
      }
    }

    // Normal zoom
    if (beats % 2 == 0) {
      playState.camGame.zoom += 0.0075;
      playState.camHUD.zoom += 0.0125;
    } else {
      playState.camGame.zoom += 0.02;
      playState.camHUD.zoom += 0.025;
    }
  }

  function handleZoom(kind:String):Void
  {
    if (PlayState.instance == null) return;

    var dad = playStage.getDad();
    var bf = playStage.getBoyfriend();

    switch (kind) {
      case 'normal':
        playState.tweenCameraZoom(0.65, 1, true, FlxEase.expoOut);
        playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 250, dad.cameraFocusPoint.y - 200);

      case 'sonic':
        playState.tweenCameraZoom(0.65, 1, true, FlxEase.expoOut);
        playState.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 200, dad.cameraFocusPoint.y + 250);

      case 'reset':
        playState.tweenCameraZoom(playState.stageZoom, 1, true, FlxEase.expoOut);
        playState.cameraFollowPoint.setPosition((dad.cameraFocusPoint.x + bf.cameraFocusPoint.x) / 2, dad.cameraFocusPoint.y);
    }
  }

  function resetFlags():Void
  {
    f = false;
    q = false;
    qe = false;
    qt = false;
    qtt = false;
    aq = false;
    ae = false;
    b = false;
    p = false;
    g = false;
    c = false;
    d = false;
    toggledShove = false;
    toggledToll = false;
    trulyBeats = 0;
    shakeTime = 0;
    songEnded = false;
    testValue = -0.25;
    hasStoredStrums = false;
    defaultPlayerStrumX = [];
    defaultPlayerStrumY = [];
    defaultOpponentStrumX = [];
    defaultOpponentStrumY = [];
    ogPlayerStrumScales = [];
    ogOppStrumScales = [];

    // lesserModchart variables
    easingValueX = 1;
    easingValueY = 1;
    arrowIndex = 0;
    pulseNumber = 1;
    pulseDir = 1;

    // scythe variables
    draining = false;
    scytheActive = false;
    scythePushed = false;
    scytheActive2 = false;
    scytheIncrease = 0;
    toting = false;
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);

    // Cleanup warning arrows
    warningArrows = [];

    resetFlags();
    resetTweens();
  }

  private function resetTweens():Void
  {
    for (tween in tweens) {
      if (tween != null)
        tween.cancel();
    }
    tweens = [];
    pausedTweens = [];
  }

  override function onResume(event:ScriptEvent):Void
  {
    super.onResume(event);
    for (tween in pausedTweens) {
      if (tween != null && !tween.finished) {
        tween.active = true;
      }
    }
    pausedTweens = [];
  }

  override function onPause(event:ScriptEvent):Void
  {
    super.onPause(event);
    pausedTweens = [];
    for (tween in tweens) {
      if (tween != null && !tween.finished) {
        tween.active = false;
        pausedTweens.push(tween);
      }
    }
  }

  function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);

    resetFlags();
    FlxTween.cancelTweensOf(scythe);
    FlxTween.cancelTweensOf(scythe2);
    scythe.visible = false;
    scythe2.visible = false;
    scythe.colorTransform.redOffset = 0;
    scythe.colorTransform.blueOffset = 0;
    scythe.colorTransform.greenOffset = 0;
    scythe2.colorTransform.redOffset = 0;
    scythe2.colorTransform.blueOffset = 0;
    scythe2.colorTransform.greenOffset = 0;

    if (PlayState.instance != null) {
      if (PlayState.instance.playerStrumline != null)
        PlayState.instance.playerStrumline.alpha = 1;
      if (PlayState.instance.opponentStrumline != null)
        PlayState.instance.opponentStrumline.alpha = 1;
    }
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    songEnded = true;
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
