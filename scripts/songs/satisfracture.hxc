import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxBasePoint;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.ui.FullScreenScaleMode;
import flixel.util.FlxTimerManager;
import flixel.util.FlxTimer;
import funkin.Conductor;
import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.GameOverSubState;
import funkin.util.ReflectUtil;
import funkin.util.TouchUtil;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.data.song.SongRegistry;
import funkin.play.cutscene.CutsceneType;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.stage.StageProp;
import funkin.play.PlayStatePlaylist;
import funkin.modding.module.ModuleHandler;
import funkin.graphics.FunkinSprite;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;
import funkin.util.Constants;

import supereric.retrospecter.modules.RetroLanguage;

class SatisfractureSong extends Song
{
  var tweens = [];
  var pausedTweens = [];

  var ghostTap = Constants.GHOST_TAPPING;
  var hasPlayedInGameCutscene:Bool;
  var hasPlayedEndCutscene:Bool;
  var skipText:FlxText;
  var cutsceneSkipped:Bool = false;
  var canSkipCutscene:Bool = false;
  var cutsceneTimerManager:FlxTimerManager;
  var cutsceneSounds:Array<FunkinSound> = [];
  var isDoingEnough:Bool = false;

  var isMobile:Bool;
  var modcharts:Bool = true;
  var hasStoredStrums:Bool = false;

  var defaultStrumX:Array<Float> = [0, 0, 0, 0, 0, 0, 0, 0];
  var defaultStrumY:Array<Float> = [0, 0, 0, 0, 0, 0, 0, 0];
  var defaultOpponentStrumlineX:Float = 0;
  var defaultPlayerStrumlineX:Float = 0;

  var camHudAngle:Float = 0;
  var hudAlpha:Float = 1.0;
  var showOnlyStrums:Bool = false;

  var mcSway:Bool = false;
  var mcQuickdraw:Bool = false;
  var mcQuickdraw2:Bool = false;
  var mcQuickdraw3:Bool = false;
  var mcQuickdraw4:Bool = false;
  var mcCrisscross:Bool = false;
  var mcCrisscross2:Bool = false;
  var mcSpeedy:Bool = false;
  var mcFadingCrissCross:Bool = false;
  var mcDidFinalFade:Bool = false;

  var beepSound:FunkinSound;
  var micSound:FunkinSound;
  var cutsceneMusic:FunkinSound;

  var cutsceneConductor:Conductor;
  var bgSprite:FunkinSprite;

  public function new()
  {
    super('satisfracture');

    hasPlayedInGameCutscene = false;
    hasPlayedEndCutscene = false;
    hasStoredStrums = false;
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    //PlayState.instance.startTimestamp = 115000; // tests

    if (!PlayStatePlaylist.isStoryMode || playState.isChartingMode) hasPlayedInGameCutscene = true;

    if (!hasPlayedInGameCutscene) {
      hasPlayedInGameCutscene = true;
      event.cancel(); // CANCEL THE COUNTDOWN!

      playState.camHUD.visible = false;

      /*bgSprite = new FunkinSprite(0, 0);
      bgSprite.makeSolidColor(2000, 2500, 0xFF000000);
      bgSprite.cameras = [PlayState.instance.camCutscene]; // Show over the HUD but below the video.
      bgSprite.zIndex = 100000;
      bgSprite.visible = false;
      PlayState.instance.add(bgSprite);
      PlayState.instance.refresh();*/

      loadIntroSounds();
      PlayState.instance.currentStage.getDad().playAnimation('introIdle', true);
      var rd = ModuleHandler.getModule('RetroDialogue');
      rd.scriptCall('startDialogue', ['satisfracture story', 'pre', function() {
        introCutscene();
        PlayState.instance.tweenCameraZoom(PlayState.instance.stageZoom, 0.5, true, FlxEase.circOut);
      }]);
    }

  }

  override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    if (!hasStoredStrums && modcharts) storeDefaultStrums();
  }


  function introCutscene() {
    //bgSprite.visible = true;
    playState.togglePauseButton(true);
    playState.isInCutscene = true;
    playState.mayPauseGame = false;

    skipText = new FlxText(0, 618 * FullScreenScaleMode.wideScale.y, 0,
      RetroLanguage.tf('cutscene.text.skip', [' ' + PlayState.instance.controls.getDialogueNameFromToken("CUTSCENE_ADVANCE", true) + ' ']), 20);
    if (FlxG.onMobile) {
      skipText.text = RetroLanguage.tf('cutscene.text.skip', [RetroLanguage.t('action.button.pause', 'Pause Button')]);
    }
    skipText.fieldWidth = 1000 * FullScreenScaleMode.wideScale.x;
    skipText.screenCenter(0x01);
    skipText.setFormat(Paths.font('vcr.ttf'), 40, 0xFFFFFFFF, "right", FlxTextBorderStyle.OUTLINE, 0xFF000000);
    skipText.scrollFactor.set();
    skipText.borderSize = 2;
    skipText.alpha = 0;
    PlayState.instance.currentStage.add(skipText);
    skipText.cameras = [PlayState.instance.camCutscene];

    var bfPos:Array<Float> = [
      PlayState.instance.currentStage.getBoyfriend().cameraFocusPoint.x,
      PlayState.instance.currentStage.getBoyfriend().cameraFocusPoint.y
    ];
    var gfPos:Array<Float> = [
      PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint.x,
      PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint.y
    ];
    var retro = playStage.getDad();
    var retroPos:Array<Float> = [
      retro.cameraFocusPoint.x,
      retro.cameraFocusPoint.y
    ];

    retro.playAnimation('introIdle', true);

    var cutsceneDelay = 1;
    var cutsceneAdjust = -0.3;

    cutsceneConductor = new Conductor();
    cutsceneConductor.forceBPM(140);
    cutsceneConductor.onBeatHit.add(onCutsceneBeatHit);
    cutsceneMusic = FunkinSound.load(Paths.music("freakyMenu/freakyMenu"), true);
    cutsceneMusic.volume = 0;
    cutsceneMusic.play(false);
    cutsceneTimerManager = new FlxTimerManager();

    // Início
    new FlxTimer(cutsceneTimerManager).start(0.1, function(tmr) {
      /*FlxTween.tween(bgSprite, {alpha: 0}, 1.7, null, function() {
        bgSprite.visible = false;
      });*/
    });

    // Câmera vai até boyfriend.
    new FlxTimer(cutsceneTimerManager).start(cutsceneDelay, function(tmr) {
      playState.cameraFollowPoint.setPosition(bfPos[0] + -50, bfPos[1] - 100);
      //playState.tweenCameraToPosition(bfPos[0] + -50, bfPos[1] - 100, 2.5, FlxEase.expoOut); //x, y, rot? eu acho
    });
    // beep + micsound
    new FlxTimer(cutsceneTimerManager).start(1.7 + cutsceneDelay + cutsceneAdjust, function(tmr) {
      playStage.getBoyfriend().playAnimation('singUP', true);
      beepSound.play();
    });
    new FlxTimer(cutsceneTimerManager).start(1.723 + cutsceneDelay + cutsceneAdjust, function(tmr) {
      micSound.play();
    });
    /* after beep (o jogo ja muda pro idle)
    new FlxTimer().start(2.4 + cutsceneDelay, function(tmr) {
      playStage.getBoyfriend().playAnimation('idle', true);
    }); */
    // retro acorda
    new FlxTimer(cutsceneTimerManager).start(2.65 + cutsceneDelay + cutsceneAdjust, function(tmr) {
      retro.playAnimation('intro', true);
    });

    // Cutscene acaba.
    new FlxTimer(cutsceneTimerManager).start(6.3 - 0.5 + cutsceneDelay + cutsceneAdjust, function(tmr) {
      cutsceneSkipped = true;
      canSkipCutscene = false;
      FlxTween.tween(skipText, {alpha: 0}, 0.5, {
        ease: FlxEase.quadIn,
        onComplete: _ ->
        {
          skipText.visible = false;
        }
      });
    });
    new FlxTimer(cutsceneTimerManager).start(6.3 + cutsceneDelay + cutsceneAdjust, function(tmr) {
      skipCutscene();
    });
  }

  function skipCutscene():Void {
    if (cutsceneMusic != null) cutsceneMusic.stop();
    if (cutsceneTimerManager != null) cutsceneTimerManager.clear();

    PlayState.instance.togglePauseButton(true);
    PlayState.instance.isInCutscene = false;
    PlayState.instance.mayPauseGame = true;
    PlayState.instance.startCountdown();

    skipText.visible = false;
  }

  function loadIntroSounds() {
    cutsceneSounds = [];
    beepSound = FunkinSound.load(Paths.sound("beep"), true);
    beepSound.volume = 1;
    cutsceneSounds.push(beepSound);

    micSound = FunkinSound.load(Paths.sound("phase1intro"), true);
    micSound.volume = 1;
    cutsceneSounds.push(micSound);
  }

  public override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGameOverState) return;

    var retro = playStage?.getDad();
    var retroPos:Array<Float> = [
      retro?.cameraFocusPoint.x,
      retro?.cameraFocusPoint.y
    ];

    // ENOUGH
    if (event.step == 176) {
      playState.cameraFollowPoint.setPosition(retroPos[0] - 350, retroPos[1]);
    }
    if (event.step == 188) {
      isDoingEnough = true;
      playState.mayPauseGame = false;
      playState.tweenCameraToPosition(retroPos[0] - 200, retroPos[1] - 100, 0.2, FlxEase.expoOut);
      tweens.push(FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 0},
        (Conductor.instance.stepLengthMs * 0.5) / 1000, {ease: FlxEase.linear}));

      // modchart: fade opponent strums
      if (modcharts) {
        for (i in 0...4) tweenFadeOut(i, 0, 0.4);
      }
    }
    if (event.step == 192) {
      playState.mayPauseGame = true;
      isDoingEnough = false;
      playState.tweenCameraToPosition(retroPos[0], retroPos[1], 0);
      PlayState.instance.opponentStrumline.alpha = 1;
      PlayState.instance.camGame.flash(0xFFFFFFFF, 0.3);
      PlayState.instance.camHUD.flash(0xFFFFFFFF, 0.2);

      // modchart: restaura HUD e strums do player
      if (modcharts) {
        for (i in 0...8) tweenFadeIn(i, 1, 0.01);
        showOnlyStrums = false;
        PlayState.instance.camHUD.alpha = 1;
        hudAlpha = 1.0;
      }
    }
    if (event.step >= 193 && event.step < 260) {
      playState.mayPauseGame = true;
      isDoingEnough = false;
      PlayState.instance.playerStrumline.alpha = 1;
      PlayState.instance.opponentStrumline.alpha = 1;
    }

    var healthBar = [
      playState.healthBar,
      playState.healthBarBG,
      playState.scoreText,
      playState.iconP2,
      playState.iconP1
    ];

    if (PlayStatePlaylist.isStoryMode) {
      if (event.step == 1120) {
        tweens.push(FlxTween.tween(PlayState.instance.opponentStrumline, {alpha: 0},
          (Conductor.instance.stepLengthMs * 5) / 1000, {ease: FlxEase.linear}));
      }

      var noteFadeDuration:Float = 2;
      var heightOffset:Float = FlxG.height + 50;

      if (event.step == 1146) {
        tweens.push(FlxTween.tween(PlayState.instance.playerStrumline.strumlineNotes.members[1],
          {y: heightOffset}, noteFadeDuration, {ease: FlxEase.quadOut}));
      }
      if (event.step == 1148) {
        tweens.push(FlxTween.tween(PlayState.instance.playerStrumline.strumlineNotes.members[2],
          {y: heightOffset}, noteFadeDuration + 1, {ease: FlxEase.quadOut}));
      }
      if (event.step == 1150) {
        tweens.push(FlxTween.tween(PlayState.instance.playerStrumline.strumlineNotes.members[3],
          {y: heightOffset}, noteFadeDuration, {ease: FlxEase.quadOut}));
      }
      if (event.step == 1153) {
        tweens.push(FlxTween.tween(PlayState.instance.playerStrumline, {alpha: 0},
          (Conductor.instance.stepLengthMs * 19) / 1000, {ease: FlxEase.linear}));
        tweens.push(FlxTween.tween(PlayState.instance.playerStrumline.strumlineNotes.members[0],
          {x: PlayState.instance.playerStrumline.strumlineNotes.members[0].x - 40},
          (Conductor.instance.stepLengthMs * 19) / 1000, {ease: FlxEase.quadInOut}));
        for (bar in healthBar) {
          tweens.push(FlxTween.tween(bar, {alpha: 0},
            (Conductor.instance.stepLengthMs * 18) / 1000, {ease: FlxEase.linear}));
        }
      }
    }

    if (!modcharts) return;

    if ((event.step >= 578 && event.step < 600) || (event.step >= 706 && event.step < 760) || (event.step >= 840 && event.step < 896) || (event.step >= 1030 && event.step < 1144))
    {
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX;
      PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX;
      for (i in 0...8) {
        setStrumX(i, defaultStrumX[i]);
        setStrumY(i, defaultStrumY[i]);
        setStrumAngle(i, 0);
      }
    }

    // hudAlpha fade a partir de step 1169
    if (event.step > 1169) {
      hudAlpha -= 0.1;
      if (hudAlpha < 0) hudAlpha = 0;
    }

    // Sway
    if (!mcSway && ((event.step >= 192 && event.step < 320) || (event.step >= 448 && event.step < 576) || (event.step >= 832 && event.step < 1024)))
    {
      mcSway = true;
    }
    else if (mcSway && ((event.step >= 320 && event.step < 448) || (event.step >= 576 && event.step < 832) || event.step >= 1024))
    {
      mcSway = false;
      PlayState.instance.camHUD.angle = 0;
    }

    // Quickdraw
    if (!mcQuickdraw && event.step >= 320 && event.step < 448)
      mcQuickdraw = true;
    else if (mcQuickdraw && event.step >= 448)
      mcQuickdraw = false;

    if (!mcQuickdraw2 && event.step >= 448 && event.step < 576)
      mcQuickdraw2 = true;
    else if (mcQuickdraw2 && event.step >= 576) {
      mcQuickdraw2 = false;
      for (i in 0...8) setStrumY(i, defaultStrumY[i]);
    }

    if (!mcQuickdraw3 && event.step >= 960 && event.step < 992) {
      mcQuickdraw3 = true;
    }
    else if (mcQuickdraw3 && event.step >= 992) {
      mcQuickdraw3 = false;
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX;
      PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX;
    }

    if (!mcQuickdraw4 && event.step >= 992 && event.step < 1024)
      mcQuickdraw4 = true;
    else if (mcQuickdraw4 && event.step >= 1024) {
      mcQuickdraw4 = false;
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX;
      PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX;
    }

    // Criss-Cross fade
    if (!mcFadingCrissCross && ((event.step >= 640 && event.step < 704) || (event.step >= 832 && event.step < 960)))
    {
      for (i in 0...4) tweenFadeOut(i, 0.3, 0.4);
      mcFadingCrissCross = true;
    }
    if (mcFadingCrissCross && ((event.step >= 704 && event.step < 832) || (event.step >= 960 && event.step < 1024)))
    {
      for (i in 0...4) tweenFadeIn(i, 1, 0.4);
      mcFadingCrissCross = false;
    }

    if (!mcCrisscross && event.step >= 640 && event.step < 704)
      mcCrisscross = true;
    else if (mcCrisscross && event.step >= 704 && event.step < 832) {
      mcCrisscross = false;
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX;
      PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX;
    }

    if (!mcCrisscross2 && event.step >= 832 && event.step < 960)
      mcCrisscross2 = true;
    else if (mcCrisscross2 && event.step >= 960) {
      mcCrisscross2 = false;
      //PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX;
      //PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX;
      for (i in 0...8) setStrumY(i, defaultStrumY[i]);
    }

    // Speedy
    if (!mcSpeedy && event.step >= 768 && event.step < 832)
      mcSpeedy = true;
    else if (mcSpeedy && event.step >= 832)
      mcSpeedy = false;

    // Spin strums
    if (event.step == 576 || event.step == 704 || event.step == 1024) {
      for (i in 0...8) {
        tweenPosXAngle(i, defaultStrumX[i], getStrumAngle(i) + 360, 0.2);
        setStrumY(i, defaultStrumY[i]);
      }
    }

    // Fade final
    if (PlayStatePlaylist.isStoryMode && !mcDidFinalFade && event.step >= 1152) {
      for (i in 4...8) tweenFadeOut(i, 0, 3);
      tweenStrumX(4, 600, 2);
      mcDidFinalFade = true;
    }
  }

  function onCutsceneBeatHit()
  {
    if (!PlayState.instance.isInCutscene) return;
    //if (PlayState.instance.currentStage.getGirlfriend().isAnimationFinished()) {
      PlayState.instance.currentStage.getGirlfriend().dance(true);
      //}
    if (cutsceneConductor.currentBeat % 2 == 0) {
      PlayState.instance.currentStage.getNamedProp('velasma').dance(true);
      PlayState.instance.currentStage.getNamedProp('serpenscheme').dance(true);
      PlayState.instance.currentStage.getNamedProp('cat').dance(true);
    }
    if (PlayState.instance.currentStage.getBoyfriend().isAnimationFinished()
      && PlayState.instance.currentStage.getBoyfriend().getCurrentAnimation() != 'singUP')
    {
      PlayState.instance.currentStage.getBoyfriend().dance(true);
    }
  }

  var stoppedEnough:Bool = false;

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (!stoppedEnough && event.beat >= 48) {
      PlayState.instance.camHUD.flash(0xFFFFFFFF, 0.2);

      playState.currentStage.getBoyfriend().playAnimation('singLEFTmiss', true);
      PlayState.instance.tweenCameraZoom(playState.defaultCameraZoom, 0);

      playState.mayPauseGame = true;
      isDoingEnough = false;

      stoppedEnough = true;
    }
  }

  override function onNoteGhostMiss(event)
  {
    super.onNoteGhostMiss(event);
    if (isDoingEnough && PlayState.instance != null) {
      event.cancel();
      event.stopPropagation();
    }
  }

  // what??
  /*override private function onStateChangeEnd(event)
	{
    if (isDoingEnough) {
		  Constants.GHOST_TAPPING = true;
    } else {
      #if FEATURE_GHOST_TAPPING
		  Constants.GHOST_TAPPING = true;
      #else
      Constants.GHOST_TAPPING = false;
      #end
    }

		super.onStateChangeEnd(event);
	}*/

  override function onDestroy(event)
	{
		super.onDestroy(event);
    cutsceneSounds = [];
    hasPlayedInGameCutscene = false;
    hasPlayedEndCutscene = false;
    isDoingEnough = false;
    stoppedEnough = false;
    hudAlpha = 1.0;
    mcSway = false;
    mcQuickdraw = false;
    mcQuickdraw2 = false;
    mcQuickdraw3 = false;
    mcQuickdraw4 = false;
    mcCrisscross = false;
    mcCrisscross2 = false;
    mcSpeedy = false;
    mcFadingCrissCross = false;
    mcDidFinalFade = false;
    hasStoredStrums = false;
		resetTweens();
	}

	private function resetTweens()
	{
		for (tween in tweens)
		{
			if (tween != null)
				tween.cancel();
		}
		tweens = [];
		pausedTweens = [];
	}

	override function onResume(event)
	{
		super.onResume(event);
		for (tween in pausedTweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = true;
			}
		}
		pausedTweens = [];
	}

	override function onPause(event)
	{
		super.onPause(event);
		pausedTweens = [];
		for (tween in tweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
	}

  /**
   * Don't replay the cutscene between restarts.
   */
  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    //playState.mayPauseGame = true;
    hasPlayedInGameCutscene = true;
    hasPlayedEndCutscene = false;
    isDoingEnough = false;

    PlayState.instance.playerStrumline.alpha = 1;
    PlayState.instance.opponentStrumline.alpha = 1;

    PlayState.instance.healthBar.alpha = 1;
    PlayState.instance.healthBarBG.alpha = 1;

    stoppedEnough = false;

    PlayState.instance.camHUD.angle = 0;
    PlayState.instance.camHUD.alpha = 1;
    hudAlpha = 1.0;
    mcSway = false;
    mcQuickdraw = false;
    mcQuickdraw2 = false;
    mcQuickdraw3 = false;
    mcQuickdraw4 = false;
    mcCrisscross = false;
    mcCrisscross2 = false;
    mcSpeedy = false;
    mcFadingCrissCross = false;
    mcDidFinalFade = false;
    PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX;
    PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX;
    for (i in 0...8) {
      setStrumX(i, defaultStrumX[i]);
      setStrumY(i, defaultStrumY[i]);
      setStrumAngle(i, 0);
    }
  }

  var isMobilePauseButtonPressed:Bool = false;

  function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (cutsceneTimerManager != null) cutsceneTimerManager.update(event.elapsed);
    if (cutsceneConductor != null && cutsceneMusic != null)
    {
      cutsceneConductor.update(cutsceneMusic.time);
    }

    if (FlxG.onMobile)
    {
      isMobilePauseButtonPressed = TouchUtil.overlapsComplex(PlayState.instance.pauseButton) && TouchUtil.justPressed;
    }

    if ((PlayState.instance.controls.CUTSCENE_ADVANCE || isMobilePauseButtonPressed) && !cutsceneSkipped)
    {
      if (!canSkipCutscene)
      {
        if (skipText != null)
        {
          FlxTween.tween(skipText, {alpha: 1}, 0.5, {ease: FlxEase.quadOut});
          new FlxTimer().start(0.5, _ ->
          {
            canSkipCutscene = true;
          });
        }
      }
    }
    if ((PlayState.instance.controls.CUTSCENE_ADVANCE || isMobilePauseButtonPressed) && !cutsceneSkipped && canSkipCutscene)
    {
      cutsceneSkipped = true;
      hasPlayedCutscene = true;
      PlayState.instance.camCutscene.fade(0xFF000000, 0.5, false, null, true);
      for (sound in cutsceneSounds) {
        if (sound == null) continue;
        sound.fadeOut(0.5, 0);
      }

      new FlxTimer().start(0.5, _ ->
      {
        PlayState.instance.justUnpaused = true;
        PlayState.instance.camCutscene.fade(0xFF000000, 0.5, true, null, true);
        PlayState.instance.currentStage.getDad().dance(true);
        PlayState.instance.currentStage.getBoyfriend().dance(true);
        skipCutscene();
        for (sound in cutsceneSounds) {
          if (sound == null) continue;
          sound.stop();
        }
      });
    }

    if (modcharts)
      updateModchart(event.elapsed);
  }

  function getStrum(i:Int) {
    if (i < 4)
      return PlayState.instance.opponentStrumline.strumlineNotes.members[i];
    return PlayState.instance.playerStrumline.strumlineNotes.members[i - 4];
  }

  function setStrumX(i:Int, val:Float) { getStrum(i).x = val; }
  function setStrumY(i:Int, val:Float) { getStrum(i).y = val; }
  function setStrumAngle(i:Int, val:Float) { getStrum(i).angle = val; }
  function getStrumAngle(i:Int):Float { return getStrum(i).angle; }

  function tweenStrumX(i:Int, x:Float, time:Float) {
    if (!hasStoredStrums) return;
    tweens.push(FlxTween.tween(getStrum(i), {x: x}, time));
  }
  function tweenStrumAngle(i:Int, angle:Float, time:Float) {
    tweens.push(FlxTween.tween(getStrum(i), {angle: angle}, time));
  }
  function tweenStrumAlpha(i:Int, alpha:Float, time:Float, ease:Dynamic) {
    tweens.push(FlxTween.tween(getStrum(i), {alpha: alpha}, time, {ease: ease}));
  }

  function tweenPosXAngle(i:Int, x:Float, angle:Float, time:Float) {
    if (!hasStoredStrums) return;
    tweenStrumX(i, x, time);
    tweenStrumAngle(i, angle, time);
  }
  function tweenFadeIn(i:Int, alpha:Float, time:Float) {
    tweenStrumAlpha(i, alpha, time, FlxEase.circIn);
  }
  function tweenFadeOut(i:Int, alpha:Float, time:Float) {
    tweenStrumAlpha(i, alpha, time, FlxEase.circOut);
  }

  function storeDefaultStrums() {
    for (i in 0...4) {
      defaultStrumX[i] = PlayState.instance.opponentStrumline.strumlineNotes.members[i].x;
      defaultStrumY[i] = PlayState.instance.opponentStrumline.strumlineNotes.members[i].y;
    }
    for (i in 0...4) {
      defaultStrumX[i + 4] = PlayState.instance.playerStrumline.strumlineNotes.members[i].x;
      defaultStrumY[i + 4] = PlayState.instance.playerStrumline.strumlineNotes.members[i].y;
    }
    defaultOpponentStrumlineX = PlayState.instance.opponentStrumline.x;
    defaultPlayerStrumlineX = PlayState.instance.playerStrumline.x;
    hasStoredStrums = true;
  }

  function updateModchart(elapsed:Float) {
    if (!hasStoredStrums) return;
    var songPos:Float = Conductor.instance.songPosition;
    var currentBeat:Float = Conductor.instance.currentBeatTime;

    if (mcSway) PlayState.instance.camHUD.angle = 5 * Math.sin(currentBeat * 0.504);

    if (mcQuickdraw) {
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX + 32 * Math.sin((currentBeat + 1 * 2) * Math.PI);
      PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX + 32 * Math.sin((currentBeat + 1 * 2) * Math.PI);
      for (i in 0...8) {
        setStrumY(i, defaultStrumY[i]);
      }
    }

    if (mcQuickdraw2) {
      for (i in 0...8) {
        setStrumX(i, defaultStrumX[i]);
        setStrumY(i, defaultStrumY[i] + 16 * Math.sin((currentBeat + i * 2) * Math.PI));
      }
    }

    /*if (mcQuickdraw3) {
      PlayState.instance.opponentStrumline.x = defaultPlayerStrumlineX + 32 * Math.sin((currentBeat + 1 * 2) * Math.PI);
      PlayState.instance.playerStrumline.x = defaultOpponentStrumlineX + 32 * Math.sin((currentBeat + 1 * 2) * Math.PI);
    }*/

    if (mcQuickdraw4) {
      //PlayState.instance.opponentStrumline.x = defaultPlayerStrumlineX;
      //PlayState.instance.playerStrumline.x = defaultOpponentStrumlineX;
      for (i in 4...8)
        setStrumY(i, defaultStrumY[i] + 16 * Math.sin((currentBeat + i) * Math.PI));
    }

    if (mcCrisscross) {
      var oppOffset:Float = 300 * Math.sin(currentBeat * 0.503) + 350 - 42;
      var plrOffset:Float = -300 * Math.sin(currentBeat * 0.503) - 275 - 42;
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX + oppOffset;
      if (!isMobile) PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX + plrOffset;
    }

    if (mcCrisscross2) {
      /*var oppOffset:Float = 300 * Math.sin(currentBeat * 0.504) + 350 - 42;
      var plrOffset:Float = -300 * Math.sin(currentBeat * 0.504) - 275 - 42;
      PlayState.instance.opponentStrumline.x = defaultOpponentStrumlineX + oppOffset;
      PlayState.instance.playerStrumline.x = defaultPlayerStrumlineX + plrOffset;*/
      for (i in 0...8)
        setStrumY(i, defaultStrumY[i] + 16 * Math.cos((currentBeat + i * 5) * Math.PI));
    }

    if (mcSpeedy) {
      for (i in 0...8)
        setStrumY(i, defaultStrumY[i] + 16 * Math.cos(currentBeat + i));
    }

    if (hudAlpha > 0) PlayState.instance.camHUD.alpha = hudAlpha;
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);

  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    isMobile = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;

    ModuleHandler.getModule('RetroTitle')?.scriptCall('load', ['retro/p1']);

    cutsceneSkipped = false;
    canSkipCutscene = false;
    cutsceneTimerManager = null;
    hasPlayedInGameCutscene = false;
    hasPlayedEndCutscene = false;
    hasStoredStrums = false;
    isDoingEnough = false;
    playState = PlayState.instance;
    playStage = PlayState.instance.currentStage;
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}
