import flixel.FlxG;
import flixel.FlxSprite;
import flixel.math.FlxBasePoint;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import flixel.math.FlxMath;
import funkin.Conductor;
import funkin.Preferences;
import funkin.FunkinMemory;
import funkin.modding.module.ModuleHandler;
import funkin.mobile.input.ControlsHandler;
import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.play.cutscene.CutsceneType;
import funkin.play.cutscene.VideoCutscene;
import funkin.play.PlayStatePlaylist;
import funkin.graphics.FunkinSprite;
import funkin.ui.FullScreenScaleMode;
import haxe.ds.IntMap;

class CatastrofiendSong extends Song
{
  var tweens = [];
  var pausedTweens = [];
  var hasPlayedCutscene:Bool;
  var hasPlayedEndCutscene:Bool;
  var bgSprite:FunkinSprite;
  var flashMultiply:FunkinSprite;
  var flashAdd:FunkinSprite;
  var didIntroAnim:Bool = false;
  var didHide:Bool = false;
  var didShowStrum:Bool = false;
  var hasCreatedSprites:Bool = false;
  var hasStoredStrums:Bool = false;
  var retroNoteStyles = null;

  // Sistema para rastrear voicelines já tocadas
  var playedVoicelines:IntMap<Int, Bool>;
  var voicelineData:Array<VoicelineInfo>;

  // Modchart variables
  var isDownScroll:Bool = false;
  var modcharts:Bool = true;
  var flashingLights:Bool = true;
  var screenShake:Bool = true;
  var enabledUnderlay:Bool = false;

  // Beat timing arrays
  var smallFlashTime:Array<Int> = [32, 192];
  var strumPatternTime:Array<StrumPattern> = [
    {start: 15, stop: 384, finished: false},
    {start: 448, stop: 832, finished: false}
  ];
  var bfFocusTime:Array<FocusTime> = [{start: 384, stop: 448}];
  var greenPulseTime:Array<PulseTime> = [{start: 440, stop: 832}];
  var greenIntensity:Float = 0.0;
  var roarTime:Array<Int> = [32, 704];

  // Store default strum positions
  var defaultPlayerStrumX:Array<Float> = [];
  var defaultPlayerStrumY:Array<Float> = [];

  public function new()
  {
    super('catastrofiend');

    hasPlayedCutscene = false;
    hasPlayedEndCutscene = false;

    // Inicializar o sistema de voicelines
    playedVoicelines = new IntMap();

    // Definir todas as voicelines com suas steps e animações
    voicelineData = [
      // Primeira seção
      {step: 512, animation: 'leaveNow', endStep: 545},
      {step: 576, animation: 'passDeez', endStep: 611},
      {step: 638, animation: 'tryYourBones', endStep: 672},
      {step: 706, animation: 'thisMeansWar', endStep: 767},

      // Segunda seção
      {step: 2304, animation: 'mudaChild', endStep: 2336},
      {step: 2368, animation: 'bigDisgrace', endStep: 2401},
      {step: 2432, animation: 'mudaChild', endStep: 2464}
    ];
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    hasPlayedEndCutscene = false;

    if (!PlayStatePlaylist.isStoryMode || PlayState.instance.isChartingMode) hasPlayedCutscene = true;

    if (!hasPlayedCutscene)
    {
      bgSprite = new FunkinSprite(0, 0);
      bgSprite.makeSolidColor(Std.int(FlxG.width * 1.2), Std.int(FlxG.height * 1.2), 0xFFFFFFFF);
      bgSprite.cameras = [PlayState.instance.camHUD];
      bgSprite.zIndex = 1000000;
      bgSprite.alpha = 1;
      PlayState.instance.add(bgSprite);
      PlayState.instance.refresh();

      hasPlayedCutscene = true;

      VideoCutscene.onVideoEnded.addOnce(function() {
          FlxTween.tween(bgSprite, {alpha: 0}, 1.5, null, function() {
            bgSprite.visible = false;
          });
      });

      event.cancel(); // CANCEL THE COUNTDOWN!

      VideoCutscene.play(Paths.videos('Phase4'));
    }
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);

    if (retroNoteStyles == null) retroNoteStyles = ModuleHandler.getModule('RetroNoteStyles');

    if (PlayState.instance.startTimestamp <= 10000) {
      if (modcharts)
      {
        for (note in PlayState.instance.playerStrumline.strumlineNotes.members)
        {
          FlxTween.cancelTweensOf(note, ['alpha']);
          note.alpha = 0;
        }
      }

      var underlay = retroNoteStyles.scriptCall('getUnderlay', [true]);
      if (underlay != null) underlay.colorTransform.alphaOffset = -255;
    } else {
      didIntroAnim = true;
    }
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);

    // Store default strum positions
    var playerStrums = PlayState.instance.playerStrumline;
    if (!hasStoredStrums) {
      for (strum in playerStrums.strumlineNotes)
      {
        defaultPlayerStrumX.push(strum.x);
        defaultPlayerStrumY.push(strum.y);

      }
      defaultPlayerStrumX.push(playerStrums.x);
      defaultPlayerStrumY.push(playerStrums.y);
      hasStoredStrums = true;
    }
    if (PlayState.instance.startTimestamp <= 10000) {
      FlxG.signals.postUpdate.addOnce(function() {
          if (modcharts && !didIntroAnim)
          {
            for (strum in playerStrums.strumlineNotes)
            {
              strum.y += 800;
              strum.alpha = 1;
            }
          }
      });
    }
  }

  public override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (modcharts)
    {
      strumMovePattern();
      updateGreenColor(event.elapsed);
    }
  }

  public override function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);
    PlayState.instance.camCutscene.stopFade();
  }

  public override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (modcharts)
    {
      introEvent(event.beat);
      greenPulseEvent(event.beat);
    }

    if (flashingLights)
    {
      smallFlashEvent(event.beat);
    }

    if (screenShake)
    {
      roarEvent(event.beat);
    }

    if (event.beat >= 832 && !hasPlayedEndCutscene) {
      ModuleHandler.getModule('RetroPlayState').scriptCall('funnyFunction', []);
      if (!PlayStatePlaylist.isStoryMode) {
        PlayState.instance.camCutscene.fade(FlxColor.WHITE, 0.4, false, null, true);
        hasPlayedEndCutscene = true;
      }

      if (!hasPlayedEndCutscene)
      {
        hasPlayedEndCutscene = true;
        PlayState.instance.isInCutscene = true;
        PlayState.instance.mayPauseGame = false;

        event.cancel();

        // start the video cutscene
        startFinale();
      }
    }
  }

  function strumMovePattern():Void
  {
    if (!hasStoredStrums) return;
    for (r in strumPatternTime)
    {
      if (r.finished) continue;
      var curBeat:Int = Conductor.instance.currentBeat;

      if (curBeat >= r.start && curBeat < r.stop) {
          var beat:Float = Conductor.instance.songPosition / Conductor.instance.beatLengthMs;
          var offset:Float = Math.cos(beat * Math.PI / 2.0) * 5.0;

          for (i in 0...4) {
            PlayState.instance.playerStrumline.strumlineNotes.members[i].y = defaultPlayerStrumY[i] + offset;
          }
      }
      else if (curBeat >= r.stop)
      {
        r.finished = true;
      }
    }
  }

  function introEvent(beat:Int):Void
  {
    if (hasStoredStrums && !didIntroAnim && beat >= 11) {
      var beatLength:Float = Conductor.instance.beatLengthMs / 1000;
      didIntroAnim = true;
      for (i in 0...4) {
        var playerStrum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        FlxTween.cancelTweensOf(playerStrum);
        playerStrum.alpha = 1;
        tweens.push(FlxTween.tween(playerStrum, {y: defaultPlayerStrumY[i]}, beatLength * 4, {ease: FlxEase.backOut}));
      }

      var underlay = retroNoteStyles.scriptCall('getUnderlay', [true]);
      if (underlay != null) tweens.push(FlxTween.tween(underlay.colorTransform, {alphaOffset: 0}, beatLength * 4, {ease: FlxEase.quadIn}));
    }
  }

  function smallFlashEvent(beat:Int):Void
  {
    for (flashBeat in smallFlashTime)
    {
      if (beat == flashBeat)
      {
        darkFlash();
      }
    }
  }

  function greenPulseEvent(beat:Int):Void
  {
    for (pulse in greenPulseTime)
    {
      if (beat >= pulse.start && beat <= pulse.stop)
      {
        if (beat % 4 == 0)
        {
          greenIntensity = 2;
        }
      }
    }
  }

  function roarEvent(beat:Int):Void
  {
    for (roarBeat in roarTime)
    {
      if (beat == roarBeat)
      {
        // Apply camera shake
        var conductor = Conductor.instance;
        var crochet = conductor.crochet / 1000;

        //FlxG.camera.shake(0.015, crochet * 16);
        PlayState.instance.camHUD.shake(0.015, crochet * 16);
        PlayState.instance.camGame.shake(0.015, crochet * 16);
      }
    }
  }

  function darkFlash():Void
  {
    // Camera zoom
    PlayState.instance.camGame.zoom += 0.02;
    PlayState.instance.camHUD.zoom += 0.035;

    // Create flash effects
    flashMultiply.active = true;
    flashMultiply.alpha = 0.6;

    FlxTween.tween(flashMultiply, {alpha: 0}, 0.35, {
      ease: FlxEase.circOut,
      onComplete: function(t) {
        if (PlayState.instance == null) return;
        // flashMultiply.destroy();
      }
    });

    if (flashingLights)
    {
      flashAdd.active = true;
      flashAdd.alpha = 0.25;

      FlxTween.tween(flashAdd, {alpha: 0}, 0.5, {
        ease: FlxEase.quadIn,
        onComplete: function(t) {
          if (PlayState.instance == null) return;
          // flashAdd.destroy();
        }
      });
    }
  }

  function updateGreenColor(elapsed:Float):Void
  {
    if (greenIntensity > 0.001)
    {
      // DECAIMENTO:
      // Quanto maior o número, mais rápido volta ao normal.
      var decaySpeed:Float = 4.0;

      // Essa fórmula faz o valor deslizar suavemente de onde está para 0
      greenIntensity = FlxMath.lerp(greenIntensity, 0, elapsed * decaySpeed);

      for (strum in PlayState.instance.playerStrumline.strumlineNotes)
      {
        if (strum.colorTransform.redMultiplier == 0.3) continue; // Essa cor é pra quando o strum está locked, então a gente não vai querer mexer.
        strum.colorTransform.redMultiplier = FlxMath.lerp(1.0, 0.6, greenIntensity);
        strum.colorTransform.greenMultiplier = FlxMath.lerp(1.0, 1.39, greenIntensity);
        strum.colorTransform.blueMultiplier = FlxMath.lerp(1.0, 1.13, greenIntensity);
      }
    }
    else
    {
      greenIntensity = 0;
    }
  }

  public function onStepHit(event) {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    var dad = PlayState.instance.currentStage.getDad();

    var currentStep = event.step;

    // Processar cada voiceline
    for (voiceline in voicelineData) {
      // Verificar se a step atual está no range da voiceline e se ainda não foi tocada
      if (currentStep >= voiceline.step && currentStep < voiceline.endStep) {
        // Verificar se esta voiceline ainda não foi tocada
        if (!playedVoicelines.exists(voiceline.step)) {
          dad.playAnimation(voiceline.animation, true);
          playedVoicelines.set(voiceline.step, true);
        }
      }
      // Voltar para idle quando passar do endStep
      else if (currentStep == voiceline.endStep) {
        dad.playAnimation('idle', false);
      }
    }
  }

   public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
  }

  function startFinale()
  {
    if (FlxG.onMobile)
    {
      FlxTween.tween(PlayState.instance.pauseButton,
        {x: (FlxG.width - PlayState.instance.pauseButton.width) - (40 + (FullScreenScaleMode.gameCutoutSize.x / 2))}, 1.0, {ease: FlxEase.quintOut});
    }

    VideoCutscene.onVideoEnded.addOnce(function() {
      // Make sure the cutscene can play again next time!
      hasPlayedEndCutscene = false;
      PlayState.instance.isInCutscene = false;
      PlayState.instance.mayPauseGame = true;
      if (FlxG.onMobile)
      {
        PlayState.instance.pauseButton.x = (FlxG.width - PlayState.instance.pauseButton.width) - Math.max(40, FullScreenScaleMode.gameNotchSize.x);
      }
      FullScreenScaleMode.removeCutouts();
    });

    PlayState.instance.camHUD.visible = false;

    PlayState.instance.isInCutscene = true;
    //hasPlayedEndCutscene = true;

    PlayState.instance.currentStage.getBoyfriend().danceEvery = 0;
    PlayState.instance.currentStage.getGirlfriend().danceEvery = 0;

    // Add a black background behind the cutscene to fix a transition bug!
    var bgSprite = new FunkinSprite(-100, -100);
    bgSprite.makeSolidColor(2000, 2500, 0xFF000000);
    bgSprite.cameras = [PlayState.instance.camHUD]; // Show over the HUD.
    bgSprite.zIndex = 1000000;
    PlayState.instance.add(bgSprite);
    PlayState.instance.refresh();

    VideoCutscene.play(Paths.videos('Phase4_OUTRO'), CutsceneType.ENDING);
  }

  override function onDestroy(event)
	{
		super.onDestroy(event);
    hasCreatedSprites = false;
    retroNoteStyles = null;
    didIntroAnim = false;
		resetTweens();
	}

	private function resetTweens()
	{
		for (tween in tweens)
		{
			if (tween != null)
				tween.cancel();
		}
		tweens = [];
		pausedTweens = [];
	}

	override function onResume(event)
	{
		super.onResume(event);
		for (tween in pausedTweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = true;
			}
		}
		pausedTweens = [];
	}

	override function onPause(event)
	{
		super.onPause(event);
		pausedTweens = [];
		for (tween in tweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
	}

  /**
   * Don't replay the cutscene between restarts.
   */
  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    hasPlayedEndCutscene = true;
    didHide = false;
    didShowStrum = false;

    // Resetar o sistema de voicelines
    playedVoicelines = new IntMap();

    // Reset modchart state
    for (pattern in strumPatternTime)
    {
      pattern.finished = false;
    }

    PlayState.instance.camCutscene.fade(FlxColor.TRANSPARENT, 0, false, null, true);
  }

  /**
   * Replay the cutscene after leaving the song.
   */
  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    hasPlayedEndCutscene = false;
    hasStoredStrums = false;
    didHide = false;
    didShowStrum = false;
    didIntroAnim = false;
    flashingLights = Preferences.flashingLights ?? false;

    // Check if downscroll
    isDownscroll = Preferences.downscroll;
    if(FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) isDownscroll = true;

    // Resetar o sistema de voicelines
    playedVoicelines = new IntMap();

    // Reset modchart state
    for (pattern in strumPatternTime)
    {
      pattern.finished = false;
    }

    if (hasCreatedSprites) return;
    flashMultiply = FunkinSprite.create(0, 0);
    flashMultiply.makeGraphic(Std.int(FlxG.width * 4), Std.int(FlxG.height * 4), FlxColor.fromRGB(4, 254, 131));
    flashMultiply.scrollFactor.set(0, 0);
    flashMultiply.screenCenter();
    flashMultiply.alpha = 0;
    flashMultiply.blend = 9; //multiply
    flashMultiply.zIndex = 10000;
    flashMultiply.active = false;
    PlayState.instance.add(flashMultiply);

    flashAdd = FunkinSprite.create(0, 0);
    flashAdd.makeGraphic(Std.int(FlxG.width * 4), Std.int(FlxG.height * 4), FlxColor.fromRGB(4, 254, 131));
    flashAdd.scrollFactor.set(0, 0);
    flashAdd.screenCenter();
    flashAdd.alpha = 0;
    flashAdd.blend = 0;
    flashAdd.zIndex = 100001;
    flashAdd.active = false;
    PlayState.instance.add(flashAdd);
    //PlayState.instance.refresh();

    FunkinMemory.cacheTexture(Paths.image('characters/BfSkins/wrath_bf', "shared"));

    hasCreatedSprites = true;
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    return !Save.instance.hasBeatenSong(this.id, null);
  }
}

// Typedef para armazenar informações de voiceline
typedef VoicelineInfo = {
  var step:Int;           // Step onde a voiceline começa
  var animation:String;   // Nome da animação
  var endStep:Int;        // Step onde volta para idle
}

// Typedefs para o modchart
typedef StrumPattern = {
  var start:Int;
  var stop:Int;
  var finished:Bool;
}

typedef FocusTime = {
  var start:Int;
  var stop:Int;
}

typedef PulseTime = {
  var start:Int;
  var stop:Int;
}
