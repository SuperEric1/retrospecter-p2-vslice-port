import funkin.effects.IntervalShake;
import funkin.util.TouchUtil;
import haxe.ds.IntMap;

import openfl.filters.ShaderFilter;
import funkin.graphics.shaders.WiggleEffectRuntime;
import funkin.graphics.shaders.WiggleEffectType;

class RetroPlayState extends Module {
  public function new() {
    super('RetroPlayState');
  }

  var isRetro:Bool = false;
  var isDoingVocalThing:Bool = false;
  var isDownscroll:Bool = false;

  var tweens = [];
  var pausedTweens = [];
  var hasCachedTextures:Bool = false;
  var hasLoadedUIElements:Bool = false;

  var healthBarOgPos:Array<Float, Float> = [];
  var healthBarBgOgPos:Array<Float, Float> = [];
  var ogStrumsX:Array<Float> = [];
  var ogStrumsY:Array<Float> = [];
  var ogOppStrumsX:Array<Float> = [];
  var ogOppStrumsY:Array<Float> = [];

  var poisonSprite:FunkinSprite;
  var poisonText:FlxText;
  var hasAddedPoisonTxt:Bool = false;
  var poisonAmount:Int = 0;
  var poisonSpriteYOffset:Float = 0;
  var poisonTextYOffset:Float = 0;

  var izzyMechanicTimer:FlxTimer;
  var izzyMechanicEndTween:FlxTween;
  var isDrugged:Bool = false;
  var wiggleShader:FlxRuntimeShader = null;

  var solidCameraSprite:FunkinSprite;

  // Chain Notes - Sistema de bloqueio de strums
  var chainLockSprites:Array<FunkinSprite> = [];
  var chainLockStates:IntMap<Int> = new IntMap(); // 0 = desbloqueado, 1-3 = numero de cliques
  var chainLockInputs:IntMap<Int> = new IntMap();
  var isStrumLocked:IntMap<Bool> = new IntMap();
  var chainText:FlxText;

  // Hydra Notes - Sistema de beam que cobre os strums
  var hydraBeamSprites:Array<FunkinSprite> = [];
  var hydraBeamTimers:Array<FlxTimer> = [];
  var hydraBeamStates:IntMap<Int> = new IntMap(); // 0 = inativo, 1 = start, 2 = loop, 3 = end

  var hurtNoteVibration:VibrationPreset =
  {
    period: 0.2,
    duration: 0.2,
    amplitude: 1,
    sharpness: 1
  };

  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    if (!isRetro) return;
    poisonAmount = 0;
    isDrugged = false;
    izzyMechanicTimer = null;

    // Inicializar sistema de chain notes
    for (i in 0...4) {
      isStrumLocked.set(i, false);
      chainLockStates.set(i, 0);
      chainLockInputs.set(i, 0);
    }

    // Inicializar sistema de hydra beams
    for (i in 0...4) {
      hydraBeamStates.set(i, 0);
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
    }
  }

  function onNoteIncoming(event) {
    if (PlayState.instance == null) return;
    if (!isRetro) return;

    if (izzyMechanicTimer != null) {
      event.note.angle = 0;
    }
    var k = event.note.noteData.kind;

    // Notas removíveis
    if (k == 'none') {
      if (event.note.noteData.getMustHitNote()) {
        Highscore.tallies.totalNotes--;
      }
			event.cancelEvent();
      event.stopPropagation();
			event.note.kill();
    }

    // Notas que não contam pro score
    if (k == 'Fake Note' || k == 'poison' || k == 'izzyNote' ||
        k =='chain' || k == 'autoChain' || k == 'Hydra') {
      if (event.note.noteData.getMustHitNote()) {
        Highscore.tallies.totalNotes--;
      }
    }

    super('onNoteIncoming');
  }

  function onNoteHit(event:HitNoteScriptEvent):Void {
  if (PlayState.instance == null) return;
  if (!isRetro) return;
  if (event.note.noteData.getMustHitNote()) { // Só pro jogador!
    var k = event.note.noteData.kind;
    var noteDir = event.note.noteData.getDirection();

    // Prevenir que notas sejam acertadas em strums bloqueados
    if (isStrumLocked.get(noteDir)) {
      handleChainUnlockInput(noteDir);
      event.cancel();
      event.stopPropagation();
      return;
    }

    if (k == 'chain' || k == 'autoChain') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      lockStrum(noteDir);
      if (k == 'autoChain') chainText.visible = true;

      PlayState.instance.health -= event.healthChange;
      event.doesNotesplash = false;
      #if mobile
      HapticUtil.vibrateByPreset(hurtNoteVibration);
      #else
      if (FlxG.onMobile) HapticUtil.vibrateByPreset(hurtNoteVibration);
      #end
    }

    if (k == 'Hydra') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      playBeamAnimation(noteDir);
      FlxG.sound.play(Paths.sound('noteSounds/hydra'));

      PlayState.instance.health -= Constants.HEALTH_KILLER_BONUS;
      event.doesNotesplash = false;
      #if mobile
      HapticUtil.vibrateByPreset(hurtNoteVibration);
      #else
      if (FlxG.onMobile) HapticUtil.vibrateByPreset(hurtNoteVibration);
      #end
    }

    if (k == 'poison') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      poisonAmount++;
      updatePoisonCounter();
      PlayState.instance.health -= Constants.HEALTH_KILLER_BONUS;
      FlxG.sound.play(Paths.sound('acid'));
      event.doesNotesplash = false;
      #if mobile
      HapticUtil.vibrateByPreset(hurtNoteVibration);
      #else
      if (FlxG.onMobile) HapticUtil.vibrateByPreset(hurtNoteVibration);
      #end
    }

    if (k == 'izzyNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      PlayState.instance.health -= Constants.HEALTH_KILLER_BONUS;
      FlxG.sound.play(Paths.sound('noteSounds/Izzy'));
      event.doesNotesplash = false;
      if (solidCameraSprite != null) {
        solidCameraSprite.makeSolidColor(2000, 2500, 0xFF66FFF7);
      }

      FlxTween.cancelTweensOf(solidCameraSprite);
      solidCameraSprite.visible = true;

      if (Preferences.flashingLights) {
        //FlxTween.cancelTweensOf(solidCameraSprite);
        tweens.push(FlxTween.tween(solidCameraSprite, {alpha: 0.3}, 0.05, {ease: FlxEase.quadOut, onComplete: function(twn:FlxTween) {
          tweens.push(FlxTween.tween(solidCameraSprite, {alpha: 0.1}, 0.3, {ease: FlxEase.quadOut}));
        }}));
      } else if (izzyMechanicEndTween == null) {
        solidCameraSprite.alpha = 0.1;
      }

      scrambleStrumline();

      #if mobile
      HapticUtil.vibrateByPreset(hurtNoteVibration);
      #else
      if (FlxG.onMobile) HapticUtil.vibrateByPreset(hurtNoteVibration);
      #end
    }
  } // fim do if de checagem que é nota do player

    super('onNoteHit');
  }

  public override function onNoteMiss( event:NoteScriptEvent )
	{
    if (PlayState.instance == null) return;
    if (!isRetro) return;

    if (event.note.noteData.getMustHitNote()) { // Só pro jogador!
      var doesVocalThing = true;
      var k = event.note.noteData.kind;
      var noteDir = event.note.noteData.getDirection();
      if (k == "autoChain") {
        lockStrum(noteDir);
        if (k == 'autoChain') chainText.visible = true;
        doesVocalThing = false;

        event.note.kill();
        event.cancel();
        event.stopPropagation();
        // don't RETURN or else the custom UI will display as a miss
      }
      if (doesVocalThing) doVocalThing(); // efeito de miss nas vocais (caso seja uma nota normal)
    } //fim do if que checa se a nota é do jogador
    super.onNoteMiss(event);
	}
  public override function onNoteHoldDrop(event:HoldNoteScriptEvent) {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.holdNote.noteData.getMustHitNote()) { // Só pro jogador!
      doVocalThing(1.3); // efeito de miss nas vocais (caso seja uma nota normal)
    }
  }
  public override function onNoteGhostMiss(event:GhostMissNoteScriptEvent):Void {
    super('onNoteGhostMiss');
    if (PlayState.instance == null) return;
    if (!isRetro) return;

    // Prevenir ghost miss em strums bloqueados
    var direction = event.dir;
    if (isStrumLocked.get(direction)) {
      handleChainUnlockInput(direction);

      event.cancel();
      event.stopPropagation();
      return;
    }

    doVocalThing(); // efeito de miss nas vocais (caso seja uma nota normal)
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
    isRetro = PlayState.instance.playerStrumline.noteStyle.id == 'retrospecter';
    if (!isRetro) return;

    isDownscroll = Preferences.downscroll;
    if(FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) isDownscroll = true;

    //loadChainLockSprites();
    if (!hasLoadedUIElements) {
      poisonAmount = 0;
      loadUIElements();
      loadChainLockSprites();
      loadHydraBeamSprites();
      updatePoisonCounter();
      hasLoadedUIElements = true;
    }
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    if (!isRetro) return;

    // salvar posicao real dos strums
    healthBarOgPos = [PlayState.instance.healthBar.x, PlayState.instance.healthBar.y];
    healthBarBgOgPos = [PlayState.instance.healthBarBG.x, PlayState.instance.healthBarBG.y];
    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
      if (ogStrumsX[i] == null && ogStrumsY[i] == null) {
        ogStrumsX.push(strum.x);
        ogStrumsY.push(strum.y);
      }
      strum = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
      if (ogOppStrumsX[i] == null && ogOppStrumsY[i] == null) {
        ogOppStrumsX.push(strum.x);
        ogOppStrumsY.push(strum.y);
      }
    }
  }

  public override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
  }

  function scrambleStrumline() {
    if (izzyMechanicTimer != null) { //se acertar uma nota enquanto ja ta com o efeito, resetar strums e o timer pra acontecer novamente
      izzyMechanicTimer.cancel();
      izzyMechanicTimer = null;
      unscrambleStrumline(true);
    }
    if (izzyMechanicEndTween != null) {
      izzyMechanicEndTween.active = false;
      izzyMechanicEndTween.cancel();
      izzyMechanicEndTween = null;
    }

    if (!wiggleShader) {
      wiggleShader = new WiggleEffectRuntime(1, 0.5, 0.03, WiggleEffectType.FLAG);
      FlxG.camera.filters = [new ShaderFilter(wiggleShader)];
      PlayState.instance.camHUD.filters = [new ShaderFilter(wiggleShader)];
    }

    var objects = [
      PlayState.instance.playerStrumline.strumlineNotes.members[0],
      PlayState.instance.playerStrumline.strumlineNotes.members[1],
      PlayState.instance.playerStrumline.strumlineNotes.members[2],
      PlayState.instance.playerStrumline.strumlineNotes.members[3],
    ];
    if (poisonText != null) {
      objects.push(poisonText);
    }

    // Embaralhar strumline: essa função seta um ângulo aleatório negativo ou positivo com valor máximo para cada objeto passado.
    PlayState.instance.camHUD.angle = (FlxG.random.bool() ? 1 : -1) * FlxG.random.float(3, 7);
    for (obj in objects) {
      var angle = (FlxG.random.bool() ? 1 : -1) * FlxG.random.float(10, 40);
      obj.angle = angle;
      var y = (FlxG.random.bool() ? 1 : -1) * FlxG.random.float(5, 15);
      obj.y += y;
      IntervalShake.shake(obj, 0.3, 0.010, 0.010, 0.010, FlxEase.quadOut);
    }

    isDrugged = true;

    izzyMechanicTimer = new FlxTimer().start(6, function(tmr:FlxTimer) { //ao completar o timer
      if (PlayState.instance == null) {
        izzyMechanicTimer = null;
        return;
      }
      if(ReflectUtil.getClassNameOf(FlxG.state.subState) == 'funkin.play.GameOverSubState') return;
      unscrambleStrumline();
    });
  }
  function unscrambleStrumline(instant:Bool = false, clearCamera:Bool = true) {
    if (PlayState.instance == null) return;
    izzyMechanicTimer = null;
    isDrugged = false;
    wiggleShader = null;
    FlxG.camera.filters = [];
    PlayState.instance.camHUD.filters = [];

    // Se for instantâneo, aplicamos o valor direto e limpamos os tweens ativos das notas
    if (instant) {
        for (i in 0...4) {
            var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
            // Cancela tweens anteriores nessa nota para evitar conflito
            FlxTween.cancelTweensOf(note);
            note.x = ogStrumsX[i];
            note.y = ogStrumsY[i];
            note.angle = 0;
        }

        PlayState.instance.camHUD.angle = 0;
        if (solidCameraSprite != null && clearCamera) {
             solidCameraSprite.alpha = 0;
             solidCameraSprite.visible = false;
        }
        return; // Sai da função, não precisa criar tweens
    }

    // Lógica normal
    for (i in 0...4) {
        var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        // Importante: cancelar tweens velhos antes de começar novos no mesmo objeto
        FlxTween.cancelTweensOf(note);

        tweens.push(FlxTween.tween(note, {x: ogStrumsX[i]}, 1.5, {ease: FlxEase.quadOut}));
        tweens.push(FlxTween.tween(note, {y: ogStrumsY[i]}, 1.5, {ease: FlxEase.quadOut}));
    }

    var objects = [
      PlayState.instance.camHUD,
      PlayState.instance.playerStrumline.strumlineNotes.members[0],
      PlayState.instance.playerStrumline.strumlineNotes.members[1],
      PlayState.instance.playerStrumline.strumlineNotes.members[2],
      PlayState.instance.playerStrumline.strumlineNotes.members[3],
    ];
    if (poisonText != null) {
      objects.push(poisonText);
    }

    // Desembaralhar strumline: essa função seta o ângulo de cada objeto passado para 0 com uma transição suave.
    for (obj in objects) {
      if(instant) {
        obj.angle = 0;
        if (solidCameraSprite != null) {
          solidCameraSprite.alpha = 0;
        }
      } else {
        izzyMechanicEndTween = FlxTween.tween(obj, {angle: 0}, 3, {ease: FlxEase.quadOut});
        if (solidCameraSprite != null) {
          tweens.push(FlxTween.tween(solidCameraSprite, {alpha: 0}, 2, {ease: FlxEase.quadOut}));
        }
      }
    }
  }

  function lockStrum(direction:Int):Void {
    if (isStrumLocked.get(direction)) return; // Já está bloqueado

    isStrumLocked.set(direction, true);
    chainLockStates.set(direction, 3); // Precisa de 3 cliques para desbloquear
    chainLockInputs.set(direction, 0); // Reseta o contador de cliques

    FlxG.sound.play(Paths.sound('noteSounds/ChainLock'));

    var lockSprite = chainLockSprites[direction];
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];
    var darkness = 0.3;
    if (lockSprite != null) {
      lockSprite.visible = true;
      var dirName = getDirectionName(direction);
      lockSprite.animation.play('startLocked' + dirName, true);
      strum.colorTransform.redMultiplier = darkness;
      strum.colorTransform.greenMultiplier = darkness;
      strum.colorTransform.blueMultiplier = darkness;
    }
  }

  function handleChainUnlockInput(direction:Int):Void {
    if (!isStrumLocked.get(direction)) return; // Não está bloqueado

    var currentClicks = chainLockInputs.get(direction);
    currentClicks++;
    chainLockInputs.set(direction, currentClicks);

    var lockSprite = chainLockSprites[direction];
    var dirName = getDirectionName(direction);
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];

    if (currentClicks < 3) FunkinSound.playOnce(Paths.soundRandom('noteSounds/ChainHit', 1, 3));

    if (currentClicks == 1) {
      if (lockSprite != null) lockSprite.animation.play('1hitLocked' + dirName, false);
    } else if (currentClicks == 2) {
      if (lockSprite != null) lockSprite.animation.play('2hitLocked' + dirName, false);
    } else if (currentClicks >= 3) {
      // Desbloqueia o strum
      FlxG.sound.play(Paths.sound('noteSounds/ChainBreak'));
      if (lockSprite != null) {
        lockSprite.animation.play('unlocked' + dirName, false);
        // Esconde o sprite após a animação terminar
        new FlxTimer().start(0.5, function(tmr:FlxTimer) {
          if (PlayState.instance == null) return;
          if (lockSprite != null) lockSprite.visible = false;
        });
      }
      // retornar cores ao normal
      strum.colorTransform.redMultiplier = 1;
      strum.colorTransform.greenMultiplier = 1;
      strum.colorTransform.blueMultiplier = 1;

      chainText.visible = false;
      isStrumLocked.set(direction, false);
      chainLockStates.set(direction, 0);
      chainLockInputs.set(direction, 0);
    }

    // Fazer uma animação de tween, podendo o valor ser negativo ou positivo.
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];

    FlxTween.cancelTweensOf(strum);

    var mult = (FlxG.random.bool() ? 1 : -1);
    var angleOffset = FlxG.random.int(5, 17) * mult;
    var xOffset = FlxG.random.int(5, 17) * mult;
    var yOffset = FlxG.random.int(-20, -5);
    var dirIdx:Int = direction;
    var targetX:Float = ogStrumsX[dirIdx];
    var targetY:Float = ogStrumsY[dirIdx];

    tweens.push(FlxTween.tween(strum, {
      angle: angleOffset,
      x: targetX + xOffset,
      y: targetY + yOffset
    }, 0.1, {
      ease: FlxEase.expoIn,
      onComplete: function(t:FlxTween) {
        tweens.push(FlxTween.tween(strum, {
            angle: 0,
            x: targetX,
            y: targetY
        }, 0.3, {
            ease: FlxEase.expoOut
        }));
      }
    }));
  }

  function getDirectionName(direction:Int):String {
    switch (direction) {
      case 0: return 'Left';
      case 1: return 'Down';
      case 2: return 'Up';
      case 3: return 'Right';
      default: return 'Down';
    }
  }

  function loadChainLockSprites():Void {
    // Se já tivermos sprites carregados (e válidos), não fazemos nada.
    // Mas se o array tiver lixo de uma sessão anterior, limpamos.
    if (chainLockSprites.length > 0) {
        // Verifica se o primeiro sprite ainda está vivo e pertence a este PlayState
        if (chainLockSprites[0] != null && chainLockSprites[0].exists) {
            return;
        } else {
            chainLockSprites = []; // Limpa referências mortas
        }
    }

    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

      var lockSprite = new FunkinSprite(strum.x, strum.y);
      lockSprite.frames = Paths.getSparrowAtlas('strumChains');

      var dirName = getDirectionName(i);
      lockSprite.animation.addByPrefix('startLocked' + dirName, 'startLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('1hitLocked' + dirName, '1hitLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('2hitLocked' + dirName, '2hitLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('3hitLocked' + dirName, '3hitLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('unlocked' + dirName, 'unlocked' + dirName, 24, false);

      // O offset é calculado lá no onUpdate!!
      lockSprite.setGraphicSize(Std.int(strum.width) * 1.35, Std.int(strum.height) * 1.35);
      lockSprite.updateHitbox();
      lockSprite.cameras = [PlayState.instance.camHUD];
      lockSprite.visible = false;
      lockSprite.zIndex = 1500; //sjdsajsadkjjdajwdjh
      lockSprite.antialiasing = false;

      PlayState.instance.add(lockSprite);
      chainLockSprites.push(lockSprite);
    }

    PlayState.instance.refresh();
  }

  function loadHydraBeamSprites():Void {
    // Se já tivermos sprites carregados (e válidos), não fazemos nada.
    if (hydraBeamSprites.length > 0) {
        if (hydraBeamSprites[0] != null && hydraBeamSprites[0].exists) {
            return;
        } else {
            hydraBeamSprites = [];
            hydraBeamTimers = [];
        }
    }

    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

      var beamSprite = new FunkinSprite(strum.x, strum.y);
      beamSprite.frames = Paths.getSparrowAtlas('HydraNoteBeam');

      // Adicionar animações do beam
      beamSprite.animation.addByPrefix('start', 'Hydra Column Hit_start', 24, false);
      beamSprite.animation.addByPrefix('loop', 'Hydra Column Hit_Loop', 24, true);
      beamSprite.animation.addByPrefix('end', 'Hydra Column Hit_End', 24, false);

      beamSprite.setGraphicSize(Std.int(strum.width * 1.4), FlxG.height + (FlxG.height / 3)); // Std.int(beamSprite.width * 0.5)
      beamSprite.updateHitbox();
      beamSprite.flipY = isDownscroll;
      beamSprite.scrollFactor.set(0, 0);
      beamSprite.cameras = [PlayState.instance.camHUD];
      beamSprite.visible = false;
      beamSprite.zIndex = 9000;
      //beamSprite.antialiasing = true;

      PlayState.instance.add(beamSprite);
      hydraBeamSprites.push(beamSprite);
      hydraBeamTimers.push(null);
    }

    PlayState.instance.refresh();
  }

  function playBeamAnimation(direction:Int):Void {
    if (hydraBeamSprites.length == 0) return;

    // Capturar o valor localmente para uso nas closures
    final dir:Int = direction;

    var beamSprite = hydraBeamSprites[dir];
    if (beamSprite == null) return;

    // Cancelar timer anterior se existir
    if (hydraBeamTimers[dir] != null) {
      hydraBeamTimers[dir].cancel();
      hydraBeamTimers[dir] = null;
    }

    // Tocar animação de start
    beamSprite.visible = true;
    beamSprite.animation.play('start', true);
    hydraBeamStates.set(dir, 1);

    // Após a animação de start, começar o loop
    hydraBeamTimers[dir] = new FlxTimer().start(0.125, function(tmr:FlxTimer) { // 3 frames a 24fps = ~0.125s
      if (PlayState.instance == null) return;
      if (beamSprite == null || !beamSprite.exists) return;

      beamSprite.animation.play('loop', true);
      hydraBeamStates.set(dir, 2);

      // Manter o loop por alguns segundos
      hydraBeamTimers[dir] = new FlxTimer().start(6.3, function(tmr2:FlxTimer) {
        if (PlayState.instance == null) return;
        if (beamSprite == null || !beamSprite.exists) return;

        // Tocar animação de end
        beamSprite.animation.play('end', true);
        hydraBeamStates.set(dir, 3);

        // Esconder após a animação de end
        hydraBeamTimers[dir] = new FlxTimer().start(0.25, function(tmr3:FlxTimer) { // 6 frames a 24fps = ~0.25s
          if (PlayState.instance == null) return;
          if (beamSprite == null) return;

          beamSprite.visible = false;
          hydraBeamStates.set(dir, 0);
          hydraBeamTimers[dir] = null;
        });
      });
    });
  }

  public function onUpdate(event):Void {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (PlayState.instance.isGamePaused) return;
    if(ReflectUtil.getClassNameOf(FlxG.state.subState) == 'funkin.play.GameOverSubState') return;

    if (poisonAmount > 0 && PlayState.instance.health > 0.08) {
      PlayState.instance.health -= poisonAmount * 0.0125 * event.elapsed; //formula real do mod original btw
    }

    if (poisonSprite?.active && poisonSprite?.visible && poisonSprite != null && poisonText != null && PlayState.instance.iconP1 != null) {
      poisonSprite.x = PlayState.instance.iconP1.x + 15;
      poisonSprite.y = (PlayState.instance.healthBar.y - 95) + poisonSpriteYOffset;
      poisonSprite?.setGraphicSize(PlayState?.instance?.iconP1?.width / 1.5);
      poisonSprite.alpha = PlayState.instance.healthBar.alpha;
      poisonText.size = PlayState.instance.iconP1.height / 2.3;
      poisonText.x = poisonSprite.x + (poisonSprite.width / 2) - (poisonText.width / 2);
      poisonText.y = poisonSprite.y + (poisonSprite.height / 2) - (poisonText.height / 2) + poisonTextYOffset;
      poisonText.alpha = PlayState.instance.healthBar.alpha;
    }

    if (isDrugged) {
      if (wiggleShader != null) wiggleShader.update(event.elapsed);
      for (i in 0...4) {
        var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        note.x = note.x + Math.sin((Conductor.instance.songPosition / 1000) * (Conductor.instance.bpm / 60) * 1.0 + i) * 0.4;
      }
    }

    // Atualizar sprites de lock para seguir os strums
    var lockSpriteOffset:Array<Float, Float> = [ -20, -25 ];
    for (i in 0...4) {
      if (chainLockSprites[i] != null) {
        var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        chainLockSprites[i].x = strum.x + lockSpriteOffset[0];
        chainLockSprites[i].y = strum.y + lockSpriteOffset[1];
        chainLockSprites[i].angle = strum.angle;
        chainLockSprites[i].alpha = strum.alpha;
      }
    }

    // Atualizar sprites de hydra beam para seguir os strums
    var beamOffset:Array<Float, Float> = [10, (FlxG.height / 4)]; // Ajustar conforme necessário
    for (i in 0...4) {
      if (hydraBeamSprites[i] != null && hydraBeamSprites[i].visible) {
        var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        var beam = hydraBeamSprites[i];
        beam.x = strum.x + (strum.width / 2) - (beam.width / 2) + beamOffset[0];
        beam.y = 0 - beamOffset[1];
        beam.alpha = strum.alpha;
        //hydraBeamSprites[i].x = strum.x + beamOffset[0];
        //hydraBeamSprites[i].y = strum.y + beamOffset[1];
      }
    }

    // Mobile: usar TouchUtil para detectar toques nos sprites de lock quando o ghost tap está ativado.
    if (FlxG.onMobile && PlayState.instance.playerStrumline.mayGhostTap()) {
      for (i in 0...4) {
        if (chainLockSprites[i] != null && chainLockSprites[i].visible && isStrumLocked.get(i)) {
          var sprite = chainLockSprites[i];

          if (TouchUtil.justPressed && TouchUtil.overlapsComplex(sprite)) {
            handleChainUnlockInput(i);
            break;
          }
        }
      }
    }

  }

  function loadUIElements()
  {
    var scoreTxt = PlayState.instance.scoreText;
    var strum = PlayState.instance.playerStrumline;
    var isMobile = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;

    chainText = new FlxText(0, 0, 0, '', 60);
    chainText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), isMobile ? 35 : strum.width / 16, 0xFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    chainText.borderSize = 1.5;
    chainText.fieldWidth = isMobile ? FlxG.width : strum.width;
    if (!isMobile) {
      chainText.x = strum.x + (strum.width / 2) - (chainText.width / 2); //strum.strumlineNotes.x
    }
    chainText.y = isMobile ? (FlxG.height / 2) + (FlxG.height / 6) : strum.strumlineNotes.members[0].y - 10;
    chainText.scrollFactor.set(scoreTxt.scrollFactor.x, scoreTxt.scrollFactor.y);
    chainText.zIndex = strum.strumlineNotes.members[3] + 1;
    chainText.cameras = [PlayState.instance.camHUD];
    chainText.text = 'MASH TO BREAK FREE';
    chainText.visible = false;
    PlayState.instance.add(chainText);

    poisonSprite = new FunkinSprite(0, 0);
    poisonSprite.loadSparrow('ui/healthBars/poison');
    poisonSprite.animation.addByPrefix('P2', 'P2_0', 1, true);
    poisonSprite.animation.addByPrefix('P3', 'P3_0', 1, true);
    poisonSprite.animation.addByPrefix('P4', 'P4_0', 1, true);
    poisonSprite.animation.play('P2', true);
    poisonSprite.cameras = [PlayState.instance.camHUD];
    poisonSprite.zIndex = PlayState.instance.iconP1.zIndex + 2;
    poisonSprite.updateHitbox();
    poisonSprite.visible = false;
    poisonSprite.active = false;
    PlayState.instance.add(poisonSprite);

    // se for editar propriedades, estao no onupdate
    poisonText = new FlxText(0, 0, 0, '0', 1);
    poisonText.setFormat(Paths.font('EastSeaDokdo-Regular.ttf'), 1, 0xFF000000, 'center');
    poisonText.cameras = [PlayState.instance.camHUD];
    poisonText.zIndex = PlayState.instance.iconP1.zIndex + 4;
    poisonText.visible = false;
    //poisonText.x = PlayState.instance.healthBarBG.x + PlayState.instance.healthBarBG.width + 10;
    //poisonText.y = PlayState.instance.healthBar.y - 5;
    PlayState.instance.add(poisonText);

    solidCameraSprite = new FunkinSprite(0, 0);
    solidCameraSprite.makeSolidColor(2000, 2500, 0xFF000000);
    solidCameraSprite.cameras = [PlayState.instance.camCutscene];
    solidCameraSprite.zIndex = 100000;
    solidCameraSprite.visible = false;
    PlayState.instance.add(solidCameraSprite);

    PlayState.instance.refresh();
  }

  function updatePoisonCounter() {
    var songName:String = PlayState.instance?.currentChart?.songName?.toLowerCase();
    if (poisonSprite != null) {
      poisonSprite.visible = true;
      poisonSprite.active = true;
      switch (songName) {
        case "spectral":
          poisonSprite.animation.play('P2', true);
        case "apocalyptro":
          poisonSprite.animation.play('P3', true);
          poisonTextYOffset = 4;
        case "catastrofiend":
          poisonSprite.animation.play('P4', true);
          poisonSpriteYOffset = -7;
          poisonTextYOffset = 8;
        default:
          poisonSprite.visible = false;
          poisonSprite.active = false;
      }
    }
    if (poisonText != null && poisonSprite.active) {
      var commaSeparated:Bool = true;
      poisonText.text = FlxStringUtil.formatMoney(poisonAmount, false, commaSeparated);
      poisonText.visible = true;
    }
  }

  function doVocalThing(mult:Float = 1.2)
  {
    if (isDoingVocalThing == true) return;
    var delay = 0.25 * mult;
    if(PlayState.instance.vocals.opponentVoices.members.length != 0) {
		  PlayState.instance.vocals.opponentVolume = 0;
      isDoingVocalThing = true;
      new FlxTimer().start(delay, function(tmr) {
        if (PlayState.instance == null) return;
        PlayState.instance.vocals.opponentVolume = 1;
        isDoingVocalThing = false;
      });
		}
    if(PlayState.instance.vocals.playerVoices.members.length != 0) {
		  PlayState.instance.vocals.playerVolume = 0;
      isDoingVocalThing = true;
      new FlxTimer().start(delay, function(tmr) {
        if (PlayState.instance == null) return;
        PlayState.instance.vocals.playerVolume = 1;
        isDoingVocalThing = false;
      });
		}
  }

  function onSongRetry(event:ScriptEvent)
	{
	  super.onSongRetry(event);
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    PlayState.instance.camHUD.alpha = 1;
    PlayState.instance.camHUD.angle = 0;
    if (healthBarOgPos != null && healthBarOgPos.length > 0) {
      PlayState.instance.healthBar.x = healthBarOgPos[0];
      PlayState.instance.healthBar.y = healthBarOgPos[1];
    }

    poisonAmount = 0;
    /*if (poisonText != null) {
      poisonText.visible = false;
    }*/

    isDrugged = false;
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.cancel();
      unscrambleStrumline(true);
      izzyMechanicTimer = null;
    }

    if (solidCameraSprite != null) {
      // Se ainda estiver na tela, removemos
      if(PlayState.instance.members.contains(solidCameraSprite)) {
        PlayState.instance.remove(solidCameraSprite);
      }
      solidCameraSprite.destroy(); // Garante a limpeza da memória gráfica
      solidCameraSprite = null;    // Anula a referência
    }

    if (chainText != null) {
      chainText.visible = false;
    }

    for (i in 0...4) {
      var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
      if (ogStrumsX[i] != null && ogStrumsY[i] != null) {
        note.x = ogStrumsX[i];
        note.y = ogStrumsY[i];
        note.angle = 0;
        note.alpha = 1;
        note.colorTransform.redMultiplier = 1;
        note.colorTransform.greenMultiplier = 1;
        note.colorTransform.blueMultiplier = 1;
      }
      note = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
      if (ogOppStrumsX[i] != null && ogOppStrumsY[i] != null) {
        note.x = ogOppStrumsX[i];
        note.y = ogOppStrumsY[i];
        note.angle = 0;
        note.alpha = 1;
      }
    }

    // Resetar chain locks
    for (i in 0...4) {
      isStrumLocked.set(i, false);
      chainLockStates.set(i, 0);
      chainLockInputs.set(i, 0);
      if (chainLockSprites[i] != null) {
        chainLockSprites[i].visible = false;
      }
    }

    // Resetar hydra beams
    for (i in 0...4) {
      hydraBeamStates.set(i, 0);
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
      if (hydraBeamSprites[i] != null) {
        hydraBeamSprites[i].visible = false;
      }
    }
  }

  function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);

  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    if (!isRetro) return;
    hasLoadedUIElements = false;

    poisonAmount = 0;
    poisonSpriteYOffset = 0;
    poisonTextYOffset = 0;
    isDrugged = false;
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.cancel();
      izzyMechanicTimer = null;
    }

    // Resetar chain locks
    for (i in 0...4) {
      isStrumLocked.set(i, false);
      chainLockStates.set(i, 0);
      chainLockInputs.set(i, 0);
      if (chainLockSprites[i] != null) {
        if(PlayState.instance.members.contains(chainLockSprites[i])) {
            PlayState.instance.remove(chainLockSprites[i]);
        }
        chainLockSprites[i].destroy();
        chainLockSprites[i] = null;
      }
    }

    // Resetar hydra beams
    for (i in 0...4) {
      hydraBeamStates.set(i, 0);
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
      if (hydraBeamSprites[i] != null) {
        if(PlayState.instance.members.contains(hydraBeamSprites[i])) {
            PlayState.instance.remove(hydraBeamSprites[i]);
        }
        hydraBeamSprites[i].destroy();
        hydraBeamSprites[i] = null;
      }
    }
  }

  override function onDestroy(event)
	{
		super.onDestroy(event);
    hasLoadedUIElements = false;
    poisonSpriteYOffset = 0;
    poisonTextYOffset = 0;

    var destroySprites = [solidCameraSprite, poisonSprite];
    for (i in 0...2) {
      var sprite = destroySprites[i];
      if (sprite != null) {
        // Se ainda estiver na tela, removemos
        if(PlayState.instance.members.contains(sprite)) {
            PlayState.instance.remove(sprite);
        }
        sprite.destroy(); // Garante a limpeza da memória gráfica
        sprite = null;    // Anula a referência
      }
    }

    // Limpar hydra beams no destroy
    for (i in 0...4) {
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
      if (hydraBeamSprites[i] != null) {
        if(PlayState.instance != null && PlayState.instance.members.contains(hydraBeamSprites[i])) {
            PlayState.instance.remove(hydraBeamSprites[i]);
        }
        hydraBeamSprites[i].destroy();
        hydraBeamSprites[i] = null;
      }
    }
    hydraBeamSprites = [];
    hydraBeamTimers = [];

		resetTweens();
	}

	private function resetTweens()
	{
		for (tween in tweens)
		{
			if (tween != null)
				tween.cancel();
		}
		tweens = [];
		pausedTweens = [];
	}

  override function onResume(event)
	{
		super.onResume(event);
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.active = true;
    }
    if (izzyMechanicEndTween != null) {
      izzyMechanicEndTween.active = true;
    }

		for (tween in pausedTweens)
		{
			if (tween != null)
				tween.active = true;
		}
		pausedTweens = [];
	}

	override function onPause(event)
	{
		super.onPause(event);
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.active = false;
    }
    if (izzyMechanicEndTween != null) {
      izzyMechanicEndTween.active = false;
    }

		for (tween in tweens)
		{
			if (tween != null)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
	}

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    poisonAmount = 0;
    isDrugged = false;

    if (!hasCachedTextures) {
			FunkinMemory.permanentCacheTexture(Paths.image('hollowNotes'));
			FunkinMemory.permanentCacheTexture(Paths.image('PoisonNotes_down'));
			FunkinMemory.permanentCacheTexture(Paths.image('PoisonNotes_up'));
			FunkinMemory.permanentCacheTexture(Paths.image('Pride_Note_Assets'));
			FunkinMemory.permanentCacheTexture(Paths.image('PoisonArrowHit'));
			FunkinMemory.permanentCacheTexture(Paths.image('ChainNotes'));
			FunkinMemory.permanentCacheTexture(Paths.image('strumChains'));
			FunkinMemory.permanentCacheTexture(Paths.image('HydraNotes'));
			FunkinMemory.permanentCacheTexture(Paths.image('HydraNoteBeam'));

      // Phase 3 - Apocalyptro
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/bg'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lavaflow_L'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lavaflow_R'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/debris1'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/geyserL'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/geyserM'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/geyserR'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/debris2'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lavabubbles'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lava_FG'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/FG_fire'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lavarock_M'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lavarock_L'));
      FunkinMemory.permanentCacheTexture(Paths.image('Phase3/lavarock_R'));
			hasCachedTextures = true;
    }
  }
}
