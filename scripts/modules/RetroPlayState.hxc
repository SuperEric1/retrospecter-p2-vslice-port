  function playBeamAnimation(direction:Int, ?duration:Float):Void {
    if (hydraBeamSprites.length == 0) return;

    // Capturar o valor localmente para uso nas closures
    final dir:Int = direction;
    final loopDur = duration != null ? duration : 6.3;

    var beamSprite = hydraBeamSprites[dir];
    if (beamSprite == null) return;

    // Cancelar timer anterior se existir
    if (hydraBeamTimers[dir] != null) {
      hydraBeamTimers[dir].cancel();
      hydraBeamTimers[dir] = null;
    }

    // Tocar animação de start
    if (!beamSprite.alive) beamSprite.revive();
    beamSprite.visible = true;
    beamSprite.animation.play('start', true);
    hydraBeamStates.set(dir, 1);

    // Após a animação de start, começar o loop
    hydraBeamTimers[dir] = new FlxTimer(globalTimerManager).start(0.125, function(tmr:FlxTimer) { // 3 frames a 24fps = 0.125s
      if (PlayState.instance == null) return;
      if (beamSprite == null || !beamSprite.exists) return;

      beamSprite.animation.play('loop', true);
      hydraBeamStates.set(dir, 2);

      // Manter o loop por alguns segundos
      hydraBeamTimers[dir] = new FlxTimer(globalTimerManager).start(loopDur, function(tmr2:FlxTimer) {
        if (PlayState.instance == null) return;
        if (beamSprite == null || !beamSprite.exists) return;

        beamSprite.animation.play('end', true);
        hydraBeamStates.set(dir, 3);

        // Esconder após a animação de end
        hydraBeamTimers[dir] = new FlxTimer(globalTimerManager).start(0.25, function(tmr3:FlxTimer) { // 6 frames a 24fps = 0.25s
          if (PlayState.instance == null) return;
          if (beamSprite == null) return;

          beamSprite.visible = false;
          beamSprite.kill();
          hydraBeamStates.set(dir, 0);
          hydraBeamTimers[dir] = null;
        });
      });
    });
  }

  public function onUpdate(event:UpdateScriptEvent):Void {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (globalTimerManager != null) globalTimerManager.update(event.elapsed);

    if (!FlxG.onMobile && RetroSave.isDebug() && FlxG.keys.pressed.F8) PlayState.instance.endSong();

    if (forceNotesAlpha != null && mechanicsEnabled && loadedMechanics.contains('spectre')) {
      if (!spectreHit) {
        forceNotesAlpha -= noteFadeTime * event.elapsed;
        if (forceNotesAlpha < minNoteAlpha) forceNotesAlpha = minNoteAlpha;
      } else {
        forceNotesAlpha += event.elapsed;
        if (forceNotesAlpha >= 1) {
          forceNotesAlpha = 1;
          spectreHit = false;
        }
      }
      if (!spectreOppHit) {
        forceOppNotesAlpha -= noteFadeTime * event.elapsed;
        if (forceOppNotesAlpha < minNoteAlpha) forceOppNotesAlpha = minNoteAlpha;
      } else {
        forceOppNotesAlpha += event.elapsed;
        if (forceOppNotesAlpha >= 1) {
          forceOppNotesAlpha = 1;
          spectreOppHit = false;
        }
      }
      applySpectreAlpha();
    }

    // Health drain things
    if (poisonAmount > 0 && PlayState.instance.health > 0.01) {
      var targetHealth = poisonAmount * 0.0125 * event.elapsed;
      if (targetHealth > PlayState.instance.health) {
        PlayState.instance.health = 0.01;
      } else {
        PlayState.instance.health -= targetHealth;
      }
    }
    if (dozircHitCounter > 0 && PlayState.instance.health > 0.01) {
      var targetHealth = (dozircHitCounter * 0.5) * 0.22 * event.elapsed;
      if (targetHealth > PlayState.instance.health) {
        PlayState.instance.health = 0.01;
      } else {
        PlayState.instance.health -= targetHealth;
      }
    }

    // Winning plus icon animation (for characters that have it, like Zerktro.)
    // it's not using healthLerp so if the player is dying rapdly, the icon can show
    if (PlayState.instance.health <= 0.1 && PlayState.instance.iconP2?.animation?.curAnim != 'winningPlus'
        && PlayState.instance.iconP2.hasAnimation('winningPlus')) {
      PlayState.instance.iconP2.animation.play('winningPlus');
    }

    if (poisonSprite != null && poisonSprite?.alive && poisonSprite?.active && PlayState.instance.iconP1 != null) {
      var targetFrame = (poisonSpriteFrame * 100) + (poisonAmount < 100 ? poisonAmount : 99);
      if (poisonSprite?.animation != null && poisonSprite.animation.curAnim.curFrame != targetFrame) poisonSprite.animation.curAnim.curFrame = targetFrame;

      poisonSprite.x = PlayState.instance.iconP1.x - 40; // + 15
      poisonSprite.y = (PlayState.instance.healthBar.y - 150) + poisonSpriteYOffset; // (PlayState.instance.healthBar.y - 95) + poisonSpriteYOffset

      var iconWidth = PlayState.instance?.iconP1?.width;
      if (iconWidth != lastIconP1Width) {
        lastIconP1Width = iconWidth;
        poisonSprite?.setGraphicSize(iconWidth / 1.5);
      }
      if (poisonSprite.alpha != PlayState.instance.healthBar.alpha) poisonSprite.alpha = PlayState.instance.healthBar.alpha;
      if (!poisonSprite.visible) poisonSprite.visible = true; // it's active, so we make it visible.
      var targetZIndex = PlayState.instance.iconP1.zIndex + 2;
      if (poisonSprite.zIndex != targetZIndex) {
        poisonSprite.zIndex = targetZIndex;
        PlayState.instance.refresh();
      }
      // old stuff
      //poisonText.size = PlayState.instance.iconP1.height / 2.3;
      //poisonText.x = poisonSprite.x + (poisonSprite.width / 2) - (poisonText.width / 2);
      //poisonText.y = poisonSprite.y + (poisonSprite.height / 2) - (poisonText.height / 2) + poisonTextYOffset;
      //poisonText.alpha = PlayState.instance.healthBar.alpha;
      /*if (poisonText.zIndex != targetZIndex + 2) {
        poisonText.zIndex = targetZIndex + 2;
        PlayState.instance.refresh();
      }*/
    }

    if (wiggleShader != null) {
      wiggleShader.update(event.elapsed);
    }

    //var lockSpriteOffset:Array<Float, Float> = [ -20, -25 ];
    //var webLockSpriteOffset:Array<Float, Float> = [ 15, 20 ];
    //var beamOffset:Array<Float, Float> = [10, (FlxG.height / 4)];
    // Ao invés de usar arrays nesse loop que é executado a todo frame, iremos guardar nessas variáveis. Criar arrays todo frame não é uma boa ideia.
    var lockTargetX:Float;
    var lockTargetY:Float;
    var webTargetX:Float;
    var webTargetY:Float;
    var beamTargetX:Float;
    var beamTargetY:Float;
    var hasChainlock:Bool = loadedMechanics.contains('chainlock');
    var hasWeblock:Bool = loadedMechanics.contains('weblock');
    var hasHydra:Bool = loadedMechanics.contains('hydra');
    var hasPatience:Bool = loadedMechanics.contains('patience');
    if (mechanicsEnabled) {
      for (i in 0...4) {
        var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        if (!strum.visible) continue;

        // Pequeno efeito dos strums com a mecânica do Izzy
        if (isDrugged) strum.x = strum.x + Math.sin((Conductor.instance.songPosition / 1000) * (Conductor.instance.bpm / 60) * 1.0 + i) * 0.4;

        // Atualizar sprites de lock para seguir os strums
        if (hasChainlock && chainLockSprites[i] != null && chainLockSprites[i].alive && chainLockSprites[i].visible && chainLockSprites[i].alpha > 0) {
          var sprite = chainLockSprites[i];
          lockTargetX = strum.x + -20;
          lockTargetY = strum.y + -25;

          if (sprite.x != lockTargetX) sprite.x = lockTargetX;
          if (sprite.y != lockTargetY) sprite.y = lockTargetY;
          if (sprite.angle != strum.angle) sprite.angle = strum.angle;
          if (sprite.alpha != strum.alpha) sprite.alpha = strum.alpha;
        }
        if (hasWeblock && webLockSprites[i] != null && webLockSprites[i].alive && webLockSprites[i].visible && webLockSprites[i].alpha > 0) {
          var sprite = webLockSprites[i];
          webTargetX = strum.x + 15;
          webTargetY = strum.y + 20;

          if (sprite.x != webTargetX) sprite.x = webTargetX;
          if (sprite.y != webTargetY) sprite.y = webTargetY;
          if (sprite.angle != strum.angle) sprite.angle = strum.angle;
          //sprite.alpha = strum.alpha; // Não atualizar o alpha aqui pois se não os tweens de alpha do sprite quebram
        }

        // Atualizar sprites de hydra beam para seguir os strums
        if ((hasHydra || hasPatience) && hydraBeamSprites[i] != null && hydraBeamSprites[i].alive && hydraBeamSprites[i].visible) {
          var beam = hydraBeamSprites[i];
          beamTargetX = strum.x + (strum.width / 2) - (beam.width / 2) + (!hasPatience ? 10 : 0);
          beamTargetY = 0 - (FlxG.height / 4);

          if (beam.x != beamTargetX) beam.x = beamTargetX;
          if (beam.y != beamTargetY) beam.y = beamTargetY;
          if (beam.alpha != strum.alpha) beam.alpha = strum.alpha;
        }
      }
    }

    // Mobile: usar TouchUtil para detectar toques nos sprites de lock quando o ghost tap está ativado.
    if (mechanicsEnabled && hasChainlock && FlxG.onMobile && PlayState.instance.playerStrumline.mayGhostTap()) {
      for (i in 0...4) {
        if (isStrumLocked.get(i) && chainLockSprites[i] != null && chainLockSprites[i].alive && chainLockSprites[i].visible && chainLockSprites[i].alpha > 0) {
          var sprite = chainLockSprites[i];

          if (TouchUtil.justPressed && TouchUtil.overlapsComplex(sprite)) {
            handleChainUnlockInput(i);
            break;
          }
        }
      }
    }

    // Atualizar mecânica dos Hivemine Papers
    if (hmpActive && hiveminePapers.length > 0) {
      var len:Int = hiveminePapers.length;
      var leaderIndex:Int = len - 1;
      var leader:FunkinSprite = hiveminePapers[leaderIndex];

      // Ponto A (Escondido)
      var leaderStartY:Float = isDownscroll ? -leader.height : FlxG.height;
      // Ponto B (Alvo/Limite Final)
      var leaderEndY:Float = isDownscroll ? 0 - hmpMaxYOffset : FlxG.height - leader.height + hmpMaxYOffset;
      var moveSpeed:Float = hmpSpeed * event.elapsed;

      // Se não estiver animando o líder com um tween, mover ele.
      if (!hmpAnimating) {
        if (isDownscroll) {
          if (leader.y < leaderEndY) {
            hmpIsAtLimit = false;
            leader.y += moveSpeed;
            if (leader.y > leaderEndY) leader.y = leaderEndY;
          } else if (leader.y >= leaderEndY) {
            hmpIsAtLimit = true;
          }
        } else {
          if (leader.y > leaderEndY) {
            hmpIsAtLimit = false;
            leader.y -= moveSpeed;
            if (leader.y < leaderEndY) leader.y = leaderEndY;
          } else if (leader.y <= leaderEndY) {
            hmpIsAtLimit = true;
          }
        }
      }

      var totalDistance:Float = leaderEndY - leaderStartY;
      var currentDistance:Float = leader.y - leaderStartY;
      // A porcentagem da posição.
      var ratio:Float = 0;
      if (totalDistance != 0) {
          ratio = currentDistance / totalDistance;
      }

      // APLICAR PARA O RESTO
      // Agora posicionamos TODOS os outros papéis baseados nesse 'ratio'
      // Ignoramos o líder no loop pois já movemos ele acima.
      for (i in 0...len - 1) {
        var paper = hiveminePapers[i];
        if (paper == null) continue;
        var myStart:Float = isDownscroll ? -paper.height : FlxG.height;
        var myEnd:Float = isDownscroll ? -hmpMaxYOffset : FlxG.height - paper.height + hmpMaxYOffset;

        // "Coloque este papel na posição X% entre o inicio dele e o fim dele"
        paper.y = FlxMath.lerp(myStart, myEnd, ratio);
      }
    }

    for (holdNote in PlayState.instance.playerStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0) {
        if (mechanicsEnabled && !PlayState.instance.isBotPlayMode) {
          checkHealthCap();
        }
      }
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var isSpectreActive:Bool = forceNotesAlpha != null && mechanicsEnabled && loadedMechanics.contains('spectre');

    for (holdNote in PlayState.instance.playerStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;
      if (!isDoingVocalThing && holdNote.missedNote && holdNote.scoreable && holdNote.sustainLength > Constants.HOLD_DROP_PENALTY_THRESHOLD_MS) {
        doVocalThing(0.2);
      }

      if (hmpActive && retroGameUI != null && holdNote.missedNote && holdNote.sustainLength > Constants.HOLD_DROP_PENALTY_THRESHOLD_MS && event.step % 2 == 0) {
        var moneyToLose:Float = 0;
        switch (songId.toLowerCase()) {
          case 'sweet-talk':
            moneyToLose = hmpMoneyLoss[0];
          default:
            moneyToLose = hmpMoneyLoss[1];
        }
        retroGameUI.scriptCall('spawnHivemineMoney', [holdNote.noteData.getDirection(), moneyToLose]);
      }

      // Update hold covers alpha to match
      if (holdNote.hitNote && !isSpectreActive) {
        var targetAlpha = PlayState.instance.playerStrumline.strumlineNotes.members[holdNote.noteData.getDirection()].alpha;
        var cover = holdNote.cover;
        if (cover != null && cover.alpha != targetAlpha) cover.alpha = targetAlpha;
      }
    }

    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;

      // Update hold covers to match
      if (holdNote.hitNote && !isSpectreActive) {
        var targetAlpha = PlayState.instance.opponentStrumline.strumlineNotes.members[holdNote.noteData.getDirection()].alpha;
        var cover = holdNote.cover;
        if (cover != null && cover.alpha != targetAlpha) cover.alpha = targetAlpha;
      }
    }
  }

  public function setMechanics(names:Array<String>) {
    trace('Loading mechanic kit: ' + Std.string(names));
    for (name in names) {
      loadedMechanics.push(name);
    }
  }

  function applySpectreAlpha():Void {
    var clampedPlayerAlpha:Float = Math.max(minNoteAlpha, Math.min(1.0, forceNotesAlpha));
    var clampedOppAlpha:Float = Math.max(minNoteAlpha, Math.min(1.0, forceOppNotesAlpha));

    for (note in PlayState.instance.playerStrumline.notes.members) {
      if (note == null || !note.alive) continue;
      if (alwaysVisibleKinds.contains(note.noteData.kind)) continue;
      note.alpha = clampedPlayerAlpha;
    }
    for (holdNote in PlayState.instance.playerStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;
      if (alwaysVisibleKinds.contains(holdNote.noteData.kind)) continue;
      holdNote.alpha = clampedPlayerAlpha;
      if (holdNote.cover != null) holdNote.cover.alpha = clampedPlayerAlpha;
    }

    for (note in PlayState.instance.opponentStrumline.notes.members) {
      if (note == null || !note.alive) continue;
      if (alwaysVisibleKinds.contains(note.noteData.kind)) continue;
      note.alpha = clampedOppAlpha;
    }
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;
      if (alwaysVisibleKinds.contains(holdNote.noteData.kind)) continue;
      holdNote.alpha = clampedOppAlpha;
      if (holdNote.cover != null) holdNote.cover.alpha = clampedOppAlpha;
    }
  }

  function checkSkillIssue():Void {
    var isCh34t1ng:String = Save.instance.modOptions.get('botplay');
    //isCh34t1ng = isCh34t1ng.toLowerCase();
    if (isCh34t1ng != null && (isCh34t1ng.isBotActive || isCh34t1ng.startWithBotplay)) {
      if (isCh34t1ng.overrideScores) {
        isCh34t1ng.overrideScores = false;
        Save.instance.flush();
      }
      funnyVar = true;
    }
  }

