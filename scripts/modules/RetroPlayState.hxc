class RetroPlayState extends Module {
  public function new() {
    super('RetroPlayState', 120);
  }

  final alwaysVisibleKinds:Array<String> = ['spectre', 'Fake Note'];

  var isRetro:Bool = false;
  var isDoingVocalThing:Bool = false;
  var isDownscroll:Bool = false;
  var isMobile:Bool = false;
  var mechanicsEnabled:Bool = true;

  var retroGameUI = null;

  var tweens = [];
  var pausedTweens = [];
  var globalTimerManager:FlxTimerManager;
  var hasCachedTextures:Bool = false;
  var hasLoadedUIElements:Bool = false;

  var healthBarOgPos:Array<Float, Float> = [];
  var healthBarBgOgPos:Array<Float, Float> = [];
  var lastIconP1Width:Float = -1;
  var hasStoredStrums:Bool = false;
  var ogStrumsX:Array<Float> = [];
  var ogStrumsY:Array<Float> = [];
  var ogOppStrumsX:Array<Float> = [];
  var ogOppStrumsY:Array<Float> = [];
  var ogPlayerStrumScales:Array<Float> = [];
  var ogOppStrumScales:Array<Float> = [];
  var ogDadId:String = null;
  var ogBfId:String = null;
  var songId:String = null;

  var poisonSprite:FunkinSprite;
  var poisonSpriteFrame:Bool = 0;
  var poisonText:FlxText;
  var hasAddedPoisonTxt:Bool = false;
  var poisonAmount:Int = 0;
  var poisonSpriteYOffset:Float = 0;
  var poisonTextYOffset:Float = 0;

  // Izzy Note
  var izzyMechanicTimer:FlxTimer;
  var izzyMechanicEndTween:FlxTween;
  var isDrugged:Bool = false;
  var wiggleShader:FlxRuntimeShader = null;
  var wiggleFilter:ShaderFilter = null;

  var solidCameraSprite:FunkinSprite;

  // Chain Notes - Sistema de bloqueio de strums (Hiveless Notes também)
  var chainLockSprites:Array<FunkinSprite> = [];
  var webLockSprites:Array<FunkinSprite> = [];
  var chainLockStates:IntMap<Int> = new IntMap(); // 0 = desbloqueado, 1-3 = numero de cliques
  var chainLockInputs:IntMap<Int> = new IntMap();
  var isStrumLocked:IntMap<Bool> = new IntMap();
  var chainText:FlxText;
  var webLockActive:Bool = false;

  // Hydra Notes - Sistema de beam que cobre os strums
  var hydraBeamSprites:Array<FunkinSprite> = [];
  var hydraBeamTimers:Array<FlxTimer> = [];
  var hydraBeamStates:IntMap<Int> = new IntMap(); // 0 = inativo, 1 = start, 2 = loop, 3 = end

  // Insatian Notes - Sistema de buracos que cobrem a tela
  var holeSprites:Array<FunkinSprite> = [];
  var insatianHolesTimer:FlxTimer = null;
  var insatianNoteDamage:Float = Constants.HEALTH_MAX * 0.33; // 32%
  var insatianNoteCounter:Int = 0;

  // Hivemine - Mecânicas relacionadas à nossa querida abelha.
  var hmpActive:Bool = false;
  var hmpSpeed:Float = 0; // Velocidade padrão que os papéis descem na tela. (decidido de acordo com a dificuldade)
  // var hmp1:FunkinSprite;
  // var hmp2:FunkinSprite;
  // var hmp3:FunkinSprite;
  // var hmp4:FunkinSprite;
  var hiveminePapers:Array<FunkinSprite> = [];
  var hmpAnimating:Bool = false;
  var hmpTweenAdvance:FlxTween = null;
  var hmpTweenRetract:FlxTween = null;
  var hmpCurrentYValue:Float = 0;
  var hmpMaxYOffset:Float = 30;
  var hmpIsAtLimit:Bool = false;
  var hmpInstructionText:FlxText;
  var hmpInstructionTween:FlxTween = null;
  var hmpInstructionPlayed:Bool = false;
  var hmpMoneyGain:Array<Int> = [31446, 23148];
  var hmpMoneyLoss:Array<Int> = [-6289, -4629];
  var hmpMoneyLossNote:Array<Int> = [-62893, -46296];

  // Atrocean Notes - Jumpscare com efeito
  var atroWaveAmplitude:Float = 0;
  var atroWaveFrequency:Float = 0;
  var atroWaveSpeed:Float = 0;
  var atroMechanicTimer:FlxTimer = null;
  var atroMechanicTweens:Array<FlxTween> = [];
  var atroDarkness:FunkinSprite;
  var atroHitCounter:Int = 0; // Caso ultrapasse de 3, matar o jogador.

  // Dozirc Notes - Health drain
  var dozircMechanicTimer:FlxTimer = null;
  var dozircHitCounter:Int = 0;

  // Misc
  var loadedMechanics:Array<String> = []; // here we will store the names of the loaded mechanics for the current song (set by the song's scripts)
  var currentHealthCap:Float = 0; // also used for the insatian notes.
  var forceNotesAlpha:Float = null;    // alpha atual das notas do jogador (null = mechanic off)
  var forceOppNotesAlpha:Float = null; // alpha atual das notas do oponente (null = mechanic off)
  var minNoteAlpha:Float = 0;

  var spectreHit:Bool = false;
  var spectreOppHit:Bool = false;
  var noteFadeTime:Float = 0.025;

  var hurtNoteVibration:VibrationPreset =
  {
    period: 0,
    duration: 0.2,
    amplitude: 0.7,
    sharpness: 0
  };

  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    if (!isRetro) return;
    poisonAmount = 0;
    isDrugged = false;
    izzyMechanicTimer = null;

    // Inicializar sistema de chain notes
    for (i in 0...4) {
      isStrumLocked.set(i, false);
      chainLockStates.set(i, 0);
      chainLockInputs.set(i, 0);
    }

    // Inicializar sistema de hydra beams
    for (i in 0...4) {
      hydraBeamStates.set(i, 0);
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
    }
  }

  var hurtNotes:Array<String> = [
    'poison', 'izzyNote', 'chain', 'autoChain',
    'sakuNote', 'Hydra', 'Fake Note', 'scytheNote',
    'spectre', 'insatianNote', 'cashNote', 'autoCash',
    'hivemoreNote', "hivelessNote", "atroceanNote",
    'dozircNote', 'holy',
    'none'
  ];

  public override function onNoteIncoming(event:NoteScriptEvent) {
    if (PlayState.instance == null) return;
    //if (!isRetro) return;

    if (izzyMechanicTimer != null) {
      event.note.angle = 0;
    }
    var k = event.note.noteData.kind;
    var note = event.note;

    if (k == 'spectre' && !loadedMechanics.contains('spectre')) {
      trace('LOADED UNLOADED MECHANIC: spectre');
      loadedMechanics.push('spectre');
      FunkinMemory.cacheSound(Paths.sound("noteSounds/SpectreArrow", "shared"));
      forceNotesAlpha = 0.5;
      forceOppNotesAlpha = 0.5;
    }

    var strum = event.note.noteData.getMustHitNote() ? PlayState.instance.playerStrumline : PlayState.instance.opponentStrumline;
    var targetAlpha = strum.strumlineNotes.members[event.note.noteData.getDirection()].alpha;
    if (targetAlpha == 1) targetAlpha = strum.alpha;
    var forcedAlpha:Float = event.note.noteData.getMustHitNote() ? forceNotesAlpha : forceOppNotesAlpha;
    if (forcedAlpha != null) targetAlpha = forcedAlpha;
    if (event.note.alpha != targetAlpha && !PlayState.instance.startingSong && !alwaysVisibleKinds.contains(k)) {
      event.note.alpha = targetAlpha;
      if (event.note.isHoldNote) event.note.holdNoteSprite.alpha = targetAlpha;
    }
    if (alwaysVisibleKinds.contains(k)) event.note.alpha = 1; // sempre visíveis.

    // Notas que não contam pro score
    // Agora todas as notas são um notekind que já seta scoreable como false, então não é mais necessário.
    /*if (hurtNotes.contains(k) && event.note.noteData.getMustHitNote() && event.note.alive) {
      event.note.scoreable = false; // não dar score/combo ao acertar.
    }*/

    if (k == 'Fake Note') {
      var time:Float = 0.3;
      var delay:Float = (note.get_strumTime() - Constants.HIT_WINDOW_MS * 0.7 - (time * 1000) - Conductor.instance.songPosition) / 1000;
      tweens.push(FlxTween.tween(note, {alpha: 0}, time, {ease: FlxEase.quadOut, startDelay: delay, onComplete: function(_:FlxTween) {
        if (note == null || !note.alive) return;
        //note.kill();
      }}));
      if (event.note.isHoldNote) {
        tweens.push(FlxTween.tween(note.holdNoteSprite, {alpha: 0}, time, {ease: FlxEase.quadOut, startDelay: delay, onComplete: function(_:FlxTween) {
        if (note == null || !note.alive) return;
        //note.holdNoteSprite.kill();
      }}));
      }
    }

    // Notas removíveis
    if (k == 'none') {
      // a remoção do score acontece ali em cima
			event.cancel();
      event.stopPropagation();
			event.note.kill();
    }

    super('onNoteIncoming');
  }

  public override function onNoteHit(event:HitNoteScriptEvent):Void {
  if (PlayState.instance == null) return;
  if (!isRetro) return;
  if (event.note.noteData.getMustHitNote()) { // Só pro jogador!
    var k = event.note.noteData.kind;
    var noteDir = event.note.noteData.getDirection();
    var isPractice = PlayState.instance.isPracticeMode;

    checkHealthCap(event.note.healthChange);

    // Prevenir que notas sejam acertadas em strums bloqueados
    if (isStrumLocked.get(noteDir)) {
      handleChainUnlockInput(noteDir);
      event.cancel();
      event.stopPropagation();
      return;
    }

    // Conquista de acertar uma nota enquanto tá com o efeito de beam
    if (songId == 'catastrofiend' && event.note.scoreable && hydraBeamStates.get(noteDir) != 0) {
      RetroAchievements.award('wrath-blindhydra', true, true);
    }

    if (k == 'chain' || k == 'autoChain') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }
      if (!loadedMechanics.contains('chainlock')) {
        trace('LOADED UNLOADED MECHANIC: chainlock');
        loadedMechanics.push('chainlock');
        loadChainLockSprites();
      }

      lockStrum(noteDir);
      if (k == 'autoChain') chainText.visible = true;

      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
      if (funnyVar) funnyHealth(Constants.HEALTH_KILLER_BONUS);
    }

    if (k == 'Hydra') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }
      if (!loadedMechanics.contains('hydra')) {
        trace('LOADED UNLOADED MECHANIC: hydra');
        loadedMechanics.push('hydra');
        loadHydraBeamSprites();
      }

      playBeamAnimation(noteDir);
      FlxG.sound.play(Paths.sound('noteSounds/hydra'));

      //PlayState.instance.health -= Constants.HEALTH_KILLER_BONUS;
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
      if (funnyVar) funnyHealth(Constants.HEALTH_KILLER_BONUS);
    }

    if (k == 'holy') { // rola
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }
      if (!loadedMechanics.contains('patience')) {
        trace('LOADED UNLOADED MECHANIC: patience');
        loadedMechanics.push('patience');
        loadBeamSprites();
      }

      playBeamAnimation(noteDir, 5.4);
      FlxG.sound.play(Paths.sound('noteSounds/beam'));

      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
      if (funnyVar) funnyHealth(Constants.HEALTH_KILLER_BONUS);
    }

    if (k == 'insatianNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }
      if (!loadedMechanics.contains('insatian')) {
        trace('LOADED UNLOADED MECHANIC: insatian');
        loadedMechanics.push('insatian');
        FunkinMemory.cacheSound(Paths.sound("noteSounds/Insatian", "shared"));
        FunkinMemory.cacheTexture(Paths.image('gluttony/hole', 'shared'));
      }

      event.doesNotesplash = false;

      if (insatianHolesTimer != null) {
        insatianHolesTimer.active = false;
        insatianHolesTimer.cancel();
        insatianHolesTimer = null;
      }

      if (!isPractice) {
        // Inicializar o sistema de vida máxima caso esteja no valor default
        if (currentHealthCap <= 0 || currentHealthCap >= Constants.HEALTH_MAX || currentHealthCap == null) {
          currentHealthCap = Constants.HEALTH_MAX;
        }
        // Capar a vida
        if (currentHealthCap > insatianNoteDamage) currentHealthCap -= insatianNoteDamage;
      }

      insatianNoteCounter += 1;
      var holeMin:Int = 2;
      var holeMax:Int = 10;
      if (insatianNoteCounter > 1) {
        var multiplier = FlxG.random.int(2, 4) * (insatianNoteCounter / 2);
        holeMin += multiplier * insatianNoteCounter;
        holeMax += multiplier * insatianNoteCounter;
      }

      for (i in holeMin...holeMax + 1) {
        var hole = FunkinSprite.create(0, 0);
        var size = FlxG.random.float(FlxG.height * 0.15, FlxG.height * 0.35);
        hole.frames = Paths.getSparrowAtlas('gluttony/hole');
        hole.animation.addByPrefix('idle', 'void', 24, true);
        hole.animation.play('idle');
        hole.setGraphicSize(size, size);
        hole.zIndex = PlayState.instance.playerStrumline.zIndex + 3;
        hole.updateHitbox();
        hole.x = FlxG.random.int(FullScreenScaleMode.gameNotchSize.x - 10, FlxG.width - hole.width + 10);
        hole.y = FlxG.random.int(FullScreenScaleMode.gameNotchSize.y - 10, FlxG.height - hole.height + 20);
        hole.cameras = [PlayState.instance.camHUD];
        hole.antialiasing = false;
        holeSprites.push(hole);
        PlayState.instance.add(hole);
      }
      PlayState.instance.refresh(); // make sure the holes zindex are updated.

      // Cortar a vida do player/aplicar dano
      checkHealthCap();
      // Se for o quarto hit, matar o jogador de vez
      if (insatianNoteCounter >= 4 && !isPractice) PlayState.instance.health -= insatianNoteDamage;

      var baseTime:Float = 6;
      if (insatianNoteCounter > 1 && insatianNoteCounter <= 4) baseTime += insatianNoteCounter / 1.3;

      var barCutPercent:Float = 1 - (currentHealthCap / Constants.HEALTH_MAX);
      if (retroGameUI != null && !isPractice) retroGameUI.scriptCall('setHealthBarCut', [barCutPercent, 0]);

      insatianHolesTimer = new FlxTimer(globalTimerManager).start(baseTime, function(tmr:FlxTimer) {
        if (PlayState.instance == null) {
          insatianHolesTimer = null;
          return;
        }
        removeInsatianHoles();
      });

      FlxG.sound.play(Paths.sound('noteSounds/Insatian'));
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
    }

    if (k == 'poison' || k == 'hivelessNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }
      if (!loadedMechanics.contains('poison')) {
        trace('LOADED UNLOADED MECHANIC: poison');
        loadedMechanics.push('poison');
        loadPoisonMechanic();
        updatePoisonCounter();
      }

      poisonAmount++;
      updatePoisonCounter();
      if (k == 'poison') {
        FlxG.sound.play(Paths.sound('acid'));
        if (ogBfId == 'bf-retrospecter' || ogBfId == 'bf-wind') {
          GameOverSubState.blueBallSuffix = '-acid';
          GameOverSubState.animationSuffix = '-acid';
        }
      } else {
        if (!loadedMechanics.contains('weblock')) {
          trace('LOADED UNLOADED MECHANIC: weblock');
          loadedMechanics.push('weblock');
          loadWebLockSprites();
        }
        for (i in 0...4) {
          lockStrum(i, true);
        }
        var moneyToLose:Int = (songId.toLowerCase() == 'deadfine') ? -0 : -95;
        if (retroGameUI != null) retroGameUI.scriptCall('spawnHivemineMoney', [event.note.noteData.getDirection(), moneyToLose]);
        FlxG.sound.play(Paths.sound('noteSounds/Take'));
      }
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
      if (funnyVar) funnyHealth(Constants.HEALTH_KILLER_BONUS);
    }

    if (k == 'scytheNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      var fullHealth = getHealthPercent(100);
      var halfHealth = getHealthPercent(65);
      var baseDamage:Float = Constants.HEALTH_MAX / 2;
      var minDamage:Float = baseDamage * 0.2;
      var nearDeathTarget:Float = Constants.HEALTH_MAX * 0.4;

      if (fullHealth > halfHealth) {
        PlayState.instance.health -= baseDamage;
      } else {
        // Se tiver menos de 50% (ou exatamente 50%)
        // Calculamos o dano necessário para chegar no "nearDeathTarget"
        var damageToApply:Float = fullHealth - nearDeathTarget;

        // Se o dano calculado for menor que o mínimo, usamos o mínimo
        // Isso garante que se ele já estiver quase morrendo, o minDamage o matará
        // No entanto, se o jogador estiver no modo practice, não vamos aplicar dano.
        if (damageToApply < minDamage) {
          damageToApply = !PlayState.instance.isPracticeMode ? minDamage : 0;
        }

        PlayState.instance.health -= damageToApply;
      }
      FlxG.sound.play(Paths.sound('noteSounds/Nightflaid'));
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
    }

    if (k == 'atroceanNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      atroHitCounter += 1;
      atroWaveSpeed = atroHitCounter * 0.9;
      atroWaveFrequency = atroHitCounter * 0.4;
      atroWaveAmplitude = atroHitCounter * 0.03;

      if (atroHitCounter > 3 && !isPractice) PlayState.instance.health -= Constants.HEALTH_MAX * 1.5;

      if (wiggleShader == null) {
        wiggleShader = new WiggleEffectRuntime(0, 0, 0, WiggleEffectType.FLAG);
        wiggleFilter = new ShaderFilter(wiggleShader);

        if (PlayState.instance.camHUD.filters == null) PlayState.instance.camHUD.filters = [];
        PlayState.instance.camHUD.filters.push(wiggleFilter);

        /*hudWaterShader = ScriptedFlxRuntimeShader.init('RetroHUDWaterShader');
        hudWaterFilter = new ShaderFilter(hudWaterShader);

        hudWaterShader.setFloat('uIntensity', 1.5);
        hudWaterShader.setFloat('uSpeed', 1.5);

        if (PlayState.instance.camHUD.filters == null) PlayState.instance.camHUD.filters = [];
        PlayState.instance.camHUD.filters.push(hudWaterFilter);*/
      }

      if (solidCameraSprite != null) {
        if (!solidCameraSprite.alive) solidCameraSprite.revive();
        FlxTween.cancelTweensOf(solidCameraSprite);
        solidCameraSprite.makeSolidColor(FlxG.width + 50, FlxG.height + 50, FlxColor.fromRGB(76, 255, 148));
        solidCameraSprite.cameras = [PlayState.instance.camHUD];
        solidCameraSprite.screenCenter();
        solidCameraSprite.alpha = 0.8;
        solidCameraSprite.blend = 9;
        solidCameraSprite.visible = true;
      }

      if (atroDarkness != null && atroHitCounter <= 3) {
        var startDelay:Float = atroHitCounter <= 0 ? 4 : 0.3;
        var time:Float = atroHitCounter <= 0 ? 4 : 4.5;

        FlxTween.cancelTweensOf(atroDarkness);
        atroDarkness.alpha = 1;
        var barOverlay = retroGameUI.scriptCall('getOverlay', []);
        barOverlay.colorTransform.redOffset = -200;
        barOverlay.colorTransform.blueOffset = -200;
        barOverlay.colorTransform.greenOffset = -200;
        PlayState.instance.iconP1.colorTransform.redOffset = -200;
        PlayState.instance.iconP1.colorTransform.blueOffset = -200;
        PlayState.instance.iconP1.colorTransform.greenOffset = -200;

        if (atroMechanicTweens != null) {
          for (tween in atroMechanicTweens)
            if (tween != null) tween.cancel();
          atroMechanicTweens = [];
        }

        tweens.push(FlxTween.tween(atroDarkness, { alpha: 0 }, time, { startDelay: startDelay, ease: FlxEase.quadOut}));
        tweens.push(FlxTween.tween(solidCameraSprite, { alpha: 0 }, time, { startDelay: startDelay, ease: FlxEase.quadOut}));
        atroMechanicTweens.push(FlxTween.tween(barOverlay.colorTransform, { redOffset: 0, blueOffset: 0, greenOffset: 0 }, time, { startDelay: startDelay, ease: FlxEase.quadOut}));
        atroMechanicTweens.push(FlxTween.tween(PlayState.instance.iconP1.colorTransform, { redOffset: 0, blueOffset: 0, greenOffset: 0 }, time, { startDelay: startDelay, ease: FlxEase.quadOut}));

        atroMechanicTweens.push(
          FlxTween.num(wiggleShader.waveAmplitude, atroWaveAmplitude, 1.5, {ease: FlxEase.linear, onUpdate: function(twn:FlxTween) {
            if (wiggleShader == null) return;
            wiggleShader.waveAmplitude = twn.value;
          }})
        );
        atroMechanicTweens.push(
          FlxTween.num(wiggleShader.waveFrequency, atroWaveFrequency, 1.5, {ease: FlxEase.linear, onUpdate: function(twn:FlxTween) {
            if (wiggleShader == null) return;
            wiggleShader.waveFrequency = twn.value;
          }})
        );
        atroMechanicTweens.push(
          FlxTween.num(wiggleShader.waveSpeed, atroWaveSpeed, 1.5, {ease: FlxEase.linear, onUpdate: function(twn:FlxTween) {
            if (wiggleShader == null) return;
            wiggleShader.waveSpeed = twn.value;
          }})
        );

        if (atroMechanicTimer != null) {
          atroMechanicTimer.cancel();
          atroMechanicTimer = null;
        }
        atroMechanicTimer = new FlxTimer(globalTimerManager).start(6, function(tmr:FlxTimer) {
          if (PlayState.instance == null) {
            atroMechanicTimer = null;
            return;
          }
          resetAtroMechanic(false);
        });
      }

      FlxG.sound.play(Paths.sound('noteSounds/Atrocean'));
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
    }

    if (k == 'izzyNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      // PlayState.instance.health -= Constants.HEALTH_KILLER_BONUS;
      FlxG.sound.play(Paths.sound('noteSounds/Izzy'));
      event.doesNotesplash = false;
      if (solidCameraSprite != null) {
        //solidCameraSprite.makeSolidColor(3000, 4000, 0xFF66FFF7);
      }

      if (solidCameraSprite != null) {
        if (!solidCameraSprite.alive) solidCameraSprite.revive();
        FlxTween.cancelTweensOf(solidCameraSprite);
        var camZoom = PlayState.instance.currentCameraZoom;
        var w = Math.ceil((FlxG.width + 50) / camZoom);
        var h = Math.ceil((FlxG.height + 50) / camZoom);
        solidCameraSprite.makeSolidColor(w, h, 0xFF66FFF7);
        solidCameraSprite.screenCenter();
        solidCameraSprite.visible = true;
      }

      if (Preferences.flashingLights) {
        //FlxTween.cancelTweensOf(solidCameraSprite);
        // old: start at 0.3 then go to 0.1
        tweens.push(FlxTween.tween(solidCameraSprite, {alpha: 0.5}, 0.7, {ease: FlxEase.quadOut, onComplete: function(twn:FlxTween) {
          tweens.push(FlxTween.tween(solidCameraSprite, {alpha: 0.3}, 0.4, {ease: FlxEase.quadOut}));
        }}));
      } else if (izzyMechanicEndTween == null) {
        solidCameraSprite.alpha = 0.4;
      }

      scrambleStrumline();
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
      if (funnyVar) funnyHealth(0.23);
    }

    if (k == 'cashNote' || k == 'autoCash') {
      retractHiveminePapers();
      if (k == 'autoCash' && !hmpInstructionPlayed && PlayStatePlaylist.isStoryMode) {
        hmpInstructionPlayed = true;
        hmpInstructionText.visible = true;
        FlxTween.tween(hmpInstructionText, {alpha: 0.6}, 1.5, {ease: FlxEase.quadIn});
        new FlxTimer(globalTimerManager).start(4, function(tmr:FlxTimer) {
          hmpInstructionText.visible = false;
        });
      }
      var moneyToAdd:Float = 0;
      switch (songId.toLowerCase()) {
        case 'sweet-talk':
          moneyToAdd = hmpMoneyGain[0];
        default:
          moneyToAdd = hmpMoneyGain[1];
      }
      if (retroGameUI != null) retroGameUI.scriptCall('spawnHivemineMoney', [event.note.noteData.getDirection(), moneyToAdd]);
      FlxG.sound.play(Paths.sound('noteSounds/Coin'));
      event.doesNotesplash = false;
    }
    if (k == 'hivemoreNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      advanceHiveminePapers();
      var moneyToLose:Float = 0;
      switch (songId.toLowerCase()) {
        case 'sweet-talk':
          moneyToLose = hmpMoneyLossNote[0];
        default:
          moneyToLose = hmpMoneyLossNote[1];
      }
      if (retroGameUI != null) retroGameUI.scriptCall('spawnHivemineMoney', [event.note.noteData.getDirection(), moneyToLose]);
      FlxG.sound.play(Paths.sound('noteSounds/Take'));
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
    }

    if (k == 'spectre') {
      spectreHit = true;
      spectreOppHit = true;
      FlxG.sound.play(Paths.sound('noteSounds/SpectreArrow'));
      event.doesNotesplash = false;
    }

    if (k == 'sakuNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }

      FlxG.sound.play(Paths.sound('noteSounds/Saku'));
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
    }

    if (k == 'dozircNote') {
      if (PlayState.instance.isBotPlayMode) {
        event.cancel();
        event.stopPropagation();
        return;
      }
      if (dozircMechanicTimer != null) {
        dozircMechanicTimer.cancel();
        dozircMechanicTimer = null;
      }

      var time:Float = 4;
      if (dozircHitCounter < 4) dozircHitCounter += 1;

      retroGameUI.scriptCall('playDozircBarAnim', [event.note.noteData.getDirection(), time]);
      dozircMechanicTimer = new FlxTimer(globalTimerManager).start(time, function(tmr:FlxTimer) {
        if (PlayState.instance == null) {
          dozircMechanicTimer = null;
          return;
        }
        retroGameUI.scriptCall('resetDozircAnim', []);
        dozircHitCounter = 0;
      });

      FlxG.sound.play(Paths.sound('noteSounds/Dozirc'));
      event.doesNotesplash = false;
      if (FlxG.onMobile && HapticUtil.hapticsAvailable) HapticUtil.vibrateByPreset(hurtNoteVibration);
    }

    if (hurtNotes.contains(k) && event.judgement == 'bad') {
      event.note.visible = false; // So the discolored sprite doesn't appear.
      event.note.active = false;
    }
  } // fim do if de checagem que é nota do player

    if (!event.note.noteData.getMustHitNote() && event.note.noteData.kind == 'spectre' && mechanicsEnabled && loadedMechanics.contains('spectre')) {
      spectreOppHit = true;
      FlxG.sound.play(Paths.sound('noteSounds/SpectreArrow'));
    }

    super('onNoteHit');
  }

  public override function onNoteMiss( event:NoteScriptEvent )
	{
    if (PlayState.instance == null) return;
    if (!isRetro) return;

    if (event.note.noteData.getMustHitNote()) { // Só pro jogador!
      var k = event.note.noteData.kind;
      var noteDir = event.note.noteData.getDirection();
      if (k == "autoChain") {
        lockStrum(noteDir);
        if (k == 'autoChain') chainText.visible = true; // why did i put a if here

        event.note.kill();
        event.cancel();
        event.stopPropagation();
        // don't RETURN or else the custom UI will display as a miss
        // instead, we'll check if the note is scoreable.
      }
      if (k == 'autoCash') {
        event.cancel();
        event.stopPropagation();

        // Simulate a note hit
        var noteEvent:NoteScriptEvent = new HitNoteScriptEvent(event.note, 0.0, 0, 'perfect', false, 0);
        PlayState.instance.dispatchEvent(noteEvent);
        PlayState.instance.playerStrumline.hitNote(event.note);
        //event.note.kill();
      }

      // Matar o jogador se ele errar uma nota enquanto os papéis da hivemine estão no limite.
      if (event.note.scoreable && hmpIsAtLimit && !PlayState.instance.isPracticeMode) {
        PlayState.instance.health -= Constants.HEALTH_MAX * 1.05;
        hmpIsAtLimit = false;
      }

      if (hmpActive && event.note.scoreable && retroGameUI != null) {
        var moneyToLose:Float = 0;
        switch (songId.toLowerCase()) {
          case 'sweet-talk':
            moneyToLose = hmpMoneyLoss[0];
          default:
            moneyToLose = hmpMoneyLoss[1];
        }
        retroGameUI.scriptCall('spawnHivemineMoney', [event.note.noteData.getDirection(), moneyToLose]);
      }

      if (event.note.scoreable) doVocalThing(1.2); // Efeito de miss nas vocais
    }

    super.onNoteMiss(event);
	}
  public override function onNoteHoldDrop(event:HoldNoteScriptEvent) {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.holdNote.noteData.getMustHitNote()) { // Só pro jogador!
      doVocalThing(1.3); // efeito de miss nas vocais

      if (hmpActive && retroGameUI != null) {
        // stay visible so we know how much we are losing.
        event.holdNote.alpha = 1;
        event.holdNote.visible = true;

        var moneyToLose:Float = 0;
        switch (songId.toLowerCase()) {
          case 'sweet-talk':
            moneyToLose = hmpMoneyLoss[0];
          default:
            moneyToLose = hmpMoneyLoss[1];
        }
        // this is done at onupdate too
        retroGameUI.scriptCall('spawnHivemineMoney', [event.holdNote.noteData.getDirection(), moneyToLose]);
      }
    }
  }
  public override function onNoteGhostMiss(event:GhostMissNoteScriptEvent):Void {
    super('onNoteGhostMiss');
    if (PlayState.instance == null) return;
    if (!isRetro) return;

    // Prevenir ghost miss em strums bloqueados
    var direction = event.dir;
    if (isStrumLocked.get(direction)) {
      handleChainUnlockInput(direction);

      event.cancel();
      event.stopPropagation();
      return;
    }

    doVocalThing(1.2); // efeito de miss nas vocais (caso seja uma nota normal)
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
    var noteStyle = PlayState.instance.playerStrumline.noteStyle.id.toLowerCase();
    isRetro = StringTools.startsWith(noteStyle, 'retro') || StringTools.startsWith(noteStyle, 'player');
    if (!isRetro) return;

    GameOverSubState.musicSuffix = '-skillissue';

    if (!hasCachedTextures) cacheEverything(); // cache things here instead of when the game opens.

    isDownscroll = Preferences.downscroll;
    if(FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) isDownscroll = true;
    isMobile = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;

    mechanicsEnabled = Save.instance.modOptions.get('retroMechanics') ?? true;
    globalTimerManager = new FlxTimerManager();

    songId = PlayState.instance?.currentChart?.song?.id ?? '';

    if (!hasLoadedUIElements) {
      ogDadId = PlayState.instance.currentStage.getDad().characterId;
      ogBfId = PlayState.instance.currentStage.getBoyfriend().characterId;
      retroGameUI = ModuleHandler.getModule('RetroGameUI');
      poisonAmount = 0;
      loadUIElements();

      // TODO: use this later to load mechanics
      /*if (PlayState.instance?.currentChart != null) {
        var startTime:Float = PlayState.instance.startTimestamp;
        for (noteData in PlayState.instance.currentChart.notes) {
          if (noteData.time < startTime) continue;
          if (noteData.getMustHitNote()) {
            switch (noteData.kind ?? '') {

            }
          }
        }
      }*/

      // Load mechanics based on what we need for this song.
      if (mechanicsEnabled) {
        if (loadedMechanics.contains('poison')) {
          loadPoisonMechanic();
          updatePoisonCounter();
        }
        if (loadedMechanics.contains('spectre')) {
          FunkinMemory.cacheSound(Paths.sound("noteSounds/SpectreArrow", "shared"));
          forceNotesAlpha = 0.5;
          forceOppNotesAlpha = 0.5;
        }
        if (loadedMechanics.contains('chainlock')) {
          loadChainLockSprites();
        }
        if (loadedMechanics.contains('weblock')) {
          loadWebLockSprites();
        }
        if (loadedMechanics.contains('hydra')) {
          loadHydraBeamSprites();
        }
        if (loadedMechanics.contains('patience') && !loadedMechanics.contains('hydra')) {
          loadBeamSprites();
        }
        if (loadedMechanics.contains('insatian')) {
          FunkinMemory.cacheSound(Paths.sound("noteSounds/Insatian", "shared"));
          FunkinMemory.cacheTexture(Paths.image('notes/splash/eatmepls', 'shared'));
          FunkinMemory.cacheTexture(Paths.image('gluttony/hole', 'shared')); // insatian's hole LOL
        }
        if (loadedMechanics.contains('dozirc')) {
          FunkinMemory.cacheTexture(Paths.image('notes/Dozirc_Note_Assets', 'shared'));
          FunkinMemory.cacheTexture(Paths.image('notes/splash/dozirc', 'shared'));
          FunkinMemory.cacheSound(Paths.sound("noteSounds/Dozirc", "shared"));
        }
        if (loadedMechanics.contains('atrocean')) {
          atroHitCounter = 0;
          FunkinMemory.cacheSound(Paths.sound("noteSounds/Atrocean", "shared"));
          atroDarkness = FunkinSprite.create(0, 0, 'envy/darkness');
          atroDarkness.scrollFactor.set(0, 0);
          atroDarkness.setGraphicSize(FlxG.width * 1.5);
          atroDarkness.cameras = [PlayState.instance.camHUD];
          atroDarkness.updateHitbox();
          atroDarkness.screenCenter(0x01);
          atroDarkness.zIndex = 0;
          atroDarkness.alpha = 0;
          PlayState.instance.add(atroDarkness);
        }
      }

      hasLoadedUIElements = true;
      PlayState.instance.refresh();

      if (loadedMechanics.length > 0) trace('Mechanics enabled (' + Std.string(loadedMechanics.length) + '): ' + Std.string(loadedMechanics));
    }
    funnyVar = false;
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    if (!isRetro) return;

    healthBarOgPos = [PlayState.instance.healthBar.x, PlayState.instance.healthBar.y];
    healthBarBgOgPos = [PlayState.instance.healthBarBG.x, PlayState.instance.healthBarBG.y];

    if (!hasStoredStrums) saveStrumPos();
    checkSkillIssue();
  }

  function saveStrumPos():Void {
    hasStoredStrums = true;
    clearStrumPos();

    // saves new positions
    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];
      if (ogStrumsX[i] == null && ogStrumsY[i] == null) {
        ogStrumsX.push(strum.x);
        ogStrumsY.push(strum.y);
        ogPlayerStrumScales.push(strum.scale.x);
        ogPlayerStrumScales.push(strum.scale.y);
      }
      strum = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
      if (ogOppStrumsX[i] == null && ogOppStrumsY[i] == null) {
        ogOppStrumsX.push(strum.x);
        ogOppStrumsY.push(strum.y);
        ogOppStrumScales.push(strum.scale.x);
        ogOppStrumScales.push(strum.scale.y);
      }
    }
  }

  function clearStrumPos():Void {
    ogStrumsX = [];
    ogStrumsY = [];
    ogPlayerStrumScales = [];
    ogOppStrumsX = [];
    ogOppStrumsY = [];
    ogOppStrumScales = [];
  }

  override public function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (!isRetro) return;

    // Limpeza de tweens já completados do array de tweens
    tweens = tweens.filter(function(t) return t != null && t.active);
  }

  function removeInsatianHoles(?instant:Bool = false):Void {
    for (hole in holeSprites) {
      if (hole == null) continue;
      if (instant) {
        hole.destroy();
        continue;
      }
      FlxTween.cancelTweensOf(hole);
      tweens.push(FlxTween.tween(hole, {alpha: 0}, 1, {ease: FlxEase.quadOut, onComplete: function(twn:FlxTween) {
        hole.destroy();
      }}));
    }

    if (retroGameUI != null) retroGameUI.scriptCall('resetHealthBarCut', []);
    currentHealthCap = 0;
    insatianNoteCounter = 0;

    holeSprites = [];
    if (insatianHolesTimer != null) {
      insatianHolesTimer.cancel();
      insatianHolesTimer = null;
    }
  }

  function resetAtroMechanic(?instant:Bool = false):Void {
    if (!loadedMechanics.contains('atrocean')) return;
    // If it's not instant, we tween the values
    if (!instant) {
      var tweenTime:Float = 7;

      atroMechanicTweens.push(
      FlxTween.num(atroWaveAmplitude, 0, tweenTime, {ease: FlxEase.linear, onUpdate: function(twn:FlxTween) {
          if (wiggleShader == null) return;
          wiggleShader.waveAmplitude = twn.value;
        }})
      );
      atroMechanicTweens.push(
        FlxTween.num(atroWaveFrequency, 0, tweenTime, {ease: FlxEase.linear, onUpdate: function(twn:FlxTween) {
          if (wiggleShader == null) return;
          wiggleShader.waveFrequency = twn.value;
        }})
      );
      /*atroMechanicTweens.push(
        FlxTween.num(atroWaveSpeed, 0, 4.7, {ease: FlxEase.quadOut, onUpdate: function(twn:FlxTween) {
          if (wiggleShader == null) return;
          wiggleShader.waveSpeed = twn.value;
        }})
      );*/

      // After the values are tweened to 0, we call the function again but this time as "instant"
      atroMechanicTimer = new FlxTimer(globalTimerManager).start(tweenTime + 0.01, function(tmr:FlxTimer) {
        if (PlayState.instance == null) {
          atroMechanicTimer = null;
          return;
        }
        resetAtroMechanic(true);
      });
    } else {
      if (wiggleShader != null) {
        PlayState.instance.camHUD.filters.remove(wiggleFilter);
        wiggleShader = null;
        wiggleFilter = null;
      }
      if (solidCameraSprite != null) {
        FlxTween.cancelTweensOf(solidCameraSprite);
        solidCameraSprite.alpha = 0;
        solidCameraSprite.visible = false;
        solidCameraSprite.kill();
      }

      atroWaveFrequency = 0;
      atroWaveAmplitude = 0;
      atroWaveSpeed = 0;
      atroHitCounter = 0;

      if (atroDarkness != null) {
        FlxTween.cancelTweensOf(atroDarkness);
        atroDarkness.alpha = 0;
      }
      if (atroMechanicTweens != null) {
        for (tween in atroMechanicTweens)
          if (tween != null) tween.cancel();
        atroMechanicTweens = [];
      }

      if (atroMechanicTimer != null) {
        atroMechanicTimer.cancel();
        atroMechanicTimer = null;
      }

      var barOverlay = retroGameUI.scriptCall('getOverlay', []);
      FlxTween.cancelTweensOf(barOverlay.colorTransform);
      barOverlay.colorTransform.redOffset = 0;
      barOverlay.colorTransform.blueOffset = 0;
      barOverlay.colorTransform.greenOffset = 0;
      var iconP1 = PlayState.instance.iconP1.colorTransform;
      FlxTween.cancelTweensOf(iconP1);
      iconP1.redOffset = 0;
      iconP1.blueOffset = 0;
      iconP1.greenOffset = 0;
    }
  }

  function checkHealthCap(?healthChange = 0):Void {
    if (currentHealthCap != null && currentHealthCap > 0) {
      if (PlayState.instance.health > currentHealthCap) {
        // Cap the player's health
        if (healthChange > 0) PlayState.instance.health -= healthChange;
        else PlayState.instance.health = currentHealthCap;
      }
    }
  }

  function scrambleStrumline() {
    if (izzyMechanicTimer != null) { //se acertar uma nota enquanto ja ta com o efeito, resetar strums e o timer pra acontecer novamente
      izzyMechanicTimer.cancel();
      izzyMechanicTimer = null;
      unscrambleStrumline(true, false);
    }
    if (izzyMechanicEndTween != null) {
      izzyMechanicEndTween.active = false;
      izzyMechanicEndTween.cancel();
      izzyMechanicEndTween = null;
    }

    if (!wiggleShader) {
      wiggleShader = new WiggleEffectRuntime(1, 0.5, 0.03, WiggleEffectType.FLAG);
      wiggleFilter = new ShaderFilter(wiggleShader);

      // Adiciona ao array existente em vez de substituir
      if (PlayState.instance.camGame.filters == null) PlayState.instance.camGame.filters = [];
      if (PlayState.instance.camHUD.filters == null) PlayState.instance.camHUD.filters = [];

      PlayState.instance.camGame.filters.push(wiggleFilter);
      PlayState.instance.camHUD.filters.push(wiggleFilter);
    }

    var objects = [
      PlayState.instance.playerStrumline.strumlineNotes.members[0],
      PlayState.instance.playerStrumline.strumlineNotes.members[1],
      PlayState.instance.playerStrumline.strumlineNotes.members[2],
      PlayState.instance.playerStrumline.strumlineNotes.members[3],
    ];
    if (poisonText != null) {
      objects.push(poisonText);
    }

    // Embaralhar strumline: essa função seta um ângulo aleatório negativo ou positivo com valor máximo para cada objeto passado.
    PlayState.instance.camHUD.angle = (FlxG.random.bool() ? 1 : -1) * FlxG.random.float(3, 7);
    for (obj in objects) {
      var angle = (FlxG.random.bool() ? 1 : -1) * FlxG.random.float(10, 40);
      obj.angle = angle;
      var y = (FlxG.random.bool() ? 1 : -1) * FlxG.random.float(5, 15);
      obj.y += y;
      IntervalShake.shake(obj, 0.3, 0.010, 0.010, 0.010, FlxEase.quadOut);
    }

    isDrugged = true;

    izzyMechanicTimer = new FlxTimer(globalTimerManager).start(6, function(tmr:FlxTimer) { // Ao completar o timer
      if (PlayState.instance == null) {
        izzyMechanicTimer = null;
        return;
      }
      if (PlayState.instance.isGameOverState) return;
      unscrambleStrumline(false, true);
    });
  }
  function unscrambleStrumline(instant:Bool = false, clearCamera:Bool = true) {
    if (PlayState.instance == null) return;
    izzyMechanicTimer = null;
    isDrugged = false;
    if (wiggleFilter != null) {
      PlayState.instance.camGame.filters.remove(wiggleFilter);
      PlayState.instance.camHUD.filters.remove(wiggleFilter);
      wiggleShader = null;
      wiggleFilter = null;
    }

    // Se for instantâneo, aplicamos o valor direto e limpamos os tweens ativos das notas
    if (instant) {
        for (i in 0...4) {
          var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
          // Cancela tweens anteriores nessa nota para evitar conflito
          FlxTween.cancelTweensOf(note);
          note.x = ogStrumsX[i];
          note.y = ogStrumsY[i];
          note.angle = 0;
        }

        PlayState.instance.camHUD.angle = 0;
        if (solidCameraSprite != null && clearCamera) {
          FlxTween.cancelTweensOf(solidCameraSprite);
          solidCameraSprite.alpha = 0;
          solidCameraSprite.visible = false;
          solidCameraSprite.kill();
        }
        return; // Sai da função, não precisa criar tweens
    }

    // Lógica normal
    for (i in 0...4) {
      var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
      // Importante: cancelar tweens velhos antes de começar novos no mesmo objeto
      FlxTween.cancelTweensOf(note);

      tweens.push(FlxTween.tween(note, {x: ogStrumsX[i]}, 1.5, {ease: FlxEase.quadOut}));
      tweens.push(FlxTween.tween(note, {y: ogStrumsY[i]}, 1.5, {ease: FlxEase.quadOut}));
    }

    var objects = [
      PlayState.instance.camHUD,
      PlayState.instance.playerStrumline.strumlineNotes.members[0],
      PlayState.instance.playerStrumline.strumlineNotes.members[1],
      PlayState.instance.playerStrumline.strumlineNotes.members[2],
      PlayState.instance.playerStrumline.strumlineNotes.members[3],
    ];
    if (poisonText != null) {
      objects.push(poisonText);
    }

    // Desembaralhar strumline: essa função seta o ângulo de cada objeto passado para 0 com uma transição suave.
    for (obj in objects) {
      if(instant) {
        obj.angle = 0;
        if (solidCameraSprite != null) {
          solidCameraSprite.alpha = 0;
          solidCameraSprite.kill();
        }
      } else {
        izzyMechanicEndTween = FlxTween.tween(obj, {angle: 0}, 3, {ease: FlxEase.quadOut});
        if (solidCameraSprite != null) {
          if (!solidCameraSprite.alive) solidCameraSprite.revive();
          tweens.push(FlxTween.tween(solidCameraSprite, {alpha: 0}, 2, {ease: FlxEase.quadOut}));
        }
      }
    }
  }

  function lockStrum(direction:Int, ?isWeb = false):Void {
    if (isStrumLocked.get(direction)) return; // Já está bloqueado

    isStrumLocked.set(direction, true);
    chainLockStates.set(direction, 3); // Precisa de 3 cliques para desbloquear
    chainLockInputs.set(direction, 0); // Reseta o contador de cliques

    var lockSprite = !isWeb ? chainLockSprites[direction] : webLockSprites[direction];
    if (!lockSprite.alive) lockSprite.revive();
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];
    var darkness = 0.3;
    if (lockSprite != null) {
      var dirName = getDirectionName(direction);
      lockSprite.visible = true;

      if (!isWeb) {
        lockSprite.animation.play('startLocked' + dirName, true);
        strum.colorTransform.redMultiplier = darkness;
        strum.colorTransform.greenMultiplier = darkness;
        strum.colorTransform.blueMultiplier = darkness;
        FlxG.sound.play(Paths.sound('noteSounds/ChainLock'));
      } else {
        var dir = direction;
        FlxTween.cancelTweensOf(lockSprite);
        lockSprite.alpha = 1;
        webLockActive = true;
        tweens.push(
          FlxTween.tween(lockSprite, {alpha: 0}, 0.3, {ease: FlxEase.quadOut, startDelay: 1, onComplete: function (_) {
            isStrumLocked.set(dir, false);
            chainLockStates.set(dir, 0);
            chainLockInputs.set(dir, 0);
            if (webLockActive) webLockActive = false;
            lockSprite.kill();
          }})
        );
      }
    }
  }

  function handleChainUnlockInput(direction:Int):Void {
    if (!isStrumLocked.get(direction)) return; // Não está bloqueado
    if (webLockActive) return; // Se for web, não faz nada.

    var currentClicks = chainLockInputs.get(direction);
    currentClicks++;
    chainLockInputs.set(direction, currentClicks);

    var lockSprite = chainLockSprites[direction];
    var dirName = getDirectionName(direction);
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];

    if (currentClicks < 3) FunkinSound.playOnce(Paths.soundRandom('noteSounds/ChainHit', 1, 3));

    if (currentClicks == 1) {
      if (lockSprite != null) lockSprite.animation.play('1hitLocked' + dirName, false);
    } else if (currentClicks == 2) {
      if (lockSprite != null) lockSprite.animation.play('2hitLocked' + dirName, false);
    } else if (currentClicks >= 3) {
      // Desbloqueia o strum
      FlxG.sound.play(Paths.sound('noteSounds/ChainBreak'));
      if (lockSprite != null) {
        lockSprite.animation.play('unlocked' + dirName, false);
        // Esconde o sprite após a animação terminar
        var dir = direction;
        new FlxTimer(globalTimerManager).start(0.6, function(tmr:FlxTimer) {
          if (PlayState.instance == null) return;
          if (lockSprite != null && !isStrumLocked.get(dir)) lockSprite.visible = false;
        });
      }
      // retornar cores ao normal
      strum.colorTransform.redMultiplier = 1;
      strum.colorTransform.greenMultiplier = 1;
      strum.colorTransform.blueMultiplier = 1;

      if (chainText != null) chainText.visible = false;
      isStrumLocked.set(direction, false);
      chainLockStates.set(direction, 0);
      chainLockInputs.set(direction, 0);
    }

    // Fazer uma animação de tween, podendo o valor ser negativo ou positivo.
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];

    FlxTween.cancelTweensOf(strum);

    var mult = (FlxG.random.bool() ? 1 : -1);
    var angleOffset = FlxG.random.int(5, 17) * mult;
    var xOffset = FlxG.random.int(5, 17) * mult;
    var yOffset = FlxG.random.int(-20, -5);
    var dirIdx:Int = direction;
    var targetX:Float = ogStrumsX[dirIdx];
    var targetY:Float = ogStrumsY[dirIdx];

    tweens.push(FlxTween.tween(strum, {
      angle: angleOffset,
      x: targetX + xOffset,
      y: targetY + yOffset
    }, 0.1, {
      ease: FlxEase.expoIn,
      onComplete: function(t:FlxTween) {
        tweens.push(FlxTween.tween(strum, {
            angle: 0,
            x: targetX,
            y: targetY
        }, 0.3, {
            ease: FlxEase.expoOut
        }));
      }
    }));
  }

  function getDirectionName(direction:Int):String {
    switch (direction) {
      case 0: return 'Left';
      case 1: return 'Down';
      case 2: return 'Up';
      case 3: return 'Right';
      default: return 'Down';
    }
  }

  function loadChainLockSprites():Void {
    // Se já tivermos sprites carregados (e válidos), não fazemos nada.
    // Mas se o array tiver lixo de uma sessão anterior, limpamos.
    if (chainLockSprites.length > 0) {
      // Verifica se o primeiro sprite ainda está vivo e pertence a este PlayState
      if (chainLockSprites[0] != null && chainLockSprites[0].exists) {
        return;
      } else {
        chainLockSprites = [];
      }
    }

    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

      var lockSprite = new FunkinSprite(strum.x, strum.y);
      lockSprite.frames = Paths.getSparrowAtlas('notes/strumChains');

      var dirName = getDirectionName(i);
      lockSprite.animation.addByPrefix('startLocked' + dirName, 'startLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('1hitLocked' + dirName, '1hitLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('2hitLocked' + dirName, '2hitLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('3hitLocked' + dirName, '3hitLocked' + dirName, 24, false);
      lockSprite.animation.addByPrefix('unlocked' + dirName, 'unlocked' + dirName, 24, false);

      // O offset é calculado lá no onUpdate!!
      lockSprite.setGraphicSize(Std.int(strum.width) * 1.35, Std.int(strum.height) * 1.35);
      lockSprite.updateHitbox();
      lockSprite.cameras = [PlayState.instance.camHUD];
      lockSprite.visible = false;
      lockSprite.zIndex = 1500; //sjdsajsadkjjdajwdjh
      lockSprite.antialiasing = false;

      PlayState.instance.add(lockSprite);
      chainLockSprites.push(lockSprite);
      lockSprite.kill();
    }

    var strum = PlayState.instance.playerStrumline;
    chainText = new FlxText(0, 0, 0, '', 60);
    chainText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), isMobile ? 35 : strum.width / 16, 0xFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    chainText.borderSize = 1.5;
    chainText.fieldWidth = isMobile ? FlxG.width : strum.width;
    if (!isMobile) {
      chainText.x = strum.x + (strum.width / 2) - (chainText.width / 2); //strum.strumlineNotes.x
    }
    if (isDownscroll) {
      chainText.y = isMobile ? (FlxG.height / 2) + (FlxG.height / 6) : strum.strumlineNotes.members[0].y - 10;
    } else chainText.y = strum.strumlineNotes.members[0].y + strum.strumlineNotes.members[0].height + 10;
    chainText.scrollFactor.set(0, 0);
    chainText.zIndex = strum.zIndex + 1;
    chainText.cameras = [PlayState.instance.camHUD];
    chainText.text = RetroLanguage.t('instruction.chainNote', 'MASH TO BREAK FREE');
    chainText.visible = false;
    PlayState.instance.add(chainText);

    // refresh where the function is called.
    //PlayState.instance.refresh();
  }

  function loadWebLockSprites():Void {
    // Se já tivermos sprites carregados (e válidos), não fazemos nada.
    if (webLockSprites.length > 0) {
      if (webLockSprites[0] != null && webLockSprites[0].exists) {
        return;
      } else {
        webLockSprites = [];
      }
    }

    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

      var dirName = getDirectionName(i).toLowerCase();
      var lockSprite = new FunkinSprite(strum.x, strum.y, Paths.image('notes/web/' + dirName, 'shared'));

      // O offset é calculado lá no onUpdate!!
      lockSprite.setGraphicSize(Std.int(strum.width) * 0.8);
      lockSprite.updateHitbox();
      lockSprite.cameras = [PlayState.instance.camHUD];
      lockSprite.visible = false;
      lockSprite.zIndex = 1500;
      lockSprite.antialiasing = false;

      PlayState.instance.add(lockSprite);
      webLockSprites.push(lockSprite);
      lockSprite.kill();
    }

    // refresh where the function is called.
    //PlayState.instance.refresh();
  }

  function loadHydraBeamSprites():Void {
    // Se já tivermos sprites carregados (e válidos), não fazemos nada.
    if (hydraBeamSprites.length > 0) {
      if (hydraBeamSprites[0] != null && hydraBeamSprites[0].exists) {
        return;
      } else {
        hydraBeamSprites = [];
        hydraBeamTimers = [];
      }
    }

    for (i in 0...4) {
      var strum = PlayState.instance.playerStrumline.strumlineNotes.members[i];

      var beamSprite = new FunkinSprite(strum.x, strum.y);
      beamSprite.frames = Paths.getSparrowAtlas('HydraNoteBeam');

      // Adicionar animações do beam
      beamSprite.animation.addByPrefix('start', 'Hydra Column Hit_start', 24, false);
      beamSprite.animation.addByPrefix('loop', 'Hydra Column Hit_Loop', 24, true);
      beamSprite.animation.addByPrefix('end', 'Hydra Column Hit_End', 24, false);

      beamSprite.setGraphicSize(Std.int(strum.width * 1.4), FlxG.height + (FlxG.height / 3)); // Std.int(beamSprite.width * 0.5)
      beamSprite.updateHitbox();
      beamSprite.flipY = isDownscroll;
      beamSprite.scrollFactor.set(0, 0);
      beamSprite.cameras = [PlayState.instance.camHUD];
      beamSprite.visible = false;
      beamSprite.zIndex = 9000;
      //beamSprite.antialiasing = true;

      PlayState.instance.add(beamSprite);
      hydraBeamSprites.push(beamSprite);
      hydraBeamTimers.push(null);
      beamSprite.kill();
    }

    // refresh where the function is called.
    //PlayState.instance.refresh();
  }

