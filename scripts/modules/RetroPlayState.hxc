  function getHealthPercent(percent:Float):Void {
    return percent / 100.0 * Constants.HEALTH_MAX;
  }

  function onSongRetry(event:ScriptEvent)
	{
	  super.onSongRetry(event);
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (globalTimerManager != null) globalTimerManager.clear();
    PlayState.instance.camHUD.alpha = 1;
    PlayState.instance.camHUD.angle = 0;
    if (healthBarOgPos != null && healthBarOgPos.length > 0) {
      PlayState.instance.healthBar.x = healthBarOgPos[0];
      PlayState.instance.healthBar.y = healthBarOgPos[1];
    }

    updatePoisonCounter(ogDadId ?? null);

    resetAtroMechanic(true);

    hmpActive = false;
    hmpSpeed = 0;
    hmpIsAtLimit = false;
    hmpCurrentYValue = 0;
    hmpAnimating = false;
    hmpInstructionPlayed = false;
    destroyHiveminePapers();

    if (dozircMechanicTimer != null) {
      dozircMechanicTimer.cancel();
      dozircMechanicTimer = null;
    }
    dozircHitCounter = 0;

    poisonAmount = 0;
    if (forceNotesAlpha != null) forceNotesAlpha = 0.5;
    if (forceOppNotesAlpha != null) forceOppNotesAlpha = 0.5;
    spectreHit = false;
    spectreOppHit = false;
    /*if (poisonText != null) {
      poisonText.visible = false;
    }*/

    if (atroMechanicTweens != null) {
      for (tween in atroMechanicTweens) {
        if (tween != null) tween.cancel();
      }
      atroMechanicTweens = [];
    }

    removeInsatianHoles(true);

    isDrugged = false;
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.cancel();
      unscrambleStrumline(true, true);
      izzyMechanicTimer = null;
    }

    if (chainText != null) {
      chainText.visible = false;
    }

    PlayState.instance.playerStrumline.alpha = 1;
    if (hasStoredStrums) {
      for (i in 0...4) {
        var note = PlayState.instance.playerStrumline.strumlineNotes.members[i];
        if (ogStrumsX[i] != null && ogStrumsY[i] != null) {
          FlxTween.cancelTweensOf(note);
          note.x = ogStrumsX[i];
          note.y = ogStrumsY[i];
          note.scale.set(ogOppStrumScales[i * 2], ogOppStrumScales[i * 2 + 1]);
          note.angle = 0;
          note.alpha = 1;
          note.colorTransform.redMultiplier = 1;
          note.colorTransform.greenMultiplier = 1;
          note.colorTransform.blueMultiplier = 1;
          note.colorTransform.redOffset = 0;
          note.colorTransform.greenOffset = 0;
          note.colorTransform.blueOffset = 0;
        }
        note = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
        if (ogOppStrumsX[i] != null && ogOppStrumsY[i] != null) {
          FlxTween.cancelTweensOf(note);
          note.x = ogOppStrumsX[i];
          note.y = ogOppStrumsY[i];
          note.scale.set(ogPlayerStrumScales[i * 2], ogPlayerStrumScales[i * 2 + 1]);
          note.angle = 0;
          note.alpha = 1;
          note.colorTransform.redMultiplier = 1;
          note.colorTransform.greenMultiplier = 1;
          note.colorTransform.blueMultiplier = 1;
          note.colorTransform.redOffset = 0;
          note.colorTransform.greenOffset = 0;
          note.colorTransform.blueOffset = 0;
        }
      }
    }

    // Resetar chain locks
    webLockActive = false;
    for (i in 0...4) {
      isStrumLocked.set(i, false);
      chainLockStates.set(i, 0);
      chainLockInputs.set(i, 0);
      if (chainLockSprites[i] != null) {
        chainLockSprites[i].visible = false;
        chainLockSprites[i].kill();
      }
      if (webLockSprites[i] != null) {
        FlxTween.cancelTweensOf(webLockSprites[i]);
        webLockSprites[i].visible = false;
        webLockSprites[i].kill();
      }
    }

    // Resetar hydra beams
    for (i in 0...4) {
      hydraBeamStates.set(i, 0);
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
      if (hydraBeamSprites[i] != null) {
        hydraBeamSprites[i].visible = false;
        hydraBeamSprites[i].kill();
      }
    }
  }

  function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);
    if (izzyMechanicTimer != null) unscrambleStrumline(true, true);

    if (GameOverSubState.blueBallSuffix == "-acid") FunkinSound.playOnce(Paths.sound('gameplay/gameover/fnf-loss-sfx-acid'));

    if (atroMechanicTweens != null) {
      for (tween in atroMechanicTweens)
        if (tween != null) tween.cancel();
      atroMechanicTweens = [];
    }
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);

    var eventKind = event.eventData.eventKind;
    var value = event.eventData.value;

    switch (eventKind) {
      case "RetroChangeCharacter":
        if (value.character == 'dad') {
          updatePoisonCounter(value.newchar); // update poison counter sprite.
          new FlxTimer().start(0.005, function(tmr:FlxTimer) {
            PlayState.instance.refresh(); // refresh for the poison sprite zindex shit
          });
        }

      default:
    }
  }

  var funnyVar:Bool = false;
  public function funnyFunction():Void {
    // Punishment for skill issue
    if (funnyVar == true) {
      PlayState.instance.songScore = 1;
      Highscore.tallies.totalNotesHit = 0;
      Highscore.tallies.shit = Highscore.tallies.sick + Highscore.tallies.good;
      Highscore.tallies.sick = 0;
      Highscore.tallies.good = 0;
      Highscore.tallies.maxCombo = 0;

      PlayState.instance.isPlayerDying = true;
      PlayState.instance.vocals?.pause();
      if (FlxG.sound.music != null) FlxG.sound.music.pause();
      funnyVar = false;

      FlxG.camera.fade(FlxColor.BLACK, 0.5);
      FlxTween.tween(PlayState.instance.camHUD, {alpha: 0}, 0.5,
      {
        onComplete: function(_) {
          FlxG.camera.stopFX();
          PlayState.instance.currentStage.getBoyfriend().shader = null;
          PlayState.instance.persistentDraw = false;
          PlayState.instance.persistentUpdate = false;
          ModuleHandler.getModule('RetroSave').scriptCall('youThoughtLol', []);
          PlayState.instance.moveToGameOver();
          PlayState.instance.disableKeys = false; // for some reason it was disabling the keys after restarting so this fixes it
          PlayState.instance.isPlayerDying = false;
        }
      });

      /*new FlxTimer().start(0.6, function(tmr:FlxTimer) {

      });*/
      return true;
    }
    return false;
  }

  function funnyHealth(?value = 0.1):Void {
    PlayState.instance.health -= Constants.HEALTH_MAX * value;
  }

  public override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    if (!isRetro) return;
    hasLoadedUIElements = false;

    if (funnyFunction()) {
      event.cancel();
      return;
    }

    checkEndingAchievements();

    poisonAmount = 0;
    poisonSpriteYOffset = 0;
    poisonTextYOffset = 0;
    isDrugged = false;
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.cancel();
      izzyMechanicTimer = null;
    }

    // Resetar chain locks
    for (i in 0...4) {
      isStrumLocked.set(i, false);
      chainLockStates.set(i, 0);
      chainLockInputs.set(i, 0);
      if (chainLockSprites[i] != null) {
        if(PlayState.instance.members.contains(chainLockSprites[i])) {
            PlayState.instance.remove(chainLockSprites[i]);
        }
        chainLockSprites[i].destroy();
        chainLockSprites[i] = null;
      }
    }

    // Resetar hydra beams
    for (i in 0...4) {
      hydraBeamStates.set(i, 0);
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
      if (hydraBeamSprites[i] != null) {
        if(PlayState.instance.members.contains(hydraBeamSprites[i])) {
            PlayState.instance.remove(hydraBeamSprites[i]);
        }
        hydraBeamSprites[i].destroy();
        hydraBeamSprites[i] = null;
      }
    }
  }

  private function checkEndingAchievements():Void {
    // showToast, instaShow, force
    switch (songId) {
      case 'spectral', 'ectospasm':
        if (poisonAmount >= 10) RetroAchievements.award('wrath-tenpoisons');
    }
  }

  override function onDestroy(event)
	{
		super.onDestroy(event);
    if (PlayState.instance == null) return;
    if (globalTimerManager != null) globalTimerManager.clear();
    hasStoredStrums = false;
    loadedMechanics = [];
    hasLoadedUIElements = false;
    poisonSprite = null;
    poisonSpriteYOffset = 0;
    poisonTextYOffset = 0;
    lastIconP1Width = -1;
    forceNotesAlpha = null;
    forceOppNotesAlpha = null;
    spectreHit = false;
    spectreOppHit = false;
    funnyVar = false;
    ogDadId = null;
    ogBfId = null;
    songId = null;
    atroHitCounter = 0;
    destroyHiveminePapers();
    hmpActive = false;
    hmpAnimating = false;
    hmpSpeed = 0;
    hmpIsAtLimit = false;
    hmpCurrentYValue = 0;
    hmpInstructionPlayed = false;
    webLockActive = false;
    wiggleShader = null;
    wiggleFilter = null;
    isDoingVocalThing = false;

    removeInsatianHoles(true);

    if (dozircMechanicTimer != null) {
      dozircMechanicTimer.cancel();
      dozircMechanicTimer = null;
    }
    dozircHitCounter = 0;

    var destroySprites = [solidCameraSprite, poisonSprite];
    for (i in 0...2) {
      var sprite = destroySprites[i];
      if (sprite != null) {
        // Se ainda estiver na tela, removemos
        if(PlayState.instance.members.contains(sprite)) {
          PlayState.instance.remove(sprite);
        }
        sprite.destroy(); // Garante a limpeza da memória gráfica
        sprite = null;    // Anula a referência
      }
    }

    // Limpar hydra beams no destroy
    for (i in 0...4) {
      if (hydraBeamTimers[i] != null) {
        hydraBeamTimers[i].cancel();
        hydraBeamTimers[i] = null;
      }
      if (hydraBeamSprites[i] != null) {
        if(PlayState.instance != null && PlayState.instance.members.contains(hydraBeamSprites[i])) {
          PlayState.instance.remove(hydraBeamSprites[i]);
        }
        hydraBeamSprites[i].destroy();
        hydraBeamSprites[i] = null;
      }
    }
    hydraBeamSprites = [];
    hydraBeamTimers = [];

    clearStrumPos();

		resetTweens();
	}

	private function resetTweens()
	{
		for (tween in tweens) {
			if (tween != null) tween.cancel();
		}
		for (tween in atroMechanicTweens) {
			if (tween != null) tween.cancel();
		}
		tweens = [];
    atroMechanicTweens = [];
		pausedTweens = [];
	}

  override function onResume(event)
	{
		super.onResume(event);
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.active = true;
    }
    if (izzyMechanicEndTween != null) {
      izzyMechanicEndTween.active = true;
    }

		for (tween in pausedTweens) {
			if (tween != null) tween.active = true;
		}
		pausedTweens = [];

    checkSkillIssue();
	}

	override function onPause(event)
	{
		super.onPause(event);
    if (izzyMechanicTimer != null) {
      izzyMechanicTimer.active = false;
    }
    if (izzyMechanicEndTween != null) {
      izzyMechanicEndTween.active = false;
    }

		for (tween in tweens)
		{
			if (tween != null)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
		for (tween in atroMechanicTweens)
		{
			if (tween != null)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}

    checkSkillIssue();
	}

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    funnyVar = false;
    poisonAmount = 0;
    isDrugged = false;

    FlxG.signals.postGameStart.addOnce(function() {
      // Title Screen
      FunkinMemory.permanentCacheTexture(Paths.image('ui/logo', "shared"));
      FunkinMemory.permanentCacheTexture(Paths.image('ui/flames', "shared"));

      // Main menu
      FunkinMemory.permanentCacheTexture(Paths.image('ui/mainmenu/credits', "shared"));
      FunkinMemory.permanentCacheTexture(Paths.image('ui/mainmenu/options', "shared"));
      FunkinMemory.permanentCacheTexture(Paths.image('ui/mainmenu/side', "shared"));
      FunkinMemory.permanentCacheTexture(Paths.image('ui/mainmenu/story', "shared"));
      FunkinMemory.permanentCacheTexture(Paths.image('ui/mainmenu/logosExtra', "shared"));
      FunkinMemory.permanentCacheTexture(Paths.image('ui/mainmenu/logosFirst', "shared"));
    });
  }

  function cacheEverything():Void {
    if (!hasCachedTextures) {
      // Notes
      var notesDir:String = 'notes/';
      var notesToCache:Array<String> = [
        'hollowNotes',
        'PoisonNotes_down',
        'PoisonNotes_up',
        'Pride_Note_Assets',
        'Atrocean_Note_Assets',
        'Hivemore_Note_Assets',
        'PoisonArrowHit',
        'ChainNotes',
        'strumChains',
        'HydraNotes',
        'scytheNotes',
        'HeartNotes',
        'Notes_Spectre',
        'SpectreHit',
        'coin'
      ];
      for (noteName in notesToCache) {
        FunkinMemory.permanentCacheTexture(Paths.image(notesDir + noteName, "shared"));
      }
			FunkinMemory.permanentCacheTexture(Paths.image('HydraNoteBeam', "shared"));

      // Mechanics
      //FunkinMemory.permanentCacheTexture(Paths.image('gluttony/munch', "shared"));

      // Sounds
      var noteSoundsDir:String = 'noteSounds/';
      var noteSoundsToCache:Array<String> = [
        'Coin',
        'Take',
        'ChainHit1',
        'ChainHit2',
        'ChainHit3',
        'hydra',
        'beam',
        'Nightflaid',
        'Saku',
      ];
      for (soundName in noteSoundsToCache) {
        FunkinMemory.permanentCacheSound(Paths.sound(noteSoundsDir + soundName, "shared"));
      }
      //FunkinMemory.permanentCacheSound(Paths.sound("acid", "shared"));
      FunkinMemory.permanentCacheSound(Paths.sound("scythe", "shared"));
      FunkinMemory.permanentCacheSound(Paths.sound("clothsSFX", "shared"));

      var fontsToCache:Array<String> = [
        'AtariST8x16SystemFont-bmp.png',
        '5by7-bmp.png'
      ];
      for (fontName in fontsToCache) {
        FunkinMemory.permanentCacheTexture(Paths.font(fontName));
      }

      // Phase 2 - Spectral
      //FunkinMemory.permanentCacheTexture(Paths.image('wrath/Crystals', "shared"));

			hasCachedTextures = true;
    }
  }

}
