import flixel.FlxG;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.modding.module.Module;

class RetroSave extends Module
{
  public function new()
  {
    super("RetroSave", 500);
    setupSave();
  }

  function setupSave():Void {
    var save:Save = Save.instance;

    if (!save.modOptions.exists("retroModcharts"))
      save.modOptions.set("retroModcharts", true);

    if (!save.modOptions.exists("retroMechanics"))
      save.modOptions.set("retroMechanics", true);

    if (!save.modOptions.exists("retroNotesTransform"))
      save.modOptions.set("retroNotesTransform", false);

    if (!save.modOptions.exists("retroShaders"))
      save.modOptions.set("retroShaders", false);

    if (!save.modOptions.exists("retroShake"))
      save.modOptions.set("retroShake", true);

    if (!save.modOptions.exists("retroSuggestive"))
      save.modOptions.set("retroSuggestive", true);

    if (!save.modOptions.exists("retroSongLength"))
      save.modOptions.set("retroSongLength", false);

    if (!save.modOptions.exists("retroCheckpoints"))
      save.modOptions.set("retroCheckpoints", true);

    if (!save.modOptions.exists("retroCustomMenus"))
      save.modOptions.set("retroCustomMenus", true);

    if (!save.modOptions.exists("retroDefaultNotes"))
      save.modOptions.set("retroDefaultNotes", true);

    save.flush();
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    if (FlxG.save?.data?.BotMode != null && FlxG.save?.data?.BotMode.toLowerCase() != 'off') {
      FlxG.save.data.BotMode = "off";
    }
  }

  public function youThoughtLol():Void {
    //var skillIssueLine:Array<String> = ['skill issue', 'melted'];
    //FlxG.save?.data?.BotMode = skillIssueLine[FlxG.random.int(0, skillIssueLine.length - 1)];
    FlxG.save?.data?.BotMode = 'off';
  }
}
