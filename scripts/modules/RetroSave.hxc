package supereric.retrospecter.modules;

import flixel.FlxG;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.modding.PolymodHandler;
import funkin.modding.module.Module;

class RetroSave extends Module
{
  public static final folderNames:Array<String> = ["retrospecter-p2-vslice-port", "retrospecter-p2-vslice-port-main"];

  // needs to be string in order to work idk why
  public static var debug:String = "false";
  private static var resetWarns:String = "false";
  private static var _initialized:Bool = false;

  public static function isDebug():Bool {
    if (!_initialized) initStatic();
    //trace(debug);
    return debug == "true";
  }
  public static function isResetWarns():Bool {
    if (!_initialized) initStatic();
    return resetWarns == "true";
  }

  public static function initStatic():Void {
    if (_initialized) return;

    var data:ModMetadata = null;
    for (name in folderNames) {
      if (data != null) break;
      // Tenta pegar o metadata via Polymod
      data = PolymodHandler.modFileSystem.getMetadata(name); // use getMetadataById and remove the foldernames when the new patch arrives.
    }

    if (data != null) {
      debug = data.metadata?.get("debug") ?? "false";
      resetWarns = data.metadata?.get("reset_warns") ?? "false";
    }

    _initialized = true;
  }

  public function new()
  {
    super("RetroSave", 1);

    initStatic();
    setupSave();
  }

  override public function onCreate(event) {
    super.onCreate(event);
    FlxG.signals.postGameStart.addOnce(function() {
      resetOneTimeFlags();
    });

    if (isDebug()) {
      resetOneTimeFlags();
    }

    var isCh34t1ng:String = Save.instance.modOptions.get('botplay');
    if (isCh34t1ng != null && (isCh34t1ng.isBotActive || isCh34t1ng.startWithBotplay)) {
      isCh34t1ng.isBotActive = false;
      isCh34t1ng.startWithBotplay = false;
      Save.instance.flush();
    }
  }

  function setupSave():Void {
    var save:Save = Save.instance;

    if (!save.modOptions.exists("retroModcharts"))
      save.modOptions.set("retroModcharts", true);

    if (!save.modOptions.exists("retroMechanics"))
      save.modOptions.set("retroMechanics", true);

    if (!save.modOptions.exists("retroNotesTransform"))
      save.modOptions.set("retroNotesTransform", false);

    if (!save.modOptions.exists("retroShaders"))
      save.modOptions.set("retroShaders", true);

    if (!save.modOptions.exists("retroShake"))
      save.modOptions.set("retroShake", true);

    if (!save.modOptions.exists("retroSuggestive"))
      save.modOptions.set("retroSuggestive", true);

    if (!save.modOptions.exists("retroSongLength"))
      save.modOptions.set("retroSongLength", false);

    if (!save.modOptions.exists("retroCheckpoints"))
      save.modOptions.set("retroCheckpoints", true);

    if (!save.modOptions.exists("retroCustomMenus"))
      save.modOptions.set("retroCustomMenus", true);

    if (!save.modOptions.exists("retroDefaultNotes"))
      save.modOptions.set("retroDefaultNotes", true);


    // Warnings / Pre title state
    if (!save.modOptions.exists("retroTitleDisclaimerLanguage") || isResetWarns()) {
      // first disclaimer, language selection
      save.modOptions.set("retroTitleDisclaimerLanguage", false);
    }
    if (!save.modOptions.exists("retroTitleDisclaimer") || isResetWarns()) {
      // second disclaimer, basic
      save.modOptions.set("retroTitleDisclaimer", false);
    }
    if (!save.modOptions.exists("retroTitleDisclaimerSuggestive") || isResetWarns()) {
      // third disclaimer, suggestive warning
      save.modOptions.set("retroTitleDisclaimerSuggestive", false);
    }

    save.flush();
  }

  function resetOneTimeFlags():Void {
    var save:Save = Save.instance;
    save.modOptions.set('retroTitleWarningsPlayed', false);
    save.modOptions.set('retroOptionsIntroPlayed', false);
    save.flush();
  }

  public function youThoughtLol():Void {
    //var skillIssueLine:Array<String> = ['skill issue', 'melted'];
    //FlxG.save?.data?.BotMode = skillIssueLine[FlxG.random.int(0, skillIssueLine.length - 1)];

    // uncomment once it has been updated
    Save.instance.modOptions.get('botplay').isBotActive = false;
    Save.instance.modOptions.get('botplay').startWithBotplay = false;
    Save.instance.flush();
  }
}
