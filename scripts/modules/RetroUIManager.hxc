import flixel.FlxG;
import flixel.FlxSprite;
import flixel.util.FlxColor;
import flixel.addons.transition.FlxTransitionableState;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.options.OptionsState;
import funkin.ui.title.TitleState;
import funkin.ui.title.AttractState;
import funkin.ui.MusicBeatState;
import funkin.modding.base.ScriptedMusicBeatState;
import funkin.modding.base.ScriptedMusicBeatSubState;
import funkin.modding.module.Module;
import funkin.save.Save;
import Std;

class RetroUIManager extends Module
{
  public function new()
  {
    super('RetroUIManager');
  }

  public static var titleInitialized:Bool = false;
  private static var disableNextTransition:Bool = false;

  var backBg:FlxSprite = null;

  override public function onCreate(event:ScriptEvent) {
    super.onCreate(event);
    FlxG.signals.postGameStart.addOnce(function() {
      Save.instance.modOptions.set('retroTitleWarningsPlayed', false);
      Save.instance.flush();
    });
  }

  // Redirect to custom states/menus
  override public function onStateChangeEnd(event:StateChangeScriptEvent)
  {
    super.onStateChangeEnd(event);
    if (!Save.instance.modOptions.get('retroCustomMenus')) return;
    var targetState = event.targetState;

    if (Std.isOfType(targetState, TitleState))
    {
      if (FlxG.sound.music != null) FlxG.sound.music.stop();

      var save = Save.instance.modOptions;
      // Here we should first open the RetroTitleWarnings state if there's warnings to play based on the saved values in the save.
      if (!titleInitialized && !save.get('retroTitleWarningsPlayed') && (!save.get('retroTitleDisclaimerLanguage') || !save.get('retroTitleDisclaimer') || !save.get('retroTitleDisclaimerSuggestive'))) {
        save.set('retroTitleWarningsPlayed', true);
        Save.instance.flush();
        disableNextTransition = true;
        FlxG.switchState(ScriptedMusicBeatState.init("RetroTitleWarnings"));
        return;
      }

      if (!titleInitialized) {
        // Make sure it resets once we reopen or reload the game (since modules stay active between states and only reset on reload.)
        save.set('retroTitleIntroPlayed', false);
        Save.instance.flush();
        titleInitialized = true;
      }
      FlxG.switchState(ScriptedMusicBeatState.init("RetroTitleState"));
    }
    else if (Std.isOfType(targetState, MainMenuState))
    {
      // insert background to avoid weird transition
      if (backBg != null) backBg.destroy();
      backBg = new FlxSprite(0, 0).makeGraphic(FlxG.width, FlxG.height, FlxColor.BLACK);
      backBg.screenCenter();
      backBg.scrollFactor.set(0, 0);
      targetState.insert(50, backBg);
      disableNextTransition = true;
      FlxG.switchState(ScriptedMusicBeatState.init("RetroMainMenu"));
    }
    else if (Std.isOfType(targetState, OptionsState))
    {
      if (FlxG.sound.music != null) FlxG.sound.music.stop();
      var save = Save.instance.modOptions;
      // save.set('retroTitleWarningsPlayed', null);
      // Since the warnings are only reset once we fully reopen the game, if the player opens the options menu and doesn't have the value saved, it means he just opened the mod for the first time!
      if (!save.get('retroTitleWarningsPlayed') && (!save.get('retroTitleDisclaimerLanguage') || !save.get('retroTitleDisclaimer') || !save.get('retroTitleDisclaimerSuggestive'))) {
        save.set('retroTitleWarningsPlayed', true);
        Save.instance.flush();
        disableNextTransition = true;
        FlxG.switchState(ScriptedMusicBeatState.init("RetroTitleWarnings"));
        return;
      }
    }
  }

  override public function onStateChangeBegin(event:StateChangeScriptEvent)
  {
    super.onStateChangeBegin(event);
    if (!Save.instance.modOptions.get('retroCustomMenus')) return;
    var targetState = event.targetState;

    if (disableNextTransition)
    {
      FlxTransitionableState.skipNextTransIn = true;
      disableNextTransition = false;
    }
  }
}
