import flixel.FlxObject;
import flixel.FlxSprite;
import flixel.FlxState;
import flixel.FlxG;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import funkin.ui.mainmenu.MainMenuState;
import funkin.play.PlayState;
import funkin.Paths;
import funkin.util.ReflectUtil;
import funkin.util.Constants;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.api.newgrounds.NewgroundsClient;

class RetroSplashText extends Module
{
  public var retroV:String = '1.0';

  public function new()
  {
    super('RetroSplashText');
  }

   public function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    if (Std.isOfType(event.targetState, MainMenuState))
    {
        var ogText = FlxG.state.leftWatermarkText.text;
        FlxG.state.leftWatermarkText.font = Paths.font('Kenyan Coffee Rg.otf');
        FlxG.state.leftWatermarkText.size = FlxG.onMobile ? 30 : 25;
        FlxG.state.leftWatermarkText.text = "Vs. RetroSpecter - Part Two: Infernadise (V-SLICE)\nFan Port v" + retroV + " | FNF " + ogText;
        FlxG.state.leftWatermarkText.y = FlxG.height - FlxG.state.leftWatermarkText.fieldHeight - (FlxG.onMobile ? 57 : 45);
    }
  }
}
