import funkin.modding.module.Module;
import funkin.ui.credits.CreditsState;
import funkin.ui.credits.CreditsDataHandler;

class RetroCredits extends Module {
	public function new() {
		super("RetroCredits", 1, {
			state: CreditsState
		});
	}

	public function onCreate(event:ScriptEvent) {
		super.onCreate(event);
		// these need to be in reverse here because of unshift()

		// Port Credits
		CreditsDataHandler.CREDITS_DATA.entries.unshift({
			header: "------------------------",
			body: []
		});

		CreditsDataHandler.CREDITS_DATA.entries.unshift({
			header: "V-Slice Mod Fan Port By",
			body: [
				{line: "SuperEric"},
			]
		});

		CreditsDataHandler.CREDITS_DATA.entries.unshift({
			header: "------------------------",
