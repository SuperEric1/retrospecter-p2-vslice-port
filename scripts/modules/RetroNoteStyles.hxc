package supereric.retrospecter.modules;

import flixel.FlxG;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.FunkinMemory;
import funkin.Conductor;
import funkin.mobile.input.ControlsHandler;
import funkin.modding.module.Module;
import funkin.play.notes.notekind.NoteKindManager;
import funkin.play.notes.notestyle.NoteStyle;
import funkin.play.notes.Strumline;
import funkin.play.notes.StrumlineNote;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;
import funkin.Preferences;
import funkin.save.Save;
import funkin.util.Constants;
import funkin.util.ReflectUtil;
import haxe.ds.IntMap;
import haxe.ds.StringMap;

class RetroNoteStyles extends Module {
	public function new() {
		super("RetroNoteStyles");
	}

	final mobileArrowsActive:Bool = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;
	var isRetro:Bool = null;

	// Originally "amplification" from Funkin's source code.
	final screenRatio:Float = (FlxG.width / FlxG.height) / (FlxG.initialWidth / FlxG.initialHeight);

	var _playerStyle:String = null;
	var _opponentStyle:String = null;
	var currentOppStyle:String = null;
	var currentPlayerStyle:String = null;
	var isOppUsingCustomNote:Bool = false;
	var isPlayerUsingCustomNote:Bool = false;
	var didNotesFade:Bool = false;

	// GAMBIARRA: Offset fixes for broken NoteStyle offset support, while they aren't fixed.
	/**
	 * Global note (NoteSprite) Y offsets per side.
	 * The engine never applies _data.assets.note.offsets to NoteSprites, so we do it manually.
	 * [xOffset, yOffset]
	 */
	var oppNoteOffset:Array<Float> = [0.0, 0.0];
	var playerNoteOffset:Array<Float> = [0.0, 0.0];

	/**
	 * Per-animation strumline offsets per side.
	 * Key format: "<directionIndex>_<animName>"
	 * 	directionIndex: 0=left, 1=down, 2=up, 3=right
	 *  animName: "static" | "press" | "confirm" | "confirm-hold"
	 * Value: [xOffset, yOffset]
	 *
	 * The engine adds per-anim offsets to AnimationData but FlxAnimationUtil.addAtlasAnimation
	 * ignores them, and StrumlineNote.playAnimation() always calls centerOffsets() which resets
	 * .offset. We re-apply them every frame in onUpdate() after all strums have updated.
	 */
	var oppStrumAnimOffsets:IntMap<StringMap<Array<Float>>> = new IntMap();
	var playerStrumAnimOffsets:IntMap<StringMap<Array<Float>>> = new IntMap();

	/**
	 * Tracks the offset we last applied to each strum, per side.
	 * Index = direction (0=left, 1=down, 2=up, 3=right). Value: [x, y].
	 *
	 * Instead of tracking animation names, we track the actual offset values we wrote.
	 * If strum.offset diverges from what we stored, it means centerOffsets() was called
	 * internally (by playAnimation() or setNoteSpacing()) since our last frame, so we re-apply.
	 *
	 * This handles the engine bug where the confirmHoldTimer fires playStatic() and then
	 * holdConfirm() re-calls playAnimation('confirm') in the same frame: both calls reset
	 * the offset, but since the animation name doesn't change, a lastAnims-based guard
	 * is blind to it. expectedOffsets catches it regardless of animation name.
	 */
	var oppExpectedOffsets:Array<Array<Float>> = [[0,0],[0,0],[0,0],[0,0]];
	var playerExpectedOffsets:Array<Array<Float>> = [[0,0],[0,0],[0,0],[0,0]];

	/**
	 * Whether the gambiarra™ should run for each side.
	 */
	var hasOppStrumAnimOffsets:Bool = false;
	var hasPlayerStrumAnimOffsets:Bool = false;

	public function setStyle(type:CharacterType, name:String):Void {
		if (type == CharacterType.BF) {
			_playerStyle = name;
		} else if (type == CharacterType.DAD) {
			_opponentStyle = name;
		}
	}

	override function onSongLoaded(event) {
		super.onSongLoaded(event);
		if (isRetro == null) isRetro = PlayState.instance.playerStrumline.noteStyle.id == 'retrospecter';
		if (!isRetro) return;

		applyCustomNoteStyles();
	}

	public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);

		didNotesFade = true; // So the game's note fade effect won't appear again when we rebuild the strumlines
	}

	public function applyCustomNoteStyles():Void {
		var dadCharacterId:String = PlayState.instance.currentStage.getDad().characterId;
		var boyfriendCharacterId:String = PlayState.instance.currentStage.getBoyfriend().characterId;

		if (_opponentStyle != null && _opponentStyle != currentOppStyle) {
			var dadNoteStyle = NoteStyleRegistry.instance.fetchEntry(_opponentStyle);
			if (dadNoteStyle != null) {
				// Reset previous offset data
				oppNoteOffset = [0.0, 0.0];
				oppStrumAnimOffsets = new IntMap();
				oppExpectedOffsets = [[0,0],[0,0],[0,0],[0,0]];
				hasOppStrumAnimOffsets = false;

				currentOppStyle = _opponentStyle;
				FunkinMemory.cacheNoteStyle(dadNoteStyle);
				refreshStrumlineStyle(PlayState.instance.opponentStrumline, _opponentStyle, false);
				isOppUsingCustomNote = true;

				// Extract and cache the offset data for this style.
				oppNoteOffset = extractNoteOffset(dadNoteStyle);
				oppStrumAnimOffsets = extractStrumAnimOffsets(dadNoteStyle);
				hasOppStrumAnimOffsets = oppStrumAnimOffsets.keys().hasNext();
			}
		}

		if (!Save.instance.modOptions.get('retroDefaultNotes') && _playerStyle != null && _playerStyle != currentPlayerStyle) {
			var bfNoteStyle = NoteStyleRegistry.instance.fetchEntry(_playerStyle);
			if (bfNoteStyle != null) {
				// Reset previus offset data
				playerNoteOffset = [0.0, 0.0];
				playerStrumAnimOffsets = new IntMap();
				playerExpectedOffsets = [[0,0],[0,0],[0,0],[0,0]];
				hasPlayerStrumAnimOffsets = false;

				currentPlayerStyle = _playerStyle;
				FunkinMemory.cacheNoteStyle(bfNoteStyle);
				refreshStrumlineStyle(PlayState.instance.playerStrumline, _playerStyle, true);
				isPlayerUsingCustomNote = true;

				// Extract and cache the offset data for this style.
				playerNoteOffset = extractNoteOffset(bfNoteStyle);
				playerStrumAnimOffsets = extractStrumAnimOffsets(bfNoteStyle);
				hasPlayerStrumAnimOffsets = playerStrumAnimOffsets.keys().hasNext();
			}
		}
	}

	/**
	 * Reads the global note offset from _data.assets.note.offsets.
	 */
	function extractNoteOffset(style:NoteStyle):Array<Float> {
		var offsets:Array<Float> = style._data?.assets?.note?.offsets;
		if (offsets != null && offsets.length >= 2) return offsets;
		return [0.0, 0.0];
	}

	/**
	 * Reads all per-animation offsets from _data.assets.noteStrumline.data.
	 * FlxAnimationUtil.addAtlasAnimation() ignores AnimationData.offsets entirely,
	 * so we apply them ourselves in onUpdate().
	 *
	 * Only entries that actually have a non-zero or explicitly defined offsets array are stored.
	 */
	function extractStrumAnimOffsets(style:NoteStyle):IntMap<StringMap<Array<Float>>> {
		var result:IntMap<StringMap<Array<Float>>> = new IntMap();
		var strumData = style._data?.assets?.noteStrumline?.data;
		if (strumData == null) return result;

		// [JSON field name, direction index as Int, animation name]
		// Direction indices: 0=left, 1=down, 2=up, 3=right
		// Animation names match what StrumlineNote.getCurrentAnimation() returns.
		var mappings:Array<Array<String>> = [
			["leftStatic", "0", "static"],
			["leftPress", "0", "press"],
			["leftConfirm", "0", "confirm"],
			["leftConfirmHold", "0", "confirm-hold"],
			["downStatic", "1", "static"],
			["downPress", "1", "press"],
			["downConfirm", "1", "confirm"],
			["downConfirmHold", "1", "confirm-hold"],
			["upStatic", "2", "static"],
			["upPress", "2", "press"],
			["upConfirm", "2", "confirm"],
			["upConfirmHold", "2", "confirm-hold"],
			["rightStatic", "3", "static"],
			["rightPress", "3", "press"],
			["rightConfirm", "3", "confirm"],
			["rightConfirmHold", "3", "confirm-hold"],
		];

		for (entry in mappings) {
			var fieldName:String = entry[0];
			var dirIndex:Int = Std.parseInt(entry[1]);
			var animName:String = entry[2];

			var animData = ReflectUtil.field(strumData, fieldName);
			if (animData == null) continue;

			var offsets:Array<Float> = animData.offsets;
			if (offsets == null || offsets.length < 2) continue;

			if (!result.exists(dirIndex)) result.set(dirIndex, new StringMap());
			result.get(dirIndex).set(animName, offsets);
		}

		return result;
	}

	/**
	 * Apply per-animation strumline offsets to a strumline's notes.
	 *
	 * Detection: instead of tracking the animation name, we track the offset values we
	 * last wrote. If strum.offset differs from expectedOffsets, centerOffsets() was called
	 * internally this frame (by playAnimation() or setNoteSpacing()), so we re-apply our delta.
	 * This correctly handles cases where playAnimation() is called multiple times in one
	 * frame with the same animation name.
	 *
	 * Scaling: JSON offsets are authored at normal strumlineScale (1.0). When the opponent
	 * strumline enters mini mode, strumlineScale shrinks (e.g. 0.4 * amplification).
	 * We multiply the delta by strumlineScale.x/y so the offset scales proportionally
	 * with the sprite, otherwise the same pixel values look exaggerated on the tiny strum.
	 *
	 * I hate this please fix it Funkin' Crew (https://github.com/FunkinCrew/Funkin/issues/6836)
	 */
	function applyStrumAnimOffsets(strumline:Strumline, animOffsets:IntMap<StringMap<Array<Float>>>, expectedOffsets:Array<Array<Float>>):Void {
		var scaleX:Float = strumline.strumlineScale.x;
		var scaleY:Float = strumline.strumlineScale.y;

		for (i in 0...4) {
			var strum = strumline.strumlineNotes.members[i];
			if (strum == null || !strum.alive) continue;

			var exp:Array<Float> = expectedOffsets[i];

			// If offset matches what we last set, centerOffsets() hasn't fired, nothing to do.
			if (strum.offset.x == exp[0] && strum.offset.y == exp[1]) continue;

			// centerOffsets() was called this frame. Apply our scaled delta for the current animation.
			// IntMap lookup by direction index (no String allocation), then StringMap by anim name.
			var dirMap:StringMap<Array<Float>> = animOffsets.get(i);
			if (dirMap != null) {
				var off:Array<Float> = dirMap.get(strum.getCurrentAnimation());
				if (off != null) {
					strum.offset.x += off[0] * scaleX;
					strum.offset.y += off[1] * scaleY;
				}
			}

			// Record the new expected values so we don't fire again next frame.
			exp[0] = strum.offset.x;
			exp[1] = strum.offset.y;
		}
	}

	override public function onNoteIncoming(event:NoteScriptEvent):Void {
		super.onNoteIncoming(event);
		if (!isRetro || !event.note.visible) return;

		if (!event.note.noteData.getMustHitNote()) {
			// Opponent note
			event.note.x += oppNoteOffset[0] ?? 0;
			event.note.yOffset = 0;
			event.note.yOffset += oppNoteOffset[1] ?? 0;

		} else if (event.note.scoreable) {
			// Player note
			event.note.x += playerNoteOffset[0] ?? 0;
			event.note.yOffset = 0;
			event.note.yOffset = playerNoteOffset[1] ?? 0;
		}
	}

	override public function onUpdate(event:UpdateScriptEvent):Void {
		super.onUpdate(event);
		if (PlayState.instance == null) return;
		if (!isRetro) return;

		if (hasOppStrumAnimOffsets) {
			applyStrumAnimOffsets(PlayState.instance.opponentStrumline, oppStrumAnimOffsets, oppExpectedOffsets);
		}
		if (hasPlayerStrumAnimOffsets) {
			applyStrumAnimOffsets(PlayState.instance.playerStrumline, playerStrumAnimOffsets, playerExpectedOffsets);
		}
	}

	public function onNoteHit(event:HitNoteScriptEvent):Void {
		super.onNoteHit(event);
		if (PlayState.instance == null) return;
		if (!isRetro) return;

		// Play splash anims for the opponent if they're using a custom notestyle.
		var noteData = event.note.noteData;
		if (!noteData.getMustHitNote() && isOppUsingCustomNote) {
			PlayState.instance.opponentStrumline.playNoteSplash(noteData.getDirection());
		}
	}

	function refreshStrumlineStyle(targetStrumline:Strumline, styleIdentifier:String, isPlayerSide:Bool):Void {
		var customStyle:NoteStyle = NoteStyleRegistry.instance.fetchEntry(styleIdentifier)
			?? NoteStyleRegistry.instance.fetchDefault();

		if (targetStrumline == null) return;

		targetStrumline.noteStyle = customStyle;

		targetStrumline.noteSplashes.clear();
		targetStrumline.noteHoldCovers.clear();

		rebuildStrumlineNotes(targetStrumline, customStyle);
		updateExistingNotes(targetStrumline, customStyle);

		if (!isPlayerSide && mobileArrowsActive) {
			adjustOppStrums();
		}
	}

	function rebuildStrumlineNotes(strumline:Strumline, styleData:NoteStyle):Void {
		for (i in 0...Strumline.KEY_COUNT) {
			strumline.strumlineNotes.members[i].kill();
			strumline.strumlineNotes.remove(strumline.strumlineNotes.members[i]);

			var newStrum:StrumlineNote = new StrumlineNote(styleData, strumline.isPlayer, Strumline.DIRECTIONS[i]);
			newStrum.x = strumline.getXPos(Strumline.DIRECTIONS[i]);
			newStrum.x += Strumline.INITIAL_OFFSET;
			newStrum.y = 0;

			styleData.applyStrumlineOffsets(newStrum);
			strumline.strumlineNotes.add(newStrum);
		}
		// The little animation of the arrows when starting the song on freeplay.
		if (!didNotesFade) strumline.fadeInArrows();
	}

	function updateExistingNotes(strumline:Strumline, styleData:NoteStyle):Void {
		for (note in strumline.notes) {
			var noteKindSpecificStyle:NoteStyle = NoteKindManager.getNoteStyle(note.kind, styleData.id)
				?? styleData;

			note.setupNoteGraphic(noteKindSpecificStyle);
			note.playNoteAnimation(note.noteData.getDirection());

			if (note.get_isHoldNote()) {
				updateHoldNote(note, strumline, styleData);
			}

			strumline.onNoteIncoming.dispatch(note);
		}
	}

	function updateHoldNote(note:Dynamic, strumline:Strumline, styleData:NoteStyle):Void {
		note.holdNoteSprite.setupHoldNoteGraphic(styleData);
		note.holdNoteSprite.noteStyleOffsets = styleData.getHoldNoteOffsets();

		note.holdNoteSprite.graphicWidth = note.holdNoteSprite.graphic.width / 8 * note.holdNoteSprite.zoom;
		note.holdNoteSprite.graphicHeight = note.holdNoteSprite.sustainLength * Constants.PIXELS_PER_MS * (strumline.scrollSpeed);

		note.holdNoteSprite.updateHitbox();
		note.holdNoteSprite.updateClipping();

		note.holdNoteSprite.x = strumline.x;
		note.holdNoteSprite.x += strumline.getXPos(Strumline.DIRECTIONS[note.noteData.getDirection() % Strumline.KEY_COUNT]);
		note.holdNoteSprite.x += Strumline.STRUMLINE_SIZE / 2;
		note.holdNoteSprite.x -= note.holdNoteSprite.graphicWidth / 2;
	}

	function adjustOppStrums():Void {
		PlayState.instance.opponentStrumline.enterMiniMode(0.4 * screenRatio);
	}

	override function onDestroy(event:ScriptEvent) {
		super.onDestroy(event);
		// Resetar estilos para que eles não arrastem pra próxima música se ela não tiver um style setado.
		isRetro = null;
		_opponentStyle = null;
		_playerStyle = null;
		currentOppStyle = null;
		currentPlayerStyle = null;
		isOppUsingCustomNote = false;
		isPlayerUsingCustomNote = false;
		didNotesFade = false;
		oppNoteOffset = [0.0, 0.0];
		playerNoteOffset = [0.0, 0.0];
		oppStrumAnimOffsets = new IntMap();
		playerStrumAnimOffsets = new IntMap();
		hasOppStrumAnimOffsets = false;
		hasPlayerStrumAnimOffsets = false;
		oppExpectedOffsets = [[0,0],[0,0],[0,0],[0,0]];
		playerExpectedOffsets = [[0,0],[0,0],[0,0],[0,0]];
	}
}
