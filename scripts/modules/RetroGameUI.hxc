  override public function onStepHit(event:SongTimeScriptEvent) {
    super.onStepHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    if (!isRetro) return;

    // We update the texts here because updating texts each frame apparently can cause lag.
    if (statsDisplay != null && statsDisplay?.visible == true)
      updateStatsDisplay(); // So the values are accurate even if we don't miss or hit notes
    if (songLengthEnabled && timeDisplay != null && timeDisplaySub != null)
      updateTimeDisplay();

    if (isHivemine && hiveminePlayerMoney != null && hivemineOppMoney != null) updateHivemineText();
  }

  public function onNoteHit(event:HitNoteScriptEvent):Void {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.note.noteData.getMustHitNote() && !PlayState.instance.isBotPlayMode) { // Só pro jogador!
      var isNormalNote = event.note.scoreable; // Todas as hazard notes têm suas 'scoreable' setadas para false ao spawnar (RetroPlayState.hxc)
      if (isNormalNote) {
        notesHit += 1;
        if (event.judgement == 'sick') sickCount += 1;
        else if (event.judgement == 'good') goodCount += 1;
        else if (event.judgement == 'bad') badCount += 1;
        else if (event.judgement == 'shit') shitCount += 1;

        if (!event.note.isHoldNote) {
          updateJudgement(event.judgement, event.score, event.isComboBreak, true);
        } else {
          var stayDuration:Float = event.note.length / 1000;
          updateJudgement(event.judgement, event.score, event.isComboBreak, true, stayDuration);
        }
        // Update stats display after note hit
        updateStatsDisplay();
      } else {
        hazardNotesHit += 1;
      }
    }
  }

  public function onNoteMiss(event:NoteScriptEvent)
	{
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.note.noteData.getMustHitNote() && !PlayState.instance.isBotPlayMode) { // Só pro jogador!
      if (event.eventCanceled) return;
      var isNormalNote = event.note.scoreable; // Todas as hazard notes têm suas 'scoreable' setadas para false ao spawnar (RetroPlayState.hxc)

      if (isNormalNote) {
        missCount += 1;
        updateJudgement('miss', Scoring.getMissScore(), true, false);
        // Update stats display after miss
        updateStatsDisplay();
      }

      // antigo sistema
      /*var k = event.note.noteData.kind;
      var hurtNotes:Array<String> = ['poison', 'izzyNote', 'chain', 'autoChain', 'sakuNote', 'Hydra', 'Fake Note'];
      if (hurtNotes.contains(k) || !event.note.alive) return;
      */
    }
  }

  public function onNoteHoldDrop(event:HoldNoteScriptEvent) {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.holdNote.noteData.getMustHitNote() && !PlayState.instance.isBotPlayMode) { // Só pro jogador!
      updateJudgement('miss', event.score, event.isComboBreak, false);
      // Update stats display after hold drop
      updateStatsDisplay();
    }
  }

  function updateScoreText(value:Int):Void {
    if (score == null || lastDisplayedScore == value) return;
    lastDisplayedScore = value;
    score.text = Std.string(value);
  }

  function updateJudgement(judgementName:String, noteScore:Float, isComboBreak = false, doesPopup:Bool = true, stayDuration:Float = 0):Void {
    cancelTweens(true);
    var judgementData = getJudgement(judgementName);

    // Atualizar o texto e cor do julgamento
    if (judgement.text != judgementData.text) judgement.text = judgementData.text;
    if (judgement.color != judgementData.color) judgement.color = judgementData.color;
    var targetComboText:String = !isComboBreak ? getCombo() : '0';
    if (comboText.text != targetComboText) comboText.text = targetComboText;
    //comboText.color = 0xFFFFFF;

    // FlxBitmapText precisa de updateHitbox após mudar o texto para que width/height reflitam corretamente a escala aplicada
    judgement.updateHitbox();
    comboText.updateHitbox();

    var totalWidth = judgement.width + comboText.width;
    judgement.x = ((FlxG.width - totalWidth) / 2) + judgementXOffset;
    comboText.x = judgement.x + judgement.width + 25;

    var displayedScore:Int = Std.int(PlayState.instance.songScore + (noteScore > 0 ? noteScore : 0));
    updateScoreText(displayedScore);

    if (updateJudgementAlpha) {
      judgement.visible = true;
      judgement.alpha = 1;
      comboText.visible = true;
      comboText.alpha = 1;
      score.visible = true;
      score.alpha = 1;
    }

    animateTexts(doesPopup, stayDuration);
  }

  function getCombo() {
    var combo:String = Std.string(Highscore.tallies.combo + 1);
    var comboString:String = '';
    comboString += combo;
    return comboString;
  }
  function getJudgement(judgement:String):{text:String, color:FlxColor} {
    switch (judgement) {
      case 'sick':
        return {text: RetroLanguage.t('judgement.sick', 'SICK!!') + ' ', color: 0xFFfccb0f}; // #fccb0f
      case 'good':
        return {text: RetroLanguage.t('judgement.good', 'GOOD!') + ' ', color: 0xFF457ff4}; // #457ff4
      case 'bad':
        return {text: RetroLanguage.t('judgement.bad', 'BAD') + ' ', color: 0xFFf53e57}; // #f53e57
      case 'shit':
        return {text: RetroLanguage.t('judgement.shit', 'SHIT') + ' ', color: 0xFF7a7c7e}; // #7a7c7e
      case 'miss':
        return {text: RetroLanguage.t('judgement.miss', 'MISS') + ' ', color: 0xFFf70200}; // #f70200
      default:
        return {text: '???', color: 0xFFFFFF};
    }
  }

  override public function onDestroy(event) {
    super.onDestroy(event);
    hasBeenCreated = false;
    isPlayerIconAnimated = false;
    isPlayerOppAnimated = false;
    ogBarTexture = null;
    cancelTweens(false);
    notesHit = 0;
    hazardNotesHit = 0;
    sickCount = 0;
    goodCount = 0;
    badCount = 0;
    shitCount = 0;
    missCount = 0;
    currentAccuracy = 0.0;
    isHivemine = false;
    resetDozircAnim(true);
    isDozirc = false;
    resetHivemineMoneyPopupPool(true);

    if (cardsTimer != null) {
      cardsTimer.cancel();
      cardsTimer = null;
    }

    for (tween in tweens) {
			if (tween != null) tween.cancel();
		}
    pausedTweens.resize(0);
  }

  override public function onCreate(event) {
    super.onCreate(event);
  }

  public override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    if (!isRetro) return;

    showCards();
  }

  function pauseActiveTweens(source:Array<FlxTween>):Void
  {
    for (tween in source)
    {
      if (tween == null || !tween.active || tween.finished) continue;
      tween.active = false;
      pausedTweens.push(tween);
    }
  }

  public override function onPause(event:PauseScriptEvent)
  {
    if (!isRetro) return;
    pausedTweens.resize(0);
    pauseActiveTweens(tweens);
    pauseActiveTweens(scoreTweens);
    pauseActiveTweens(comboTweens);
    pauseActiveTweens(judgementTweens);

    if (true) return; // not implemented yet

    // Ignore base game's pause menu
    event.cancelEvent();

    // Flags to 'pause' the game
    PlayState.instance.persistentUpdate = false;
    PlayState.instance.persistentDraw = true;

    // Create and show the pause menu
    final pauseSubState = new RetroPauseMenu();
    PlayState.instance.shouldSubstatePause = true;
    PlayState.instance.openSubState(pauseSubState);
  }

  public function onUpdate(event:UpdateScriptEvent) {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (globalTimerManager != null) globalTimerManager.update(event.elapsed);

    var playState = PlayState.instance;

    for (holdNote in playState.playerStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;
      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0) {
        // Update score text.
        if (!playState.isBotPlayMode) {
          updateScoreText(Std.int(playState.songScore)); //+ Std.int(Constants.SCORE_HOLD_BONUS_PER_SECOND * event.elapsed);
        }
        break;
      }
    }

    if (!hasBeenCreated || retroHealthBarFill == null) return;

    // ---- Health Bars ----
    var healthPercent:Float = playState.healthLerp / Constants.HEALTH_MAX;
    var newWidth:Float = fillOriginalWidth * healthPercent;

    var clipX:Float = fillOriginalWidth - newWidth; // Cortar fill das barras
    //retroHealthBarFill.clipRect = FlxRect.get(clipX, 0, newWidth, retroHealthBarFill.frameHeight);
    var fillFrameHeight:Float = retroHealthBarFill.frameHeight;
    if (_fillClipRect.x != clipX || _fillClipRect.width != newWidth || _fillClipRect.height != fillFrameHeight) {
      _fillClipRect.set(clipX, 0, newWidth, fillFrameHeight);
      retroHealthBarFill.clipRect = _fillClipRect;
    }

    // Isso aqui agora é na função de setCut, não tem pra que estar aqui
    /*if (currentHealthCut > 0 && (healthBarResetTween == null || !healthBarResetTween.active)) {
      var maxHealthCutWidth:Float = fillOriginalWidth * currentHealthCut;
      retroHealthBarOverlay.clipRect = FlxRect.get(maxHealthCutWidth + maxHealthCutOffset, 0, retroHealthBarOverlay.frameWidth - (maxHealthCutWidth + maxHealthCutOffset), retroHealthBarOverlay.frameHeight);
    }*/

    // Catastrofiend has 2 colors: default and losing.
    if (ogDadId == 'phase4') {
      var targetColor = (PlayState.instance.healthLerp > Constants.HEALTH_MAX - HealthIcon.LOSING_THRESHOLD) ? BAR_COLOR_PHASE4_DEAD : BAR_COLOR_PHASE4;
      if (retroHealthBarFillBG.color != targetColor) retroHealthBarFillBG.color = targetColor;
    }

    var targetBarY = playState.healthBar.y + healthBgYOffset;
    var targetBarAlpha = playState.healthBar.alpha;
    if (retroHealthBarOverlay.y != targetBarY) retroHealthBarOverlay.y = targetBarY;
    if (retroHealthBarOverlay.alpha != targetBarAlpha) retroHealthBarOverlay.alpha = targetBarAlpha;
    if (retroHealthBarFill.y != targetBarY) retroHealthBarFill.y = targetBarY;
    if (retroHealthBarFill.alpha != targetBarAlpha) retroHealthBarFill.alpha = targetBarAlpha;
    if (retroHealthBarFillBG.y != targetBarY && !StringTools.startsWith(ogDadId, 'mixter')) retroHealthBarFillBG.y = targetBarY;
    if (retroHealthBarFillBG.alpha != targetBarAlpha) retroHealthBarFillBG.alpha = targetBarAlpha;

    // workaround for the animated icons to bop.
    if (isPlayerIconAnimated && !PlayState.instance.iconP1.isLegacyStyle) PlayState.instance.iconP1.isLegacyStyle = true;
    if (isOppIconAnimated && !PlayState.instance.iconP2.isLegacyStyle) PlayState.instance.iconP2.isLegacyStyle = true;

    if (isDozirc && dozircColorDir != 0) updateDozircIcon();

    // ---- Texts ----
    if (ratingTextDisplay != null) {
      if (ratingTextDisplay.alpha != statsDisplay.alpha) ratingTextDisplay.alpha = statsDisplay.alpha;
      if (ratingTextDisplay.visible != statsDisplay.visible) ratingTextDisplay.visible = statsDisplay.visible;
    }
    if (isHivemine && hiveminePlayerMoney != null && hivemineOppMoney != null) {
      if (!PlayState.instance.startingSong) {
        var moneyIncrease = Math.round(event.elapsed * 1000) * 3;
        var moneyIncreaseDecimals = (event.elapsed * 100) / 100;
        var markiplier = hivemineMoneyMulti;
        hivemineOppMoneyValue += (moneyIncrease + moneyIncreaseDecimals); // no multiplier here cuz it's always going up
        hiveminePlayerMoneyValue += (moneyIncrease + moneyIncreaseDecimals) * markiplier;
      }
      //updateHivemineText(); now in stepHit
    }
  }

  public override function onSongRetry(event) {
    super.onSongRetry(event);
    if (!hasBeenCreated) return;
    if (!isRetro) return;

    notesHit = 0;
    hazardNotesHit = 0;
    sickCount = 0;
    goodCount = 0;
    badCount = 0;
    shitCount = 0;
    missCount = 0;
    updateJudgementAlpha = true;
    lastDisplayedScore = null;
    lastDisplayedTimeSecond = -1;
    lastDisplayedSongLengthSecond = -1;
    invalidateStatsCache();
    resetHivemineMoneyPopupPool();

    for (tween in tweens) {
			if (tween != null) tween.cancel();
		}

    hideCards();

    healthBgYOffset = ogBarOffsetY; // Resetar offset se mudou
    if (ogBarTexture != null) updateBarTexture(ogBarTexture); // Resetar a barra se ela mudou

    isOppIconAnimated = false;
    isPlayerIconAnimated = false;
    if (retroHealthBarFill != null) retroHealthBarFill.color = getIconColor(ogBfId, false);
    if (retroHealthBarFillBG != null) retroHealthBarFillBG.color = getIconColor(!isDozirc ? ogDadId : 'dozirc', false);

    if (currentHealthCut > 0) resetHealthBarCut(0);

    judgement.visible = false;
    comboText.visible = false;
    if (!PlayState.instance.isBotPlayMode) score.visible = false;

    var coloredObjects = [
      judgement,
      comboText,
      score,
      retroHealthBarFill,
      retroHealthBarFillBG,
      retroHealthBarOverlay,
      statsDisplay,
      timeDisplay,
      timeDisplaySub,
      ratingTextDisplay
    ];

    for (obj in coloredObjects) {
      if (obj == null) continue;
      obj.colorTransform.redOffset = 0;
      obj.colorTransform.blueOffset = 0;
      obj.colorTransform.greenOffset = 0;
    }

    // Reset stats display
    currentAccuracy = 0.0;
    updateStatsDisplay(true);
    if (timeDisplay != null) {
      timeDisplay.visible = false;
      timeDisplaySub.visible = false;
      updateTimeDisplay();
    }
    if (isHivemine) setHivemineMoney(0);

    if (isDozirc) resetDozircAnim(true);

    // ahhhhh cansei de mexer nos icones
    getIconColor(ogBfId, true); // Atualizar anims novamente
    getIconColor(ogDadId, true); // Atualizar anims novamente
    configureIcon(); // Setar zindex e tudo mais nos dois icons (por algum motivo estava ficando errado ao recomeçar)

    // i tried
    if (isPlayerIconAnimated) syncIconAnim(PlayState.instance.iconP1, false);
    if (isOppIconAnimated) syncIconAnim(PlayState.instance.iconP2, true);
  }

  public override function onResume(event)
	{
		super.onResume(event);
    if (!isRetro) return;

    for (tween in pausedTweens) {
			if (tween != null && !tween.finished) tween.active = true;
		}
		pausedTweens.resize(0);
  }

  public function getIconColor(characterId:String, ?updateIconAnim:Bool = false, ?bar:FunkinSprite = null):FlxColor {
    playerIcon = PlayState.instance.iconP1;
    oppIcon = PlayState.instance.iconP2;
    switch (characterId) {
      case 'bf-retrospecter':
        return getRGB(25, 153, 186);
      case 'bf-wind':
        return getRGB(25, 153, 186);
      case 'bf-pride':
        return getRGB(128, 245, 224);
      case 'bf-wrath':
        if (!isPlayerIconAnimated && updateIconAnim) {
          isPlayerIconAnimated = true;
          // playerIcon.animation.addByPrefix("idle", "neutral", 24, false);
          // playerIcon.animation.addByPrefix("winning", "win", 24, false);
          // playerIcon.animation.addByPrefix("losing", "lose", 24, false);
          //syncIconAnim(playerIcon, false);
        }
        return getRGB(40, 45, 78);
      case 'bf-gluttony':
        return getRGB(171, 22, 74);
      case 'bf-greed':
        return getRGB(127, 31, 227);
      case 'bf-envy':
        return getRGB(30, 104, 120);
      case 'bf-sloth':
        return getRGB(55, 101, 120);
      case 'bf-lust':
        return getRGB(107, 27, 63);

      case 'phase1':
        return getRGB(23, 216, 228);
      case 'phase2':
        if (!isOppIconAnimated && updateIconAnim) {
          isOppIconAnimated = true;
          // oppIcon.animation.addByPrefix("idle", "neutral", 0, false);
          // oppIcon.animation.addByPrefix("winning", "win", 0, false);
          oppIcon.animation.addByPrefix("winningPlus", "pluswin", 0, false);
          // oppIcon.animation.addByPrefix("losing", "lose", 0, false);
          //syncIconAnim(oppIcon, true);
        }
        return getRGB(76, 255, 148);
      case 'phase3':
        return getRGB(18, 255, 255);
      case 'phase4':
        if (!isOppIconAnimated && updateIconAnim) {
          isOppIconAnimated = true;
          oppIcon.animation.addByPrefix("idle", "neutral", 24, false);
          oppIcon.animation.addByPrefix("winning", "win", 24, false);
          oppIcon.animation.addByPrefix("losing", "lose", 24, false);
          syncIconAnim(oppIcon, true);
        }
        return BAR_COLOR_PHASE4;
      case 'izzy':
        return getRGB(130, 255, 250);
      case 'insatian':
        return getRGB(193, 20, 68);
      case 'hivemine':
        return getRGB(183, 19, 238);
      case 'hiveless':
        return getRGB(175, 102, 206);
      case 'atrocean':
        return getRGB(18, 228, 118);
      case 'dozirc':
        if (!isOppIconAnimated && updateIconAnim) {
          isOppIconAnimated = true;

          // if you change something here please change it also in slowstopper.hxc
          oppIcon.animation.addByPrefix("up", "up", 1, false);
          oppIcon.animation.addByPrefix("down", "down", 1, false);
          oppIcon.animation.addByPrefix("left", "left", 1, false);
          oppIcon.animation.addByPrefix("right", "right", 1, false);

          syncIconAnim(oppIcon, true);
        }
        return getRGB(227, 146, 18);
      case 'sakuroma':
        return getRGB(248, 54, 107);
      case 'sakuroma-p2-atlas':
        return getRGB(169, 50, 140);
      case 'patience':
        return getRGB(95, 86, 153);
      case 'mixter':
        return getRGB(255, 255, 255);
      case 'mixter-pixel':
        return getRGB(255, 255, 255);
      case 'nightflaid_atlas':
        return 0xFFFFFFFF;
      case 'nightflaid_unbeatable':
        FlxTween.color(PlayState.instance.iconP2, 1, PlayState.instance.iconP2.color, 0xFFA7D6F4, { ease: FlxEase.circOut });
        return updateBarColor(CharacterType.DAD, 0xFFA7D6F4, true);
      default:
        if (bar != null) {
          return bar.color;
        }
        return p2BarColor;
    }
  }

  function getRGB(R:Int, G:Int, B:Int):Void { return FlxColor.fromRGB(R, G, B); }

  public function updateBarColor(char:CharacterType, ?color:FlxColor = p2BarColor, ?tween:Bool = false, ?tweenTime:Float = 1, ?tweenEase:FlxEase = FlxEase.circOut):Void {
    var oppBar = retroHealthBarFillBG;
    var playerBar = retroHealthBarFill;
    var targetBar = (char == CharacterType.DAD) ? oppBar : playerBar;

    if (targetBar.color == color) return;

    if (tween) {
      FlxTween.cancelTweensOf(targetBar, ['color']);
      FlxTween.color(targetBar, tweenTime, targetBar.color, color, {
        ease: tweenEase,
      });
    } else {
      targetBar.color = color;
    }
  }

  public function getOverlay():FlxSprite {
    return retroHealthBarOverlay;
  }

  public function updateBarTexture(charId:String) {
    var f:String = 'ui/healthBars/';
    ogBarTexture = null;
    switch (charId) {
      case 'hiveless':
        ogBarTexture = 'hivemore';
        var targetScale = 0.53;
        healthBgYOffset = -80;

        retroHealthBarOverlay.loadTexture(f + 'hiveless/overlay');
        retroHealthBarOverlay.screenCenter(0x01);
        retroHealthBarOverlay.scale.set(targetScale, targetScale);
        retroHealthBarFill.loadTexture(f + 'hiveless/bar');
        retroHealthBarFill.scale.set(targetScale, targetScale);
        retroHealthBarFill.screenCenter(0x01);
        retroHealthBarFillBG.loadTexture(f + 'hiveless/bar');
        retroHealthBarFillBG.screenCenter(0x01);
        retroHealthBarFillBG.scale.set(targetScale, targetScale);

        hiveminePlayerMoney.x += 10;
        hiveminePlayerMoney.y += 10;
        hivemineOppMoney.x -= 10;
        hivemineOppMoney.y += 10;
      case 'hivemore':
        var targetScale = 0.55;
        healthBgYOffset = -65;

        retroHealthBarOverlay.loadTexture(f + 'hivemore/overlay');
        retroHealthBarOverlay.screenCenter(0x01);
        retroHealthBarOverlay.scale.set(targetScale, targetScale);
        retroHealthBarFill.loadTexture(f + 'hivemore/bar');
        retroHealthBarFill.screenCenter(0x01);
        retroHealthBarFill.scale.set(targetScale, targetScale);
        retroHealthBarFillBG.loadTexture(f + 'hivemore/bar');
        retroHealthBarFillBG.screenCenter(0x01);
        retroHealthBarFillBG.scale.set(targetScale, targetScale);

        hiveminePlayerMoney.x = ogHivePlayerTextPos[0];
        hiveminePlayerMoney.y = ogHivePlayerTextPos[1];
        hivemineOppMoney.x = ogHiveOppTextPos[0];
        hivemineOppMoney.y = ogHiveOppTextPos[1];
    }

    // Atualizar o cliprect com o tamanho novo
    fillOriginalWidth = retroHealthBarFill.frameWidth;
  }

  function syncIconAnim(icon, ?opp:Bool = false) {
    win = HealthIcon.WINNING_THRESHOLD;
    lose = HealthIcon.LOSING_THRESHOLD;
    health = PlayState.instance.health;
    if (!opp) { // player
      if (health > win) {
        icon.animation.play('winning', true, false);
      } else if (health < lose) {
        icon.animation.play('losing', true, false);
      } else {
        icon.animation.play('idle', true, false);
      }
    } else { // opp
      if (health > win) {
        icon.animation.play('losing', true, false);
      } else if (health < lose) {
        icon.animation.play('winning', true, false);
      } else {
        icon.animation.play('idle', true, false);
      }
    }
  }

  public function configureIcon(?icon = 'both', ?bop:Int = 0):Void { // This should not be called every frame because of the playstate refresh
    var playState = PlayState.instance;
    var iZIndex = (retroHealthBarOverlay?.zIndex ?? playState.healthBar.zIndex) + 5;
    var iBopEvery = (bop == 0 || bop == null) ? 8 : bop;
    var iconLower = icon?.toLowerCase() ?? 'both';

    if (iconLower == 'p1' || iconLower == 'both') {
      playState.iconP1.bopEvery = iBopEvery;
      if (playState.iconP1.zIndex != iZIndex + 1) playState.iconP1.zIndex = iZIndex + 1;
      if (isPlayerIconAnimated) PlayState.instance.iconP1.isLegacyStyle = true; // workaround for the animated icon to bop.
    }
    if (iconLower == 'p2' || iconLower == 'both') {
      playState.iconP2.bopEvery = iBopEvery;
      if (playState.iconP2.zIndex != iZIndex) playState.iconP2.zIndex = iZIndex;
      if (isOppIconAnimated) PlayState.instance.iconP2.isLegacyStyle = true; // workaround for the animated icon to bop.
    }
    PlayState.instance.refresh();
  }

  public function setHealthBarCut(cutPercent:Float, ?offset:Float = 0):Void {
    if (retroHealthBarFillBG == null || retroHealthBarOverlay == null) return;
    if (healthBarResetTween != null) {
      healthBarResetTween.cancel();
      healthBarResetTween = null;
    }

    currentHealthCut = cutPercent;
    maxHealthCutOffset = offset;

    // Calcular a largura que deve ser cortada da esquerda
    var cutWidth:Float = fillOriginalWidth * cutPercent;

    var oppBarXOffset = -65; // Para que a barra fique cortada certinho (antes cortava mais do que deveria)
    _fillBGClipRect.set(cutWidth + offset + oppBarXOffset, 0, fillOriginalWidth - (cutWidth + offset), retroHealthBarFillBG.frameHeight);
    retroHealthBarFillBG.clipRect = _fillBGClipRect;

    _overlayClipRect.set(cutWidth + offset, 0, retroHealthBarOverlay.frameWidth - (cutWidth + offset), retroHealthBarOverlay.frameHeight);
    retroHealthBarOverlay.clipRect = _overlayClipRect;

    // Antigo
    //retroHealthBarFillBG.clipRect = FlxRect.get(cutWidth + offset + oppBarXOffset, 0, fillOriginalWidth - (cutWidth + offset), retroHealthBarFillBG.frameHeight);

    //retroHealthBarOverlay.clipRect = FlxRect.get(cutWidth + offset, 0, retroHealthBarOverlay.frameWidth - (cutWidth + offset), retroHealthBarOverlay.frameHeight);
    /// retroHealthBarOverlay.clipRect = FlxRect.get(cutWidth + offset, 0, retroHealthBarOverlay.frameWidth - (cutWidth + offset), retroHealthBarOverlay.frameHeight);
  }

  public function resetHealthBarCut(?duration:Float = 1.0):Void {
    if (retroHealthBarFillBG == null || retroHealthBarOverlay == null) return;
    if (healthBarResetTween != null) {
      healthBarResetTween.cancel();
      healthBarResetTween = null;
    }

    if (duration <= 0) { // Instantâneo
      currentHealthCut = 0;
      maxHealthCutOffset = 0;
      retroHealthBarFillBG.clipRect = null;
      retroHealthBarOverlay.clipRect = null;
      healthBarResetTween = null;
      return;
    }

    var startCut:Float = currentHealthCut;
    var dummyObject = {progress: startCut};

    healthBarResetTween = FlxTween.tween(dummyObject, {progress: 0}, duration, {
      ease: FlxEase.quadOut,
      onUpdate: function(twn:FlxTween) {
        if (PlayState.instance == null) {
          healthBarResetTween.cancel();
          healthBarResetTween = null;
          return;
        }
        var cutWidth:Float = fillOriginalWidth * dummyObject.progress;

        // Atualizar clips
        retroHealthBarFillBG.clipRect = FlxRect.get(
          cutWidth + maxHealthCutOffset,
          0,
          fillOriginalWidth - (cutWidth + maxHealthCutOffset) - 10,
          retroHealthBarFillBG.frameHeight
        );

        retroHealthBarOverlay.clipRect = FlxRect.get(
          cutWidth + maxHealthCutOffset,
          0,
          retroHealthBarOverlay.frameWidth - (cutWidth + maxHealthCutOffset),
          retroHealthBarOverlay.frameHeight
        );
      },
      onComplete: function(twn:FlxTween) {
        // Reset completo, só pra garantir
        currentHealthCut = 0;
        maxHealthCutOffset = 0;
        retroHealthBarFillBG.clipRect = null;
        retroHealthBarOverlay.clipRect = null;
        healthBarResetTween = null;
      }
    });
  }

  public function getObj(name:String):Dynamic {
    switch (name) {
      case 'rightBar':
        return retroHealthBarFill;
      case 'leftBar':
        return retroHealthBarFillBG;
      case 'barOverlay':
        return retroHealthBarOverlay;
      case 'scoreTxt':
        return score;
      case 'combo':
        return comboText;
      case 'judgement':
        return judgement;
      case 'statsDisplay':
        return statsDisplay;
      case 'timeDisplay':
        return timeDisplay;
      case 'timeDisplaySub':
        return timeDisplaySub;
      default:
        return null;
    }
  }

  function cancelTweens(resetScale:Bool):Void {
    for (tween in judgementTweens) {
      if (tween != null) tween.cancel();
    }
    judgementTweens = [];

    for (tween in comboTweens) {
      if (tween != null) tween.cancel();
    }
    comboTweens = [];

    for (tween in scoreTweens) {
      if (tween != null) tween.cancel();
    }
    scoreTweens = [];

    if (resetScale) {
      judgement.scale.x = hudTextScale;
      judgement.scale.y = hudTextScale;
      comboText.scale.x = hudTextScale;
      comboText.scale.y = hudTextScale;
      score.scale.x = hudTextScale;
      score.scale.y = hudTextScale;
    }
  }

  public function setUpdateJudgementAlpha(bool:Bool) {
    updateJudgementAlpha = bool;
  }

  function animateTexts(doesPulse:Bool = true, stayDuration:Float = 0):Void {
    var pulseDuration:Float = 0.1;
    var pulseScale:Float = hudTextScale + 0.06;
    cancelTweens(true);

    if (doesPulse) {
      judgementTweens.push(
        FlxTween.tween(judgement.scale, {x: pulseScale, y: pulseScale}, pulseDuration, {
          ease: FlxEase.expoOut,
          onComplete: function(twn:FlxTween) {
            judgementTweens.push(
              FlxTween.tween(judgement.scale, {x: hudTextScale, y: hudTextScale}, pulseDuration, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );

      comboTweens.push(
        FlxTween.tween(comboText.scale, {x: pulseScale, y: pulseScale}, pulseDuration, {
          ease: FlxEase.expoOut,
          onComplete: function(twn:FlxTween) {
            comboTweens.push(
              FlxTween.tween(comboText.scale, {x: hudTextScale, y: hudTextScale}, pulseDuration, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );

      scoreTweens.push(
        FlxTween.tween(score.scale, {x: pulseScale, y: pulseScale}, pulseDuration, {
          ease: FlxEase.expoOut,
          onComplete: function(twn:FlxTween) {
            scoreTweens.push(
              FlxTween.tween(score.scale, {x: hudTextScale, y: hudTextScale}, pulseDuration, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );
    }

    if (!updateJudgementAlpha) return;

    var fadeDelay:Float = 3.0; // Tempo antes de começar a desaparecer
    if (stayDuration > 0) fadeDelay += stayDuration;
    var fadeDuration:Float = 0.3;

    judgementTweens.push(
      FlxTween.tween(judgement, {alpha: 0}, fadeDuration, {
        startDelay: fadeDelay,
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          judgement.visible = false;
        }
      })
    );

    comboTweens.push(
      FlxTween.tween(comboText, {alpha: 0}, fadeDuration, {
        startDelay: fadeDelay,
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          comboText.visible = false;
        }
      })
    );

    scoreTweens.push(
      FlxTween.tween(score, {alpha: 0}, fadeDuration, {
        startDelay: fadeDelay,
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          score.visible = false;
        }
      })
    );
  }

  override function onSongEvent(event) {
		super.onSongEvent(event);
    if (!hasBeenCreated) return;
    // Atualizar cor do ícone se o personagem mudar.
		if (event.eventData.eventKind == "RetroChangeCharacter") {
      var target = event.eventData.value.character;
      var characterId = event.eventData.value.newchar.toLowerCase();
      isDozirc = StringTools.startsWith(characterId, 'doz');

      if (target == "bf") {
        isPlayerIconAnimated = false;
			  retroHealthBarFill.color = getIconColor(!isDozirc ? characterId : 'dozirc', true, retroHealthBarFill);
        configureIcon('p1');
      }
      if (target == "dad") {
        isOppIconAnimated = false;
        retroHealthBarFillBG.color = getIconColor(characterId, true, retroHealthBarFillBG);
        updateBarTexture(characterId);
        configureIcon('p2');
      }
    }
  }
}
