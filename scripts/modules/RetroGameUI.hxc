        retroHealthBarOverlay.cameras = [playState.camHUD];
        retroHealthBarOverlay.zIndex = playState.playerStrumline.zIndex + 15; //803
        retroHealthBarOverlay.scale.set(defaultScale[0], defaultScale[1]);
        retroHealthBarOverlay.screenCenter(0x01);

        // Configurar o fundo da barra (cor do oponente)
        retroHealthBarFillBG.zIndex = retroHealthBarOverlay.zIndex - 5;
        retroHealthBarFillBG.cameras = [playState.camHUD];
        retroHealthBarFillBG.scale.set(defaultScale[0], defaultScale[1]);
        retroHealthBarFillBG.screenCenter(0x01);
        retroHealthBarFillBG.color = p2BarColor;
        retroHealthBarFillBG.color = getIconColor(!isDozirc ? playStage.getDad().characterId.toLowerCase() : 'dozirc', true, retroHealthBarFillBG); // Cor do oponente
        retroHealthBarFillBG.antialiasing = false;

        // Configurar o preenchimento da barra (cor do jogador)
        retroHealthBarFill.zIndex = retroHealthBarOverlay.zIndex - 4;
        retroHealthBarFill.cameras = [playState.camHUD];
        retroHealthBarFill.scale.set(defaultScale[0], defaultScale[1]);
        retroHealthBarFill.screenCenter(0x01);
        retroHealthBarFill.color = p1BarColor;
        retroHealthBarFill.color = getIconColor(playStage.getBoyfriend().characterId.toLowerCase(), true, retroHealthBarFill); // Cor do jogador
        retroHealthBarFill.antialiasing = false;

        // Guardar a largura original
        fillOriginalWidth = retroHealthBarFill.frameWidth;

        // Adicionar
        playState.add(retroHealthBarFillBG);
        playState.add(retroHealthBarFill);
        playState.add(retroHealthBarOverlay);

        // Extras
        if (isDozirc) {
          dozircVertice1.scale.set(defaultScale[0], defaultScale[1]);
          dozircVertice1.updateHitbox();
          dozircVertice1.cameras = [playState.camHUD];
          dozircVertice1.zIndex = retroHealthBarOverlay.zIndex - 2;
          dozircVertice1.screenCenter(0x01);
          dozircVertice1.y += 85;
          dozircVertice1.x -= 360;
          dozircVertice1.color = getIconColor(!isDozirc ? playStage.getDad().characterId.toLowerCase() : 'dozirc', false);
          dozircVertice1.antialiasing = false;

          dozircVertice2.scale.set(defaultScale[0], defaultScale[1]);
          dozircVertice2.updateHitbox();
          dozircVertice2.cameras = [playState.camHUD];
          dozircVertice2.zIndex = retroHealthBarOverlay.zIndex - 2;
          dozircVertice2.screenCenter(0x01);
          dozircVertice2.y += 85;
          dozircVertice2.x += 360;
          dozircVertice2.flipX = true;
          dozircVertice2.color = getIconColor(playStage.getBoyfriend().characterId.toLowerCase(), false);
          dozircVertice2.antialiasing = false;

          dozircEletric.scale.set(defaultScale[0], defaultScale[1]);
          dozircEletric.updateHitbox();
          dozircEletric.cameras = [playState.camHUD];
          dozircEletric.zIndex = retroHealthBarFillBG.zIndex - 2;
          dozircEletric.screenCenter(0x01);
          dozircEletric.y += 7.3;
          dozircEletric.x += 6;
          dozircEletric.antialiasing = false;
          dozircEletric.alpha = 0;
          dozircEletric.kill();

          playState.add(dozircVertice1);
          playState.add(dozircVertice2);
          playState.add(dozircEletric);
        }
        /*if (insatianMunch != null) {
          insatianMunch.zIndex = retroHealthBarOverlay.zIndex;
          playState.add(insatianMunch);
        }*/
      }

      // Outros
      if (isCustomHealthBar) {
        if (isHivemine) loadHivemineText(hivemineTextColor);
        if (isMobileArrowScheme) playState.opponentStrumline.zIndex = retroHealthBarOverlay.zIndex + 10;
      }
      configureIcon(); // setar zindex e tudo mais nos dois icons

      playState.remove(playState.comboPopUps); // remover os popups padrão de julgamento e combo

      playState.refresh();

      hasBeenCreated = true;
  }

  override function onCountdownStart(event:CountdownScriptEvent) {
    super.onCountdownStart(event);
    if (!isRetro) return;
    updateStatsDisplay(true);
  }

  function createCard(text:String, isTitle:Bool = false) {
    var group = new FunkinGroup();
    group.cameras = [PlayState.instance.camCutscene];
    group.zIndex = 999999;
    group.scrollFactor.set(0, 0);
    group.refresh();
    group.screenCenter(0x10);

    var cardMargin:Float = isTitle ? 20 : 25;
    var card = FunkinSprite.create(0, 0, isTitle ? 'titlecard' : 'subcard');
    card.antialiasing = false;
    group.add(card);

    var maxWidth:Float = card.width - cardMargin * 2;
    var fontSize:Int = isTitle ? 60 : 44;

    // fieldWidth = 0 para medir a largura natural sem quebra de linha
    var cardText:FlxText = new FlxText(0, 0, 0, text.toUpperCase(), fontSize);
    group.add(cardText);
    cardText.setFormat(Paths.font('Kenyan Coffee Rg.otf'), fontSize, 0xFFFFFFFF, 'center');
    cardText.letterSpacing = -1;
    cardText.wordWrap = false;
    cardText.fieldWidth = maxWidth;

    while (cardText.textField.numLines > 1 && fontSize > 1) {
      fontSize--;
      cardText.size = fontSize;
    }

    cardText.localX = card.x + cardMargin;
    cardText.localY = card.y + (card.height / 2) - (cardText.height / 2);

    PlayState.instance.add(group);

    return group;
  }

  function hideCards(instant:Bool = true):Void {
    if (cardsTimer != null) {
      cardsTimer.cancel();
      cardsTimer = null;
    }
    if (PlayState.instance == null) return;

    var cards:Array<FunkinGroup> = [titleCard, subCard, subCard2, subCard3];

    for (card in cards) {
      if (card == null) return;
      FlxTween.cancelTweensOf(card);
      if (instant) {
        card.x -= card.width;
        card.alpha = 1;
        card.kill();
      } else {
        tweens.push(FlxTween.tween(card, {x: -card.width, alpha: 0}, 0.6, {ease: FlxEase.sineOut, onComplete: function() {
          card.kill();
        }}));
      }
    }
  }

  function showCards():Void {
    var cards:Array<FunkinGroup> = [titleCard, subCard, subCard2, subCard3];
    var delay:Float = 0.5;
    for (card in cards) {
      if (card == null) continue;
      if (!card.alive) card.revive();
      card.alpha = 1;
      tweens.push(FlxTween.tween(card, {x: 0}, 0.4, {ease: FlxEase.sineOut, startDelay: delay}));
      delay += 0.7;
    }

    cardsTimer = new FlxTimer(globalTimerManager).start(5, function(tmr) {
      hideCards(false);
    });
  }

  function loadTextElements() {
    var camera = PlayState.instance.camHUD;
    var yPos = PlayState.instance.playerStrumline.y * 1.075;
    if (!downscroll) {
      yPos = PlayState.instance.playerStrumline.y + 50;
    }
    yPos += judgementYOffset;
    var zIndex = 9999;
    if (_fontAtari == null) _fontAtari = FlxBitmapFont.fromAngelCode(Paths.font("AtariST8x16SystemFont-bmp.png"), Paths.font("AtariST8x16SystemFont-bmp.fnt"));

    //judgement = new FlxText(0, yPos, 0, '', 20);
    //judgement.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    judgement = new FlxBitmapText(0, yPos, '', _fontAtari);
    judgement.scale.set(hudTextScale, hudTextScale);
    judgement.updateHitbox();
    judgement.letterSpacing = -1;
    judgement.alignment = 'left';
    judgement.borderStyle = FlxTextBorderStyle.OUTLINE;
    judgement.borderColor = FlxColor.BLACK;
    judgement.borderSize = 3;
    judgement.cameras = [camera];
    judgement.zIndex = zIndex;
    judgement.visible = false;
    PlayState.instance.add(judgement);

    //comboText = new FlxText(0, yPos, 0, '', 20);
    //comboText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'left', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    comboText = new FlxBitmapText(0, yPos, '', _fontAtari);
    comboText.scale.set(hudTextScale, hudTextScale);
    comboText.updateHitbox();
    comboText.letterSpacing = -1;
    comboText.alignment = 'left';
    comboText.borderStyle = FlxTextBorderStyle.OUTLINE;
    comboText.borderColor = FlxColor.BLACK;
    comboText.borderSize = 3;
    comboText.cameras = [camera];
    comboText.zIndex = zIndex;
    comboText.visible = false;
    PlayState.instance.add(comboText);

    //score = new FlxText(0, yPos + judgement.frameHeight, 0, '', 20);
    //score.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    score = new FlxBitmapText(0, yPos + judgement.height, '', _fontAtari);
    score.scale.set(hudTextScale, hudTextScale);
    score.cameras = [camera];
    score.autoSize = false;
    score.autoBounds = false;
    score.alignment = 'center';
    score.fieldWidth = 1280;
    score.letterSpacing = -1;
    score.alignment = 'center';
    score.borderStyle = FlxTextBorderStyle.OUTLINE;
    score.borderColor = FlxColor.BLACK;
    score.borderSize = 3;
    //score.background = true;
    //score.backgroundColor = FlxColor.BLACK;
    score.zIndex = zIndex;
    score.updateHitbox();
    score.visible = !PlayState.instance.isBotPlayMode ? false : true;
    score.screenCenter(0x01);
    score.x += judgementXOffset + 15;
    PlayState.instance.add(score);
    if (PlayState.instance.isBotPlayMode) {
      score.text = 'BOTPLAY';
      score.x += judgementXOffset;
      FlxTween.tween(score, {alpha: 0.5}, 1.5, {type: 4, ease: FlxEase.sineOut});
    }
    lastDisplayedScore = null;

    PlayState.instance.scoreText.alpha = 0;
    PlayState.instance.scoreText.visible = false;

    // Create other stats
    createStatsDisplay();
    if (songLengthEnabled) createTimeDisplay();
  }

  var statsFontSizeOLD:Float = FlxG.onMobile ? 35 : 30;
  var statsFontSize:Float = FlxG.onMobile ? 0.52 : 0.47;
  var statsTextMargin:Array<Float> = [FlxG.onMobile ? 0 : 60, 30];
  function createStatsDisplay():Void {
    var zIndex = 9999;
    var camera = PlayState.instance.camHUD;

    statsDisplay = new FlxText(0, 0, 0, '', statsFontSize);
    statsDisplay.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), statsFontSizeOLD, 0xFFFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    statsDisplay.cameras = [camera];
    statsDisplay.zIndex = zIndex;
    statsDisplay.alignment = 'right';
    statsDisplay.visible = false;
    statsDisplay.y = statsTextMargin[1];
    statsDisplay.antialiasing = false;
    statsDisplay.borderSize = 1.3;
    statsDisplay.borderQuality = 0;
    PlayState.instance.add(statsDisplay);

    ratingTextDisplay = new FlxText(0, 20, 0, '', statsFontSize);
    ratingTextDisplay.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), statsFontSizeOLD, 0xFFFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    ratingTextDisplay.cameras = [camera];
    ratingTextDisplay.zIndex = zIndex;
    ratingTextDisplay.alignment = 'right';
    ratingTextDisplay.visible = false;
    ratingTextDisplay.antialiasing = false;
    ratingTextDisplay.borderSize = 1.3;
    ratingTextDisplay.borderQuality = 0;
    PlayState.instance.add(ratingTextDisplay);

    invalidateStatsCache();
    updateStatsDisplay(true);
