  override public function onSongLoaded(event) {
      super.onSongLoaded(event);
      isRetro = PlayState.instance.playerStrumline.noteStyle.id == 'retrospecter';
      if (!isRetro) return;
      if (hasBeenCreated) return;
      downscroll = Preferences.downscroll;
      isMobileArrowScheme = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice;
      if (isMobileArrowScheme) downscroll = true;

      var playState = PlayState.instance;
      var playStage = PlayState.instance.currentStage;
      var songId = playState.currentSong.id.toLowerCase();
      ogBfId = playStage.getBoyfriend().characterId.toLowerCase();
      ogDadId = playStage.getDad().characterId.toLowerCase();

      // Check if Story Mode
      isStoryMode = PlayStatePlaylist.isStoryMode;
      if (isStoryMode) talliesLevel = Highscore.talliesLevel;

      songLengthEnabled = Save.instance.modOptions.get('retroSongLength') ?? true;
      loadTextElements();

      // HEALTH BARS
      var defaultScale:Array<Float, Float> = [0.5, 0.5];
      var fillDirection:Array<Float, Float> = [1500, 80];
      cutOffset = 0;

      playState.healthBar.y += downscroll ? -17 : 0;
      playState.healthBar.visible = false;
      playState.healthBarBG.y = downscroll ? -17 : 0;
      playState.healthBarBG.visible = false;

      var isCustomHealthBar:Bool = true;
      var hivemineTextColor:Bool = null;
      isHivemine = false;
      switch (playStage.getDad().characterId.toLowerCase()) {
        case 'phase1':
          defaultScale = [0.45, 0.45];
          healthBgYOffset = -115;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP1/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP1/bar'); // opp
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP1/bar'); // player
        case 'phase2':
          healthBgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP2/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP2/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP2/bar');
        case 'phase3':
          defaultScale = [0.48, 0.48];
          healthBgYOffset = -83;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP3/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP3/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP3/bar');
        case 'phase4':
          defaultScale = [0.43, 0.43];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP4/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP4/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP4/bar');
        case 'izzy':
          defaultScale = [0.4, 0.4];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/izzy/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
        case 'izzy':
          defaultScale = [0.4, 0.4];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/izzy/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
        case 'hivemine':
          // se mexer aqui, nao esquecer de mexer na funcao de updateBarTexture também.
          defaultScale = [0.55, 0.55];
          healthBgYOffset = -65;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/hivemore/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hivemore/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hivemore/bar');
          isHivemine = true;
        case 'hiveless':
          // se mexer aqui, nao esquecer de mexer na funcao de updateBarTexture também.
          defaultScale = [0.53, 0.53];
          healthBgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/hiveless/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hiveless/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hiveless/bar');
          isHivemine = true;
        case 'insatian':
          /*var healthGroup:FlxTypedSpriteGroup; testing

          healthGroup = new FlxTypedSpriteGroup();
          healthGroup.cameras = [playState.camHUD];
          playState.add(healthGroup);*/

          defaultScale = [0.45, 0.45];
          healthBgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/insatian/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/insatian/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/insatian/bar');
          // Create health bar cut sprite for mechanic
          /*insatianMunch = FunkinSprite.create(playState.healthBar.x, playState.healthBar.y + healthBgYOffset, 'gluttony/munch');
          insatianMunch.setGraphicSize(Std.int(retroHealthBarOverlay.height - 30));
          insatianMunch.updateHitbox();
          insatianMunch.alpha = 0.9;
          insatianMunch.blend = 4;
          insatianMunch.cameras = [playState.camHUD];*/
        case 'sakuromap2-atlas':
          defaultScale = [0.45, 0.45];
          healthBgYOffset = -75;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/sakuP2/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/sakuP2/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/sakuP2/bar');
        case 'nightflaid_atlas':
          defaultScale = [0.58, 0.58];
          healthBgYOffset = -95;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/death/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/death/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/death/bar');

        default:
          playState.healthBar.visible = true;
          playState.healthBarBG.visible = true;
          return; // nao criar health bar custom
      }

      if (isCustomHealthBar) {
        ogBarOffsetY = healthBgYOffset;
        //retroHealthBarOverlay.y += healthBgYOffset; // aplicar offset (antigo, agora é no onUpdate!!!)
        retroHealthBarOverlay.camera = playState.camHUD;
        retroHealthBarOverlay.zIndex = playState.playerStrumline.zIndex + 5; //803
        retroHealthBarOverlay.scale.set(defaultScale[0], defaultScale[1]);
        retroHealthBarOverlay.screenCenter(0x01);

        // Configurar o fundo da barra (cor do oponente)
        retroHealthBarFillBG.zIndex = retroHealthBarOverlay.zIndex - 2;
        retroHealthBarFillBG.camera = playState.camHUD;
        retroHealthBarFillBG.scale.set(defaultScale[0], defaultScale[1]);
        retroHealthBarFillBG.screenCenter(0x01);
        retroHealthBarFillBG.color = getIconColor(playStage.getDad().characterId.toLowerCase(), true); // Cor do oponente
        retroHealthBarFillBG.antialiasing = false;

        // Configurar o preenchimento da barra (cor do jogador)
        retroHealthBarFill.zIndex = retroHealthBarOverlay.zIndex - 1;
        retroHealthBarFill.camera = playState.camHUD;
        retroHealthBarFill.scale.set(defaultScale[0], defaultScale[1]);
        retroHealthBarFill.screenCenter(0x01);
        retroHealthBarFill.color = getIconColor(playStage.getBoyfriend().characterId.toLowerCase(), true); // Cor do jogador
        retroHealthBarFill.antialiasing = false;

        // Guardar a largura original
        fillOriginalWidth = retroHealthBarFill.frameWidth;

        // Adicionar na ordem correta: fundo -> preenchimento -> overlay
        playState.add(retroHealthBarFillBG);
        playState.add(retroHealthBarFill);
        playState.add(retroHealthBarOverlay);
        /*if (insatianMunch != null) {
          insatianMunch.zIndex = retroHealthBarOverlay.zIndex;
          playState.add(insatianMunch);
        }*/
      }

      // Outros
      configureIcon(); // setar zindex e tudo mais nos dois icons
      if (isHivemine) loadHivemineText(hivemineTextColor);
      if (isMobileArrowScheme) playState.opponentStrumline.zIndex = retroHealthBarOverlay.zIndex + 1;
      playState.scoreText.font = Paths.font('AtariST8x16SystemFont.ttf');

      playState.refresh();

      hasBeenCreated = true;
