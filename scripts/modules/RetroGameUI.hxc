import flixel.FlxG;
import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.audio.FunkinSound;
import funkin.util.Constants;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import flixel.util.FlxStringUtil;
import flixel.math.FlxRect;
import flixel.ui.FlxBar;
import flixel.ui.FlxBarFillDirection;
import funkin.play.components.HealthIcon;
import funkin.play.notes.Strumline;
import funkin.play.notes.NoteSprite;
import funkin.play.GameOverSubState;
import funkin.play.character.CharacterType;
import funkin.FunkinMemory;
import funkin.Preferences;
import funkin.Conductor;
import funkin.Highscore;
import funkin.Paths;
import funkin.graphics.FunkinSprite;
import funkin.util.ReflectUtil;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;
import funkin.effects.IntervalShake;

class RetroGameUI extends Module {
  public function new() {
    super('RetroGameUI');
  }

  var isRetro:Bool = false;
  var downscroll = false;
  var healthBgYOffset:Float = 0;

  var retroHealthBar:FlxBar;
  var retroHealthBarOverlay:FunkinSprite;
  var retroHealthBarFill:FunkinSprite;
  var retroHealthBarFillBG:FunkinSprite; // Fundo da barra (cor do oponente)
  var p1BarColor:FlxColor = Constants.COLOR_HEALTH_BAR_GREEN; // bf
  var p2BarColor:FlxColor = Constants.COLOR_HEALTH_BAR_RED; // dad
  var isOppIconAnimated:Bool = false;
  var isPlayerIconAnimated:Bool = false;
  var ogBfId:String;
  var ogDadId:String;

  var judgement:FlxText;
  var comboText:FlxText;
  var score:FlxText;
  // Tweens para controlar as animações
  var judgementTweens:Array<FlxTween> = [];
  var comboTweens:Array<FlxTween> = [];
  var scoreTweens:Array<FlxTween> = [];

  var fillOriginalWidth:Float = 0; // Largura original da barra
  var hasBeenCreated:Bool = false;

  override public function onSongLoaded(event) {
      super.onSongLoaded(event);
      isRetro = PlayState.instance.playerStrumline.noteStyle.id == 'retrospecter';
      if (!isRetro) return;
      if (hasBeenCreated) return;
      downscroll = Preferences.downscroll;
      if(FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) downscroll = true;

      var playState = PlayState.instance;
      var playStage = PlayState.instance.currentStage;
      var songId = playState.currentSong.id.toLowerCase();
      ogBfId = playStage.getBoyfriend().characterId.toLowerCase();
      ogDadId = playStage.getDad().characterId.toLowerCase();

      loadTextElements();

      // HEALTH BARS
      var defaultScale:Array<Float, Float> = [0.5, 0.5];
      var fillDirection:Array<Float, Float> = [1500, 80];

      playState.healthBar.y += downscroll ? -17 : 17;
      playState.healthBar.visible = false;
      playState.healthBarBG.y = downscroll ? -17 : 17;
      playState.healthBarBG.visible = false;


      switch (playStage.getDad().characterId.toLowerCase()) {
        case 'phase1':
          defaultScale = [0.45, 0.45];
          healthBgYOffset = -115;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP1/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP1/bar'); // opp
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP1/bar'); // player
        case 'phase2':
          healthBgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP2/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP2/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP2/bar');
        case 'phase3':
          defaultScale = [0.48, 0.48];
          healthBgYOffset = -83;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP3/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP3/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP3/bar');
        case 'phase4':
          defaultScale = [0.4, 0.4];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP4/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP4/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP4/bar');
        case 'izzy':
          defaultScale = [0.4, 0.4];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/izzy/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');

        default:
          playState.healthBar.visible = true;
          playState.healthBarBG.visible = true;
          return; // nao criar health bar custom
      }

      //retroHealthBarOverlay.y += healthBgYOffset; // aplicar offset (antigo, agora é no onUpdate!!!)
      retroHealthBarOverlay.camera = playState.camHUD;
      retroHealthBarOverlay.zIndex = 803; //803
      retroHealthBarOverlay.scale.set(defaultScale[0], defaultScale[1]);
      retroHealthBarOverlay.screenCenter(0x01);

      // Configurar o fundo da barra (cor do oponente)
      retroHealthBarFillBG.zIndex = retroHealthBarOverlay.zIndex - 2;
      retroHealthBarFillBG.camera = playState.camHUD;
      retroHealthBarFillBG.scale.set(defaultScale[0], defaultScale[1]);
      retroHealthBarFillBG.screenCenter(0x01);
      retroHealthBarFillBG.color = getIconColor(playStage.getDad().characterId.toLowerCase()); // Cor do oponente

      // Configurar o preenchimento da barra (cor do jogador)
      retroHealthBarFill.zIndex = retroHealthBarOverlay.zIndex - 1;
      retroHealthBarFill.camera = playState.camHUD;
      retroHealthBarFill.scale.set(defaultScale[0], defaultScale[1]);
      retroHealthBarFill.screenCenter(0x01);
      retroHealthBarFill.color = getIconColor(playStage.getBoyfriend().characterId.toLowerCase()); // Cor do jogador

      // Guardar a largura original
      fillOriginalWidth = retroHealthBarFill.frameWidth;

      // Adicionar na ordem correta: fundo -> preenchimento -> overlay
      playState.add(retroHealthBarFillBG);
      playState.add(retroHealthBarFill);
      playState.add(retroHealthBarOverlay);

      // Outros
      playState.scoreText.font = Paths.font('AtariST8x16SystemFont.ttf');

      playState.refresh();

      hasBeenCreated = true;
  }

  function loadTextElements() {
    var camera = PlayState.instance.camHUD;
    var yPos = PlayState.instance.playerStrumline.strumlineNotes.members[0].y;
    var zIndex = 9999;

    judgement = new FlxText(0, yPos, 0, '', 20);
    judgement.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    judgement.cameras = [camera];
    judgement.zIndex = zIndex;
    judgement.visible = false;
    PlayState.instance.add(judgement);

    comboText = new FlxText(0, yPos, 0, '', 20);
    comboText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'left', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    comboText.cameras = [camera];
    comboText.zIndex = zIndex;
    comboText.visible = false;
    PlayState.instance.add(comboText);

    score = new FlxText(0, 0, 0, '', 20);
    score.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    score.fieldWidth = FlxG.width;
    score.screenCenter(0x01);
    score.cameras = [camera];
    score.zIndex = zIndex;
    score.y = yPos + judgement.frameHeight;
    score.visible = false;
    PlayState.instance.add(score);

    PlayState.instance.scoreText.alpha = 0;
    PlayState.instance.scoreText.visible = false;
  }

  public function onNoteHit(event:HitNoteScriptEvent):Void {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.note.noteData.getMustHitNote()) { // Só pro jogador!
      if (!event.note.isHoldNote) {
        updateJudgement(event.judgement, event.score, event.isComboBreak, true);
      } else {
				var stayDuration:Float = event.note.length / 1000;
        updateJudgement(event.judgement, event.score, event.isComboBreak, true, stayDuration);
      }
    }
  }

  public function onNoteMiss( event:NoteScriptEvent )
	{
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.note.noteData.getMustHitNote()) { // Só pro jogador!
      var k = event.note.noteData.kind;
      var hurtNotes:Array<String> = ['poison', 'izzyNote', 'chain', 'autoChain', 'Hydra', 'Fake Note'];
      if (hurtNotes.contains[k] || !event.note.alive || k == 'autoChain') return; // por algum motivo o autoChain ainda passa nesse evento, então precisamos especificar ele
      updateJudgement('miss', event.score, true);
    }
  }

  public function onNoteHoldDrop(event:HoldNoteScriptEvent) {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.holdNote.noteData.getMustHitNote()) { // Só pro jogador!
      updateJudgement('miss', event.score, event.isComboBreak, false);
    }
  }

  function updateJudgement(judgementName:String, noteScore:Float, isComboBreak = false, doesPopup:Bool = true, stayDuration:Float = 0):Void {
    var judgementData = getJudgement(judgementName);
    cancelTweens();

    // Atualizar o texto e cor do julgamento
    judgement.text = judgementData.text;
    judgement.color = judgementData.color;
    if (!isComboBreak) {
      comboText.text = getCombo();
    } else {
      comboText.text = '0';
    }
    //comboText.color = 0xFFFFFF;

    var totalWidth = judgement.width + comboText.width;
    judgement.x = (FlxG.width - totalWidth) / 2;
    comboText.x = judgement.x + judgement.width;

    if (noteScore) {
      score.text = PlayState.instance.songScore + noteScore;
    } else score.text = PlayState.instance.songScore;

    judgement.visible = true;
    judgement.alpha = 1;
    comboText.visible = true;
    comboText.alpha = 1;
    score.visible = true;
    score.alpha = 1;

    animateTexts(doesPopup, stayDuration);
  }

  function getCombo() {
    var combo:String = Std.string(Highscore.tallies.combo + 1);
    var comboString:String = '';
    comboString += combo;
    return comboString;
  }
  function getJudgement(judgement:String):{text:String, color:FlxColor} {
    switch (judgement) {
      case 'sick':
        return {text: 'SICK!! ', color: 0xFFffec44}; // #ffec44ff
      case 'good':
        return {text: 'GOOD! ', color: 0xFF2457ff}; // #2457ffff
      case 'bad':
        return {text: 'BAD ', color: 0xFFff4949}; // #ff4949ff
      case 'shit':
        return {text: 'SHIT ', color: 0xFFafaeae}; // #afaeaeff
      case 'miss':
        return {text: 'MISS ', color: 0xFFe90606}; // #e90606ff
      default:
        return {text: '', color: 0xFFFFFF};
    }
  }

  override public function onDestroy(event) {
    super.onDestroy(event);
    hasBeenCreated = false;
    cancelTweens();
  }

  override public function onCreate(event) {
    super.onCreate(event);
  }

  public function onUpdate(event) {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (!isRetro || !hasBeenCreated || retroHealthBarFill == null) return;
    if (PlayState.instance.isGamePaused) return;
    if(PlayState.instance.isGameOverState) return;

    var playState = PlayState.instance;

    // ---- Health Bars ----
    var healthPercent:Float = playState.healthLerp / 2.0;
    var newWidth:Float = fillOriginalWidth * healthPercent;

    var clipX:Float = fillOriginalWidth - newWidth; // Cortar barras

    retroHealthBarFill.clipRect = FlxRect.get(clipX, 0, newWidth, retroHealthBarFill.frameHeight);

    retroHealthBarOverlay.y = playState.healthBar.y + healthBgYOffset;
    retroHealthBarOverlay.alpha = playState.healthBar.alpha;
    retroHealthBarFill.y = playState.healthBar.y + healthBgYOffset;
    retroHealthBarFill.alpha = playState.healthBar.alpha;
    retroHealthBarFillBG.y = playState.healthBar.y + healthBgYOffset;
    retroHealthBarFillBG.alpha = playState.healthBar.alpha;

    // ---- Texts ----
    // Process hold notes on the player's side.
    for (holdNote in playState.playerStrumline.holdNotes.members)
    {
      if (holdNote == null || !holdNote.alive) continue;
      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0)
      {
        // Update score text.
        if (!playState.isBotPlayMode)
        {
          score.text = PlayState.instance.songScore; //+ Std.int(Constants.SCORE_HOLD_BONUS_PER_SECOND * event.elapsed);
        }
      }
    }
  }

  public function onSongRetry(event) {
    super.onSongRetry(event);
    if (!hasBeenCreated) return;
    isOppIconAnimated = false;
    isPlayerIconAnimated = false;
    retroHealthBarFill.color = getIconColor(ogBfId);
    retroHealthBarFillBG.color = getIconColor(ogDadId);
    judgement.alpha = 0;
    comboText.alpha = 0;
    score.alpha = 0;
  }

  public function getIconColor(characterId:String) {
    isOppIconAnimated = false;
    playerIcon = PlayState.instance.iconP1;
    oppIcon = PlayState.instance.iconP2;
    switch (characterId) {
      case 'bf-retrospecter':
        return 0xFF31b0d1;
      case 'bf-wind':
        return 0xFF31b0d1;
      case 'bf-pride':
        return 0xFF80f5e0;
      case 'bf-wrath':
        if (!isPlayerIconAnimated) {
          isPlayerIconAnimated = true;
          playerIcon.animation.addByPrefix("idle", "neutral", 24, false);
          playerIcon.animation.addByPrefix("winning", "win", 24, false);
          playerIcon.animation.addByPrefix("losing", "lose", 24, false);
          syncIconAnim(playerIcon, false);
        }
        return 0xFF282d4e;

      case 'phase1':
        return 0xFF17d7e3;
      case 'phase2':
        return 0xFF4cff94;
      case 'phase3':
        return 0xFF17d7e3;
      case 'phase4':
        if (!isOppIconAnimated) {
          isOppIconAnimated = true;
          oppIcon.animation.addByPrefix("idle", "neutral", 24, false);
          oppIcon.animation.addByPrefix("winning", "win", 24, false);
          oppIcon.animation.addByPrefix("losing", "lose", 24, false);
          syncIconAnim(oppIcon, true);
        }
        return 0xFF17d7e3;
      case 'izzy':
        return 0xFF78fff8;
      default:
        return p1BarColor;
    }
  }

  function syncIconAnim(icon, opp:Bool = false) {
    win = HealthIcon.WINNING_THRESHOLD;
    lose = HealthIcon.LOSING_THRESHOLD;
    health = PlayState.instance.health;
    if (!opp) { // player
      if (health > win) {
        icon.playAnimation('winning', false, false, 0);
      } else if (health < lose) {
        icon.playAnimation('losing', false, false, 0);
      } else {
        icon.playAnimation('idle', false, false, 0);
      }
    } else { // opp
      if (health > win) {
        icon.playAnimation('losing', false, false, 0);
      } else if (health < lose) {
        icon.playAnimation('winning', false, false, 0);
      } else {
        icon.playAnimation('idle', false, false, 0);
      }
    }
  }
  function cancelTweens():Void {
    for (tween in judgementTweens) {
      if (tween != null) tween.cancel();
    }
    judgementTweens = [];

    for (tween in comboTweens) {
      if (tween != null) tween.cancel();
    }
    comboTweens = [];

    for (tween in scoreTweens) {
      if (tween != null) tween.cancel();
    }
    scoreTweens = [];
  }

  function animateTexts(doesPulse:Bool = true, stayDuration:Float = 0):Void {
    var pulseDuration:Float = 0.1;
    var pulseScale:Float = 1.05;
    judgement.scale.x = 1;
    judgement.scale.y = 1;
    comboText.scale.x = 1;
    comboText.scale.y = 1;
    score.scale.x = 1;
    score.scale.y = 1;

    if (doesPulse) {
      judgementTweens.push(
        FlxTween.tween(judgement.scale, {x: pulseScale, y: pulseScale}, pulseDuration, {
          ease: FlxEase.expoOut,
          onComplete: function(twn:FlxTween) {
            judgementTweens.push(
              FlxTween.tween(judgement.scale, {x: 1, y: 1}, pulseDuration, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );

      comboTweens.push(
        FlxTween.tween(comboText.scale, {x: pulseScale, y: pulseScale}, pulseDuration, {
          ease: FlxEase.expoOut,
          onComplete: function(twn:FlxTween) {
            comboTweens.push(
              FlxTween.tween(comboText.scale, {x: 1, y: 1}, pulseDuration, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );

      scoreTweens.push(
        FlxTween.tween(score.scale, {x: pulseScale, y: pulseScale}, pulseDuration, {
          ease: FlxEase.expoOut,
          onComplete: function(twn:FlxTween) {
            scoreTweens.push(
              FlxTween.tween(score.scale, {x: 1, y: 1}, pulseDuration, {
                ease: FlxEase.quadOut
              })
            );
          }
        })
      );
    }

    var fadeDelay:Float = 3.0; // Tempo antes de começar a desaparecer
    if (stayDuration > 0) fadeDelay += stayDuration;
    var fadeDuration:Float = 0.3;

    judgementTweens.push(
      FlxTween.tween(judgement, {alpha: 0}, fadeDuration, {
        startDelay: fadeDelay,
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          judgement.visible = false;
        }
      })
    );

    comboTweens.push(
      FlxTween.tween(comboText, {alpha: 0}, fadeDuration, {
        startDelay: fadeDelay,
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          comboText.visible = false;
        }
      })
    );

    scoreTweens.push(
      FlxTween.tween(score, {alpha: 0}, fadeDuration, {
        startDelay: fadeDelay,
        ease: FlxEase.quadOut,
        onComplete: function(twn:FlxTween) {
          score.visible = false;
        }
      })
    );
  }

  override function onSongEvent(event) {
		super.onSongEvent(event);
    // Atualizar cor do icone se o personagem mudar.
		if (event.eventData.eventKind == "RetroChangeCharacter") {
      var target = event.eventData.value.character;
      var characterId = event.eventData.value.newchar.toLowerCase();

      if (target == "bf") {
			  retroHealthBarFill.color = getIconColor(characterId);
      }
      if (target == "dad") {
			  retroHealthBarFillBG.color = getIconColor(characterId);
      }
    }
  }
}
