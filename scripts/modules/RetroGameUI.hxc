import flixel.FlxG;
import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.audio.FunkinSound;
import funkin.util.Constants;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import flixel.util.FlxStringUtil;
import flixel.math.FlxRect;
import flixel.ui.FlxBar;
import flixel.ui.FlxBarFillDirection;
import funkin.play.notes.Strumline;
import funkin.play.notes.NoteSprite;
import funkin.play.GameOverSubState;
import funkin.play.character.CharacterType;
import funkin.FunkinMemory;
import funkin.Preferences;
import funkin.Conductor;
import funkin.Highscore;
import funkin.Paths;
import funkin.graphics.FunkinSprite;
import funkin.util.ReflectUtil;
import flixel.text.FlxText;
import flixel.text.FlxTextBorderStyle;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import funkin.Preferences;
import funkin.mobile.input.ControlsHandler;
import funkin.effects.IntervalShake;

class RetroGameUI extends Module {
  public function new() {
    super('RetroGameUI');
  }

  var isRetro:Bool = false;
  var downscroll = false;

  var retroHealthBar:FlxBar;
  var retroHealthBarOverlay:FunkinSprite;
  var retroHealthBarFill:FunkinSprite;
  var retroHealthBarFillBG:FunkinSprite; // Fundo da barra (cor do oponente)
  var p1BarColor:FlxColor = Constants.COLOR_HEALTH_BAR_GREEN; // bf
  var p2BarColor:FlxColor = Constants.COLOR_HEALTH_BAR_RED; // dad
  var isOppIconAnimated:Bool = false;
  var isPlayerIconAnimated:Bool = false;
  var ogBfId:String;
  var ogDadId:String;

  var fillOriginalWidth:Float = 0; // Largura original da barra
  var hasBeenCreated = false;

  public function onSongLoaded(event) {
      super.onSongLoaded(event);
      isRetro = PlayState.instance.playerStrumline.noteStyle.id == 'retrospecter';
      if (!isRetro) return;
      if (hasBeenCreated) return;
      var downscroll = Preferences.downscroll;
      if(FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice) downscroll = true;

      var playState = PlayState.instance;
      var playStage = PlayState.instance.currentStage;
      var songId = playState.currentSong.id.toLowerCase();
      ogBfId = playStage.getBoyfriend().characterId.toLowerCase();
      ogDadId = playStage.getDad().characterId.toLowerCase();

      // HEALTH BARS
      var defaultScale:Array<Float, Float> = [0.5, 0.5];
      var bgYOffset:Float = 0;
      var fillDirection:Array<Float, Float> = [1500, 80];

      playState.healthBar.y += downscroll ? -17 : 17;
      playState.healthBar.visible = false;
      playState.healthBarBG.y = downscroll ? -17 : 17;
      playState.healthBarBG.visible = false;

      switch (playStage.getDad().characterId.toLowerCase()) {
        case 'phase1':
          defaultScale = [0.45, 0.45];
          bgYOffset = -115;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP1/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP1/bar'); // opp
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP1/bar'); // player
        case 'phase2':
          bgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP2/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP2/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP2/bar');
        case 'phase3':
          defaultScale = [0.48, 0.48];
          bgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP3/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP3/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP3/bar');
        case 'phase4':
          defaultScale = [0.4, 0.4];
          bgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP4/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP4/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/retroP4/bar');
        case 'izzy':
          defaultScale = [0.4, 0.4];
          bgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/izzy/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/izzy/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + bgYOffset, 'ui/healthBars/izzy/bar');

        default:
          playState.healthBar.visible = true;
          playState.healthBarBG.visible = true;
          return; // nao criar health bar custom
      }

      retroHealthBarOverlay.y += bgYOffset; // aplicar offset
      retroHealthBarOverlay.camera = playState.camHUD;
      retroHealthBarOverlay.zIndex = 803; //803
      retroHealthBarOverlay.scale.set(defaultScale[0], defaultScale[1]);
      retroHealthBarOverlay.screenCenter(0x01);

      // Configurar o fundo da barra (cor do oponente)
      retroHealthBarFillBG.zIndex = retroHealthBarOverlay.zIndex - 2;
      retroHealthBarFillBG.camera = playState.camHUD;
      retroHealthBarFillBG.scale.set(defaultScale[0], defaultScale[1]);
      retroHealthBarFillBG.screenCenter(0x01);
      retroHealthBarFillBG.color = getIconColor(playStage.getDad().characterId.toLowerCase()); // Cor do oponente

      // Configurar o preenchimento da barra (cor do jogador)
      retroHealthBarFill.zIndex = retroHealthBarOverlay.zIndex - 1;
      retroHealthBarFill.camera = playState.camHUD;
      retroHealthBarFill.scale.set(defaultScale[0], defaultScale[1]);
      retroHealthBarFill.screenCenter(0x01);
      retroHealthBarFill.color = getIconColor(playStage.getBoyfriend().characterId.toLowerCase()); // Cor do jogador

      // Guardar a largura original
      fillOriginalWidth = retroHealthBarFill.frameWidth;

      // Adicionar na ordem correta: fundo -> preenchimento -> overlay
      playState.add(retroHealthBarFillBG);
      playState.add(retroHealthBarFill);
      playState.add(retroHealthBarOverlay);

      // Outros
      playState.scoreText.font = Paths.font('AtariST8x16SystemFont.ttf');

      playState.refresh();

      hasBeenCreated = true;
  }

  function getCombo() {
    var combo:String = Std.string(Highscore.tallies.combo);
    var comboString:String = '';
    comboString += combo;
    return comboString;
  }

  public function onDestroy(event) {
    super.onDestroy(event);
    hasBeenCreated = false;
  }

  public function onCreate(event) {
    super.onCreate(event);
  }

  public function onUpdate(event) {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (!isRetro || !hasBeenCreated || retroHealthBarFill == null) return;
    if (PlayState.instance.isGamePaused) return;
    if(ReflectUtil.getClassNameOf(FlxG.state.subState) == 'funkin.play.GameOverSubState') return;

    var playState = PlayState.instance;


    // ---- health bars ----
    var healthPercent:Float = playState.healthLerp / 2.0;
    var newWidth:Float = fillOriginalWidth * healthPercent;

    var clipX:Float = fillOriginalWidth - newWidth; // Cortar barras

    retroHealthBarFill.clipRect = FlxRect.get(clipX, 0, newWidth, retroHealthBarFill.frameHeight);

    retroHealthBarOverlay.alpha = playState.healthBar.alpha;
    retroHealthBarFill.alpha = playState.healthBar.alpha;
    retroHealthBarFillBG.alpha = playState.healthBar.alpha;
  }

  public function onSongRetry(event) {
    super.onSongRetry(event);
    if (!hasBeenCreated) return;
    isOppIconAnimated = false;
    isPlayerIconAnimated = false;
    retroHealthBarFill.color = getIconColor(ogBfId);
    retroHealthBarFillBG.color = getIconColor(ogDadId);
  }

  public function getIconColor(characterId:String) {
    isOppIconAnimated = false;
    switch (characterId) {
      case 'bf-retrospecter':
        return 0xFF31b0d1;
      case 'bf-wind':
        return 0xFF31b0d1;
      case 'bf-pride':
        return 0xFF80f5e0;
      case 'bf-wrath':
        if (!isPlayerIconAnimated) {
          isPlayerIconAnimated = true;
          PlayState.instance.iconP1.animation.addByPrefix("idle", "neutral", 24, false);
          PlayState.instance.iconP1.animation.addByPrefix("winning", "win", 24, false);
          PlayState.instance.iconP1.animation.addByPrefix("losing", "lose", 24, false);
          PlayState.instance.iconP1.playAnimation('idle', false, false, 0);
        }
        return 0xFF282d4e;

      case 'phase1':
        return 0xFF17d7e3;
      case 'phase2':
        return 0xFF4cff94;
      case 'phase3':
        return 0xFF17d7e3;
      case 'phase4':
        if (!isOppIconAnimated) {
          isOppIconAnimated = true;
          PlayState.instance.iconP2.animation.addByPrefix("idle", "neutral", 24, false);
          PlayState.instance.iconP2.animation.addByPrefix("winning", "win", 24, false);
          PlayState.instance.iconP2.animation.addByPrefix("losing", "lose", 24, false);
          PlayState.instance.iconP2.playAnimation('idle', false, false, 0);
        }
        return 0xFF17d7e3;
      case 'izzy':
        return 0xFF78fff8;
      default:
        return p1BarColor;
    }
  }

  override function onSongEvent(event) {
		super.onSongEvent(event);
    // Atualizar cor do icone se o personagem mudar.
		if (event.eventData.eventKind == "RetroChangeCharacter") {
      var target = event.eventData.value.character;
      var characterId = event.eventData.value.newchar.toLowerCase();

      if (target == "bf") {
			  retroHealthBarFill.color = getIconColor(characterId);
      }
      if (target == "dad") {
			  retroHealthBarFillBG.color = getIconColor(characterId);
      }
    }
  }
}
