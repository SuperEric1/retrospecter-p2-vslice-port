          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP3/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP3/bar');
        case 'phase4':
          defaultScale = [0.43, 0.43];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/retroP4/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP4/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/retroP4/bar');
        case 'izzy':
          defaultScale = [0.4, 0.4];
          healthBgYOffset = -100;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/izzy/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/izzy/bar');
        case 'hivemine':
          // se mexer aqui, nao esquecer de mexer na funcao de updateBarTexture também.
          defaultScale = [0.55, 0.55];
          healthBgYOffset = -65;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/hivemore/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hivemore/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hivemore/bar');
          isHivemine = true;
        case 'hiveless':
          // se mexer aqui, nao esquecer de mexer na funcao de updateBarTexture também.
          defaultScale = [0.53, 0.53];
          healthBgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/hiveless/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hiveless/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/hiveless/bar');
          isHivemine = true;
        case 'atrocean':
          defaultScale = [0.45, 0.45];
          healthBgYOffset = -70;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/atrocean/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/atrocean/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/atrocean/bar');
        case 'insatian':
          /*var healthGroup:FlxTypedSpriteGroup; testing

          healthGroup = new FlxTypedSpriteGroup();
          healthGroup.cameras = [playState.camHUD];
          playState.add(healthGroup);*/

          defaultScale = [0.45, 0.45];
          healthBgYOffset = -80;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/insatian/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/insatian/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/insatian/bar');
          // Create health bar cut sprite for mechanic
          /*insatianMunch = FunkinSprite.create(playState.healthBar.x, playState.healthBar.y + healthBgYOffset, 'gluttony/munch');
          insatianMunch.setGraphicSize(Std.int(retroHealthBarOverlay.height - 30));
          insatianMunch.updateHitbox();
          insatianMunch.alpha = 0.9;
          insatianMunch.blend = 4;
          insatianMunch.cameras = [playState.camHUD];*/
        case 'dozirc':
          defaultScale = [0.43, 0.43];
          healthBgYOffset = -90;
          retroHealthBarOverlay = FunkinSprite.create(0, playState.healthBar.y, 'ui/healthBars/dozirc/overlay');
          retroHealthBarFillBG = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/dozirc/bar');
          retroHealthBarFill = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/dozirc/bar');
          dozircVertice1 = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/dozirc/vertices');
          dozircVertice2 = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset, 'ui/healthBars/dozirc/vertices');
          dozircEletric = FunkinSprite.create(0, playState.healthBar.y + healthBgYOffset);
          dozircEletric.frames = Paths.getSparrowAtlas("ui/healthBars/dozirc/eletric");
          dozircEletric.animation.addByPrefix("start", "start0", 24, false);
          dozircEletric.animation.addByPrefix("loop", "loop0", 24, true);
          dozircEletric.animation.addByPrefix("fade", "fading0", 24, false);
          dozircEletric.animation.play("loop");
        case 'sakuroma':
