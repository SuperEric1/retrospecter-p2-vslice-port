  override function onCountdownStart(event:CountdownScriptEvent) {
    super.onCountdownStart(event);
    if (!isRetro) return;
    updateStatsDisplay(true);
  }

  function loadTextElements() {
    var camera = PlayState.instance.camHUD;
    var yPos = PlayState.instance.playerStrumline.y * 1.075;
    if (!downscroll) {
      yPos = PlayState.instance.playerStrumline.y + 50;
    }
    var zIndex = 9999;

    judgement = new FlxText(0, yPos, 0, '', 20);
    judgement.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    judgement.cameras = [camera];
    judgement.zIndex = zIndex;
    judgement.visible = false;
    PlayState.instance.add(judgement);

    comboText = new FlxText(0, yPos, 0, '', 20);
    comboText.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'left', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    comboText.cameras = [camera];
    comboText.zIndex = zIndex;
    comboText.visible = false;
    PlayState.instance.add(comboText);

    score = new FlxText(0, yPos + judgement.frameHeight, 0, '', 20);
    score.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), 30, 0xFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    score.fieldWidth = FlxG.width;
    score.screenCenter(0x01);
    score.cameras = [camera];
    score.zIndex = zIndex;
    if (PlayState.instance.isBotPlayMode) score.text = 'BOTPLAY';
    score.visible = !PlayState.instance.isBotPlayMode ? false : true;
    score.x += judgementXOffset;
    PlayState.instance.add(score);

    PlayState.instance.scoreText.alpha = 0;
    PlayState.instance.scoreText.visible = false;

    // Create other stats
    createStatsDisplay();
    if (songLengthEnabled) createTimeDisplay();
  }

  var statsFontSize:Float = FlxG.onMobile ? 35 : 30;
  var statsTextMargin:Array<Float> = [FlxG.onMobile ? 0 : 60, 30];
  function createStatsDisplay():Void {
    var zIndex = 9999;
    var camera = PlayState.instance.camHUD;

    statsDisplay = new FlxText(0, 0, 0, '', statsFontSize);
    statsDisplay.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), statsFontSize, 0xFFFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    statsDisplay.cameras = [camera];
    statsDisplay.zIndex = zIndex;
    statsDisplay.alignment = 'right';
    statsDisplay.visible = false;
    statsDisplay.y = statsTextMargin[1];
    PlayState.instance.add(statsDisplay);

    ratingTextDisplay = new FlxText(0, 20, 0, '', statsFontSize);
    ratingTextDisplay.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), statsFontSize, 0xFFFFFFFF, 'right', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    ratingTextDisplay.cameras = [camera];
    ratingTextDisplay.zIndex = zIndex;
    ratingTextDisplay.alignment = 'right';
    ratingTextDisplay.visible = false;
    PlayState.instance.add(ratingTextDisplay);

    updateStatsDisplay(true);
  }
  function createTimeDisplay():Void {
    var zIndex = 9999;

    timeDisplay = new FlxText(0, 0, 0, '', statsFontSize);
    timeDisplay.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), statsFontSize, 0xFFFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    timeDisplay.cameras = [PlayState.instance.camHUD];
    timeDisplay.zIndex = zIndex;
    timeDisplay.visible = false;
    PlayState.instance.add(timeDisplay);

    updateTimeDisplay();
  }

  function updateTimeDisplay():Void {
    if (timeDisplay == null || PlayState.instance == null) return;
    if (PlayState.instance?.isBotPlayMode) {
      timeDisplay.visible = false;
      return;
    }

    var currentTime:Float = Conductor.instance.songPosition ?? 0.0;
    var songLength:Float = FlxG.sound?.music?.length ?? 0.0;

    // Clamp to avoid negative values
    if (currentTime < 0) currentTime = 0;
    if (currentTime > songLength) currentTime = songLength;

    var currentTimeStr:String = formatTime(currentTime);
    var totalTimeStr:String = formatTime(songLength);

    timeDisplay.text = RetroLanguage.t('stats.timeLeft', 'Time Left') + '\n' + currentTimeStr + '|' + totalTimeStr;
    var targetY = (!isMobileArrowScheme && downscroll) ? statsTextMargin[1] : Std.int(FlxG.height) - timeDisplay.height - statsTextMargin[1];
    timeDisplay.x = (FullScreenScaleMode.gameCutoutSize.x / 2) + statsTextMargin[0];
    timeDisplay.y = !isMobileArrowScheme ? targetY : PlayState.instance.playerStrumline.y + timeDisplay.height / 2;
    if (currentTime > 0) timeDisplay.visible = true;
  }

  function formatTime(milliseconds:Float):String {
    var totalSeconds:Int = Std.int(milliseconds / 1000);
    var minutes:Int = Std.int(totalSeconds / 60);
    var seconds:Int = totalSeconds % 60;

    // M:SS
    return minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
  }

  function updateStatsDisplay(?hide:Bool = false):Void {
    if (statsDisplay == null || ratingTextDisplay == null) return;
    if (PlayState.instance.isBotPlayMode || hide) {
      statsDisplay.visible = false;
      ratingTextDisplay.visible = false;
      return;
    }
    statsDisplay.visible = true;
    ratingTextDisplay.visible = true;

    // Get tallies
    var tallies = Highscore.tallies;
    var totalNotes = tallies.totalNotes;
    var totalNotesHit = tallies.totalNotesHit;
    var sicks = tallies.sick;
    var goods = tallies.good;
    var bads = tallies.bad;
    var shits = tallies.shit;
    var missed = tallies.missed;
    var isNewHighscore = tallies.isNewHighscore;

    // Add Story Mode accumulated stats
    /*if (isStoryMode && talliesLevel != null) {
      totalNotes += talliesLevel.totalNotes;
      totalNotesHit += talliesLevel.totalNotesHit;
      sicks += talliesLevel.sick;
      goods += talliesLevel.good;
      bads += talliesLevel.bad;
      shits += talliesLevel.shit;
      missed += talliesLevel.missed;
    }*/

    // Calculate accuracy
    if (totalNotesHit > 0) {
      currentAccuracy = 100 - ((shits + bads + (missed * 2)) / totalNotesHit * 100);
      currentAccuracy = Math.min(100, Math.max(0, currentAccuracy));
      //currentAccuracy = Std.int(currentAccuracy);*/
    } else {
      currentAccuracy = 0.0;
    }

    // Get rating color
    var ratingData = getVanillaRatingData(currentAccuracy, goods);

    // Format accuracy
    var accuracyStr:String = Std.string(Math.round(currentAccuracy));

    // Update main stats text
    //statsDisplay.text = ' \n';
    statsDisplay.text = RetroLanguage.tf('stats.accuracy', [accuracyStr]) + '\n';
    statsDisplay.text += RetroLanguage.tf('stats.misses', [missed]) + '\n';
    statsDisplay.text += RetroLanguage.t('stats.rating', 'RANK:') + '  '; // we add the rating after. the two spaces are important
    // if (isNewHighscore) statsDisplay.text += '\nNEW HIGHSCORE!';
    var targetY = (!isMobileArrowScheme && downscroll) ? statsTextMargin[1] : Std.int(FlxG.height) - statsDisplay.height - statsTextMargin[1];
    statsDisplay.x = FlxG.width - (FullScreenScaleMode.gameCutoutSize.x / 2) - statsDisplay.width - statsTextMargin[0];
    statsDisplay.y = !isMobileArrowScheme ? targetY : PlayState.instance.playerStrumline.y + (statsDisplay.height / 2) - 40;

    // Update rating text with color
    ratingTextDisplay.text = ratingData.name;
    ratingTextDisplay.color = ratingData.color;

    // Position rating text right after "RATING: " label
    // Calculate the width of "RATING: " in the last line
    var ratingLabelWidth = statsDisplay.textField.getLineMetrics(2).width;
    ratingTextDisplay.x = statsDisplay.x + statsDisplay.textField.width - ratingTextDisplay.width; //statsDisplay.x + ratingLabelWidth - (statsFontSize / 2)
    ratingTextDisplay.y = statsDisplay.y + (statsFontSize * 2); // 2 lines down
  }

  function getVanillaRatingData(ratingPercent:Float, goods:Int):{name:String, color:FlxColor} {
    if (ratingPercent == 100 && goods == 0) {
      return {name: 'P', color: 0xFFffef5a};
    }
    else if (ratingPercent == 100 && goods >= 1) {
      return {name: 'P', color: 0xFFffa9ff};
    }
    else if (ratingPercent >= 90) {
      return {name: 'E', color: 0xFFffffb8};
    }
    else if (ratingPercent >= 80) {
      return {name: 'G', color: 0xFFe7f2ff};
    }
    else if (ratingPercent >= 60) {
      return {name: 'G', color: 0xFFf4a481};
    }
    else {
      return {name: 'L', color: 0xFF6c8dff};
    }
  }

  function loadHivemineText(?color:FlxColor = null) {
    var txtColor = color ?? 0xFFee8044;
    //if (color != null) txtColor = color;
    // update the zIndexes when the text gets updated, so it inherits the health bar's zindex.
    var hiveTextSize = retroHealthBarOverlay.width * 0.013;
    var hiveTextFieldWidth = retroHealthBarOverlay.width * 0.12;

    hiveminePlayerMoney = new FlxText(0, 0, 0, '$ 0.00', hiveTextSize);
    hiveminePlayerMoney.setFormat(Paths.font('5by7.ttf'), hiveTextSize, txtColor, 'center', FlxTextBorderStyle.NONE);
    hiveminePlayerMoney.cameras = [PlayState.instance.camHUD];
    hiveminePlayerMoney.fieldWidth = hiveTextFieldWidth;
    //hiveminePlayerMoney.textField.background = true;
    hiveminePlayerMoney.screenCenter();
    hiveminePlayerMoney.antialiasing = false;

    hivemineOppMoney = new FlxText(0, 0, 0, '$ 0.00', hiveTextSize);
    hivemineOppMoney.setFormat(Paths.font('5by7.ttf'), hiveTextSize, txtColor, 'center', FlxTextBorderStyle.NONE);
    hivemineOppMoney.cameras = [PlayState.instance.camHUD];
    hivemineOppMoney.fieldWidth = hiveTextFieldWidth;
    //hivemineOppMoney.textField.background = true;
    hivemineOppMoney.antialiasing = false;

    hivemineMoneyMulti = 1;
    positionHivemineText();
    setHivemineMoney(0);
    updateHivemineText();
  }

  function updateHivemineText(?color:FlxColor = null) {
    if (!hasBeenCreated) return;
    if (hiveminePlayerMoney == null || hivemineOppMoney == null) return;
    if (retroHealthBarOverlay == null) return;

    var targetZIndex = retroHealthBarOverlay.zIndex + 1;
    if (hiveminePlayerMoney.zIndex != targetZIndex) {
      hiveminePlayerMoney?.zIndex = targetZIndex;
      PlayState.instance.add(hiveminePlayerMoney);
      PlayState.instance.refresh(); // refresh to make sure the zindex is applied
    }
    if (hiveminePlayerMoney.alpha != retroHealthBarOverlay.alpha) hiveminePlayerMoney.alpha = retroHealthBarOverlay.alpha;
    if (hivemineOppMoney.zIndex != targetZIndex) {
      hivemineOppMoney?.zIndex = targetZIndex;
      PlayState.instance.add(hivemineOppMoney);
      PlayState.instance.refresh(); // refresh to make sure the zindex is applied
    }
    if (hivemineOppMoney.alpha != retroHealthBarOverlay.alpha) hivemineOppMoney.alpha = retroHealthBarOverlay.alpha;

    var commaSeparated:Bool = true;
    hiveminePlayerMoney.text = '$ ' + FlxStringUtil.formatMoney(hiveminePlayerMoneyValue, true, commaSeparated);
    hivemineOppMoney.text = '$ ' + FlxStringUtil.formatMoney(hivemineOppMoneyValue, true, commaSeparated);

    var negativeColor = 0xFFdb5659;
    if (hiveminePlayerMoneyValue < 0 && hiveminePlayerMoney.color != negativeColor) {
      hiveminePlayerMoney.color = negativeColor;
    } else {
      hiveminePlayerMoney.color = color ?? 0xFFee8044;
    }
  }
  public function positionHivemineText():Void {
    var hiveTextMarginX = retroHealthBarOverlay.width * 0.115;
    var hiveTextMarginY = retroHealthBarOverlay.height * 0.3;

    hiveminePlayerMoney.screenCenter();
    hiveminePlayerMoney.x += hiveTextMarginX;
    if (ogDadId == 'hiveless') hiveminePlayerMoney.x += 7;
    hiveminePlayerMoney.y = retroHealthBarOverlay.y + (retroHealthBarOverlay.height / 2) - hiveTextMarginY;
    ogHivePlayerTextPos = [hiveminePlayerMoney.x, hiveminePlayerMoney.y];

    hivemineOppMoney.screenCenter();
    hivemineOppMoney.x -= hiveTextMarginX;
    if (ogDadId == 'hiveless') hivemineOppMoney.x -= 7;
    hivemineOppMoney.y = retroHealthBarOverlay.y + (retroHealthBarOverlay.height / 2) - hiveTextMarginY;
    ogHiveOppTextPos = [hivemineOppMoney.x, hivemineOppMoney.y];
  }
  public function setHivemineMoney(value:Bool, ?target:String = null) {
    var valueFinal:Float = 0; // should be 100k but it was inaccurate with the original mod
    var lTarget:String = target ?? 'both';
    if (value != 0) valueFinal = value;
    if (value == -1) hivemineMoneyMulti = -1;
    if (lTarget.toLowerCase() == 'both') {
      hivemineOppMoneyValue = valueFinal;
      hiveminePlayerMoneyValue = valueFinal;
    } else if (lTarget.toLowerCase() == 'player') {
      hiveminePlayerMoneyValue = valueFinal;
    } else if (lTarget.toLowerCase() == 'opp') {
      hivemineOppMoneyValue = valueFinal;
    }
    return value;
  }
  public function addHivemineMoney(value:Bool, ?target:String = null) {
    var lTarget:String = target ?? 'both';
    if (lTarget.toLowerCase() == 'both') {
      hivemineOppMoneyValue += value;
      hiveminePlayerMoneyValue += value;
    } else if (lTarget.toLowerCase() == 'player') {
      hiveminePlayerMoneyValue += value;
    } else if (lTarget.toLowerCase() == 'opp') {
      hivemineOppMoneyValue += value;
    }
    return value;
  }
  public function spawnHivemineMoney(direction:Int, amount:Float) {
    if (PlayState.instance == null) return;
    var strum = PlayState.instance.playerStrumline.strumlineNotes.members[direction];
    addHivemineMoney(amount, 'player');

    var txt = new FlxText(strum.x, 0, 0, '+0', 23);
    txt.setFormat(Paths.font('5by7.ttf'), 23, amount > 0 ? 0xFFffec44 : FlxColor.RED, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    txt.cameras = [PlayState.instance.camHUD];
    txt.text = amount >= 0 ? '+' + Std.string(amount) : Std.string(amount);
    txt.x = strum.x + (strum.width / 2) - (txt.fieldWidth / 2);
    txt.y = (strum.y + (strum.height / 2) - (txt.height / 2)) + (downscroll ? -40 : 40);
    txt.zIndex = PlayState.instance.playerStrumline.zIndex + 10;
    txt.antialiasing = false;
    PlayState.instance.add(txt);

    var marketplace:Int = downscroll ? -1 : 1;
    FlxTween.tween(txt, {y: txt.y + (100 * marketplace)}, 0.4, {ease: FlxEase.quintIn, onComplete: function(_) {
      if (PlayState.instance == null || txt == null) return;
      txt.destroy();
    }});
    FlxTween.tween(txt, {alpha: 0}, 0.07, {startDelay: 0.4 - 0.07});
  }

  override public function onBeatHit(event:SongTimeScriptEvent) {
    super.onBeatHit(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    if (!isRetro) return;

    if (songLengthEnabled) {
      updateTimeDisplay();
    }
  }

  public function onNoteHit(event:HitNoteScriptEvent):Void {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.note.noteData.getMustHitNote() && !PlayState.instance.isBotPlayMode) { // Só pro jogador!
      var isNormalNote = event.note.scoreable; // Todas as hazard notes têm suas 'scoreable' setadas para false ao spawnar (RetroPlayState.hxc)
      if (isNormalNote) {
        if (!event.note.isHoldNote) {
          updateJudgement(event.judgement, event.score, event.isComboBreak, true);
        } else {
          var stayDuration:Float = event.note.length / 1000;
          updateJudgement(event.judgement, event.score, event.isComboBreak, true, stayDuration);
        }
        // Update stats display after note hit
        updateStatsDisplay();
      }
    }
  }

  public function onNoteMiss( event:NoteScriptEvent )
	{
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.note.noteData.getMustHitNote() && !PlayState.instance.isBotPlayMode) { // Só pro jogador!
      if (event.eventCanceled) return;
      var isNormalNote = event.note.scoreable; // Todas as hazard notes têm suas 'scoreable' setadas para false ao spawnar (RetroPlayState.hxc)

      if (isNormalNote) {
        updateJudgement('miss', Scoring.getMissScore(), true);
        // Update stats display after miss
        updateStatsDisplay();
      }

      // antigo sistema
      /*var k = event.note.noteData.kind;
      var hurtNotes:Array<String> = ['poison', 'izzyNote', 'chain', 'autoChain', 'sakuNote', 'Hydra', 'Fake Note'];
      if (hurtNotes.contains(k) || !event.note.alive) return;
      */
    }
  }

  public function onNoteHoldDrop(event:HoldNoteScriptEvent) {
    if (PlayState.instance == null) return;
    if (!isRetro) return;
    if (event.holdNote.noteData.getMustHitNote() && !PlayState.instance.isBotPlayMode) { // Só pro jogador!
      updateJudgement('miss', event.score, event.isComboBreak, false);
      // Update stats display after hold drop
      updateStatsDisplay();
    }
  }

  function updateJudgement(judgementName:String, noteScore:Float, isComboBreak = false, doesPopup:Bool = true, stayDuration:Float = 0):Void {
    cancelTweens();
    var judgementData = getJudgement(judgementName);
    var xOffset = FlxG.onMobile && Preferences.controlsScheme == 'Arrows' && !ControlsHandler.usingExternalInputDevice ? 0 : -50;

    // Atualizar o texto e cor do julgamento
    judgement.text = judgementData.text;
    judgement.color = judgementData.color;
    if (!isComboBreak) {
      comboText.text = getCombo();
    } else {
      comboText.text = '0';
    }
    //comboText.color = 0xFFFFFF;

    var totalWidth = judgement.width + comboText.width;
    judgement.x = ((FlxG.width - totalWidth) / 2) + judgementXOffset;
    comboText.x = judgement.x + judgement.width;

    if (noteScore > 0) {
      total = PlayState.instance.songScore;
      score.text = Std.string(total + noteScore);
    } else score.text = PlayState.instance.songScore;

    judgement.visible = true;
    judgement.alpha = 1;
    comboText.visible = true;
    comboText.alpha = 1;
    score.visible = true;
    score.alpha = 1;

    animateTexts(doesPopup, stayDuration);
  }

  function getCombo() {
    var combo:String = Std.string(Highscore.tallies.combo + 1);
    var comboString:String = '';
    comboString += combo;
    return comboString;
  }
  function getJudgement(judgement:String):{text:String, color:FlxColor} {
    switch (judgement) {
      case 'sick':
        return {text: RetroLanguage.t('judgement.sick', 'SICK!!') + ' ', color: 0xFFffec44}; // #ffec44ff
      case 'good':
        return {text: RetroLanguage.t('judgement.good', 'GOOD!') + ' ', color: 0xFF2457ff}; // #2457ffff
      case 'bad':
        return {text: RetroLanguage.t('judgement.bad', 'BAD') + ' ', color: 0xFFff4949}; // #ff4949ff
      case 'shit':
        return {text: RetroLanguage.t('judgement.shit', 'SHIT') + ' ', color: 0xFFafaeae}; // #afaeaeff
      case 'miss':
        return {text: RetroLanguage.t('judgement.miss', 'MISS') + ' ', color: 0xFFe90606}; // #e90606ff
      default:
        return {text: '?', color: 0xFFFFFF};
    }
  }

  override public function onDestroy(event) {
    super.onDestroy(event);
    hasBeenCreated = false;
    cancelTweens();
    currentAccuracy = 0.0;
    isHivemine = false;
  }

  override public function onCreate(event) {
    super.onCreate(event);
  }

  public override function onPause(event:PauseScriptEvent)
  {
    if (!isRetro) return;
    if (true) return; // not implemented yet

    // Ignore base game's pause menu
    event.cancelEvent();

    // Flags to 'pause' the game
    PlayState.instance.persistentUpdate = false;
    PlayState.instance.persistentDraw = true;

    // Create and show the pause menu
    final pauseSubState = new RetroPauseMenu();
    PlayState.instance.shouldSubstatePause = true;
    PlayState.instance.openSubState(pauseSubState);
  }

  public function onUpdate(event:UpdateScriptEvent) {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (!isRetro || !hasBeenCreated || retroHealthBarFill == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var playState = PlayState.instance;

    if (statsDisplay.visible == true) updateStatsDisplay(); // so the values are accurate
    if (songLengthEnabled && timeDisplay != null && timeDisplay.visible) {
      updateTimeDisplay();
    }

    // ---- Health Bars ----
    var healthPercent:Float = playState.healthLerp / Constants.HEALTH_MAX;
    var newWidth:Float = fillOriginalWidth * healthPercent;

    var clipX:Float = fillOriginalWidth - newWidth; // Cortar fill das barras
    retroHealthBarFill.clipRect = FlxRect.get(clipX, 0, newWidth, retroHealthBarFill.frameHeight);

    // Isso aqui agora é na função de setCut, não tem pra que estar aqui
    /*if (currentHealthCut > 0 && (healthBarResetTween == null || !healthBarResetTween.active)) {
      var maxHealthCutWidth:Float = fillOriginalWidth * currentHealthCut;
      retroHealthBarOverlay.clipRect = FlxRect.get(maxHealthCutWidth + maxHealthCutOffset, 0, retroHealthBarOverlay.frameWidth - (maxHealthCutWidth + maxHealthCutOffset), retroHealthBarOverlay.frameHeight);
    }*/

    // Catastrofiend has 2 colors: default and losing.
    if (PlayState.instance.health > Constants.HEALTH_MAX - HealthIcon.LOSING_THRESHOLD) {
      if (PlayState.instance.currentStage.getDad().characterId == 'phase4' && retroHealthBarFillBG.color != getIconColor('phase4-dead')) retroHealthBarFillBG.color = getIconColor('phase4-dead');
    } else if (PlayState.instance.health < Constants.HEALTH_MAX - HealthIcon.LOSING_THRESHOLD) {
      if (PlayState.instance.currentStage.getDad().characterId == 'phase4' && retroHealthBarFillBG.color != getIconColor('phase4')) retroHealthBarFillBG.color = getIconColor('phase4');
    }

    var targetBarY = playState.healthBar.y + healthBgYOffset;
    var targetBarAlpha = playState.healthBar.alpha;
    if (retroHealthBarOverlay.y != targetBarY) retroHealthBarOverlay.y = targetBarY;
    if (retroHealthBarOverlay.alpha != targetBarAlpha) retroHealthBarOverlay.alpha = targetBarAlpha;
    if (retroHealthBarFill.y != targetBarY) retroHealthBarFill.y = targetBarY;
    if (retroHealthBarFill.alpha != targetBarAlpha) retroHealthBarFill.alpha = targetBarAlpha;
    if (retroHealthBarFillBG.y != targetBarY) retroHealthBarFillBG.y = targetBarY;
    if (retroHealthBarFillBG.y != targetBarAlpha) retroHealthBarFillBG.alpha = targetBarAlpha;

    // ---- Texts ----
    if (isHivemine && !PlayState.instance.startingSong && hiveminePlayerMoney != null && hivemineOppMoney != null) {
      var moneyIncrease = Math.round(event.elapsed * 1000) * 3;
      var moneyIncreaseDecimals = (event.elapsed * 100) / 100;
      var markiplier = hivemineMoneyMulti;
      hivemineOppMoneyValue += (moneyIncrease + moneyIncreaseDecimals); // no multiplier here cuz it's always going up
      hiveminePlayerMoneyValue += (moneyIncrease + moneyIncreaseDecimals) * markiplier;
    }

    updateHivemineText();

    for (holdNote in playState.playerStrumline.holdNotes.members) {
      if (holdNote == null || !holdNote.alive) continue;
      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0) {
        // Update score text.
        if (!playState.isBotPlayMode) {
          score.text = PlayState.instance.songScore; //+ Std.int(Constants.SCORE_HOLD_BONUS_PER_SECOND * event.elapsed);
        }
      }
    }
  }

