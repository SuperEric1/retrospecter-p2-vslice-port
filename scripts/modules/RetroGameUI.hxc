  override public function onSongLoaded(event) {
      super.onSongLoaded(event);
      isRetro = PlayState.instance.playerStrumline.noteStyle.id == 'retrospecter';
      if (!isRetro) return;

      if (hasBeenCreated) return;

      downscroll = Preferences.downscroll;
      isMobileArrowScheme = RetroUtil.isMobileScheme();
      if (isMobileArrowScheme) downscroll = true;
      judgementXOffset = (isMobileArrowScheme ? -30 : -60) + (Save.instance.modOptions.get('retroComboOffX') ?? 0);
      judgementYOffset = Save.instance.modOptions.get('retroComboOffY') ?? 0;
      judgementYOffset = downscroll ? -judgementYOffset : judgementYOffset;
      updateJudgementAlpha = true;

      var playState = PlayState.instance;
      var playStage = PlayState.instance.currentStage;
      var songId = playState.currentSong.id.toLowerCase();
      ogBfId = playStage.getBoyfriend().characterId.toLowerCase();
      ogDadId = playStage.getDad().characterId.toLowerCase();
      globalTimerManager = new FlxTimerManager();

      // Check if Story Mode
      isStoryMode = PlayStatePlaylist.isStoryMode;
      if (isStoryMode) talliesLevel = Highscore.talliesLevel;

      songLengthEnabled = Save.instance.modOptions.get('retroSongLength') ?? true;
      loadTextElements();

      var artist = PlayState.instance.currentSong.songArtist;
      var originalArtists = artist.split('|');
      if (originalArtists.length > 1) {
        artist = originalArtists[0];
      }

      // Song name
      titleCard = createCard(PlayState.instance.currentSong.songName, true);
      // Artist
      subCard = createCard(RetroLanguage.tf(originalArtists.length > 1 ? 'stats.card.remix' : 'stats.card.artist', [artist]));
      if (originalArtists.length > 1) {
        // Original by...
        subCard2 = createCard(RetroLanguage.tf('stats.card.original', [originalArtists.slice(1).join('|')]));
        subCard3 = createCard(RetroLanguage.tf('stats.card.charter', [PlayState.instance.currentSong.charter]));
      } else {
        // Charter only
        subCard2 = createCard(RetroLanguage.tf('stats.card.charter', [PlayState.instance.currentSong.charter]));
        subCard3 = null; // making sure
      }

      var CARD_SPACING:Float = 5;
      var lastCard = subCard;
      titleCard.y -= 140;
      subCard.y = titleCard.y + titleCard.height + 15;
      subCard2.y = lastCard.y + lastCard.height + CARD_SPACING;
      lastCard = subCard2;
      if (subCard3 != null) {
        subCard3.y = lastCard.y + lastCard.height + CARD_SPACING;
        lastCard = subCard3;
      }

      hideCards();

      // HEALTH BARS
      var defaultScale:Array<Float, Float> = [0.5, 0.5];
      var fillDirection:Array<Float, Float> = [1500, 80];
      cutOffset = 0;

      playState.healthBar.y += downscroll ? -17 : 0;
      playState.healthBar.visible = false;
      playState.healthBarBG.y += downscroll ? -17 : 0;
      playState.healthBarBG.visible = false;

      var isCustomHealthBar:Bool = true;
      var hivemineTextColor:Bool = null;
      isHivemine = false;
      isDozirc = StringTools.startsWith(playStage.getDad().characterId.toLowerCase(), 'doz');
      switch (!isDozirc ? playStage.getDad().characterId.toLowerCase() : 'dozirc') {
        case 'phase1':
