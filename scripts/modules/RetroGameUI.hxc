  function createTimeDisplay():Void {
    var zIndex = 9999;

    //timeDisplay = new FlxText(0, 0, 0, '', statsFontSize);
    //timeDisplay.setFormat(Paths.font('AtariST8x16SystemFont.ttf'), statsFontSize, 0xFFFFFFFF, 'center', FlxTextBorderStyle.OUTLINE, 0xFF000000);
    timeDisplay = new FlxBitmapText(0, 0, '', _fontAtari);
    timeDisplay.scale.set(statsFontSize, statsFontSize);
    timeDisplay.updateHitbox();
    timeDisplay.letterSpacing = -1;
    timeDisplay.alignment = 'center';
    timeDisplay.borderStyle = FlxTextBorderStyle.OUTLINE;
    timeDisplay.borderColor = FlxColor.BLACK;
    timeDisplay.borderSize = 3;
    timeDisplay.fieldWidth = 10;
    timeDisplay.cameras = [PlayState.instance.camHUD];
    timeDisplay.zIndex = zIndex;
    timeDisplay.antialiasing = false;
    timeDisplay.visible = false;
    timeDisplay.text = RetroLanguage.t('stats.timeLeft', 'Time Left');
    PlayState.instance.add(timeDisplay);

    timeDisplaySub = new FlxBitmapText(0, 0, '', _fontAtari);
    timeDisplaySub.scale.set(statsFontSize, statsFontSize);
    timeDisplaySub.updateHitbox();
    timeDisplaySub.letterSpacing = -1;
    timeDisplaySub.alignment = 'center';
    timeDisplaySub.borderStyle = FlxTextBorderStyle.OUTLINE;
    timeDisplaySub.borderColor = FlxColor.BLACK;
    timeDisplaySub.borderSize = 3;
    timeDisplaySub.cameras = [PlayState.instance.camHUD];
    timeDisplaySub.zIndex = zIndex;
    timeDisplaySub.visible = false;
    PlayState.instance.add(timeDisplaySub);

    lastDisplayedTimeSecond = -1;
    lastDisplayedSongLengthSecond = -1;
    updateTimeDisplay();
  }

  function updateTimeDisplay():Void {
    if (timeDisplay == null || timeDisplaySub == null || PlayState.instance == null) return;
    /*if (PlayState.instance?.isBotPlayMode) {
      timeDisplay.visible = false;
      timeDisplaySub.visible = false;
      return;
    }*/

    var currentTime:Float = Conductor.instance.songPosition ?? 0.0;
    var songLength:Float = FlxG.sound?.music?.length ?? 0.0;

    // Clamp to avoid negative values
    if (currentTime < 0) currentTime = 0;
    if (currentTime > songLength) currentTime = songLength;

    var currentTimeSecond:Int = Std.int(currentTime / 1000);
    var songLengthSecond:Int = Std.int(songLength / 1000);
    if (currentTimeSecond != lastDisplayedTimeSecond || songLengthSecond != lastDisplayedSongLengthSecond) {
      lastDisplayedTimeSecond = currentTimeSecond;
      lastDisplayedSongLengthSecond = songLengthSecond;

      var currentTimeStr:String = formatTime(currentTime);
      var totalTimeStr:String = formatTime(songLength);
      var targetDisplaySubText:String = currentTimeStr + '|' + totalTimeStr;
      if (timeDisplaySub.text != targetDisplaySubText) timeDisplaySub.text = targetDisplaySubText;
    }
    //timeDisplay?.updateHitbox();
    //timeDisplaySub?.updateHitbox();

    var totalHeight = timeDisplay.height + timeDisplaySub.height;
    var targetY = (!isMobileArrowScheme && downscroll) ? statsTextMargin[1] : Std.int(FlxG.height) - totalHeight - statsTextMargin[1];
    var baseX = (FullScreenScaleMode.gameCutoutSize.x / 2) + statsTextMargin[0];
    var baseY = !isMobileArrowScheme ? targetY : PlayState.instance.playerStrumline.y + totalHeight / 2;

    timeDisplay?.x = baseX;
    timeDisplay?.y = baseY;
    timeDisplaySub?.x = timeDisplay.x + (timeDisplay.width / 2) - (timeDisplaySub.width / 2);
    timeDisplaySub?.y = baseY + timeDisplay.height;

    if (currentTime > 0) {
      timeDisplay?.visible = true;
      timeDisplaySub?.visible = true;
    }
  }

  function formatTime(milliseconds:Float):String {
    var totalSeconds:Int = Std.int(milliseconds / 1000);
    var minutes:Int = Std.int(totalSeconds / 60);
    var seconds:Int = totalSeconds % 60;

    // M:SS
    return minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
  }

  function invalidateStatsCache():Void {
    lastStatsAccuracyNumerator = null;
    lastStatsInteractions = null;
    lastStatsGoods = null;
    lastStatsMissed = null;
    lastStatsLanguage = null;
  }

  function updateStatsDisplay(?hide:Bool = false):Void {
    if (statsDisplay == null || ratingTextDisplay == null) return;
    if (PlayState.instance.isBotPlayMode || hide) {
      statsDisplay.visible = false;
      ratingTextDisplay.visible = false;
      return;
    }
    statsDisplay.visible = true;
    ratingTextDisplay.visible = true;

    // Get tallies
    var tallies = Highscore.tallies;
    var totalNotes = tallies.totalNotes;
    var totalNotesHit = tallies.totalNotesHit;
    var sicks = tallies.sick;
    var goods = tallies.good;
    var bads = tallies.bad;
    var shits = tallies.shit;
    var missed = tallies.missed;
    var isNewHighscore = tallies.isNewHighscore;

    // Add Story Mode accumulated stats
    /*if (isStoryMode && talliesLevel != null) {
      totalNotes += talliesLevel.totalNotes;
      totalNotesHit += talliesLevel.totalNotesHit;
      sicks += talliesLevel.sick;
      goods += talliesLevel.good;
      bads += talliesLevel.bad;
      shits += talliesLevel.shit;
      missed += talliesLevel.missed;
    }*/

    var notesInteracted = sickCount + goodCount + badCount + shitCount + missCount;
    var accuracyNumerator = sickCount + goodCount - missCount;
    var currentLanguage = RetroLanguage.getCurrentLanguage();
    var statsChanged = lastStatsAccuracyNumerator != accuracyNumerator
      || lastStatsInteractions != notesInteracted
      || lastStatsGoods != goods
      || lastStatsMissed != missed
      || lastStatsLanguage != currentLanguage;

    if (statsChanged) {
      lastStatsAccuracyNumerator = accuracyNumerator;
      lastStatsInteractions = notesInteracted;
      lastStatsGoods = goods;
      lastStatsMissed = missed;
      lastStatsLanguage = currentLanguage;

      // Calculate accuracy
      if (notesInteracted > 0) {
        currentAccuracy = (accuracyNumerator / notesInteracted) * 100;
        currentAccuracy = Math.min(100, Math.max(0, currentAccuracy));
      } else {
        currentAccuracy = 0.0;
      }

      // Get rating color
      var ratingData = getVanillaRatingData(currentAccuracy, goods);

      // Format accuracy
      var accuracyStr:String = Std.string(Math.round(currentAccuracy));

      // Update main stats text
      var targetText:String = RetroLanguage.tf('stats.accuracy', [accuracyStr]) + '\n';
      targetText += RetroLanguage.tf('stats.misses', [missed]) + '\n';
      targetText += RetroLanguage.t('stats.rating', 'RANK:') + '  '; // we add the rating after. the two spaces are important
      if (statsDisplay.text != targetText) statsDisplay.text = targetText;
      //statsDisplay.text = ' \n';
      /*statsDisplay.text = RetroLanguage.tf('stats.accuracy', [accuracyStr]) + '\n';
      statsDisplay.text += RetroLanguage.tf('stats.misses', [missed]) + '\n';
      statsDisplay.text += RetroLanguage.t('stats.rating', 'RANK:') + '  ';*/

      // Update rating text with color
      try {
        if (ratingTextDisplay?.text != ratingData?.name) ratingTextDisplay.text = ratingData?.name;
        if (ratingTextDisplay?.color != ratingData?.color) ratingTextDisplay.color = ratingData?.color;
      } catch(e:Dynamic) {}
    }

    var targetY = (!isMobileArrowScheme && downscroll) ? statsTextMargin[1] : Std.int(FlxG.height) - statsDisplay.height - statsTextMargin[1];
    statsDisplay.x = FlxG.width - (FullScreenScaleMode.gameCutoutSize.x / 2) - statsDisplay.width - statsTextMargin[0];
    statsDisplay.y = !isMobileArrowScheme ? targetY : PlayState.instance.playerStrumline.y + (statsDisplay.height / 2) - 40;

    // Position rating text right after "RANK: " text
    // Calculate the width of "RANK: " in the last line
    if (statsDisplay == null || statsDisplay?.textField == null) return;
    //var ratingLabelWidth = statsDisplay?.textField?.getLineMetrics(2)?.width ?? 0;
    ratingTextDisplay?.x = statsDisplay.x + statsDisplay?.textField?.width - ratingTextDisplay.width; //statsDisplay.x + ratingLabelWidth - (statsFontSize / 2)
    ratingTextDisplay?.y = statsDisplay.y + (statsFontSizeOLD * 2); // 2 lines down
  }

  function getVanillaRatingData(ratingPercent:Float, goods:Int):{name:String, color:FlxColor} {
    if (ratingPercent == 100 && goods == 0) {
      return {name: 'P', color: 0xFFffef5a};
    }
    else if (ratingPercent == 100 && goods >= 1) {
      return {name: 'P', color: 0xFFffa9ff};
    }
    else if (ratingPercent >= 90) {
      return {name: 'E', color: 0xFFffffb8};
    }
    else if (ratingPercent >= 80) {
      return {name: 'G', color: 0xFFe7f2ff};
    }
    else if (ratingPercent >= 60) {
      return {name: 'G', color: 0xFFf4a481};
    }
    else {
      return {name: 'L', color: 0xFF6c8dff};
    }
  }

  function getAccuracy():Float {
    return currentAccuracy;
  }

  function loadHivemineText(?color:FlxColor = null) {
    var txtColor = color ?? 0xFFee8044;
    //if (color != null) txtColor = color;
    // update the zIndexes when the text gets updated, so it inherits the health bar's zindex.
    var hiveTextSizeOLD = retroHealthBarOverlay.width * 0.013;
    var hiveTextSize = 0.335;
    var hiveTextFieldWidthOLD = retroHealthBarOverlay.width * 0.12;
    var hiveTextFieldWidth = 7 * 100;
    if (_font5by7 == null) _font5by7 = FlxBitmapFont.fromAngelCode(Paths.font("5by7-bmp.png"), Paths.font("5by7-bmp.fnt"));

    //hiveminePlayerMoney = new FlxText(0, 0, 0, '$ 0.00', hiveTextSize);
    //hiveminePlayerMoney.setFormat(Paths.font('5by7.ttf'), hiveTextSize, txtColor, 'center', FlxTextBorderStyle.NONE);
    hiveminePlayerMoney = new FlxBitmapText(0, 0, '$ 0.00', _font5by7);
    hiveminePlayerMoney.color = 0xFFee8044;
    hiveminePlayerMoney.scale.set(hiveTextSize, hiveTextSize);
    hiveminePlayerMoney.updateHitbox();
    hiveminePlayerMoney.letterSpacing = -1;
    hiveminePlayerMoney.alignment = "center";
    hiveminePlayerMoney.borderStyle = FlxTextBorderStyle.NONE;
    hiveminePlayerMoney.autoSize = false; // for the fieldwith to work
    hiveminePlayerMoney.fieldWidth = hiveTextFieldWidth;
    //hiveminePlayerMoney.background = true;
    //hiveminePlayerMoney.backgroundColor = FlxColor.BLACK;
    hiveminePlayerMoney.cameras = [PlayState.instance.camHUD];
    //hiveminePlayerMoney.textField.background = true;
    hiveminePlayerMoney.screenCenter();
    hiveminePlayerMoney.antialiasing = false;

    //hivemineOppMoney = new FlxText(0, 0, 0, '$ 0.00', hiveTextSizeOLD);
    //hivemineOppMoney.setFormat(Paths.font('5by7.ttf'), hiveTextSizeOLD, txtColor, 'center', FlxTextBorderStyle.NONE);
    hivemineOppMoney = new FlxBitmapText(0, 0, '$ 0.00', _font5by7);
    hivemineOppMoney.color = 0xFFee8044;
    hivemineOppMoney.scale.set(hiveTextSize, hiveTextSize);
    hivemineOppMoney.updateHitbox();
    hivemineOppMoney.letterSpacing = -1;
    hivemineOppMoney.alignment = "center";
    hivemineOppMoney.borderStyle = FlxTextBorderStyle.NONE;
    hivemineOppMoney.autoSize = false; // for the fieldwith to work
    hivemineOppMoney.fieldWidth = hiveTextFieldWidth;
    hivemineOppMoney.cameras = [PlayState.instance.camHUD];
    //hivemineOppMoney.textField.background = true;
    hivemineOppMoney.antialiasing = false;

    hiveminePlayerMoney.zIndex = retroHealthBarOverlay.zIndex + 1;
    hivemineOppMoney.zIndex = retroHealthBarOverlay.zIndex + 1;
    PlayState.instance.add(hiveminePlayerMoney);
    PlayState.instance.add(hivemineOppMoney);
    // no need to refresh since we already do it after the function is called

    hivemineMoneyMulti = 1;
    positionHivemineText();
    setHivemineMoney(0);
    updateHivemineText();
