  public function new()
  {
    super('RetroAchievements');
    initSave();

    if (RetroSave.isResetAchievements()) {
      resetAllAchievements();
    }
  }

  public static function resetAllAchievements():Void
  {
    Save.instance.modOptions.set(SAVE_KEY, []);
    Save.instance.flush();
  }

  public static function isUnlocked(id:String):Bool
  {
    return getSave().contains(id);
  }

  public static function grantAchievement(id:String, ?showToast:Bool = true, ?instaShow = false, ?force:Bool = false):Void
  {
    if (isUnlocked(id) && !force) return;
    if (PlayState.instance != null && (PlayState.instance.isChartingMode || PlayState.instance.isBotPlayMode)) return;

    var ach:Dynamic = getAchievement(id);
    if (ach != null && ach.unlockable != null && ach.unlockable == true) return;

    var save:Array<Dynamic> = getSave();
    save.push(id);
    Save.instance.modOptions.set(SAVE_KEY, save);
    Save.instance.flush();

    trace("Awarded achievement: " + id);

    if (showToast) {
      if (instaShow) {
        _showQueue([id]);
      } else {
        queueToast(id);
      }
    }
  }

  public static function grantAc(id:String, ?showToast:Bool = true, ?instaShow:Bool = false, ?force:Bool = false):Void
  {
    grantAchievement(id, showToast, instaShow, force);
  }
  public static function award(id:String, ?showToast:Bool = true, ?instaShow:Bool = false, ?force:Bool = false):Void
  {
    grantAchievement(id, showToast, instaShow, force);
  }

  // Resolves the full Paths.image()-compatible path for a given achievement ID.
  // Non-standard icons (mixter songs, etc.) declare iconOverride in their data.
  // Category "all" uses the root icons/all-{iconId} path.
  // All others follow icons/{category}/{category}-{iconId}.
  public static function getIconPath(id:String):String
  {
    var ach:Dynamic = getAchievement(id);
    if (ach != null && ach.iconOverride != null)
      return PATH + 'icons/' + ach.iconOverride;

    var parts:Array<String> = id.split('-');
    if (parts.length < 1) return PATH + 'icons/dummy';

    var category:String = parts[0];
    var iconId:String = parts.slice(1).join('-');

    if (category == 'all')
      return PATH + 'icons/all-' + iconId;

    return PATH + 'icons/' + category + '/' + category + '-' + iconId;
  }

  static function initSave():Void
  {
    if (Save.instance.modOptions[SAVE_KEY] == null)
    {
      Save.instance.modOptions.set(SAVE_KEY, []);
      Save.instance.flush();
    }
  }

  static function getSave():Array<Dynamic>
  {
    var val:Dynamic = Save.instance.modOptions[SAVE_KEY];
    if (val == null) return [];
    return val;
  }

  static function getAchievement(id:String):Dynamic
  {
    for (ach in ACHIEVEMENTS)
      if (ach.id == id) return ach;
    return null;
  }

  static function toasts():Array<Dynamic>
  {
    if (activeToasts == null) activeToasts = [];
    return activeToasts;
  }

  static function pendingQueue():Array<String>
  {
    if (toastQueue == null) toastQueue = [];
    return toastQueue;
  }

  public static function queueToast(id:String):Void
  {
    if (getAchievement(id) == null) return;
    pendingQueue().push(id);
  }

  public static function showQueuedToasts(?delay:Float = 0):Void
  {
    if (pendingQueue().length == 0) return;

    var queue:Array<String> = pendingQueue().copy();
    toastQueue = [];

    if (delay > 0) {
      new FlxTimer().start(delay, function(_) { _showQueue(queue); });
      return;
    }

    _showQueue(queue);
  }

  static function scaleForPos(pos:Int):Float
  {
    if (pos <= 1)
      return Math.max(TOAST_MIN_SCALE, 1.0 - pos * TOAST_SCALE_STEP);
    var baseScale:Float = Math.max(TOAST_MIN_SCALE, 1.0 - 1 * TOAST_SCALE_STEP);
    return Math.max(TOAST_MIN_SCALE, baseScale - (pos - 1) * TOAST_SCALE_STEP_SMALL);
  }

  static function _showQueue(queue:Array<String>):Void
  {
    if (queue.length == 0) return;

    var ts = toasts();
    var groupBaseY:Float = TOAST_PADDING;
    if (ts.length > 0) {
      var last:Dynamic = ts[ts.length - 1];
      groupBaseY = last.targetY + TOAST_H * last.targetScale + TOAST_GROUP_GAP;
    }

    var gId:Int = nextGroupId++;
    var n:Int = queue.length;
    var insertStart:Int = ts.length;

    // Insert in reverse so queue[0] ends up on top of the display list
    var i:Int = n - 1;
    while (i >= 0) {
      var tY:Float = groupBaseY + i * TOAST_PEEK_OFFSET;
      var tScale:Float = scaleForPos(i);
      createToast(queue[i], tY, tScale, i, gId);
      i--;
    }

    // activeToasts now has [queue[n-1]...queue[0]] for this group; reverse so index 0 = top
    var half:Int = Std.int(n / 2);
    for (k in 0...half) {
      var tmp:Dynamic = ts[insertStart + k];
      ts[insertStart + k] = ts[insertStart + n - 1 - k];
      ts[insertStart + n - 1 - k] = tmp;
    }
  }

  static function achievementKey(id:String, field:String):String
  {
    var parts:Array<String> = id.split('-');
    var category:String = parts[0];
    var idPart:String = parts.slice(1).join('-');
    return 'achievement.' + category + '.' + idPart + '.' + field;
  }

  public static function createToast(id:String, ?targetY:Float = -1, ?targetScale:Float = 1.0, ?posInGroup:Int = 0, ?groupId:Int = -1):Void
  {
    var ach:Dynamic = getAchievement(id);
    if (ach == null) return;

    var icon:FunkinSprite = FunkinSprite.create(0, 0, getIconPath(id));
    var cancelGraphic:FunkinSprite = FunkinSprite.create(0, 0, 'ui/menu/cancel_x');

    if (can_play_sound) {
      var unlockSound:FlxSound = new FlxSound().loadEmbedded(Paths.sound('unlock_popup'));
      unlockSound.persist = true;
      unlockSound.volume = 1;
      unlockSound.play();
      can_play_sound = false;

      soundTimer = new FlxTimer().start(3, function(_) {
        can_play_sound = true;
      });
    }

    if (groupId < 0) groupId = nextGroupId++;
    if (targetY < 0) {
      var ts = toasts();
      if (ts.length == 0) {
        targetY = TOAST_PADDING;
      } else {
        var last:Dynamic = ts[ts.length - 1];
        targetY = last.targetY + TOAST_H * last.targetScale + TOAST_GROUP_GAP;
      }
    }
    var padLeft:Float = 12 * TOAST_SCALE_MULT;
    var titlePadTop:Float = 14 * TOAST_SCALE_MULT;

    // Container. the entire toast moves as one unit
    var container = new Sprite();
    container.graphics.beginFill(0x000000, 1);
    container.graphics.drawRoundRect(0, 0, TOAST_W, TOAST_H, TOAST_CORNER_RADIUS, TOAST_CORNER_RADIUS);
    container.graphics.endFill();

    // Icon
    var iconBm = new Bitmap(icon.graphic.bitmap);
    iconBm.x = 12 + padLeft;
    iconBm.y = 12;
    iconBm.width = ICON_SIZE;
    iconBm.height = ICON_SIZE;
    container.addChild(iconBm);

    // Title
    var titleField = new TextField();
    titleField.text = RetroLanguage.t(achievementKey(id, 'name'), 'Unknown');
    titleField.setTextFormat(new TextFormat('Kenyan Coffee', TITLE_FONT_SIZE, 0xFFFFFF, true));
    titleField.wordWrap = true;
    titleField.selectable = false;
    titleField.width = TOAST_W - ICON_SIZE - 50;
    titleField.x = ICON_SIZE + 35 + padLeft;
    titleField.y = (12 + titlePadTop) * TOAST_SCALE_MULT;

    var currentTitleSize:Int = TITLE_FONT_SIZE;
    while (titleField.numLines > 1 && currentTitleSize > TITLE_MIN_FONT_SIZE) {
      currentTitleSize--;
      titleField.setTextFormat(new TextFormat('Kenyan Coffee', currentTitleSize, 0xFFFFFF, true));
    }

    container.addChild(titleField);

    // Description
    var descField = new TextField();
    descField.text = RetroLanguage.t(achievementKey(id, 'description'), 'Could not fetch description for the current language');
    descField.setTextFormat(new TextFormat('Atari ST 8x16 System Font', DESC_FONT_SIZE, 0xFFFFFF));
    descField.wordWrap = true;
    descField.selectable = false;
    descField.width = TOAST_W - ICON_SIZE - (50 * TOAST_SCALE_MULT);
    descField.x = ICON_SIZE + 35 + padLeft;
    descField.y = (50 + titlePadTop) * TOAST_SCALE_MULT;

    var descBottomLimit:Float = TOAST_H - (7 * TOAST_SCALE_MULT);
    if ((descField.y + descField.textHeight) > descBottomLimit) {
      var availableHeight:Float = descBottomLimit - descField.y;
      var fittedSize:Int = Std.int(DESC_FONT_SIZE * availableHeight / descField.textHeight);
      if (fittedSize < DESC_MIN_FONT_SIZE) fittedSize = DESC_MIN_FONT_SIZE;
      descField.setTextFormat(new TextFormat('Atari ST 8x16 System Font', fittedSize, 0xFFFFFF));
      while ((descField.y + descField.textHeight) > descBottomLimit && fittedSize > DESC_MIN_FONT_SIZE) {
        fittedSize--;
        descField.setTextFormat(new TextFormat('Atari ST 8x16 System Font', fittedSize, 0xFFFFFF));
      }
    }

    container.addChild(descField);

    // Cancel button added last so it sits on top
    var cancelSprite = new Sprite();
    // Invisible hit area slightly larger than the icon for easier clicking
    cancelSprite.graphics.beginFill(0, 0);
    cancelSprite.graphics.drawRect(0, 0, 24, 24);
    cancelSprite.graphics.endFill();

    var cancelBm = new Bitmap(cancelGraphic.graphic.bitmap);
    cancelBm.x = 3;
    cancelBm.y = 3;
    cancelBm.width = 14 * TOAST_SCALE_MULT;
    cancelBm.height = 14 * TOAST_SCALE_MULT;
    cancelSprite.addChild(cancelBm);

    cancelSprite.x = 2;
    cancelSprite.y = 2;
    cancelSprite.buttonMode = true;
    cancelSprite.mouseEnabled = true;
    container.addChild(cancelSprite);

    container.scaleX = targetScale;
    container.scaleY = targetScale;
    container.x = Math.max(15, FullScreenScaleMode.gameNotchSize.x) + posInGroup * TOAST_STAIR_OFFSET;
    container.y = -TOAST_H;
    //FlxG.stage.addChild(container);
    FlxG.addChildBelowMouse(container, 0);

    var toastEntry:Dynamic = { container: container, targetY: targetY, targetScale: targetScale, timer: null, groupId: groupId, posInGroup: posInGroup };
    toasts().push(toastEntry);

    var capturedEntry:Dynamic = toastEntry;
    cancelSprite.addEventListener('click', function(e:Dynamic) {
      e.stopPropagation();
      FunkinSound.playOnce(Paths.sound('scrollMenu'), 0.8);
      dismissToast(capturedEntry);
      FlxG.mouse.reset();
    });

    var displayDuration:Float = DISPLAY_TIME * (posInGroup + 1);
    if (posInGroup > 0) displayDuration = (DISPLAY_TIME * 2) + ((posInGroup + 1) * 0.8);
    FlxTween.tween(container, { y: targetY }, ENTER_TIME, {
      ease: FlxEase.elasticOut,
      onComplete: function(_) {
        var t = new FlxTimer();
        capturedEntry.timer = t;
        t.start(displayDuration, function(_) {
          FlxG.mouse.reset();
          dismissToast(capturedEntry);
        });
      }
    });

    icon.destroy();
    cancelGraphic.destroy();
  }

  static function dismissToast(toastEntry:Dynamic, ?instant:Bool = false):Void
  {
    var toasts:Array<Dynamic> = toasts();
    if (!toasts.contains(toastEntry)) return;

    if (toastEntry.timer != null)
    {
      toastEntry.timer.cancel();
      toastEntry.timer = null;
    }

    toasts.remove(toastEntry);
    repositionToasts();

    var c:Dynamic = toastEntry.container;
    if (!instant) {
      FlxTween.cancelTweensOf(c);
      FlxTween.tween(c, { y: -(TOAST_H * 1.2) }, LEAVE_TIME, {
        ease: FlxEase.quadIn,
        onComplete: function(_) {
          if (FlxG.game.contains(c)) FlxG.game.removeChild(c);
          toastEntry.container = null;
        }
      });
    } else {
      if (FlxG.game.contains(c)) FlxG.game.removeChild(c);
      toastEntry.container = null;
    }
  }

  static function repositionToasts():Void
  {
    var ts = toasts();
    if (ts.length == 0) return;

    var i:Int = 0;
    var groupBaseY:Float = TOAST_PADDING;

    while (i < ts.length) {
      var gId:Int = ts[i].groupId;
      var groupStart:Int = i;

      while (i < ts.length && ts[i].groupId == gId) i++;
      var groupSize:Int = i - groupStart;

      for (j in groupStart...groupStart + groupSize) {
        var t:Dynamic = ts[j];
        var pos:Int = j - groupStart;
        t.posInGroup = pos;

        var tScale:Float = scaleForPos(pos);
        var tY:Float = groupBaseY + pos * TOAST_PEEK_OFFSET;
        var tX:Float = TOAST_PADDING + pos * TOAST_STAIR_OFFSET;

        t.targetY = tY;
        t.targetScale = tScale;

        FlxTween.cancelTweensOf(t.container);
        FlxTween.tween(t.container, { x: tX, y: tY, scaleX: tScale, scaleY: tScale }, REPOSITION_TIME, { ease: FlxEase.quadOut });
      }

      var lastPos:Int = groupSize - 1;
      var lastScale:Float = scaleForPos(lastPos);
      groupBaseY = groupBaseY + lastPos * TOAST_PEEK_OFFSET + TOAST_H * lastScale + TOAST_GROUP_GAP;
    }
  }

  public static function deleteToasts():Void {
    for (toast in toasts().copy()) {
      dismissToast(toast, true);
    }
    toastQueue = null;
    nextGroupId = 0;
    activeToasts = [];
  }

  static function detachToastLayers():Void
  {
    for (t in toasts()) {
      if (t.timer != null) {
        t.timerRemaining = t.timer.time * (1.0 - t.timer.progress);
        t.timer.cancel();
        t.timer = null;
      }
      var c:Dynamic = t.container;
      if (c == null) continue;
      if (c.parent != null) c.parent.removeChild(c);
    }
  }

  static function refreshToastLayers():Void
  {
    var ts = toasts();
    var i = ts.length - 1;
    while (i >= 0) {
      var t = ts[i];
      var c:Dynamic = t.container;
      if (c != null) {
        if (c.parent != null) c.parent.removeChild(c);
        FlxG.addChildBelowMouse(c, 0);
      }
      if (t.timer == null && t.timerRemaining > 0) {
        var remaining:Float = t.timerRemaining;
        t.timerRemaining = 0;
        var capturedEntry:Dynamic = t;
        t.timer = new FlxTimer().start(remaining, function(_) {
          FlxG.mouse.reset();
          dismissToast(capturedEntry);
        });
      }
      i--;
    }
  }

  override public function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    deleteToasts();
  }

  override public function onStateChangeBegin(event:StateChangeScriptEvent)
  {
    super.onStateChangeBegin(event);
    detachToastLayers();
  }
  override public function onStateChangeEnd(event:StateChangeScriptEvent)
  {
    super.onStateChangeEnd(event);
    refreshToastLayers();
  }

  override public function onSubStateOpenBegin(event:StateChangeScriptEvent)
  {
    super.onSubStateOpenBegin(event);
    detachToastLayers();
  }
  override public function onSubStateOpenEnd(event:StateChangeScriptEvent)
  {
    super.onSubStateOpenEnd(event);
    refreshToastLayers();

    var targetState = event.targetState;
    //trace("Is results? " + Std.isOfType(targetState, ResultState));
    if (Std.isOfType(targetState, ResultState)) {
      showQueuedToasts(0.3);
    }
  }

  override public function onUpdate(event:ScriptEvent):Void
  {
    super.onUpdate(event);

    if (FlxG.keys.justPressed.N && RetroSave.isDebug()) {
      queueToast('wrath-blindhydra');
      queueToast('death-deathgf');
      //grantAchievement('all-dummy');
      queueToast('all-all');
      // queueToast('all-all');
      // queueToast('all-all');
      showQueuedToasts();
    }
  }
}
