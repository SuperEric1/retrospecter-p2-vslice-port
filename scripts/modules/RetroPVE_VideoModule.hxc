// Coded by AbnormalPoof, modified by SuperEric
// Originally from https://gamebanana.com/mods/514499
// Saw this being used in a lot of mods and tought it was public. Sorry!

package supereric.retrospecter.modules;

import flixel.FlxG;
import flixel.group.FlxTypedGroup;
import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.Conductor;
import funkin.graphics.FunkinSprite;
import funkin.graphics.video.FunkinVideoSprite;
import funkin.modding.events.ScriptEvent;
import funkin.modding.module.Module;
import funkin.play.PlayState;
import funkin.ui.AtlasText;
import haxe.ds.StringMap;
import thx.Objects;
import funkin.Paths;

/**
 * PVE_VideoModule is the module that handles actual video creation with the help of hxvlc.
 * You are able to call this module directly in your song scripts:
 *
 * ModuleHandler.getModule("PVE_VideoModule").scriptCall("createVideo", [
 *   Paths.videos("VIDEO_FILE_NAME_HERE"),
 *   {
 *     videoType: 1,
 *     disableControls: false,
 *     hudFadeDuration: 1,
 *     resync: true,
 *     zIndex: 300,
 *     mute: false,
 *     timestamp: Conductor.instance.songPosition
 *   }
 * ]);
 *
 * This tells PVE_VideoModule to play a video behind the HUD,
 * enable inputs, set a HUD fade duration of 1,
 * resync the video, have a custom zIndex of 3000,
 * and mute the video.
 *
 * Additionally, you can use the function as a normal `FunkinVideoSprite` object:
 *
 * var vid:FunkinVideoSprite = ModuleHandler.getModule("PVE_VideoModule").scriptCall("createVideo", [
 *   Paths.videos("VIDEO_FILE_NAME_HERE"),
 *   {
 *     videoType: 1,
 *     disableControls: false,
 *     hudFadeDuration: 1,
 *     resync: true,
 *     zIndex: 300,
 *     mute: false,
 *     timestamp: Conductor.instance.songPosition
 *   }
 * ]);
 *
 * vid.bitmap.onEndReached.add(function() {
 *   // Insert logic here I guess.
 * });
 */
class RetroPVE_VideoModule extends Module
{
  /**
   * An group of video objects.
   */
  public var videoSpriteGroup:FlxTypedGroup<PVE_VideoData> = new FlxTypedGroup();

  /**
   * Video players loaded ahead of time, grouped by their resolved file path.
   * There is one player for every occurrence of RetroPlayVideo in the chart.
   */
  var preloadedVideos:StringMap<Array<FunkinVideoSprite>> = new StringMap();

  /**
   * The next preloaded player to use for each path.
   * These cursors are reset on retry so every video can be played again.
   */
  var preloadedVideoCursors:StringMap<Int> = new StringMap();

  /**
   * onSongLoaded also fires on retry, so keep the cache alive for the whole
   * PlayState and only populate it once.
   */
  var videosPreloaded:Bool = false;

  /**
   * Whether or not to fade the HUD.
   * This is a global variable since other parts of the code outside of `createVideo()` use this.
   */
  var fadeHUD:Bool = false;

  /**
   * The tween used for fading the HUD out.
   */
  var fadeOutTween:FlxTween;

  /**
   * The tween used for fading the HUD in.
   */
  var fadeInTween:FlxTween;

  /**
   * The threshold for resyncing a video, in milliseconds.
   */
  var VIDEO_RESYNC_THRESHOLD:Int = 550;

  function new()
  {
    super('RetroPVE_VideoModule');
  }

  /**
   * Handles video creation
   * @param config The data to configure the video.
   */
  function createVideo(filePath:String, ?config:PVE_ConfigData):FunkinVideoSprite
  {
    if (filePath == Paths.videos('nightflaid')) return; //o evento é só usado como um callback, o video real ta la no stage
    if (config == null)
    {
      config = getDefaultConfig();
    }
    else
    {
      config = Objects.shallowCombine(getDefaultConfig(), config);
    }

    var videoSprite:FunkinVideoSprite = getPreloadedVideo(filePath);
    var isPreloaded:Bool = videoSprite != null;
    if (!isPreloaded)
    {
      videoSprite = new FunkinVideoSprite(0, 0);
      setupVideoSizing(videoSprite);
    }
    var blackBars:FunkinSprite = new FunkinSprite(0, 0).makeGraphic(FlxG.width, FlxG.height * 1.1, 0xFF000000);

    videoSprite.zIndex = config.zIndex;
    blackBars.zIndex = config.zIndex - 1;

    if (filePath == null)
    {
      //trace('ALERT: The video is null! How did you come across this?');
      return;
    }

    // Add the hud fade time (converted to ms) to the timestamp
    if (config.videoType == 2) config.timestamp += (config.hudFadeDuration * 1000);

    var trackedVideo:Dynamic = {
      videoSprite: videoSprite,
      config: config,
      letterBoxing: blackBars,
      destroyOnClear: !isPreloaded
    };
    videoSpriteGroup.add(trackedVideo);

    // A cached player may still have one-shot callbacks from an interrupted
    // attempt. Replace them before attaching callbacks for this occurrence.
    if (isPreloaded)
    {
      videoSprite.bitmap.onEncounteredError.removeAll();
      videoSprite.bitmap.onEndReached.removeAll();
    }

    // Ideally, the video itself should play without any issues.
    // If for some reason hxvlc shits itself or something, this error text will automatically show.
    videoSprite.bitmap.onEncounteredError.add(function() {
      if (trackedVideo != null && videoSpriteGroup != null) {
        videoSpriteGroup.remove(trackedVideo, true);
        trackedVideo = null;
      }
      if (videoSprite != null)
      {
        blackBars.destroy();
        if (isPreloaded) removePreloadedVideo(filePath, videoSprite);
        videoSprite.destroy();
        videoSprite = null;
      }
      var someErrorTextThing:AtlasText = new AtlasText(140, 240, ' AN ERROR OCCURED' + '\nDURING VIDEO PLAYBACK!', 'bold');
      someErrorTextThing.camera = PlayState.instance.camHUD;
      someErrorTextThing.zIndex = 5000;
      PlayState.instance.add(someErrorTextThing);
      new FlxTimer().start(10, function(errortextshit) {
        PlayState.instance.remove(someErrorTextThing);
      });
    }, true);

    videoSprite.bitmap.onEndReached.add(function() {
      if (trackedVideo != null && videoSpriteGroup != null) {
        videoSpriteGroup.remove(trackedVideo, true);
        trackedVideo = null;
      }
      if (fadeHUD)
      {
        fadeInTween = FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 0.5,
          {
            ease: FlxEase.quadInOut
          });
        fadeHUD = false;
      }
      blackBars.destroy();
      if (isPreloaded)
      {
        PlayState.instance.remove(videoSprite);
        videoSprite.visible = false;
        videoSprite.pause();
        videoSprite.bitmap.time = 0;
      }
      else
      {
        videoSprite.destroy();
      }
      PlayState.instance.camHUD.visible = true;
      PlayState.instance.disableKeys = false;
    }, true);

    PlayState.instance.add(blackBars);
    PlayState.instance.add(videoSprite);
    videoSprite.visible = true;
    PlayState.instance.refresh();

    if (config.disableControls)
    {
      PlayState.instance.disableKeys = true;
    }

    switch (config.videoType)
    {
      case 2:
        fadeHUD = true;
        iSwearToGodIWillLiterallyStrangleFNFTheFilePathIsLiterallyRightThereYouCanFindItStopLying = filePath;
        fuckingHell = (config.mute ? 0 : 1);
        fadeOutTween = FlxTween.tween(PlayState.instance.camHUD, {alpha: 0}, config.hudFadeDuration,
          {
            ease: FlxEase.quadOut,
            onComplete: function(twn:FlxTween) {
              videoSprite.camera = PlayState.instance.camCutscene;
              blackBars.camera = PlayState.instance.camCutscene;
              if (isPreloaded || videoSprite.load(iSwearToGodIWillLiterallyStrangleFNFTheFilePathIsLiterallyRightThereYouCanFindItStopLying))
              {
                if (isPreloaded) videoSprite.bitmap.time = 0;
                videoSprite.play();
                videoSprite.bitmap.volumeAdjust = fuckingHell;
              }
            }
          });
      case 3:
        videoSprite.camera = PlayState.instance.camCutscene;
        blackBars.camera = PlayState.instance.camCutscene;
        PlayState.instance.camHUD.visible = false;
        if (isPreloaded || videoSprite.load(filePath))
        {
          if (isPreloaded) videoSprite.bitmap.time = 0;
          videoSprite.play();
          videoSprite.bitmap.volumeAdjust = config.mute ? 0 : 1;
        }
      default:
        videoSprite.camera = PlayState.instance.camHUD;
        blackBars.camera = PlayState.instance.camHUD;
        if (isPreloaded || videoSprite.load(filePath))
        {
          if (isPreloaded) videoSprite.bitmap.time = 0;
          videoSprite.play();
          videoSprite.bitmap.volumeAdjust = config.mute ? 0 : 1;
        }
    }

    return videoSprite;
  }

  /**
   * Loads every RetroPlayVideo player used by the current chart.
   */
  function preloadSongVideos():Void
  {
    if (videosPreloaded || PlayState.instance == null) return;
    videosPreloaded = true;

    for (songEvent in PlayState.instance.songEvents)
    {
      if (songEvent.eventKind != 'RetroPlayVideo') continue;

      var filePath:String = Paths.videos(songEvent.value.path);
      if (filePath == Paths.videos('nightflaid')) continue;

      var videoSprite:FunkinVideoSprite = new FunkinVideoSprite(0, 0);
      setupVideoSizing(videoSprite);

      if (!videoSprite.load(filePath))
      {
        videoSprite.destroy();
        trace('Failed to preload video: ' + filePath);
        continue;
      }

      videoSprite.visible = false;
      videoSprite.pause();

      var videosForPath = preloadedVideos.get(filePath);
      if (videosForPath == null)
      {
        videosForPath = [];
        preloadedVideos.set(filePath, videosForPath);
        preloadedVideoCursors.set(filePath, 0);
      }
      videosForPath.push(videoSprite);
    }
  }

  /**
   * Gets the next prepared player for a video path.
   */
  function getPreloadedVideo(filePath:String):FunkinVideoSprite
  {
    var videosForPath = preloadedVideos.get(filePath);
    if (videosForPath == null) return null;

    var cursor:Int = preloadedVideoCursors.get(filePath) ?? 0;
    if (cursor >= videosForPath.length) return null;

    preloadedVideoCursors.set(filePath, cursor + 1);
    return videosForPath[cursor];
  }

  /**
   * Installs sizing before load(), since onFormatSetup may fire during preload.
   */
  function setupVideoSizing(videoSprite:FunkinVideoSprite):Void
  {
    videoSprite.bitmap.onFormatSetup.add(() -> {
      var scale:Float = Math.min(FlxG.width / videoSprite.bitmap.bitmapData.width, FlxG.height / videoSprite.bitmap.bitmapData.height);

      videoSprite.setGraphicSize((videoSprite.bitmap.bitmapData.width * scale) + 10, videoSprite.bitmap.bitmapData.height * scale);
      videoSprite.updateHitbox();
      videoSprite.screenCenter();
    });
  }

  /**
   * Makes all prepared players available again without loading their files again.
   */
  function resetPreloadedVideos():Void
  {
    for (filePath in preloadedVideos.keys())
    {
      preloadedVideoCursors.set(filePath, 0);
      for (videoSprite in preloadedVideos.get(filePath))
      {
        if (videoSprite == null) continue;
        PlayState.instance.remove(videoSprite);
        videoSprite.visible = false;
        videoSprite.pause();
        if (videoSprite.bitmap != null) videoSprite.bitmap.time = 0;
      }
    }
  }

  /**
   * Releases the preload cache when leaving the song.
   */
  function destroyPreloadedVideos():Void
  {
    for (videosForPath in preloadedVideos)
    {
      for (videoSprite in videosForPath)
      {
        if (videoSprite != null) videoSprite.destroy();
      }
    }
    preloadedVideos.clear();
    preloadedVideoCursors.clear();
    videosPreloaded = false;
  }

  function removePreloadedVideo(filePath:String, videoSprite:FunkinVideoSprite):Void
  {
    var videosForPath = preloadedVideos.get(filePath);
    if (videosForPath == null) return;

    var removedIndex:Int = videosForPath.indexOf(videoSprite);
    videosForPath.remove(videoSprite);
    var cursor:Int = preloadedVideoCursors.get(filePath) ?? 0;
    if (removedIndex >= 0 && removedIndex < cursor) preloadedVideoCursors.set(filePath, cursor - 1);

    if (videosForPath.length == 0)
    {
      preloadedVideos.remove(filePath);
      preloadedVideoCursors.remove(filePath);
    }
  }

  /**
   * Check and resync the video.
   * @param video The video data.
   * @param instant Resync the video instantly without checking.
   * @param resume Whether or not to resume the video after resyncing.
   */
  function checkResync(video:PVE_VideoData, ?instant:Bool = false, ?resume:Bool = true):Void
  {
    if (video?.videoSprite?.bitmap == null) return;

    var expectedVideoTime:Float = Conductor.instance.songPosition - Conductor.instance.combinedOffset - video.config.timestamp;
    var videoError:Float = video.videoSprite.bitmap.time - expectedVideoTime;

    if (instant || Math.abs(videoError) > VIDEO_RESYNC_THRESHOLD)
    {
      //trace('VIDEO NEEDS RESYNC!');
      //trace('Video error: ' + Std.int(Math.abs(videoError)) + 'ms');
      //trace('Resyncing video to ' + Std.int(expectedVideoTime) + 'ms (was ' + Std.int(video.videoSprite.bitmap.time) + 'ms)');
      video.videoSprite.pause();
      video.videoSprite.bitmap.time = expectedVideoTime;
      if (resume) video.videoSprite.resume();
    }
  }

  /**
   * Clears all the video sprites from the sprite group.
   */
  function clearVideoSprites():Void
  {
    for (video in videoSpriteGroup?.members)
    {
      if (video?.videoSprite != null)
      {
        var destroyOnClear:Bool = video.destroyOnClear ?? true;
        if (destroyOnClear)
        {
          video.videoSprite.destroy();
          video.letterBoxing.destroy();
        }
        else
        {
          video.videoSprite.visible = false;
          video.videoSprite.pause();
          if (isVideoPreloaded(video.videoSprite))
          {
            PlayState.instance.remove(video.videoSprite);
            video.videoSprite.bitmap.onEncounteredError.removeAll();
            video.videoSprite.bitmap.onEndReached.removeAll();
          }
          if (video.videoSprite.bitmap != null) video.videoSprite.bitmap.time = 0;
          video.letterBoxing.active = false;
          video.letterBoxing.visible = false;
        }
      }
    }
    videoSpriteGroup.clear();
  }

  function isVideoPreloaded(videoSprite:FunkinVideoSprite):Bool
  {
    for (videosForPath in preloadedVideos)
    {
      if (videosForPath.contains(videoSprite)) return true;
    }
    return false;
  }

  /**
   * Register an external video for resync tracking
   * @param videoSprite The video sprite to track
   * @param blackBars The black bars sprite
   * @param resync Whether to enable resync for this video
   */
  public function registerVideoForResync(videoSprite:FunkinVideoSprite, blackBars:FunkinSprite, ?resync:Bool = true):Void
  {
    videoSpriteGroup.add({
      videoSprite: videoSprite,
      config: {
        videoType: 1,
        disableControls: false,
        hudFadeDuration: 0,
        resync: resync,
        zIndex: 1,
        mute: false,
        timestamp: Conductor.instance.songPosition
      },
      letterBoxing: blackBars,
      destroyOnClear: false
    });
  }

  /**
   * Gets the default video configuration.
   */
  function getDefaultConfig():Void
  {
    // Reasonable defaults
    return {
      videoType: 1,
      disableControls: false,
      hudFadeDuration: 1,
      resync: true,
      zIndex: 300,
      mute: false,
      timestamp: Conductor.instance.songPosition
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (videoSpriteGroup == null || videoSpriteGroup.length == 0) return;

    for (video in videoSpriteGroup.members)
    {
      if (video?.videoSprite == null || video?.letterBoxing == null) continue;

      var videoSprite = video.videoSprite;
      var letterBoxing = video.letterBoxing;
      if (letterBoxing.visible != videoSprite.visible) letterBoxing.visible = videoSprite.visible;
      if (letterBoxing.alpha != videoSprite.alpha) letterBoxing.alpha = videoSprite.alpha;
    }
  }

  override function onFocusGained(event:FocusScriptEvent):Void
  {
    super.onFocusGained(event);
    if (videoSpriteGroup != null)
    {
      // Re-pause the video when we regain focus due to a weird bug.
      if (PlayState.instance?.isGamePaused)
      {
        for (video in videoSpriteGroup.members)
        {
          video.videoSprite.pause();
        }
      }
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    for (video in videoSpriteGroup.members)
    {
      if (video.config.resync && video.videoSprite?.bitmap?.isPlaying)
      {
        checkResync(video, false, true);
      }
    }
  }

  override function onPause(event:PauseScriptEvent):Void
  {
    if (fadeOutTween != null) fadeOutTween.active = false;
    if (fadeInTween != null) fadeInTween.active = false;
    for (video in videoSpriteGroup.members)
    {
      video.videoSprite.pause();
      if (video.config.resync)
      {
        // Force a resync to prevent the video from desyncing when pausing multiple times.
        checkResync(video, true, false);
      }
    }
  }

  override function onResume(event:ScriptEvent):Void
  {
    if (fadeOutTween != null) fadeOutTween.active = true;
    if (fadeInTween != null) fadeInTween.active = true;
    for (video in videoSpriteGroup.members)
    {
      video.videoSprite.resume();
    }
  }

  override function onSongRetry(event:SongRetryEvent):Void
  {
    if (fadeHUD)
    {
      if (fadeOutTween != null) fadeOutTween.cancel(); // For some reason this is needed to prevent a stack overflow thing I guess???
      fadeInTween = FlxTween.tween(PlayState.instance.camHUD, {alpha: 1}, 0.5, {ease: FlxEase.quadInOut});
    }
    else
    {
      PlayState.instance.camHUD.visible = true;
    }
    clearVideoSprites();
    resetPreloadedVideos();
  }

  override function onGameOver(event:ScriptEvent):Void
  {
    clearVideoSprites();
  }

  override function onSongEnd(event:ScriptEvent):Void
  {
    clearVideoSprites();
    destroyPreloadedVideos();
  }

  override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    clearVideoSprites();
  }

  override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
    preloadSongVideos();
  }
}

typedef PVE_VideoData =
{
  /**
   * The video sprite object itself.
   */
  videoSprite:FunkinVideoSprite,

  /**
   * The configuration for the video.
   */
  config:PVE_ConfigData,

  /**
   * The black bars associated with the video.
   */
  letterBoxing:FunkinSprite,

  /**
   * False for reusable/preloaded players and external players owned by a stage.
   */
  ?destroyOnClear:Bool,
}

typedef PVE_ConfigData =
{
  /**
   * The type of video (1 = normal, 2 = fade HUD, 3 = hide HUD).
   */
  videoType:Int,

  /**
   * The duration of the HUD fade.
   */
  hudFadeDuration:Float,

  /**
   * Whether to resync the video.
   */
  resync:Bool,

  /**
   * The timestamp the video was played at.
   */
  timestamp:Float
}
