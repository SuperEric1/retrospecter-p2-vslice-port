import flixel.FlxG;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.title.TitleState;
import funkin.ui.title.AttractState;
import funkin.modding.base.ScriptedMusicBeatState;
import funkin.modding.module.Module;
import Std;

// this makes the custom title screen appear when starting the game.
class RetroTitleScreen extends Module
{
  final ENABLED = true;

  public function new()
  {
    super('RetroTitleScreen');
  }

  var initialized:Bool = false;

  function setInitialized(bool:Bool)
  {
    initialized = bool;
  }

  function onStateChangeEnd(event:StateChangeScriptEvent)
  {
    super.onStateChangeEnd(event);

    if (Std.isOfType(FlxG.state, TitleState) && ENABLED)
    {
      TitleState.initialized = true;
      if (FlxG.sound.music != null) FlxG.sound.music.stop();
      FlxG.switchState(ScriptedMusicBeatState.init("RetroTitleState"));
    }
    else if (Std.isOfType(FlxG.state, MainMenuState) || Std.isOfType(FlxG.state, AttractState))
    {
      initialized = true;
    }
  }
}
