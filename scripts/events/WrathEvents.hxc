import funkin.play.event.SongEvent;
import funkin.play.PlayState;

class WrathEvents extends SongEvent {
  function new() {
    super('WrathEvents');
  }

  override function getTitle() {
    return "Wrath Events";
  }

  override function handleEvent(data) {
    if (PlayState.instance == null || PlayState.instance.currentStage == null) return;
    if (PlayState.instance.isMinimalMode) return;
  }

  override function getEventSchema() {
    return [
      {
        name: "eventType",
        title: "Tipo do Evento",
        defaultValue: 0,
        type: "enum",
        keys: [
          "Phase3 geysers" => 0,
          "Phase3 eruption" => 1,
          "Phase3 sink" => 2,

          "shakeChange" => 3,
          "weirdPulse" => 4,
          "resetNote" => 5,
          "uniqueReturn" => 6,
          "setSwayVal" => 7,
        ]
      },
      {
        name: "value1",
        title: "Valor 1",
        defaultValue: '',
        type: "string"
      },
    ];
  }
}
