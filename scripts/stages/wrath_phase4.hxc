class WrathPhase4Stage extends Stage
{
  var prefix:String = 'Phase4/';
  var defaultCamZoom:Float = 1.0;
  var debugText:FlxText;
  var hasCreatedStage:Bool = false;
  var currentCameraTarget:String = 'dad';
  var downscroll = false;
  var retroNoteStyles = null;

  // Stage sprites
  var blue:StageProp;
  var vortex:StageProp;
  var sky:StageProp;
  var skies:StageProp;
  var farWalls:StageProp;
  var mountains:StageProp;
  var izzyTower:StageProp;
  var izzyCloud:StageProp;
  var dozirc_Smoke:StageProp;
  var dozirc:StageProp;
  var dozirc_Lights:StageProp;
  var soulriver:StageProp;
  var insatianVoid:StageProp;
  var hivemine:StageProp;
  var backBuildings:StageProp;
  var buildingsL:StageProp;
  var windowsL:StageProp;
  var buildingsR:StageProp;
  var windowsR:StageProp;
  var sakuTower:StageProp;
  var buildingsFront:StageProp;
  var windowsFront:StageProp;
  var smoke:StageProp;
