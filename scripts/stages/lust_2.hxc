import flixel.FlxG;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import flixel.math.FlxMath;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.Conductor;
import funkin.Preferences;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.play.stage.StageProp;
import funkin.play.character.BaseCharacter;
import funkin.play.character.CharacterType;
import funkin.modding.events.ScriptEvent;
import funkin.Paths;

class LustTwoStage extends Stage
{
  var bgX:Float = -1000;
  var bgY:Float = -700;

  var heartFrames:Array<Int> = [0, 1, 2, 3, 4, 0, 4, 0];
  var hasCreatedStage:Bool = false;

  // Stage sprites
  var bg:StageProp;
  var hooks:StageProp;
  var chairs:StageProp;
  var tables:StageProp;
  var bar:StageProp;
  var bars:StageProp;
  var dfloor:StageProp;
  var heart:StageProp;
  var fgBottom:StageProp;
  var fgLeftTable:StageProp;
  var fgRightTable:StageProp;
  var fgCages:StageProp;
  var fgCurtains:StageProp;

  public function new()
  {
    super('lust_2');
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    if (hasCreatedStage) return;

    // Background
    bg = makeSprite('bg', 'Background', bgX, bgY);
    bg.antialiasing = false;

    // Get suggestive setting
    var suggestiveEnabled = Save.instance.modOptions.get('retroSuggestive');
    var hooksAnim = suggestiveEnabled ? 'Sex toys' : 'SFW hooks';

    // Hooks (sex toys or SFW)
    hooks = makeAnimSprite('hooks', hooksAnim, bgX, bgY);
    hooks.antialiasing = false;

    // Chairs
    chairs = makeAnimSprite('chairs', 'BG chairs', bgX, bgY);
    chairs.antialiasing = false;

    // Tables
    tables = makeAnimSprite('tables', 'BG tables', bgX, bgY);
    tables.antialiasing = false;

    // Bar
    bar = makeAnimSprite('bar', 'Barr', bgX, bgY);

    // Bar stools
    bars = makeAnimSprite('bars', 'Bar stools', bgX, bgY);

    // Dance floor
    dfloor = makeAnimSprite('dfloor', 'Dance floor', bgX, bgY);
    dfloor.antialiasing = false;

    // Heart lights
    heart = makeAnimSprite('heart', 'Heart', bgX, bgY);
    heart.animation.curAnim.curFrame = 0;
    heart.antialiasing = false;

    // Foreground bottom
    fgBottom = makeAnimSprite('FG_Bottom', 'FG_Bottom', bgX, bgY);

    // Foreground left table
    fgLeftTable = makeAnimSprite('FG_LeftTable', 'FG_LeftTable', bgX, bgY);

    // Foreground right table
    fgRightTable = makeAnimSprite('FG_RightTable', 'FG_RightTable', bgX, bgY);

    // Foreground cages
    fgCages = makeAnimSprite('FG_cages', 'FG_cages', bgX, bgY);
    fgCages.antialiasing = false;

    // Foreground curtains
    fgCurtains = makeAnimSprite('FG_curtains', 'FG_curtains', bgX, bgY);
    fgCurtains.zIndex = 305;
    fgCurtains.antialiasing = false;

    hasCreatedStage = true;
    PlayState.instance.refresh();
  }

  override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
  }

  function makeSprite(name:String, imageName:String, x:Float, y:Float):StageProp
  {
    var sprite = FunkinSprite.create(x, y);
    sprite.loadTexture('lust/' + imageName);
    sprite.active = false;
    PlayState.instance.add(sprite, name);
    return sprite;
  }

  function makeAnimSprite(name:String, animName:String, x:Float, y:Float):StageProp
  {
    var sprite = FunkinSprite.create(x, y);
    sprite.loadSparrow('lust/saku-master');
    sprite.animation.addByPrefix(animName, animName, 0);
    sprite.animation.play(animName);
    PlayState.instance.add(sprite, name);
    return sprite;
  }

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    // Update heart frame based on beat
    var beatIndex = event.beat % 8;
    if (heart != null && heart.animation != null && heart.animation.curAnim != null) {
      heart.animation.curAnim.curFrame = heartFrames[beatIndex];
    }

    // Update dance floor frame based on beat
    if (dfloor != null && dfloor.animation != null && dfloor.animation.curAnim != null) {
      dfloor.animation.curAnim.curFrame = event.beat % 2;
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);

    switch (charType)
    {
      case CharacterType.GF:
        character.antialiasing = false;
        character.danceEvery = 0;
        character.visible = false;
        character.kill(); // finish HER!!
      default:
    }
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);

    if (event.eventData.eventKind == "FocusCamera")
    {
      var value = event.eventData.value;
      var step = Conductor.instance.currentStep;
      switch (Std.parseInt(value.char)) {
        case 0:
          FlxTween.tween(PlayState.instance, {currentCameraZoom: PlayState.instance.stageZoom + 0.1}, 0.7, {ease: FlxEase.quadOut});
        case 1:
          FlxTween.tween(PlayState.instance, {currentCameraZoom: PlayState.instance.stageZoom}, 1, {ease: FlxEase.quadOut});
        default:
      }
    }
  }

  override function onDestroy(event):Void
  {
    super.onDestroy(event);
    hasCreatedStage = false;
  }
}
