class prideStage extends Stage
{
  // Shader
  var godrays:ScriptedFlxRuntimeShader;
  var lightPosX:Float = 0.5;
  var lightPosY:Float = 0.3;
  // Cameras
  var camRays:FlxCamera;
  var camNoRays:FlxCamera;
  var camNoz:FlxCamera;

  // LEGACY SHADER
  var shaderColor = 0xFFaad2ff; // #f5f5f5ff #aad2ffff
  var shadersInit:Bool = false;

  var overlay:StageProp;

  function new()
  {
    super('pride');
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    // Create legacy shaders
    if (Save.instance.modOptions.get('retroShaders')) {
      var objectsRight = [
        'pillar1r',
        'pillar2r',
        'pillar3r',
        'pillar4r'
      ];
      var objectsLeft = [
        'pillar1l',
        'pillar2l',
        'pillar3l',
        'pillar4l'
      ];

      var stichShader = new DropShadowShader();
      stichShader.setAdjustColor(8, 0, -4, 0); // brilho, hue, contraste e saturação
      stichShader.color = 0xFFf5f5f5;
      stichShader.angle = 120;
      stichShader.distance = 15;
      stichShader.threshold = -1;
      getNamedProp('stich').shader = stichShader;
      getNamedProp('stich').antialiasing = false;
      stichShader.attachedSprite = getNamedProp('stich');
      getNamedProp('stich').animation.onFrameChange.add(function() {
        if (getNamedProp('stich') != null)
        {
          stichShader.updateFrameInfo(getNamedProp('stich').frame);
        }
      });

      //desativado por questoes de otimizacao
      /*for (obj in objectsRight) {
        // o shader precisa estar aqui dentro pra que pegue nos outros objetos corretamente
        var rim = new DropShadowShader();
        rim.setAdjustColor(0, 0, 0, 0); // brilho, hue, contraste e saturação
        rim.color = shaderColor;
        rim.angle = 120;
        rim.distance = 5;

        getNamedProp(obj).shader = rim;
        rim.attachedSprite = getNamedProp(obj);
      }
      for (obj in objectsLeft) {
        var rim = new DropShadowShader();
        rim.setAdjustColor(0, 0, 0, 0); // brilho, hue, contraste e saturação
        rim.color = shaderColor;
        rim.angle = 120;
        rim.distance = 5;

        getNamedProp(obj).shader = rim;
        rim.attachedSprite = getNamedProp(obj);
      }*/
    }
  }

  override public function onSongLoaded(event:ScriptEvent)
  {
    super.onSongLoaded(event);
    var game = PlayState.instance;

    // Create shaders & cameras
    if (Save.instance.modOptions.get('retroShaders')) {
      // code for the shaders if i knew how to mess with the cameras properly
      // need help with the shaders!!!!
    }

    if (overlay == null) {
      // Overlay
      overlay = FunkinSprite.create(0, 0);
      overlay.loadTexture('pride/dust_fuck');
      //overlay.screenCenter();
      overlay.scrollFactor.set(0.15, 0);
      overlay.blend = 12; //screen
      overlay.cameras = [PlayState.instance.camHUD];
      PlayState.instance.add(overlay);
    }

    shadersInit = true;
  }

  public function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);
    getBoyfriend().shader = null;
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);

    // LEGACY SHADER
    var rim = null;
    if (Save.instance.modOptions.get('retroShaders')) {
      rim = new DropShadowShader();
      rim.setAdjustColor(3, 0, -4, 0); // brilho, hue, contraste e saturação
      rim.color = shaderColor;
      character.shader = rim;
      rim.attachedSprite = character;
    }

    switch (charType)
    {
      case CharacterType.BF:
        if (getBoyfriend().characterId == 'bf-retrospecter') {
          character.idleSuffix = '-alt';
        }
        character.danceEvery = 1;

        if (rim != null) {
          //rim.threshold = 0.3;
          rim.angle = 140;
          character.animation.onFrameChange.add(function() {
            if (getBoyfriend() != null)
            {
              rim.updateFrameInfo(getBoyfriend().frame);
            }
          });
        }

      case CharacterType.GF:
        character.antialiasing = false;

        if (rim != null) {
          rim.angle = 90;
          rim.setAdjustColor(8, 0, -4, 0);
          rim.color = 0xFFf5f5f5;
          rim.distance = 20;
          rim.threshold = -1;
          character.animation.onFrameChange.add(function() {
            rim.updateFrameInfo(getGirlfriend().frame);
          });
        }

      case CharacterType.DAD:
        if (rim != null) {
          rim.angle = 40;
          character.animation.onFrameChange.add(function() {
            rim.updateFrameInfo(getDad().frame);
          });
        }

      default:
    }
  }

  /**
   * Called when the chart hits a song event.
   */
  public override function onSongEvent(scriptEvent:SongEventScriptEvent)
  {
    super.onSongEvent(scriptEvent);
  }

  function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
  }

  function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    shadersInit = false;
    /*if (getGirlfriend().characterId == 'otis-speaker')
    {
      getNamedProp('tankBricks').setPosition(445, 774);
    }*/
  }

  function onDestroy(event:Dynamic)
  {
      super.onDestroy(event);
      if (PlayState.instance == null) return;
      if (!shadersInit) return;
      shadersInit = false;
      FlxG.camera.filters = [];
  }
}
