import flixel.FlxG;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import funkin.graphics.video.FunkinVideoSprite;
import flixel.math.FlxMath;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.Conductor;
import funkin.Preferences;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.play.stage.StageProp;
import funkin.play.character.BaseCharacter;
import funkin.play.character.CharacterType;
import funkin.modding.module.ModuleHandler;
import funkin.ui.FullScreenScaleMode;
import funkin.play.PlayStatePlaylist;
import funkin.Paths;
import StringTools;

/**
 * Nightflaid Stage - Dynamic multi-character boss rush stage with color-changing shaders
 *
 * SHADER IMPLEMENTATION NEEDED:
 * This stage requires a custom shader system called "NightflaidShaderHandler" with:
 * - Left and right side color management
 * - Color tweening (gradual color transitions)
 * - Side swapping (swap left/right colors)
 * - Lighting toggle
 *
 * Additional shader effects needed:
 * - ReflectionShader: Creates reflection effect for characters
 * - VCRBorder: Adds VCR-style border effect
 * - NTSCFilter: Adds NTSC/analog TV distortion effect
 *
 * CUSTOM CAMERAS:
 * The original implementation uses multiple custom cameras:
 * - camCharacters: For character reflections
 * - camVideo: For special "unbeatable" sequence with VCR effects
 *
 * GAMEPLAY MECHANICS:
 * This stage supports multiple opponent characters that switch mid-song:
 * - Each character has unique health bar colors and visual effects
 * - Some characters have special mechanics (shake, screen effects, note drain)
 * - Special "80sNightflaid" transformation sequence with unique visuals
 */
class NightflaidStage extends Stage
{
  var xAdjust:Float = -300;
  var yAdjust:Float = -700;
  var bgX:Float = -1700 + xAdjust;
  var bgY:Float = -1200 + yAdjust;
  var bgWidth:Float = 2760;
  var bgHeight:Float = 1429;
  var ogNfY:Float;

  var hasCreatedStage:Bool = false;
  var hasCreatedUnbeatable:Bool = false;
  var usedCheckPoint:Bool = false;
  var qe:Bool = true;

  var retroGameUI;

  // Color variants based on song
  var alt:String = '';
  var colorr:String = 'fb002d'; // #fb002d

  // Stage sprites
  var N_hls:StageProp;
  var N_drk:StageProp;
  var N_clrRight:StageProp;
  var N_clrLeft:StageProp;
  var N_top:StageProp;
  var N_glw:StageProp;
  var N_glt:StageProp;
  var N_rlt:StageProp;
  var N_lt1:StageProp;
  var N_lt2:StageProp;
  var coverSpr:StageProp;
  var unbeatableBG:StageProp;
  var whiteScreen:StageProp;
  var nfUnbeatable:FunkinSprite;
  var midsongVideo:FunkinVideoSprite; // Pre-created video sprite
  var midsongVideoBlackBars:FunkinSprite; // Black bars for video
  var midsongVideoPath:String = ''; // Path to load later
  var midsongVideoResyncThreshold:Int = 1000; // Resync threshold in ms
  var midsongVideoPlaying:Bool = false; // Track if video is currently playing
  var midsongVideoLoaded:Bool = false; // Check if video has loaded correcly
  var hasVideoSpriteBeenCreated:Bool = false;

  // Unbeatable elements
  var unbeatableNeedlesLeft:Array<FlxSprite> = [];
  var unbeatableNeedlesRight:Array<FlxSprite> = [];
  var unbeatableVignette:FlxSprite;
  var unbeatableLightningLeft:FlxSprite;
  var unbeatableLightningRight:FlxSprite;
  var unbeatableLightningLeftPos:Float; //110.0 - 500.0
  var unbeatableLightningRightPos:Float; // 1020.0 + 500.0
  var needlesActive:Bool = false;

  // Light animation variables
  var lightLeftBlinkCount:Float = 0;
  var lightLeftBlinkTime:Float = 0;
  var lightRightBlinkCount:Float = 0;
  var lightRightBlinkTime:Float = 0;
  var redLightTime:Float = 0;

  // Event tracking
  var sq:Bool = false;
  var qqs:Bool = false;
  var qqas:Bool = false;
  var qweqe:Bool = false;
  var qqqqq:Bool = false;
  var finalFadeout:Bool = false;
  var dd:Bool = false;
  var pp:Bool = false;

  // Zoom beats
  var zoomBeats:Array<Int> = [415, 447, 479, 511, 543, 575, 607, 639, 671];

  // Ground offset for descend/ascend animations
  var groundedOff:Int = 250;

  public function new()
  {
    super('nightflaid');
  }

  /**
   * STAGE MECHANICS OVERVIEW:
   *
   * COLOR VARIANTS:
   * - Default (red): colorr = 'fb002d', alt = ''
   * - Hexerpatient (green): colorr = '00FB3C', alt = '_green'
   * - Extiraging (cyan): colorr = '00FBCE', alt = '_cyan'
   *
   * TIMELINE EVENTS (by step):
   * - Step 64: Initial color tween to CCCCCC (if not checkpoint)
   * - Steps 1664-2944: Dynamic camera side swapping based on focus
   * - Step 2304: Both sides go dark (0d0d0d)
   * - Step 2432: Left side lights up with song color
   * - Step 2944: Lightings turn on
   * - Step 3456: Lightings turn off, return to dark
   * - Step 3512: Final fadeout to black (story mode only)
   *
   * SPECIAL SEQUENCES:
   * - "80sNightflaid" character: Triggers "Unbeatable" sequence
  * Switches to camVideo with VCR/NTSC effects
  * Shows animated lightning and moving needles
  * Animated background with random movement
   *
   * OPPONENT TRANSFORMATIONS:
   * Each opponent character (DAD, WHITTY, RUV, etc.) has:
   * - Custom health bar colors
   * - Custom icon colors
   * - Unique health values
   * - Special effects (shake, screen shake, note drain)
   * - Different idle suffix patterns
   *
   * ANIMATION SUFFIXES:
   * - animsWithOwnIdles: Use '-CHARACTERNAME' for idle and sing
   * - groundedAnims: Use '-GENERAL' for idle, '-CHARACTERNAME' for sing
   * - aerialAnims: Use '' for idle, '-CHARACTERNAME' for sing
   */
  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    if (hasCreatedStage) return;
    resetFlags();
    retroGameUI = ModuleHandler.getModule('RetroGameUI');

    // Determine song variant
    var songName = PlayState.instance?.currentChart?.songName ?? '';
    if (songName == 'hexerpatient')
    {
      alt = '_green';
      colorr = '00FB3C';
    }
    else if (songName == 'extiraging')
    {
      alt = '_cyan';
      colorr = '00FBCE';
    }

    // Create background layers
    N_hls = makeSprite('N_hls', 'nightflaid/highlights', bgX, bgY);
    N_drk = makeSprite('N_drk', 'nightflaid/darklayer' + alt, bgX, bgY);

    // Color layers (behind the bg, used to color the ground & other things in the toplayer)
    N_clrLeft = FunkinSprite.create(bgX, bgY);
    N_clrLeft.makeGraphic(Std.int(bgWidth), Std.int(bgHeight), FlxColor.WHITE);
    N_clrLeft.color = 0xFF0d0d0d;
    PlayState.instance.add(N_clrLeft, 'N_clrLeft');

    N_clrRight = FunkinSprite.create(bgX + bgWidth, bgY);
    N_clrRight.makeGraphic(Std.int(bgWidth), Std.int(bgHeight), FlxColor.WHITE);
    N_clrRight.color = 0xFF0d0d0d;
    PlayState.instance.add(N_clrRight, 'N_clrRight');

    N_top = makeSprite('N_top', 'nightflaid/toplayer' + alt, bgX, bgY);
    //N_top.visible = false;

    // Scale color layers to match top layer
    N_clrLeft.setGraphicSize(Std.int(N_top.width / 2) + 5, Std.int(N_top.height)); // + 5 so it goes behind the right layer and fills correcly
    N_clrLeft.updateHitbox();
    N_clrRight.setGraphicSize(Std.int(N_top.width / 2), Std.int(N_top.height));
    N_clrRight.updateHitbox();

    // Glow layer (foreground)
    N_glw = makeSprite('N_glw', 'nightflaid/glow' + alt, bgX, bgY);
    N_glw.zIndex = 200; // Above characters

    // Glow top
    N_glt = makeSprite('N_glt', 'nightflaid/glowTop' + alt, 140 + xAdjust, -1280 + yAdjust);
    N_glt.scale.set(2.65, 2.65);
    N_glt.updateHitbox();

    // Red lights
    N_rlt = makeSprite('N_rlt', 'nightflaid/redlights' + alt, -1375 + xAdjust, -555 + yAdjust);
    N_rlt.scale.set(2.65, 2.65);
    N_rlt.updateHitbox();

    // Light rays
    N_lt1 = makeSprite('N_lt1', 'nightflaid/lightray', -1340 + xAdjust, -765 + yAdjust);
    N_lt1.scale.set(2.65, 2.65);
    N_lt1.updateHitbox();

    N_lt2 = makeSprite('N_lt2', 'nightflaid/lightray', 2900 + xAdjust, -765 + yAdjust);
    N_lt2.scale.set(2.65, 2.65);
    N_lt2.flipX = true;
    N_lt2.updateHitbox();

    // Cover sprite (black screen overlay)
    coverSpr = FunkinSprite.create(0, 0);
    coverSpr.makeGraphic(FlxG.width * 1.1, FlxG.height * 1.1, FlxColor.BLACK);
    coverSpr.camera = PlayState.instance.camCutscene; // camhud is hidden at the end so it must be camCutscene
    coverSpr.scrollFactor.set(0, 0);
    coverSpr.updateHitbox();
    coverSpr.alpha = 0;
    coverSpr.visible = false;
    coverSpr.zIndex = 10000;
    PlayState.instance.add(coverSpr, 'coverSpr');

    initializeMidsongVideo(); // Create video sprite early

    // Unbeatable background
    unbeatableBG = makeSprite('unbeatableBG', 'nightflaid/unbeatableBG' + alt, -1000 + xAdjust, 0 + yAdjust); // old y: -900 + yAdjust
    unbeatableBG.scrollFactor.set(0, 0);
    unbeatableBG.antialiasing = false;
    unbeatableBG.scale.set(150, 150);
    unbeatableBG.updateHitbox();
    unbeatableBG.alpha = 0;
    // no need to add cuz makesprite already does that

    // White screen flash
    whiteScreen = FunkinSprite.create(0, 0);
    whiteScreen.makeGraphic(FlxG.width * 1.1, FlxG.height * 1.1, FlxColor.WHITE);
    whiteScreen.camera = PlayState.instance.camCutscene;
    whiteScreen.updateHitbox();
    whiteScreen.screenCenter();
    whiteScreen.alpha = 0;
    whiteScreen.camera = PlayState.instance.camHUD;
    PlayState.instance.add(whiteScreen, 'whiteScreen');

    hasCreatedStage = true;
    PlayState.instance.refresh();
  }

  override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
    if (unbeatableLightningLeft == null || unbeatableLightningRight == null) setupUnbeatableElements();
    setupShaders();
    if (ogNfY == 0 || ogNfY == null) ogNfY = getDad().y;

    // Check for checkpoint
    if (Conductor.instance.songPosition > 200000)
    {
      usedCheckPoint = true;
      //if (getDad() != null) getDad().y = 350;
    }
    else
    {
      // Initial color tween would go here
      // triggerNightflaidColorTween('0d0d0d', 0.15);
    }
  }

  function initializeMidsongVideo():Void
  {
    midsongVideoLoaded = false;

    // Create black bars sprite for video letterboxing
    midsongVideoBlackBars = FunkinSprite.create(0, 0);
    midsongVideoBlackBars.makeGraphic(FlxG.width, FlxG.height * 1.1, 0xFF000000);
    //midsongVideoBlackBars.zIndex = 298; // Just behind video
    midsongVideoBlackBars.scrollFactor.set(0, 0);
    midsongVideoBlackBars.visible = false;
    midsongVideoBlackBars.active = false;
    PlayState.instance.add(midsongVideoBlackBars);

    // Create video sprite early so it's added before other unbeatable elements
    // This ensures correct rendering order without z-index issues
    midsongVideo = new FunkinVideoSprite(0, 0);
    midsongVideo.zIndex = 0;
    midsongVideo.scrollFactor.set(0, 0);

    if (midsongVideo.load(Paths.videos('nightflaid')))
    {
      midsongVideoLoaded = true;
      // Scale the video to fit the screen while keeping aspect ratio
      midsongVideo.bitmap.onFormatSetup.add(() -> {
        var scale:Float = Math.min(FlxG.width / midsongVideo.bitmap.bitmapData.width, FlxG.height / midsongVideo.bitmap.bitmapData.height);
        midsongVideo.setGraphicSize((midsongVideo.bitmap.bitmapData.width * scale) + 10, midsongVideo.bitmap.bitmapData.height * scale);
        midsongVideo.updateHitbox();
        midsongVideo.screenCenter();
      });

      //midsongVideo.play(); // play later!
      midsongVideo.bitmap.volumeAdjust = 0; // mute video (it's already mute but yeah)

      // Handle video end
      midsongVideo.bitmap.onEndReached.add(function() {
        midsongVideoBlackBars.active = false;
        midsongVideoBlackBars.visible = false;
        midsongVideo.active = false;
        midsongVideo.visible = false;

        midsongVideoPlaying = false;
        midsongVideoLoaded = false;
      }, true);

      // Handle video errors
      midsongVideo.bitmap.onEncounteredError.add(function() {
        trace('ERROR: Failed to play midsong video: ' + videoPath);
        midsongVideoBlackBars.active = false;
        midsongVideoBlackBars.visible = false;
        midsongVideo.active = false;
        midsongVideo.visible = false;

        midsongVideoPlaying = false;
        midsongVideoLoaded = false;
      }, true);
    }
    else
    {
      trace('ERROR: Could not load video file: ' + videoPath);
      midsongVideoPlaying = false;
      midsongVideoLoaded = false;
    }
    midsongVideo.visible = false; // Start invisible
    midsongVideo.active = false; // Don't update until we play

    hasVideoSpriteBeenCreated = true;
    PlayState.instance.add(midsongVideo);
    PlayState.instance.refresh();
  }

  function makeSprite(name:String, imageName:String, x:Float, y:Float):StageProp
  {
    var sprite = FunkinSprite.create(x, y);
    sprite.loadTexture(imageName);
    PlayState.instance.add(sprite, name);
    return sprite;
  }

  function setupUnbeatableElements():Void
  {
    unbeatableLightningLeftPos = (FlxG.width * 0.086) - 500;
    unbeatableLightningRightPos = (FlxG.width * 0.797) + 500;

    // Lightning sprites
    unbeatableLightningLeft = FunkinSprite.create(unbeatableLightningLeftPos, -50);
    unbeatableLightningLeft.loadSparrow('nightflaid/ycbu_lightning');
    unbeatableLightningLeft.animation.addByPrefix('lightning', 'lightning', 24, true);
    unbeatableLightningLeft.animation.play('lightning', true);
    unbeatableLightningLeft.scrollFactor.set(0, 0);
    unbeatableLightningLeft.visible = false;
    unbeatableLightningLeft.active = false;
    PlayState.instance.add(unbeatableLightningLeft);

    unbeatableLightningRight = FunkinSprite.create(unbeatableLightningRightPos, -50);
    unbeatableLightningRight.loadSparrow('nightflaid/ycbu_lightning');
    unbeatableLightningRight.animation.addByPrefix('lightning', 'lightning', 24, true);
    unbeatableLightningRight.animation.play('lightning', true);
    unbeatableLightningRight.scrollFactor.set(0, 0);
    unbeatableLightningRight.flipY = true;
    unbeatableLightningRight.visible = false;
    unbeatableLightningRight.active = false;
    PlayState.instance.add(unbeatableLightningRight);

    // Create needles
    for (i in 0...6)
    {
      var needleY:Float = 0.0;
      switch(i % 3)
      {
        case 1: needleY = 360.0;
        case 2: needleY = 720.0;
      }

      var needle = FunkinSprite.create(-1900, needleY);
      needle.scrollFactor.set(0, 0);
      needle.loadSparrow('nightflaid/needle');
      needle.animation.addByPrefix('needle', 'anim', 24, true);
      needle.animation.play('needle', true);
      needle.visible = false;
      needle.active = false;
      //needle.camera = PlayState.instance.camHUD;
      //needle.zIndex = 3;
      PlayState.instance.add(needle);

      if (i < 3)
      {
        unbeatableNeedlesLeft.push(needle);
      }
      else
      {
        needle.flipX = true;
        unbeatableNeedlesRight.push(needle);
      }
    }

    unbeatableVignette = FunkinSprite.create(0, 0);
    unbeatableVignette.loadTexture('nightflaid/vignette');
    unbeatableVignette.setGraphicSize(FlxG.width * 1.5, FlxG.height * 1.05);
    unbeatableVignette.scrollFactor.set(0, 0);
    unbeatableVignette.alpha = 0;
    unbeatableVignette.camera = PlayState.instance.camHUD;
    PlayState.instance.add(unbeatableVignette);

    hasCreatedUnbeatable = true;

    // Start unbeatable tween
    unbeatableTween();
  }

  function unbeatableTween():Void
  {
    if (PlayState.instance == null) return;
    if (unbeatableBG == null) return;

    FlxTween.tween(unbeatableBG, {
      x: FlxG.random.float(-1000.0, -1400.0),
      angle: FlxG.random.float(-25.0, 25.0)
    }, FlxG.random.float(2.5, 4.5), {
      ease: FlxEase.linear,
      onComplete: function(twn:FlxTween) {
        unbeatableTween();
      }
    });
  }

