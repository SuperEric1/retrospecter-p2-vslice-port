  function setCameraOnThings(top:Bool):Void
  {
    // TODO: Placeholder for camera switching
    // Would switch between normal view and "unbeatable" view
    needlesActive = top;

    if (top)
    {
      // Enable VCR/NTSC effects
      FlxTween.tween(unbeatableLightningLeft, {x: unbeatableLightningLeft.x + 500.0}, 0.75, {ease: FlxEase.quadOut});
      FlxTween.tween(unbeatableLightningRight, {x: unbeatableLightningRight.x - 500.0}, 0.75, {ease: FlxEase.quadOut});
      FlxTween.tween(unbeatableVignette, {alpha: 1}, 0.75, {ease: FlxEase.quadOut});

      FullScreenScaleMode.addCutouts(0.75, FlxEase.quadOut);
    }
    else
    {
      // Disable effects
      FlxTween.cancelTweensOf(unbeatableVignette);
      FlxTween.cancelTweensOf(unbeatableLightningLeft);
      FlxTween.cancelTweensOf(unbeatableLightningRight);
      FlxTween.tween(unbeatableVignette, {alpha: 0}, 0.5, {ease: FlxEase.quadOut});
      FullScreenScaleMode.removeCutouts();
      triggerColorTween('CCCCCC', 0, 'both');
    }

    // Update needle visibility
    for (needle in unbeatableNeedlesLeft)
    {
      if (needle != null) {
        needle.active = needlesActive;
        needle.visible = needlesActive;
      }
    }
    for (needle in unbeatableNeedlesRight)
    {
      if (needle != null) {
        needle.active = needlesActive;
        needle.visible = needlesActive;
      }
    }
    unbeatableLightningLeft.active = needlesActive;
    unbeatableLightningRight.active = needlesActive;
    unbeatableLightningLeft.visible = needlesActive;
    unbeatableLightningRight.visible = needlesActive;
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var elapsed = event.elapsed;

    // Light blinking logic - Left light
    lightLeftBlinkTime -= elapsed * 5.0;
    if (lightLeftBlinkTime < 0)
    {
      lightLeftBlinkCount = FlxG.random.float(2, 4);
      lightLeftBlinkTime = FlxG.random.float(12.0, 20.0);
    }
    else
    {
      if (lightLeftBlinkTime > lightLeftBlinkCount)
      {
        if (N_lt1 != null) N_lt1.visible = true;
      }
      else
      {
        if (N_lt1 != null) N_lt1.visible = (lightLeftBlinkTime % 1 < 0.5);
      }
    }

    // Light blinking logic - Right light
    lightRightBlinkTime -= elapsed * 5.0;
    if (lightRightBlinkTime < 0)
    {
      lightRightBlinkCount = FlxG.random.float(2, 4);
      lightRightBlinkTime = FlxG.random.float(12.0, 20.0);
    }
    else
    {
      if (lightRightBlinkTime > lightRightBlinkCount)
      {
        if (N_lt2 != null) N_lt2.visible = true;
      }
      else
      {
        if (N_lt2 != null) N_lt2.visible = (lightRightBlinkTime % 1 < 0.5);
      }
    }

    // Red light pulsing
    redLightTime += elapsed;
    if (N_rlt != null)
    {
      N_rlt.alpha = Math.sin(Math.PI * redLightTime) * 0.25 + 0.85;
    }

    // Update needles if active
    if (needlesActive)
    {
      for (needle in unbeatableNeedlesLeft)
      {
        needle.x = unbeatableLightningLeft.x - 80.0;
        needle.y -= 360 * elapsed;
        if (needle.y < -needle.height)
        {
          needle.y += (720.0 / 2.0) * 3.0;
        }
      }

      for (needle in unbeatableNeedlesRight)
      {
        needle.x = unbeatableLightningRight.x - 80.0;
        needle.y += 360 * elapsed;
        if (needle.y > FlxG.height)
        {
          needle.y -= (720.0 / 2.0) * 3.0;
        }
      }
    }

  }

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var curBeat = event.beat;

    // Zoom on specific beats
    for (zoomBeat in zoomBeats)
    {
      if (curBeat == zoomBeat)
      {
        var crochet = (Conductor.instance.stepLengthMs * 4) / 1000;
        FlxTween.tween(PlayState.instance.camGame, {zoom: PlayState.instance.camGame.zoom + 0.1, angle: -4.5}, crochet, {
          ease: FlxEase.expoIn,
          onComplete: function(twn:FlxTween) {
            FlxTween.tween(PlayState.instance.camGame, {angle: 0}, crochet, {ease: FlxEase.expoOut});
          }
        });

        FlxTween.tween(PlayState.instance.camHUD, {zoom: 1.1, angle: 4}, crochet, {
          ease: FlxEase.expoIn,
          onComplete: function(twn:FlxTween) {
            FlxTween.tween(PlayState.instance.camHUD, {angle: 0}, crochet, {ease: FlxEase.expoOut});
          }
        });
      }
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    var curStep = event.step;

    // Step-based events
    if (curStep >= 3512 && !finalFadeout && PlayStatePlaylist.isStoryMode) // storymode only
    {
      finalFadeout = true;
      PlayState.instance.mayPauseGame = false;
      // Hide pause button
      if (FlxG.onMobile)
      {
        FlxTween.tween(PlayState.instance.pauseButton,
          {x: (FlxG.width - PlayState.instance.pauseButton.width) - (40 + (FullScreenScaleMode.gameCutoutSize.x / 2))}, 2, {ease: FlxEase.quintOut});
      }
      // Black screen
      coverSpr.alpha = 0;
      coverSpr.visible = true;
      FlxTween.tween(coverSpr, {alpha: 1}, 0.5);
      // End song (mayPauseGame won't let the song end normally)
      new FlxTimer().start(2.5, function(tmr) {
        PlayState.instance.endSong(true);
      });
    }

    if (curStep >= 64 && !sq && !usedCheckPoint)
    {
      sq = true;
      // Trigger initial color tween
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid color tween', ['CCCCCC', '0.15'])));
      triggerColorTween('CCCCCC', 0.15, 'both');
    }

    if (curStep >= 2944 && !qqs)
    {
      qqs = true;
      // Turn on lightings
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid lightings', ['on', ''])));
    }

    if (curStep >= 3456 && !qqas)
    {
      qqas = true;
      // Turn off lightings and go dark
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid lightings', ['off', ''])));
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid color tween', ['0d0d0d', '0.15'])));
      triggerColorTween('0d0d0d', 0, 'both');
    }

    if (curStep >= 2304 && !qweqe)
    {
      // Both sides go dark
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid color tween right-only', ['0d0d0d', '0.3'])));
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid color tween left-only', ['0d0d0d', '0.3'])));
      triggerColorTween('0d0d0d', 0, 'both');
      qweqe = true;
      qe = false;
    }

    if (curStep >= 2432 && !qqqqq)
    {
      // Left side lights up
      //PlayState.instance.dispatchEvent(new SongEventScriptEvent(new SongEventData(0, 'Nightflaid color tween left-only', [colorr, '0.3'])));
      triggerColorTween(colorr, 0, 'left');
      qqqqq = true;
      qe = true;
    }

    if ((curStep >= 3191 && curStep < 3200) && whiteScreen.alpha == 0) {
      FlxTween.tween(whiteScreen, {alpha: 1}, 0.9);
    }
    if (curStep >= 3200 && whiteScreen.alpha == 1) {
      FlxTween.tween(whiteScreen, {alpha: 0}, 0.5);
    }
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);

    var eventKind = event.eventData.eventKind;
    var value = event.eventData.value;

    // Handle camera related events
    if (eventKind == "FocusCamera")
    {
      var value = event.eventData.value;
      var step = Conductor.instance.currentStep;
      // Dynamic camera side swapping between steps 1663-2944
      if (!qe) return;

      var currentStep = Conductor.instance.currentStep;
      if (currentStep < 1663 || currentStep >= 2944) return;

      // Track which side should be lit based on camera focus
      switch (Std.parseInt(value.char)) {
        case 0:
          if (!dd) {
            dd = true;
            pp = false;
            // Swap sides and update colors
            // triggerNightflaidSwapSides('', '');
            // triggerNightflaidColorTweenLeftOnly(colorr, 0.3);
            // triggerNightflaidColorTweenRightOnly('0d0d0d', 0.3);
            triggerColorTween(colorr, 0, 'right');
            triggerColorTween('0d0d0d', 0, 'left');
          }
        case 1:
          if (!pp) {
            pp = true;
            dd = false;
            // Swap sides and update colors
            // triggerNightflaidSwapSides('', '');
            // triggerNightflaidColorTweenRightOnly(colorr, 0.3);
            // triggerNightflaidColorTweenLeftOnly('0d0d0d', 0.3);
            triggerColorTween(colorr, 0, 'left');
            triggerColorTween('0d0d0d', 0, 'right');
          }
        default:
          break;
      }
    }

    // Handle Nightflaid events
    if (eventKind == "NightflaidEvents") {
      switch (Std.parseInt(value.eventType)) {
        case 0: // Nightflaid color tween
          if (value != null && value.length >= 3)
          {
            var colorHex:String = value[1];
            var duration:Float = Std.parseFloat(value[2]);
          }

        case 1: // Nightflaid color tween left-only
          if (value != null && value.length >= 3)
          {
            var colorHex:String = value[1];
            var duration:Float = Std.parseFloat(value[2]);
          }

        case 2: // Nightflaid color tween right-only
          if (value != null && value.length >= 3)
          {
            var colorHex:String = value[1];
            var duration:Float = Std.parseFloat(value[2]);
          }

        case 3: // Nightflaid swap sides
          var duration:Float = 0.15;
          if (value != null && value.length > 0)
          {
            duration = Std.parseFloat(value[1]);
          }

        case 4: // Nightflaid lightings
          var enableLights:Bool = false;
          if (value != null && value.length > 0)
          {
            var val = value[1].toLowerCase();
            enableLights = (val == 'on' || val == '1');
          }
      }
    }

    switch (eventKind) {
      case "PlayAnimation":
        if (value != null)
        {
          handleCutsceneAnimation(value.anim);
        }

      case "RetroChangeCharacter":
        if (value != null)
        {
          var target = value.character;
          var characterId = value.newchar;
          if (target == "dad" || characterId != null)
          {
            handleOpponentCharacterChange(characterId);
          }
        }

      case "RetroPlayVideo":
        handleMidsongCutscene();
    }
  }

  function triggerColorTween(color:String, duration:Float, ?side:String = 'both', ?easeType:FlxEase = FlxEase.cubicOut):Void
  {
    var targetColor:Int = StringTools.startsWith(color, '#') ? FlxColor.fromString(color) : FlxColor.fromString('#' + color);

    if (side.toLowerCase() == 'both') {
      if (duration > 0) {
        FlxTween.color(N_clrLeft, duration, N_clrLeft.color, targetColor, { ease: easeType });
        FlxTween.color(N_clrRight, duration, N_clrRight.color, targetColor, { ease: easeType });
      } else {
        N_clrLeft.color = targetColor;
        N_clrRight.color = targetColor;
      }
    } else if (side.toLowerCase() == 'left') {
      if (duration > 0) {
        FlxTween.color(N_clrLeft, duration, N_clrLeft.color, targetColor, { ease: easeType });
      } else {
        N_clrLeft.color = targetColor;
      }
    } else if (side.toLowerCase() == 'right') {
      if (duration > 0) {
        FlxTween.color(N_clrRight, duration, N_clrRight.color, targetColor, { ease: easeType });
      } else {
        N_clrRight.color = targetColor;
      }
    }
  }

  function handleCutsceneAnimation(animName:String):Void
  {
    var dad = getDad();
    if (dad == null) return;

    var crochet = Conductor.instance.stepLengthMs * 4;

    switch (animName)
    {
      case 'descend':
        FlxTween.cancelTweensOf(dad);
        FlxTween.tween(dad, {y: dad.y + groundedOff}, crochet / 400, {ease: FlxEase.quadInOut});
        dad.cameraFocusPoint.y -= groundedOff;

      case 'ascend':
        FlxTween.cancelTweensOf(dad);
        FlxTween.tween(dad, {y: ogNfY}, crochet / 400, {ease: FlxEase.quadInOut});
        dad.cameraFocusPoint.y += groundedOff;

      case 'final':
        //dad.danceEvery = 0;
        PlayState.instance.disableKeys = true;
        FlxTween.tween(PlayState.instance.camHUD, {alpha: 0}, 2, {ease: FlxEase.quadOut});
    }
  }

  function handleOpponentCharacterChange(character:String):Void
  {
    var dad = getDad();
    if (dad == null) return;

    //setOppAnimation(character);

    if (character == 'nightflaid_unbeatable')
    {
      // Special setup for 80s Nightflaid character
      dad.playAnimation('singLEFT', true);

      /*if (coverSpr != null)
      {
        FlxTween.cancelTweensOf(coverSpr);
        coverSpr.alpha = 1;
      }*/

      var posY = FlxG.height - (dad.width / 4.5); // 200
      dad.y = FlxG.height + 100; //posY + FlxG.height + 100
      FlxTween.tween(dad, {y: posY}, 0.75, {ease: FlxEase.circOut});
      //FlxTween.tween(getBoyfriend(), {alpha: 0}, 0.75, {ease: FlxEase.circOut});

      if (unbeatableBG != null)
      {
        FlxTween.tween(unbeatableBG, {alpha: 1}, 0.75, {ease: FlxEase.circOut});
      }

      PlayState.instance.tweenCameraToPosition(getDad().cameraFocusPoint.x, FlxG.height, 0.1, FlxEase.circOut);
      FlxTween.tween(PlayState.instance, {currentCameraZoom: 1}, 0.3, {ease: FlxEase.circOut});

      setCameraOnThings(true);
    }

    if (character == 'nightflaid_atlas')
    {
      dad.y = ogNfY;
      PlayState.instance.currentCameraZoom = PlayState.instance.stageZoom;
      PlayState.instance.tweenCameraToPosition(getDad().cameraFocusPoint.x, getDad().cameraFocusPoint.y, 0.1, FlxEase.circOut);
      midsongVideo.visible = false;
      midsongVideoBlackBars.visible = false;
      //triggerColorTween('CCCCCC', 0.05, 'both');
    }
  }

  function handleMidsongCutscene():Void
  {
    var dad = getDad();
    if (dad == null) return;

    // Play the midsong video
    playMidsongVideo();

    // Transition dad out
    FlxTween.tween(dad, {y: dad.y + FlxG.height + 100}, 0.5, {ease: FlxEase.sineIn});

    if (unbeatableBG != null)
    {
      FlxTween.tween(unbeatableBG, {alpha: 0}, 0.5, {ease: FlxEase.circOut});
    }

    // Pre-transition effects
    if (unbeatableLightningLeft != null)
    {
      FlxTween.tween(unbeatableLightningLeft, {x: unbeatableLightningLeft.x - 500.0}, 0.5, {ease: FlxEase.quadIn});
    }
    if (unbeatableLightningRight != null)
    {
      FlxTween.tween(unbeatableLightningRight, {x: unbeatableLightningRight.x + 500.0}, 0.5, {ease: FlxEase.quadIn});
    }

    // Update health bar colors to white
    FlxTween.color(PlayState.instance.iconP2, 0.5, PlayState.instance.iconP2.color, -1, { ease: FlxEase.circOut });
    retroGameUI?.scriptCall('updateBarColor', [CharacterType.DAD, FlxColor.WHITE, true, 0.5]);

    // After animation completes, switch character and reset
    new FlxTimer().start(0.5, function(tmr:FlxTimer) {
      // Switch to nightflaid_atlas character
      coverSpr.alpha = 1;
      FlxTween.tween(coverSpr, {alpha: 0}, 0.5);

      setCameraOnThings(false);

      // Reset color tween to dark
      // triggerNightflaidColorTween('0d0d0d', 0.15);
      triggerColorTween(colorr, 0, 'both');
    });
  }

  function playMidsongVideo():Void
  {
    if (midsongVideo == null || !midsongVideoLoaded) return;

    // Make video and black bars visible and active
    midsongVideo.active = true;
    midsongVideo.visible = true;
    midsongVideoBlackBars.active = true;
    midsongVideoBlackBars.visible = true;
    midsongVideoPlaying = true;

    midsongVideo.play();

    // Quando o vídeo é ativado, o stage registra no módulo:
    var videoModule = ModuleHandler.getModule('RetroPVE_VideoModule');
    videoModule.scriptCall('registerVideoForResync', [midsongVideo, midsongVideoBlackBars, true]);
    // O módulo faz o resync automaticamente em onStepHit()
  }

  override function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);
    getDad().danceEvery = 1;
    N_clrRight.color = -1;
    N_clrLeft.color = -1;
    PlayState.instance.disableKeys = false;
    if (hasCreatedUnbeatable) { // if the unbeatable elements were already created, hide them
      setCameraOnThings(false);
      unbeatableBG.alpha = 0;
      unbeatableLightningLeft.x = unbeatableLightningLeftPos;
      unbeatableLightningRight.x = unbeatableLightningRightPos;

      /*unbeatableLightningLeft.destroy();
      unbeatableLightningLeft = null;
      unbeatableLightningRight.destroy();
      unbeatableLightningRight = null;

      for (needle in unbeatableNeedlesRight)
      {
        if (needle != null) {
          needle.destroy();
          unbeatableNeedlesRight.pop(needle);
        }
      }
      for (needle in unbeatableNeedlesLeft)
      {
        if (needle != null) {
          needle.destroy();
          unbeatableNeedlesLeft.pop(needle);
        }
      }

      // Cleanup arrays
      unbeatableNeedlesLeft = [];
      unbeatableNeedlesRight = [];*/
    }

    if (midsongVideo != null) {
      midsongVideoPlaying = false;
      //midsongVideoLoaded = false;
      //midsongVideo.destroy();
      //midsongVideo = null;
      //midsongVideoBlackBars.destroy();
      //midsongVideoBlackBars = null;
    }

    finalFadeout = false;
  }

  function resetFlags():Void {
    sq = false;
    qqs = false;
    qqas = false;
    qweqe = false;
    qqqqq = false;
    qe = true;
    dd = false;
    pp = false;
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    hasCreatedStage = false;
    hasCreatedUnbeatable = false;
    midsongVideoPlaying = false;
    midsongVideoLoaded = false;
    finalFadeout = false;
    resetFlags();

    // this so when we play again, the objects can appear properly (otherwise they won't build)
    unbeatableBG = null;
    unbeatableNeedlesLeft = null;
    unbeatableNeedlesRight = null;

    // Cleanup arrays
    unbeatableNeedlesLeft = [];
    unbeatableNeedlesRight = [];
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);

    switch (charType)
    {
      case CharacterType.BF:
        character.idleSuffix = '-alt';
        character.danceEvery = 1;

      case CharacterType.GF:
        character.antialiasing = false;
        character.danceEvery = 0;
        character.visible = false;
        character.kill(); // finish HER!!
      default:
    }
  }

