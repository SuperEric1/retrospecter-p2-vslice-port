import flixel.FlxG;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.graphics.FunkinSprite;
import funkin.Paths;
import funkin.Conductor;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.graphics.shaders.AdjustColorShader;
import funkin.play.character.CharacterType;
import flixel.addons.effects.FlxSkewedSprite;
import flixel.addons.display.FlxBackdrop;

class RemixesBarStage extends Stage
{
  var bgX:Float = -600;
  var bgY:Float = -600;
  var initY:Float = 0;
  var startedSong:Bool = false;
  var songFinished:Bool = false;
  var stageLoaded:Bool = false;

  var cameo0:Bool = false;
  var cameo1:Bool = false;
  var cameo2:Bool = false;
  var cameo3:Bool = false;
  var cameo4:Bool = false;
  var cameo5:Bool = false;
  var cameo6:Bool = false;
  var cameo7:Bool = false;
  var cameo8:Bool = false;
  var cameo9:Bool = false;
  var cameo10:Bool = false;
  var cameo11:Bool = false;

  var toAdd:Int = 0;
  var isPixel:Bool = false;
  var songId:String = '';

  var stageSprite:FunkinSprite;
  var counter:FunkinSprite;
  var tableFG:FunkinSprite;
  var tree:FunkinSprite;
  var tree2:FunkinSprite;
  var rain:FunkinSprite;
  var pixelBg:FunkinSprite;

  var hexLeft:FunkinSprite;
  var hexRight:FunkinSprite;
  var hexLeft2:FunkinSprite;
  var hexRight2:FunkinSprite;
  var hexLeft3:FunkinSprite;
  var hexRight3:FunkinSprite;

  var cameo0Spr:FunkinSprite;
  var cameo1Spr:FunkinSprite;
  var cameo2Spr:FunkinSprite;
  var cameo3Spr:FunkinSprite;
  var cameo4Spr:FunkinSprite;
  var cameo5Spr:FunkinSprite;
  var cameo6Spr:FunkinSprite;
  var cameo7Spr:FunkinSprite;
  var cameo8Spr:FunkinSprite;
  var cameo9Spr:FunkinSprite;
  var cameo10Spr:FunkinSprite;
  var cameo11Spr:FunkinSprite;

  var skySpr:FunkinSprite;
  var boySpr:FunkinSprite;
  var girlSpr:FunkinSprite;
  var ruverSpr:FunkinSprite;
  var sarverSpr:FunkinSprite;

  var noiserMiddle:FlxSkewedSprite;
  var noiserLeft:FlxSkewedSprite;
  var noiserRight:FlxSkewedSprite;

  var light:FunkinSprite;

  var snowfgweak:FlxBackdrop;
  var snowfgweak2:FlxBackdrop;
  var snowfgmid:FlxBackdrop;
  var snowfgmid2:FlxBackdrop;

  var specialThing:Bool = false;
  var specialThing2:Bool = false;
  var disabled:Bool = false;
  var h1:Bool = false;
  var h2:Bool = false;
  var h3:Bool = false;
  var h4:Bool = false;
  var h5:Bool = false;
  var h6:Bool = false;
  var h7:Bool = false;
  var h8:Bool = false;
  var h9:Bool = false;
  var zoomOut:Bool = false;
  var mixterOffset:Float = 0;
  var animNum:Int = 0;
  var animationName:String = 'anim';
  var disableAnim:Bool = false;
  var gospelSnow:Bool = false;

  public function new()
  {
    super('remixes-bar');
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    songId = PlayState.instance?.currentChart?.song?.id ?? '';
    isPixel = songId == 'roses-r' || songId == 'thorns-r' || songId == 'thorns-k' || songId == 'chkdsk-r' || songId == 'pico-r';

    // Noisers
    if (!isPixel)
    {
      noiserMiddle = new FlxSkewedSprite(1000, -200);
      noiserMiddle.scale.set(1.2, 1.2);
      noiserMiddle.updateHitbox();
      noiserMiddle.frames = Paths.getSparrowAtlas('remixes/noise');
      noiserMiddle.animation.addByPrefix('anim', 'noise', 12, true);
      noiserMiddle.animation.play('anim', true);
      add(noiserMiddle);

      noiserLeft = new FlxSkewedSprite(200, -200);
      noiserLeft.scale.set(1.2, 1.2);
      noiserLeft.updateHitbox();
      noiserLeft.frames = Paths.getSparrowAtlas('remixes/noise');
      noiserLeft.animation.addByPrefix('anim', 'noise', 12, true);
      noiserLeft.animation.play('anim', true);
      noiserLeft.animation.curAnim.curFrame = 5;
      noiserLeft.skew.x = 15;
      add(noiserLeft);

      noiserRight = new FlxSkewedSprite(1800, -200);
      noiserRight.scale.set(1.2, 1.2);
      noiserRight.updateHitbox();
      noiserRight.frames = Paths.getSparrowAtlas('remixes/noise');
      noiserRight.animation.addByPrefix('anim', 'noise', 12, true);
      noiserRight.animation.play('anim', true);
      noiserRight.animation.curAnim.curFrame = 1;
      noiserRight.skew.x = -15;
      add(noiserRight);
    }
    else
    {
      var pY:Float = 200;
      var pX:Float = 120;
      var scalar:Float = 7;

      noiserMiddle = new FlxSkewedSprite(1000 + pX, -200 + pY);
      noiserMiddle.scale.set(scalar, scalar);
      noiserMiddle.updateHitbox();
      noiserMiddle.frames = Paths.getSparrowAtlas('remixes/pixelNoise');
      noiserMiddle.animation.addByPrefix('anim', 'noise', 24, true);
      noiserMiddle.animation.play('anim', true);
      add(noiserMiddle);

      noiserLeft = new FlxSkewedSprite(200 + pX, -200 + pY);
      noiserLeft.scale.set(scalar, scalar);
      noiserLeft.updateHitbox();
      noiserLeft.frames = Paths.getSparrowAtlas('remixes/pixelNoise');
      noiserLeft.animation.addByPrefix('anim', 'noise', 24, true);
      noiserLeft.animation.play('anim', true);
      noiserLeft.animation.curAnim.curFrame = 2;
      noiserLeft.skew.x = 15;
      add(noiserLeft);

      noiserRight = new FlxSkewedSprite(1800 + pX, -200 + pY);
      noiserRight.scale.set(scalar, scalar);
      noiserRight.updateHitbox();
      noiserRight.frames = Paths.getSparrowAtlas('remixes/pixelNoise');
      noiserRight.animation.addByPrefix('anim', 'noise', 24, true);
      noiserRight.animation.play('anim', true);
      noiserRight.animation.curAnim.curFrame = 3;
      noiserRight.skew.x = -15;
      add(noiserRight);
    }

    noiserRight.antialiasing = false;
    noiserMiddle.antialiasing = false;
    noiserLeft.antialiasing = false;

    //PlayState.instance.refresh();

    if (isPixel)
    {
      pixelBg = FunkinSprite.create(-602, -593);
      pixelBg.frames = Paths.getSparrowAtlas('remixes/pixel');
      pixelBg.animation.addByPrefix('anim', 'anim', 12, true);
      pixelBg.animation.play('anim', true);
      pixelBg.antialiasing = false;
      pixelBg.scale.set(5.75744047619, 5.75744047619);
      pixelBg.updateHitbox();
      add(pixelBg);
    }

    // Background stage
    if (songId == 'cocoa-r')
      stageSprite = buildStageSprite('Bar StageXMAS', bgX, bgY);
    else if (songId == 'chiller-r')
      stageSprite = buildStageSprite('Bar StageCORRUPT', bgX, bgY);
    else if (songId == 'hellclown-r')
      stageSprite = buildStageSprite('Bar StageCLOWN', bgX, bgY);
    else if (songId == 'tripletrouble-r' || songId == 'deathtoll-r' || songId == 'frostbite-r')
      stageSprite = buildStageSprite('HorrorBar', bgX, bgY);
    else if (!isPixel)
      stageSprite = buildStageSprite('Bar Stage', bgX, bgY);
    if (stageSprite != null) add(stageSprite);

    if (songId == 'glitcher-r')
    {
      hexLeft = buildStageSprite('HexBarLeft', bgX, bgY);
      hexLeft.alpha = 1;
      hexLeft.visible = false;
      add(hexLeft);

      hexRight = buildStageSprite('HexBarRight', 1208, bgY);
      hexRight.alpha = 1;
      hexRight.visible = false;
      add(hexRight);
    }

    // Rain
    if (songId == 'tripletrouble-r' || songId == 'deathtoll-r'
      || songId == 'frostbite-r' || songId == 'cocoa-r')
    {
      rain = FunkinSprite.create(2400, 25);
      rain.frames = Paths.getSparrowAtlas('remixes/rain');
      rain.animation.addByPrefix('anim', 'rain', 24, true);
      rain.animation.play('anim', true);
      rain.alpha = 0.4;
      rain.visible = songId == 'cocoa-r';
      add(rain);

      if (songId == 'cocoa-r')
      {
        tree2 = buildStageSprite('tree2', 2557, -398);
        add(tree2);
      }
    }
    else if (!isPixel)
    {
      rain = FunkinSprite.create(2400, 25);
      rain.frames = Paths.getSparrowAtlas('remixes/rain');
      rain.animation.addByPrefix('anim', 'rain', 24, true);
      rain.animation.play('anim', true);
      rain.alpha = 0.4;
      add(rain);
    }

    // Counter
    if (songId == 'cocoa-r') {
      counter = buildStageSprite('Bar CounterXMAS', bgX + 523, bgY + 1168);
    }
    else if (songId == 'chiller-r') {
      counter = buildStageSprite('Bar CounterCORRUPT', bgX + 523, bgY + 1168);
    }
    else if (songId == 'hellclown-r') {
      counter = buildStageSprite('Bar CounterCLOWN', bgX + 523, bgY + 1168);
    }
    else if (songId == 'tripletrouble-r' || songId == 'deathtoll-r' || songId == 'frostbite-r') {
      if (songId == 'tripletrouble-r') {
        cameo6Spr = buildCameo('remixes/cameos/ace', 0, 0); add(cameo6Spr);
        cameo7Spr = buildCameo('remixes/cameos/izzy', 2150, 100); add(cameo7Spr);
      }
      counter = buildStageSprite('HorrorBarTable', (bgX + 523) - 106, bgY + 1168);
    }
    else if (!isPixel) {
      counter = buildStageSprite('Bar Counter', bgX + 523, bgY + 1168);
    }
    if (counter != null) add(counter);

    if (songId == 'glitcher-r')
    {
      hexLeft2 = buildStageSprite('HexTableBarLeft', bgX + 523, 602);
      hexLeft2.visible = false;
      add(hexLeft2);

      hexRight2 = buildStageSprite('HexTableBarRight', 1205, bgY + 1168);
      hexRight2.visible = false;
      add(hexRight2);
    }

    buildCameos();

    if (songId == 'roses-r' || songId == 'thorns-r' || songId == 'thorns-k' || songId == 'chkdsk-r')
    {
      tableFG = buildStageSprite('jack', bgX + 867, 1072);
      tableFG.antialiasing = false;
      tableFG.scale.set(5.75744047619, 5.75744047619);
      tableFG.updateHitbox();
      add(tableFG);
    }

    if (songId == 'cocoa-r')
    {
      tree = buildStageSprite('tree', -533, -648);
      add(tree);
    }

    // Table foreground
    if (tableFG == null)
    {
      if (songId == 'cocoa-r')
        tableFG = buildStageSprite('Bar Table foreground', bgX + 867, bgY + 1752);
      else if (songId == 'chiller-r')
        tableFG = buildStageSprite('Bar Table foregroundCORRUPT', bgX + 867, bgY + 1752);
      else if (songId == 'hellclown-r')
        tableFG = buildStageSprite('Bar Table foregroundCLOWN', bgX + 867, bgY + 1752);
      else if (songId == 'tripletrouble' || songId == 'deathtoll' || songId == 'frostbite-r')
        tableFG = buildStageSprite('HorrorBarForeground', bgX + 867, bgY + 1752);
      else if (!isPixel)
        tableFG = buildStageSprite('Bar Table foreground', bgX + 867, bgY + 1752);
      if (tableFG != null) add(tableFG);
    }

    if (songId == 'glitcher-r')
    {
      hexLeft3 = buildStageSprite('hexForeLeft', bgX + 875, bgY + 1752);
      hexLeft3.visible = false;
      add(hexLeft3);

      hexRight3 = buildStageSprite('hexForeRight', bgX + 874, bgY + 1752);
      hexRight3.visible = false;
      add(hexRight3);
    }
  }

  function buildStageSprite(image:String, x:Float, y:Float):FunkinSprite
  {
    var spr = FunkinSprite.create(x, y, 'remixes/' + image);
    spr.scrollFactor.set(1, 1);
    spr.active = false;
    return spr;
  }

  function buildCameo(imagePath:String, x:Float, y:Float):FunkinSprite
  {
    var spr = FunkinSprite.create(x, y);
    spr.frames = Paths.getSparrowAtlas(imagePath);
    spr.animation.addByPrefix('anim', 'idle', 24, false);
    spr.animation.play('anim', true);
    spr.scrollFactor.set(1, 1);
    return spr;
  }

  function buildSign(imagePath:String, x:Float, y:Float):FunkinSprite
  {
    var spr = FunkinSprite.create(x, y, 'remixes/cameos/' + imagePath);
    spr.scrollFactor.set(1, 1);
    spr.active = false;
    return spr;
  }

  function buildCameos():Void
  {
    switch (songId)
    {
      case 'hellclown-r':
        cameo0 = true;
        cameo0Spr = buildCameo('remixes/cameos/hellclown', -340, -1000);
        cameo0Spr.scale.set(2, 2);
        cameo0Spr.flipX = true;
        add(cameo0Spr);

        cameo1 = true;
        cameo1Spr = buildCameo('remixes/cameos/hank', 1890, 420);
        cameo1Spr.flipX = true;
        add(cameo1Spr);

      case 'foolhardy-r' | 'foolhardy-k':
        cameo1 = true;
        cameo1Spr = buildCameo('remixes/cameos/zardy', 1568, 360);
        add(cameo1Spr);

      case 'genocide-r':
        cameo1 = true; cameo2 = true; cameo3 = true; cameo4 = true;
        cameo1Spr = buildCameo('remixes/cameos/tabiFucked', 1486, 350);
        cameo1Spr.scale.set(1.2, 1.2);
        add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/whitty', 155, 190);
        cameo2Spr.scale.set(0.85, 0.85);
        cameo2Spr.x += 10; cameo2Spr.y += 80;
        add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/tikyUnmasked', 740, 310);
        cameo3Spr.flipX = true;
        add(cameo3Spr);
        cameo4Spr = buildCameo('remixes/cameos/zardy', 2178, 360);
        add(cameo4Spr);
        toAdd = 3;

      case 'genocide-k':
        cameo1 = true;
        cameo1Spr = buildCameo('remixes/cameos/tabiFucked', 1486, 320);
        cameo1Spr.scale.set(1.2, 1.2);
        add(cameo1Spr);

      case 'last-chance-r' | 'my-battle-r':
        cameo1 = true;
        cameo1Spr = buildCameo('remixes/cameos/tabi', 1486, 320);
        cameo1Spr.scale.set(1.2, 1.2);
        add(cameo1Spr);

      case 'milf-r':
        cameo1 = true; cameo2 = true; cameo3 = true; cameo4 = true;
        cameo1Spr = buildCameo('remixes/cameos/mommy', 670, 234);
        cameo1Spr.flipX = true; add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/henchman', 1525, 328);
        cameo2Spr.flipX = true; add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/man', 70, 328);
        add(cameo3Spr);
        cameo4Spr = buildCameo('remixes/cameos/man', 2150, 328);
        cameo4Spr.flipX = true; add(cameo4Spr);
        toAdd = 3;

      case 'nerves-r':
        cameo1 = true; cameo2 = true;
        cameo2Spr = buildCameo('remixes/cameos/garcello', 2060, 303);
        add(cameo2Spr);
        cameo1Spr = buildCameo('remixes/cameos/annie', 1570, 430);
        cameo1Spr.flipX = true; add(cameo1Spr);
        toAdd = 1;

      case 'release-r':
        cameo1 = true; cameo2 = true; cameo3 = true; cameo4 = true;
        cameo1Spr = buildCameo('remixes/cameos/annie', 710, 430);
        add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/ghost', 90, 283);
        cameo2Spr.flipX = true; add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/ralsei', 2240, 440);
        cameo3Spr.flipX = true;
        cameo3Spr.scale.set(5, 5);
        cameo3Spr.antialiasing = false;
        add(cameo3Spr);
        cameo4Spr = buildCameo('remixes/cameos/kris', 1590, 430);
        cameo4Spr.scale.set(5, 5);
        cameo4Spr.antialiasing = false;
        add(cameo4Spr);
        toAdd = 3;

      case 'fading-r':
        cameo2 = true;
        cameo2Spr = buildCameo('remixes/cameos/ghost', 2070, 283);
        add(cameo2Spr);

      case 'release-k':
        cameo1 = true; cameo2 = true; cameo3 = true;
        cameo1Spr = buildCameo('remixes/cameos/annie', 690, 420);
        add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/ghost', 2050, 283);
        add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/napstablook', 1620, 250);
        cameo3Spr.scale.set(5, 5); cameo3Spr.updateHitbox();
        cameo3Spr.antialiasing = false;
        add(cameo3Spr);
        toAdd = 2;

      case 'improbable-outset-r':
        cameo1 = true; cameo2 = true;
        cameo1Spr = buildCameo('remixes/cameos/hank', 1290, 420);
        cameo1Spr.flipX = true; add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/tikyMasked', 768, 310);
        cameo2Spr.flipX = true; add(cameo2Spr);
        toAdd = 1;

      case 'smokebomb-r':
        cameo2 = true;
        cameo2Spr = buildCameo('remixes/cameos/nikku', 1500, 340);
        cameo2Spr.flipX = true; add(cameo2Spr);

      case 'south-r':
        cameo2 = true; cameo3 = true;
        cameo2Spr = buildCameo('remixes/cameos/kidsGlasses', 690, 425);
        add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/monokuma', 1570, 490);
        add(cameo3Spr);
        toAdd = 1;

      case 'manifest-r':
        cameo1 = true; cameo3 = true; cameo4 = true;
        cameo1Spr = buildCameo('remixes/cameos/sans', 1590, 410);
        cameo1Spr.scale.set(5, 5); cameo1Spr.updateHitbox();
        cameo1Spr.antialiasing = false;
        add(cameo1Spr);
        skySpr = buildSign('sky', 210, 520); add(skySpr);
        cameo3Spr = buildCameo('remixes/cameos/sunday', 830, 430);
        cameo3Spr.flipX = true; add(cameo3Spr);
        cameo4Spr = buildCameo('remixes/cameos/megaman', 2220, 370);
        add(cameo4Spr);
        toAdd = 2;

      case 'madness-r':
        cameo1 = true; cameo2 = true; cameo3 = true;
        cameo1Spr = buildCameo('remixes/cameos/hank', 1290, 420);
        cameo1Spr.flipX = true; add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/tikyUnmasked', 768, 310);
        cameo2Spr.flipX = true; add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/chicken', 2290, 595);
        add(cameo3Spr);
        toAdd = 2;

      case 'madness-k':
        cameo1 = true; cameo2 = true;
        cameo1Spr = buildCameo('remixes/cameos/hank', 1290, 420);
        cameo1Spr.flipX = true; add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/tikyUnmasked', 768, 310);
        cameo2Spr.flipX = true; add(cameo2Spr);
        toAdd = 1;

      case 'agoti-r' | 'agoti-k':
        cameo1 = true; cameo2 = true; cameo3 = true; cameo4 = true;
        cameo1Spr = buildCameo('remixes/cameos/nikusa', 0, 85); add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/aldryx', 700, 270); add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/agoti', 1460, 340); add(cameo3Spr);
        cameo4Spr = buildCameo('remixes/cameos/solazar', 2070, 115); add(cameo4Spr);
        toAdd = 3;

      case 'athazagoraphobia-r':
        cameo2 = true; cameo3 = true;
        cameo2Spr = buildCameo('remixes/cameos/legion', 500, 30); add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/troll', 1310, 35); add(cameo3Spr);
        toAdd = 1;

      case 'ballistic-r':
        cameo2 = true; cameo3 = true;
        cameo2Spr = buildCameo('remixes/cameos/whitty', 765, 190);
        cameo2Spr.scale.set(0.85, 0.85);
        cameo2Spr.x += 10; cameo2Spr.y += 80;
        add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/colress', 1600, 315);
        cameo3Spr.scale.set(5, 5);
        cameo3Spr.antialiasing = false;
        add(cameo3Spr);
        toAdd = 1;

      case 'ballistic-k':
        cameo2 = true;
        cameo2Spr = buildCameo('remixes/cameos/whitty', 765, 190);
        cameo2Spr.scale.set(0.85, 0.85);
        cameo2Spr.x += 10; cameo2Spr.y += 80;
        add(cameo2Spr);

      case 'blammed-r':
        cameo2 = true; cameo3 = true;
        cameo3Spr = buildCameo('remixes/cameos/pico', 1470, 445); add(cameo3Spr);

      case 'blammed-k':
        cameo3 = true;
        cameo3Spr = buildCameo('remixes/cameos/pico', 1470, 445); add(cameo3Spr);

      case 'chiller-r':
        cameo2 = true; cameo3 = true;
        cameo2Spr = buildCameo('remixes/cameos/kidsCorrupt', 680, 410); add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/gfCorrupt', 1570, 400); add(cameo3Spr);
        toAdd = 1;

      case 'chkdsk-r':
        cameo2 = true; cameo4 = true;
        cameo2Spr = buildCameo('remixes/cameos/spirit', 760, 100);
        cameo2Spr.scale.set(5, 5);
        cameo2Spr.antialiasing = false;
        add(cameo2Spr);
        cameo4Spr = buildCameo('remixes/cameos/corrupt', 1570, 485);
        cameo4Spr.animation.addByPrefix('anim', 'idle', 12, false);
        cameo4Spr.scale.set(5, 5);
        cameo4Spr.antialiasing = false;
        add(cameo4Spr);

      case 'roses-r':
        cameo2 = true; cameo3 = true;
        cameo2Spr = buildCameo('remixes/cameos/senpai', 730, 275);
        cameo2Spr.scale.set(5, 5);
        cameo2Spr.antialiasing = false;
        add(cameo2Spr);
        cameo3Spr = buildCameo('remixes/cameos/neon', 1565, 485);
        cameo3Spr.animation.addByPrefix('anim', 'idle', 16, false);
        cameo3Spr.scale.set(5, 5);
        cameo3Spr.antialiasing = false;
        add(cameo3Spr);

      case 'thorns-r':
        cameo1 = true; cameo2 = true; cameo3 = true; cameo4 = true;
        cameo1Spr = buildCameo('remixes/cameos/spirit', 140, 100);
        cameo1Spr.scale.set(5, 5);
        cameo1Spr.antialiasing = false;
        add(cameo1Spr);
        cameo2Spr = buildCameo('remixes/cameos/giygas', 620, 45);
