  function initializeSnow():Void
  {
    snowfgweak = makeSnow('iceolation/weak', 100, 110);
    snowfgweak2 = makeSnow('iceolation/weak2', -100, 110);
    snowfgmid = makeSnow('iceolation/mid', 400, 210);
    snowfgmid2 = makeSnow('iceolation/mid2', -400, 210);
    PlayState.instance.add(snowfgweak);
    PlayState.instance.add(snowfgweak2);
    PlayState.instance.add(snowfgmid);
    PlayState.instance.add(snowfgmid2);
    PlayState.instance.refresh();
  }

  function makeSnow(image:String, velx:Float, vely:Float):FlxBackdrop
  {
    var bd = new FlxBackdrop(Paths.image(image));
    bd.scrollFactor.set(0.2, 0);
    bd.velocity.set(velx, vely);
    bd.screenCenter();
    bd.alpha = 0;
    return bd;
  }

  override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
    if (stageLoaded) return;

    light = FunkinSprite.create(-599, -601);
    light.loadTextureAtlas('remixes/lights', 'shared', {
      applyStageMatrix: true,
    });
    light.scale.set(0.9999, 0.9999);
    light.animation.addBySymbolIndices('anim1', 'lightening', [0], 24, false);
    light.animation.addBySymbolIndices('anim2', 'lightening', [1], 24, false);
    light.animation.play('anim1', false);
    light.alpha = 0.5;
    light.zIndex = 90;
    add(light);

    stageLoaded = true;
  }

  override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    startedSong = true;
  }

  override function onSongEnd(event:ScriptEvent):Void
  {
    super.onSongEnd(event);
    songFinished = true;
  }

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    var curBeat = event.beat;

    if (curBeat % 4 == 0)
    {
      animNum = (animNum + 1) % 2;
      if (light != null)
        light.animation.play('anim' + (animNum + 1), false);
    }

    if (curBeat % 2 == 0 && !disableAnim)
    {
      if (cameo0 && cameo0Spr != null) cameo0Spr.animation.play('anim', true);
      if (cameo1 && cameo1Spr != null) cameo1Spr.animation.play('anim', true);
      if (cameo2 && cameo2Spr != null) cameo2Spr.animation.play('anim', true);
      if (cameo3 && cameo3Spr != null) cameo3Spr.animation.play(animationName, true);
      if (cameo4 && cameo4Spr != null) cameo4Spr.animation.play('anim', true);
      if (cameo5 && cameo5Spr != null) cameo5Spr.animation.play('anim', true);
      if (cameo6 && cameo6Spr != null) cameo6Spr.animation.play('anim', true);
      if (cameo7 && cameo7Spr != null) cameo7Spr.animation.play('anim', true);
      if (cameo8 && cameo8Spr != null) cameo8Spr.animation.play('anim', true);
      if (cameo9 && cameo9Spr != null) cameo9Spr.animation.play('anim', true);
      if (cameo10 && cameo10Spr != null) cameo10Spr.animation.play('anim', true);
      if (cameo11 && cameo11Spr != null) cameo11Spr.animation.play('anim', true);
    }
  }

  override function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
    var elapsed = event.elapsed;
    var curStep = Conductor.instance.curStep;

    var targetCamY = getBoyfriend()?.cameraFocusPoint.y ?? 0;
    if (PlayState.instance.cameraFollowPoint.y != targetCamY) PlayState.instance.cameraFollowPoint.y = targetCamY;

    if (!songFinished)
    {
      var songPos = Conductor.instance.songPosition / 1000;
      mixterOffset = Math.cos(songPos) * 50;

      var dadChar = PlayState.instance?.currentStage?.getDad();
      if (dadChar != null && (dadChar.characterId == 'mixter' || dadChar.characterId == 'mixter-pixel'))
        dadChar.y = initY + mixterOffset;
    }

    if (curStep > 4 && !disabled)
    {
      disabled = true;
      if (noiserRight != null) noiserRight.active = false;
      if (noiserLeft != null) noiserLeft.active = false;
      if (noiserMiddle != null) noiserMiddle.active = false;
    }

    if (songId == 'stress-r' && !specialThing && curStep >= 2362)
    {
      specialThing = true;
      // This would only happen in story mode but we can only play in freeplay, so...
      if (cameo4Spr != null) cameo4Spr.alpha = 1;
      if (cameo3Spr != null) cameo3Spr.alpha = 0;
    }

    if (songId == 'gospel-r' && !gospelSnow)
    {
      var curBeat = Conductor.instance.currentBeat;
      if (curBeat >= 430)
      {
        gospelSnow = true;
        FlxTween.tween(snowfgweak, { alpha: 1 }, 5);
        FlxTween.tween(snowfgweak2, { alpha: 1 }, 5);
        FlxTween.tween(snowfgmid, { alpha: 1 }, 5);
        FlxTween.tween(snowfgmid2, { alpha: 1 }, 5);
      }
    }

    if (songId == 'glitcher-r')
    {
      if (curStep >= 592 && !h1) { enableGlitch(); h1 = true; }
      if (curStep >= 832 && !h2) { disableGlitch(); h2 = true; }
      if (curStep >= 1104 && !h3) { enableGlitch(); h3 = true; }
      if (curStep >= 1344 && !h4) { disableGlitch(); h4 = true; }
      if (curStep >= 2320 && !h5) { enableGlitch(); h5 = true; }
      if (curStep >= 2560 && !h6) { disableGlitch(); h6 = true; }
      if (curStep >= 2832 && !h7) { enableGlitch(); h7 = true; }
      if (curStep >= 3072 && !h8) { disableGlitch(); h8 = true; }

      if (curStep >= 2000 && !h9)
      {
        h9 = true;
        PlayState.instance.tweenCameraZoom(1, 4, true, FlxEase.sineOut);
      }
      if (curStep >= 2060 && !specialThing)
      {
        specialThing = true;
        animationName = 'glitch';
        if (cameo3Spr != null) cameo3Spr.animation.play('glitch', true);
      }
      if (curStep >= 2064 && !zoomOut)
      {
        zoomOut = true;
        PlayState.instance.tweenCameraZoom(1, 2, false, FlxEase.sineOut);
      }
      if (curStep >= 3755 && !specialThing2)
      {
        specialThing2 = true;
        animationName = 'transition';
        disableAnim = true;
        if (cameo3Spr != null) cameo3Spr.animation.play('transition', true);
      }
    }

    if (songId == 'release-r' && curStep >= 2384)
    {
      if (cameo2Spr != null) cameo2Spr.alpha -= elapsed / 4;
    }
    if (songId == 'fading-r' && curStep >= 704)
    {
      if (cameo2Spr != null) cameo2Spr.alpha -= elapsed / 2;
    }

    if (songId == 'boogieman-r' && !specialThing && curStep >= 1344)
    {
      specialThing = true;
      animationName = 'hypnosis';
      if (cameo3Spr != null) cameo3Spr.animation.play('hypnosis', true);
    }
  }

  function enableGlitch():Void
  {
    tableFG.alpha = 0;
    rain.alpha = 0;
    hexLeft.visible = true;
    hexLeft2.visible = true;
    hexLeft3.visible = true;
    hexRight.visible = true;
    hexRight2.visible = true;
    hexRight3.visible = true;
  }

  function disableGlitch():Void
  {
    tableFG.alpha = 1;
    rain.alpha = 1;
    hexLeft.visible = false;
    hexLeft2.visible = false;
    hexLeft3.visible = false;
    hexRight.visible = false;
    hexRight2.visible = false;
    hexRight3.visible = false;
  }

  override function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);
    resetFlags();

    if (noiserLeft != null) noiserLeft.active = true;
    if (noiserRight != null) noiserRight.active = true;
    if (noiserMiddle != null) noiserMiddle.active = true;

    if (songId == 'glitcher-r') disableGlitch();
  }

  function resetFlags():Void {
    startedSong = false;
    songFinished = false;
    specialThing = false;
    specialThing2 = false;
    disabled = false;
    h1 = false; h2 = false; h3 = false; h4 = false;
    h5 = false; h6 = false; h7 = false; h8 = false; h9 = false;
    zoomOut = false;
    gospelSnow = false;
    animationName = 'anim';
    disableAnim = false;
    animNum = 0;
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    resetFlags();
    stageLoaded = false;
    stageSprite = null; counter = null; tableFG = null;
    tree = null; tree2 = null; rain = null; pixelBg = null;
    hexLeft = null; hexRight = null;
    hexLeft2 = null; hexRight2 = null;
    hexLeft3 = null; hexRight3 = null;
    cameo0Spr = null; cameo1Spr = null; cameo2Spr = null; cameo3Spr = null;
    cameo4Spr = null; cameo5Spr = null; cameo6Spr = null; cameo7Spr = null;
    cameo8Spr = null; cameo9Spr = null; cameo10Spr = null; cameo11Spr = null;
    skySpr = null; boySpr = null; girlSpr = null; ruverSpr = null; sarverSpr = null;
    noiserMiddle = null; noiserLeft = null; noiserRight = null;
    light = null;
    snowfgweak = null; snowfgweak2 = null; snowfgmid = null; snowfgmid2 = null;
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    super.addCharacter(character, charType);

    if (charType == CharacterType.BF && character.characterId == 'bf-retrospecter') {
      character.idleSuffix = '-alt';
    } else if (charType == CharacterType.GF) {
      // #623dd282
      // hsla(255, 62%, 53%, 0.51)
      var shader = new AdjustColorShader();
      shader.hue = -40;
      shader.saturation = 0;
      shader.brightness = -55;
      shader.contrast = 0;
      character.shader = shader;
    }
  }
}
