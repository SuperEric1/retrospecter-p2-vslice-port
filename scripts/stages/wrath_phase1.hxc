import flixel.FlxG;
import flixel.math.FlxAngle;
import flixel.util.FlxColor;
import flixel.util.FlxGradient;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.play.stage.StageProp;
import funkin.save.Save;
import funkin.graphics.shaders.DropShadowShader;
import funkin.play.character.CharacterType;
import openfl.display.BitmapData;
import flixel.graphics.FlxGraphic;
import funkin.graphics.FunkinSprite;

class wrathPhaseOneStage extends Stage
{
  function new()
  {
    super('wrath_phase1');
  }

  var overlay:StageProp;
  var hasCreatedStage:Bool = false;
  var isWideScreen:Bool = false;

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    isWideScreen = FlxG.width > 1280;

    if (Save.instance.modOptions.get('retroShaders')) {
      var objects = [
        'velasma',
        'serpenscheme',
        'cat'
      ];

      for (obj in objects) {
        // o shader precisa estar aqui dentro pra que pegue nos outros objetos corretamente
        var rim = new DropShadowShader();
        rim.setAdjustColor(-5, 0, -5, 0); // brilho, hue, contraste e saturação
        //rim.setAdjustColor(-33, 0, -23, 0); // brilho, hue, contraste e saturação
        rim.color = 0xFF29c23e; // #29c23eff
        rim.angle = 90;
        rim.antialiasAmt = 0;

        getNamedProp(obj).shader = rim;
        rim.attachedSprite = getNamedProp(obj);
        getNamedProp(obj).animation.onFrameChange.add(function() {
          if (getNamedProp(obj) != null)
          {
            rim.updateFrameInfo(getNamedProp(obj).frame);
          }
        });
      }
    }
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);

    if (!hasCreatedStage) {
      // Overlay
      overlay = FunkinSprite.create(0, 0);
      overlay.loadTexture('wrath/wrath_overlay');
      overlay.screenCenter();
      overlay.scrollFactor.set(0.6, 0.6);
      overlay.blend = 12;
      overlay.y += -128;
      overlay.x += 40;
      overlay.scale.set(1.1, 1);
      overlay.zIndex = 350;
      //overlay.cameras = [PlayState.instance.camGame];
      add(overlay);

      // Borders for wide screens
      if (isWideScreen) {

        var caveExtra = getNamedProp('caveLeft').clone();
        caveExtra.x = getNamedProp('caveLeft').x - getNamedProp('caveLeft').width + 1.5;
        caveExtra.flipX = false;
        caveExtra.scrollFactor.set(0.8, 0.8);
        caveExtra.antialiasing = false;
        add(caveExtra);

        var caveExtra2 = getNamedProp('caveRight').clone();
        caveExtra2.x = getNamedProp('caveRight').x + getNamedProp('caveRight').width - 1.5;
        caveExtra2.flipX = true;
        caveExtra2.scrollFactor.set(0.8, 0.8);
        caveExtra2.antialiasing = false;
        add(caveExtra2);

        var camZoom = PlayState.instance.stageZoom;
        var w = 500;
        var h = Math.ceil((FlxG.height + 50) / camZoom);
        var color = 0xFF000f03; // #000f03

        var border1 = FlxGradient.createGradientFlxSprite(w, h, [color, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT], 1, 0);
        border1.x = -1144;
        border1.screenCenter(0x10);
        border1.scrollFactor.set(1.4, 0);
        border1.zIndex = 400;
        add(border1);
        var fillBorderLeft = FunkinSprite.create(border1.x, border1.y).makeSolidColor(w * 5, h, color);
        fillBorderLeft.zIndex = border1.zIndex;
        fillBorderLeft.x -= fillBorderLeft.width;
        fillBorderLeft.scrollFactor.set(border1.scrollFactor.x, border1.scrollFactor.y);
        add(fillBorderLeft);

        var border2 = FlxGradient.createGradientFlxSprite(w, h, [FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, color, color], 1, 0);
        border2.x = 2178;
        border2.screenCenter(0x10);
        border2.scrollFactor.set(1.4, 0);
        border2.zIndex = 400;
        add(border2);
        var fillBorderRight = FunkinSprite.create(border2.x + border2.width, border2.y).makeSolidColor(w * 5, h, color);
        fillBorderRight.zIndex = border2.zIndex;
        fillBorderRight.scrollFactor.set(border2.scrollFactor.x, border2.scrollFactor.y);
        add(fillBorderRight);
      }

      refresh();
    }

    hasCreatedStage = true;
  }

  public function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);
    getBoyfriend().shader = null;
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    hasCreatedStage = false;
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    // Apply the shader automatically to each character as it gets added.
    super.addCharacter(character, charType);
    trace('Applied stage shader to ' + character.characterName);

    /*var rim = new DropShadowShader();
    rim.setAdjustColor(-33, 0, -23, 0); // brilho, hue, contraste e saturação
    rim.color = 0xFF29c23e; // #29c23eff
    character.shader = rim;
    rim.attachedSprite = character;
    rim.antialiasAmt = 0;*/

    switch (charType)
    {
      case CharacterType.BF:
        if (getBoyfriend().characterId == 'bf-retrospecter') {
          character.idleSuffix = '-alt';
          character.danceEvery = 1;
        }

        /*rim.angle = 90;
        character.animation.onFrameChange.add(function() {
          if (getBoyfriend() != null)
          {
            rim.updateFrameInfo(getBoyfriend().frame);
          }
        });

      case CharacterType.GF:
        rim.angle = 90;

        character.animation.onFrameChange.add(function() {
          rim.updateFrameInfo(getGirlfriend().frame);
        });

      case CharacterType.DAD:
        rim.angle = 90;

        character.animation.onFrameChange.add(function() {
          rim.updateFrameInfo(getDad().frame);
        });*/

      default:
    }
  }

  /**
   * Called when the chart hits a song event.
   */
  public override function onSongEvent(scriptEvent:SongEventScriptEvent)
  {
    super.onSongEvent(scriptEvent);
  }

  function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);
  }

  function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
  }

  function onSongRetry(event:ScriptEvent)
  {
    super.onSongRetry(event);

    /*if (getGirlfriend().characterId == 'otis-speaker')
    {
      getNamedProp('tankBricks').setPosition(445, 774);
    }*/
  }
}
