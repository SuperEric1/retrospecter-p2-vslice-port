    override public function onSongLoaded(event:ScriptEvent):Void
    {
        super.onSongLoaded(event);
        //loadDebugElements();
        // Salvar posições iniciais
        saveInitialPositions();

        // Fix inicial
        sinkUpdate(0);
    }

    function saveInitialPositions():Void
    {
        stagePositions.set('ground_L', {x: ground_L.x, y: ground_L.y});
        stagePositions.set('ground_M', {x: ground_M.x, y: ground_M.y});
        stagePositions.set('ground_R', {x: ground_R.x, y: ground_R.y});
        stagePositions.set('lavarock_L', {x: lavarock_L.x, y: lavarock_L.y});
        stagePositions.set('lavarock_M', {x: 0, y: lavarock_M.y});
        stagePositions.set('lavarock_R', {x: 0, y: lavarock_R.y});
        stagePositions.set('lavabubbles', {x: 0, y: lavabubbles.y});
        stagePositions.set('frontbgLava', {x: 0, y: frontbgLava.y});
        stagePositions.set('bg', {x: 0, y: bg.y});
        stagePositions.set('frontbg', {x: 0, y: frontbg.y});

        if (getBoyfriend() != null)
            stagePositions.set('boyfriend', {x: getBoyfriend().x, y: getBoyfriend().y});
        if (getDad() != null)
            stagePositions.set('dad', {x: getDad().x, y: getDad().y});
        if (getGirlfriend() != null)
            stagePositions.set('gf', {x: getGirlfriend().x, y: getGirlfriend().y});
    }

    function createRocks():Void
    {
        var dadRockX:Float = 330;  // Ajustar conforme necessário
        var bfRockX:Float = 1280;  // Ajustar conforme necessário
        var gfRockX:Float = 830;   // Ajustar conforme necessário

        var frontRockY:Float = 740;
        var backRockY:Float = 710;

        ground_M = FunkinSprite.create(gfRockX, backRockY);
        ground_M.loadTexture('Phase3/ground_M');
        ground_M.scale.set(0.675, 0.675);
        ground_M.updateHitbox();
        ground_M.x -= ground_M.width / 2;
        ground_M.scrollFactor.set(0.9, 0.95);
        PlayState.instance.add(ground_M, 'ground_M');

        lavarock_M = FunkinSprite.create(ground_M.x - 80, ground_M.y + 50);
        lavarock_M.loadSparrow('Phase3/lavarock_M');
        lavarock_M.animation.addByPrefix('anim', 'lavarock_M', 24, true);
        lavarock_M.animation.play('anim');
        lavarock_M.scale.set(0.75, 0.75);
        lavarock_M.updateHitbox();
        lavarock_M.scrollFactor.set(0.9, 0.95);
        PlayState.instance.add(lavarock_M, 'lavarock_M');
        spriteMap.set('lavarock_M', lavarock_M);

        ground_L = FunkinSprite.create(dadRockX, frontRockY);
        ground_L.loadTexture('Phase3/ground_L');
        ground_L.scale.set(0.825, 0.825);
        ground_L.updateHitbox();
        ground_L.x -= ground_L.width / 2;
        PlayState.instance.add(ground_L, 'ground_L');

        lavarock_L = FunkinSprite.create(ground_L.x - 10, ground_L.y + 100);
        lavarock_L.loadSparrow('Phase3/lavarock_L');
        lavarock_L.animation.addByPrefix('anim', 'lavarock_L', 24, true);
        lavarock_L.animation.play('anim');
        lavarock_L.scale.set(0.75, 0.75);
        lavarock_L.zIndex = 201; // ficar acima do dad
        lavarock_L.updateHitbox();
        PlayState.instance.add(lavarock_L, 'lavarock_L');
        spriteMap.set('lavarock_L', lavarock_L);

        ground_R = FunkinSprite.create(bfRockX, frontRockY + 30);
        ground_R.loadTexture('Phase3/ground_R');
        ground_R.scale.set(0.75, 0.75);
        ground_R.updateHitbox();
        ground_R.x -= ground_R.width / 2;
        PlayState.instance.add(ground_R, 'ground_R');

        lavarock_R = FunkinSprite.create(ground_R.x - 40, ground_R.y + 50);
        lavarock_R.loadSparrow('Phase3/lavarock_R');
        lavarock_R.animation.addByPrefix('anim', 'lavarock_R', 24, true);
        lavarock_R.animation.play('anim');
        lavarock_R.scale.set(0.75, 0.75);
        lavarock_R.updateHitbox();
        PlayState.instance.add(lavarock_R, 'lavarock_R');
        spriteMap.set('lavarock_R', lavarock_R);

        // Lava background fix
        lavabgfix = FunkinSprite.create(lavarock_L.x, lavarock_L.y + 84);
        lavabgfix.makeGraphic(900, 120, 0xFF0FF8F9);
        PlayState.instance.add(lavabgfix, 'lavabgfix');
    }

    override public function onUpdate(event:UpdateScriptEvent):Void
    {
        super.onUpdate(event);

        // Camera fix durante erupção
        if (inEruption && PlayState.instance != null)
        {
            var camFollow = PlayState.instance.cameraFollowPoint;
            if (camFollow != null)
            {
                var diff = lava_FG.y - camFollow.y - 125; //245
                if (diff < 0)
                    camFollow.y += Math.min(0, diff);
            }
        }

        // Geysers animation loop
        if (geyserL.animation.curAnim != null && geyserL.animation.curAnim.finished)
            geyserL.animation.play('loop');
        if (geyserM.animation.curAnim != null && geyserM.animation.curAnim.finished)
            geyserM.animation.play('loop');
        if (geyserR.animation.curAnim != null && geyserR.animation.curAnim.finished)
            geyserR.animation.play('loop');

        // Atualizar movimento das rochas
        sinkUpdate(event.elapsed);

        // Debris recycling
        if (debris1.y >= debrisResetY)
        {
            debris1.x = FlxG.random.float(debrisXCenter - debrisSpread, debrisXCenter + debrisSpread);
            debris1.y = FlxG.random.float(-900, -1200);
            debris1.flipX = FlxG.random.bool(50);
            var scale = FlxG.random.float(0.8, 1);
            debris1.scale.set(scale, scale);
            debris1.updateHitbox();
            debris1.velocity.y = 400 + (scale - 0.8) * 50;
        }

        if (debris2.y >= debrisResetY)
        {
            debris2.x = FlxG.random.float(debrisXCenter - debrisSpread, debrisXCenter + debrisSpread);
            debris2.y = FlxG.random.float(-900, -1200);
            debris2.flipX = FlxG.random.bool(50);
            var scale = FlxG.random.float(0.8, 1);
            debris2.scale.set(scale, scale);
            debris2.updateHitbox();
            debris2.velocity.y = 475 + (scale - 0.8) * 50;
        }

        if (debris3.y >= debrisResetY)
        {
            var debrisNum = FlxG.random.int(1, 2);
            debris3.loadSparrow('Phase3/debris${debrisNum}');
            debris3.animation.addByPrefix('debris', 'debris', 24, true);
            debris3.animation.play('debris');
            debris3.x = FlxG.random.float(debrisXCenter - debrisSpread, debrisXCenter + debrisSpread);
            debris3.y = FlxG.random.float(-900, -1200);
            debris3.flipX = FlxG.random.bool(50);
            var scale = FlxG.random.float(0.9, 1);
            debris3.scale.set(scale, scale);
            debris3.updateHitbox();
            debris3.velocity.y = 500 + (scale - 0.8) * 50;
        }

        // Sink logic - SOLUÇÃO: usar spriteMap ao invés de getNamedProp
        if (sinkValue > 0)
        {
            var elapsed = Conductor.instance.stepLengthMs;
            if (sinkValue >= 75)
                sinkMult = Math.min(1, sinkMult + elapsed);
            else
                sinkMult = Math.max(0.75, sinkMult - elapsed / 6);

            var sinkv = sinkValue / 30.0 * elapsed * sinkMult;
            sinkv = Math.min(sinkValue, sinkv);
            sinkValue -= sinkv;

            for (sprName in sinkables)
            {
                var spr = spriteMap.get(sprName);
                if (spr != null)
                {
                    spr.y += sinkv;
                }
            }
        }
    }

    function sinkUpdate(elapsed:Float):Void
    {
        sineValue += elapsed;

        var lavaFGOff = (lava_FG.y - lava_FG_Y) * 0.75;

        for (i in 0...3)
        {
            if (i == 0 && disableDadRockMovement) continue;
            var char = getDad();
            var charGroupPos = stagePositions.get('dad');
            var name = 'dad';
            var ground:StageProp = ground_L;

            if (i == 1)
            {
                name = 'boyfriend';
                ground = ground_R;
                char = getBoyfriend();
                charGroupPos = stagePositions.get('boyfriend');
            }
            else if (i == 2)
            {
                name = 'gf';
                ground = ground_M;
                char = getGirlfriend();
                charGroupPos = stagePositions.get('gf');
            }

            if (char == null || charGroupPos == null) continue;
            var groundName = 'ground_' + (i == 0 ? 'L' : (i == 1 ? 'R' : 'M'));
            var pos = stagePositions.get(groundName);
            if (pos == null) continue;

            var speed = sineSpeed.get(name);
            var add = sineAdd.get(name);
            var mult = sineMult.get(name);

            var offX = Math.sin(sineValue * Math.PI * speed.x + add.x) * mult.x;
            var offY = Math.cos(sineValue * Math.PI * speed.y + add.y) * mult.y;

            ground.x = pos.x + offX;
            ground.y = pos.y + offY + lavaFGOff;
            char.x = charGroupPos.x + offX;
            char.y = charGroupPos.y + offY + lavaFGOff;
        }

        // SOLUÇÃO: Update eruption sprites usando spriteMap
        for (sprName in eruptionSprites)
        {
            var spr:StageProp = spriteMap.get(sprName);
            var pos = stagePositions.get(sprName);

            if (debugText != null) {
                debugText.text = 'spr: ' + spr +
                '\nsprName: ' + sprName +
                '\npos: ' + pos +
                '\nlavaFGOff: ' + lavaFGOff;
            }

            if (spr != null && pos != null)
            {
                var mult = 1.0;
                if (sprName == 'frontbgLava') mult = 0.6;
                else if (sprName == 'lavabubbles') mult = 1.0;
                spr.y = pos.y + lavaFGOff * mult;
            }
        }
    }

    override public function onBeatHit(event:SongTimeScriptEvent):Void
    {
        super.onBeatHit(event);

        if (event.beat % 16 == 0)
        {
            // Garbage collection ?
        }
    }

    function loadDebugElements()
    {
      if (debugText) return;
      var scoreTxt = PlayState.instance.scoreText;

      debugText = new FlxText(0, 0, 0, '', scoreTxt.size + 5);
      debugText.setFormat(Paths.font('Inconsolata-Bold.ttf'), scoreTxt.size + 5, 0xFF09ce3b, 'center', scoreTxt.borderStyle, scoreTxt.borderColor);
      debugText.x = PlayState.instance.healthBarBG.x + PlayState.instance.healthBarBG.width / 2;
      debugText.y = PlayState.instance.healthBar.y + 20;
      debugText.scrollFactor.set(scoreTxt.scrollFactor.x, scoreTxt.scrollFactor.y);
      debugText.zIndex = 901;
      debugText.cameras = [PlayState.instance.camHUD];
      debugText.visible = true;
      PlayState.instance.add(debugText);
      PlayState.instance.refresh();
    }

    override public function onStepHit(event:SongTimeScriptEvent):Void
    {
        super.onStepHit(event);

        if (event.curStep >= 2624 && !debrisFlag)
        {
            debris1.visible = true;
            debris1.active = true;
            debris1.animation.play('debris');
            debris2.visible = true;
            debris2.active = true;
            debris2.animation.play('debris');
            debris3.visible = true;
            debris3.active = true;
            debris3.animation.play('debris');
            debrisFlag = true;
        }
    }

    override public function onSongEvent(event:SongEventScriptEvent):Void
    {
        super.onSongEvent(event);

        if (event.eventData.eventKind == "WrathEvents") {
        value = event.eventData.value;

        switch (Std.int(value.eventType))
        {
            case 0:
                geyserL.visible = true;
                geyserM.visible = true;
                geyserR.visible = true;
                geyserL.animation.play('spout', true);
                geyserM.animation.play('spout', true);
                geyserR.animation.play('spout', true);

            case 1:
                inEruption = !inEruption;
                var duration:Float = 25;
                if (Math.isNaN(duration)) duration = 20;
                // var targetY = inEruption ? (lava_FG_Y - 1000) : lava_FG_Y;
                // FlxTween.tween(lava_FG, {y: targetY}, duration, {ease: FlxEase.linear});
                var targetY = 790; // baixar o y
                var objects = [bg, frontbg, FG_fire_L, FG_fire_R, geyserL, geyserM, geyserR, debris1, debris2, debris3, lavaflowL, lavaflowR];
                for (obj in objects) {
                  tweens.push(FlxTween.tween(obj, {y: obj.y + targetY}, duration, {ease: FlxEase.outQuad}));
                }
                sinkValue = 700;
                sinkMult = 0;

            case 2:
                if (getBoyfriend() == null) return;

                FlxG.sound.play(Paths.sound('sink'));
                var duration:Float = 5;
                if (Math.isNaN(duration)) duration = 5;
                disableDadRockMovement = true;

                if (getDad() != null)
                {
                    tweens.push(FlxTween.tween(getDad(), {y: getDad().y + 700}, duration, {ease: FlxEase.cubeIn}));
                }
                tweens.push(FlxTween.tween(ground_L, {y: ground_L.y + 700}, duration, {
                    ease: FlxEase.cubeIn,
                    onComplete: function(twn:FlxTween) {
                        lavarock_L.visible = false;
                    }
                }));
            }
        }

        if (event.eventData.eventKind == "FocusCamera")

		{
		    if (Conductor.instance.currentStep >= 1722 && Conductor.instance.currentStep <= 1735) return; // bf toca uma animação nesse tempo, a câmera tem um zoom customizado. não queremos que esse zoom conflite com os de baixo
			var value = event.eventData.value;
			switch (Std.parseInt(value.char)) {
				case 0:
	            FlxTween.tween(PlayState.instance, {currentCameraZoom: 1.15}, 1, {ease: FlxEase.quadOut});
				case 1:
	            FlxTween.tween(PlayState.instance, {currentCameraZoom: 1}, 1.03, {ease: FlxEase.quadOut});
				default:

			}
		}
    }

    override function onDestroy(event)
	{
		super.onDestroy(event);
		resetTweens();
        hasCreatedStage = false;
	}

	private function resetTweens()
	{
		for (tween in tweens)
		{
			if (tween != null)
				tween.cancel();
		}
		tweens = [];
		pausedTweens = [];
	}

	override function onResume(event)
	{
		super.onResume(event);
		for (tween in pausedTweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = true;
			}
		}
		pausedTweens = [];
	}

	override function onPause(event)
	{
		super.onPause(event);
		pausedTweens = [];
		for (tween in tweens)
		{
			if (tween != null && !tween.finished)
			{
				tween.active = false;
				pausedTweens.push(tween);
			}
		}
	}

}
