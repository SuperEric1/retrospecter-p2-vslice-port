    override public function onSongLoaded(event:ScriptEvent):Void
    {
        super.onSongLoaded(event);
        dadBaseX = getDad().x;
        dadBaseY = getDad().y;
        bfBaseX = getBoyfriend().x;
        bfBaseY = getBoyfriend().y;
        gfBaseX = getGirlfriend().x;
        gfBaseY = getGirlfriend().y;

        sinkUpdate(0);

        if (!hasCreatedStage)
        {
            hasCreatedStage = true;

            // Borders for wide screens
            // Actually let's make it always true because this stage is kinda small
            if (true) {
                var camZoom = PlayState.instance.stageZoom;
                var w = 500;
                var h = Math.ceil((FlxG.height + 50) / camZoom);
                var color = 0xFF031100; // #031100
                var color2 = 0xFF0b110a;

                var border1 = FlxGradient.createGradientFlxSprite(w, h, [color, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT], 1, 0);
                border1.x = bg.x + 10;
                border1.screenCenter(0x10);
                border1.scrollFactor.set(bg.scrollFactor.x, 0);
                border1.zIndex = bg.zIndex + 1;
                add(border1);
                var fillBorderLeft = FunkinSprite.create(border1.x, border1.y).makeSolidColor(w * 3, h, color);
                fillBorderLeft.zIndex = border1.zIndex - 1;
                fillBorderLeft.x -= fillBorderLeft.width;
                fillBorderLeft.scrollFactor.set(bg.scrollFactor.x, 0);
                add(fillBorderLeft);

                var border2 = FlxGradient.createGradientFlxSprite(w, h, [FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, color, color], 1, 0);
                border2.x = bg.x + bg.width - 380;
                border2.screenCenter(0x10);
                border2.scrollFactor.set(bg.scrollFactor.x, 0);
                border2.zIndex = bg.zIndex + 1;
                add(border2);
                var fillBorderRight = FunkinSprite.create(border2.x + border2.width, border2.y).makeSolidColor(w * 3, h, color);
                fillBorderRight.zIndex = border2.zIndex - 1;
                fillBorderRight.scrollFactor.set(bg.scrollFactor.x, 0);
                add(fillBorderRight);

                /*var border3 = FlxGradient.createGradientFlxSprite(150, (frontbg.height / 1.7) + 15, [color2, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT], 1, 0);
                border3.x = frontbg.x;
                border3.y = frontbg.y;
                border3.scrollFactor.set(frontbg.scrollFactor.x, frontbg.scrollFactor.y);
                border3.zIndex = frontbg.zIndex + 1;
                add(border3);
                var fillBorderFix = FunkinSprite.create(border3.x, border3.y).makeSolidColor(300, border3.height, color2);
                fillBorderFix.x -= fillBorderFix.width;
                fillBorderFix.zIndex = border3.zIndex - 1;
                fillBorderFix.scrollFactor.set(frontbg.scrollFactor.x, frontbg.scrollFactor.y);
                add(fillBorderFix);*/
            }
        }
    }

    private function createRocks():Void
    {
        var dadRockX:Float = 330;
        var bfRockX:Float = 1280;
        var gfRockX:Float = 830;
        var frontRockY:Float = 740;
        var backRockY:Float = 710;

        ground_M = FunkinSprite.create(gfRockX, backRockY);
        ground_M.loadTexture('Phase3/ground_M');
        ground_M.scale.set(0.675, 0.675);
        ground_M.updateHitbox();
        ground_M.x -= ground_M.width / 2;
        ground_M.scrollFactor.set(0.9, 0.95);
        ground_M.zIndex = 75;
        ground_M.antialiasing = false;
        add(ground_M);

        ground_L = FunkinSprite.create(dadRockX, frontRockY);
        ground_L.loadTexture('Phase3/ground_L');
        ground_L.scale.set(0.825, 0.825);
        ground_L.updateHitbox();
        ground_L.x -= ground_L.width / 2;
        ground_L.scrollFactor.set(1.0, 1.0);
        ground_L.zIndex = 250;
        add(ground_L);

        ground_R = FunkinSprite.create(bfRockX, frontRockY + 30);
        ground_R.loadTexture('Phase3/ground_R');
        ground_R.scale.set(0.75, 0.75);
        ground_R.updateHitbox();
        ground_R.x -= ground_R.width / 2;
        ground_R.scrollFactor.set(1.0, 1.0);
        ground_R.zIndex = 150;
        add(ground_R);

        lavarockL = FunkinSprite.create(ground_L.x - 10, ground_L.y + 100);
        lavarockL.loadSparrow('Phase3/lavarock_L');
        lavarockL.animation.addByPrefix('anim', 'lavarock_L', 24, true);
        lavarockL.animation.play('anim');
        lavarockL.scale.set(0.75, 0.75);
        lavarockL.updateHitbox();
        lavarockL.scrollFactor.set(1.0, 1.0);
        lavarockL.zIndex = ground_L.zIndex + 1;
        add(lavarockL);

        lavarockM = FunkinSprite.create(ground_M.x - 80, ground_M.y + 50);
        lavarockM.loadSparrow('Phase3/lavarock_M');
        lavarockM.animation.addByPrefix('anim', 'lavarock_M', 24, true);
        lavarockM.animation.play('anim');
        lavarockM.scale.set(0.75, 0.75);
        lavarockM.updateHitbox();
        lavarockM.scrollFactor.set(0.9, 0.95);
        lavarockM.zIndex = ground_M.zIndex + 1;
        lavarockM.antialiasing = false;
        add(lavarockM);

        lavarockR = FunkinSprite.create(ground_R.x - 40, ground_R.y + 50);
        lavarockR.loadSparrow('Phase3/lavarock_R');
        lavarockR.animation.addByPrefix('anim', 'lavarock_R', 24, true);
        lavarockR.animation.play('anim');
        lavarockR.scale.set(0.75, 0.75);
        lavarockR.updateHitbox();
        lavarockR.scrollFactor.set(1.0, 1.0);
        lavarockR.zIndex = ground_R.zIndex + 1;
        add(lavarockR);
    }

    override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
    {
        super.addCharacter(character, charType);

        if (charType == CharacterType.DAD)
        {
            dadChar = character;
            dadDefaultX = character.x;
        }
        else if (charType == CharacterType.BF)
        {
            bfDefaultX = character.x;
            bfDefaultY = character.y;
            if (character.characterId == 'bf-retrospecter') {
                character.idleSuffix = '-alt';
                character.danceEvery = 1;
            }
            bfChar = character;
            character.antialiasing = false;
        }
        else if (charType == CharacterType.GF)
        {
            gfChar = character;
            gfDefaultX = character.x;
            character.scrollFactor.set(0.9, 0.95);
            character.antialiasing = false;
        }
    }

    override function onUpdate(event:UpdateScriptEvent):Void
    {
        super.onUpdate(event);
        if (PlayState.instance == null) return;
        if (PlayState.instance.isGamePaused) return;
        if (PlayState.instance.isGameOverState) return;

        var elapsed:Float = event.elapsed;

        // Durante a erupção, impede a câmera de subir além da lava
        if (inEruption)
        {
            var followY:Float = PlayState.instance.cameraFollowPoint.y;
            PlayState.instance.cameraFollowPoint.y += Math.min(0, lavaFG.y - followY - 245);

            if (geyserL.animation.curAnim != null && geyserL.animation.curAnim.name == 'spout' && geyserL.animation.curAnim.finished)
            geyserL.animation.play('loop');
            if (geyserM.animation.curAnim != null && geyserM.animation.curAnim.name == 'spout' && geyserM.animation.curAnim.finished)
                geyserM.animation.play('loop');
            if (geyserR.animation.curAnim != null && geyserR.animation.curAnim.name == 'spout' && geyserR.animation.curAnim.finished)
                geyserR.animation.play('loop');
        }

        sinkUpdate(elapsed);

        if (debrisFlag)
        {
            recycleDebris(debris1, 400, 0.8, 1.0, 50);
            recycleDebris(debris2, 475, 0.8, 1.0, 50);

            if (debris3.y >= DEBRIS_RESET_Y)
            {
                var sheet:String = 'Phase3/debris' + FlxG.random.int(1, 2);
                debris3.loadSparrow(sheet);
                debris3.animation.addByPrefix('debris', 'debris', 24, true);
                debris3.animation.play('debris');
                debris3.x = FlxG.random.float(DEBRIS_X_CENTER - DEBRIS_SPREAD, DEBRIS_X_CENTER + DEBRIS_SPREAD);
                debris3.y = FlxG.random.float(-900, -1200);
                debris3.flipX = FlxG.random.bool(50);
                var scale3:Float = FlxG.random.float(0.9, 1.0);
                debris3.scale.set(scale3, scale3);
                debris3.velocity.y = 500 + (scale3 - 0.8) * 50;
            }
        }

        if (sinkValue > 0)
        {
            if (sinkValue >= 75)
                sinkMult = Math.min(1.0, sinkMult + elapsed);
            else
                sinkMult = Math.max(0.75, sinkMult - elapsed / 6);

            var sinkv:Float = Math.min(sinkValue, sinkValue / 30.0 * elapsed * sinkMult);
            sinkValue -= sinkv;

            for (spr in sinkableSprites)
                spr.y += sinkv;
        }
    }

    private function recycleDebris(debris:FunkinSprite, baseVelocity:Float, minScale:Float, maxScale:Float, velScaleMult:Float):Void
    {
        if (debris.y < DEBRIS_RESET_Y) return;

        debris.x = FlxG.random.float(DEBRIS_X_CENTER - DEBRIS_SPREAD, DEBRIS_X_CENTER + DEBRIS_SPREAD);
        debris.y = FlxG.random.float(-900, -1200);
        debris.flipX = FlxG.random.bool(50);
        var scale:Float = FlxG.random.float(minScale, maxScale);
        debris.scale.set(scale, scale);
        debris.velocity.y = baseVelocity + (scale - 0.8) * velScaleMult;
    }

    private function sinkUpdate(elapsed:Float):Void
    {
        sineValue += elapsed;

        var lavaFGOff:Float = (lavaFG.y - LAVA_FG_Y) * 0.75;

        var charRefs:Array<BaseCharacter> = [dadChar, bfChar, gfChar];
        var ground_Refs:Array<FunkinSprite> = [ground_L, ground_R, ground_M];
        var groundBaseX:Array<Float> = [ground_LBaseX, ground_RBaseX, ground_MBaseX];
        var groundBaseY:Array<Float> = [ground_LBaseY, ground_RBaseY, ground_MBaseY];
        var charBaseX:Array<Float> = [dadBaseX, bfBaseX, gfBaseX];
        var charBaseY:Array<Float> = [dadBaseY, bfBaseY, gfBaseY];

        for (i in 0...3)
        {
            if (i == 0 && disableDadRockMovement) continue;
            if (charRefs[i] == null || ground_Refs[i] == null) continue;

            var offX:Float = Math.sin(sineValue * Math.PI * sineSpeedX[i] + sineAddX[i]) * sineMultX[i];
            var offY:Float = Math.cos(sineValue * Math.PI * sineSpeedY[i] + sineAddY[i]) * sineMultY[i];

            ground_Refs[i].x = groundBaseX[i] + offX;
            ground_Refs[i].y = groundBaseY[i] + offY + lavaFGOff;
            charRefs[i].x = charBaseX[i] + offX;
            charRefs[i].y = charBaseY[i] + offY + lavaFGOff;
        }

        lavarockL.y = eruptionBaseY.get('lavarockL') + lavaFGOff;
        lavarockM.y = eruptionBaseY.get('lavarockM') + lavaFGOff;
        lavarockR.y = eruptionBaseY.get('lavarockR') + lavaFGOff;
        lavabubbles.y = eruptionBaseY.get('lavabubbles') + lavaFGOff;
        frontbgLava.y = eruptionBaseY.get('frontbgLava') + lavaFGOff;
        frontbgLava2.y = eruptionBaseY.get('frontbgLava2') + lavaFGOff;
        frontbgLava3.y = eruptionBaseY.get('frontbgLava3') + lavaFGOff;
    }

    override function onStepHit(event:SongTimeScriptEvent):Void
    {
        super.onStepHit(event);
        if (PlayState.instance == null) return;
        if (PlayState.instance.isGamePaused) return;
        if (PlayState.instance.isGameOverState) return;

        if (event.step >= 2624 && !debrisFlag)
        {
            debris1.visible = true;
            debris1.active = true;
            debris2.visible = true;
            debris2.active = true;
            debris3.visible = true;
            debris3.active = true;
            debrisFlag = true;
        }
    }

    override function onBeatHit(event:SongTimeScriptEvent):Void
    {
        super.onBeatHit(event);
        if (PlayState.instance == null) return;
        if (PlayState.instance.isGamePaused) return;
        if (PlayState.instance.isGameOverState) return;
    }

    override public function onSongEvent(event:SongEventScriptEvent):Void
    {
        super.onSongEvent(event);

        if (event.eventData.eventKind == "WrathEvents") {
        value = event.eventData.value;

        switch (Std.int(value.eventType))
        {
            case 0: // Geysers
                if (Conductor.instance.currentStep < 2624) return; // Por algum motivo macabro, o evento estava acionando antes da hora
                handleGeysers();

            case 1: // Eruption
                var duration:Float = event.eventData.getFloat('value1');
                if (duration == null || duration <= 0) duration = 20;
                handleEruption(duration);

            case 2: // Sink
                var duration:Float = 5;
                handleSink(duration);
            }
        }

        if (event.eventData.eventKind == "FocusCamera")
		{
		    if (Conductor.instance.currentStep >= 3174 && Conductor.instance.currentStep <= 3220) return; // bf toca uma animação nesse tempo, a câmera tem um zoom customizado. não queremos que esse zoom conflite com os de baixo
			var value = event.eventData.value;
			switch (Std.parseInt(value.char)) {
				case 0: // BF
	            PlayState.instance.tweenCameraZoom(1.2, 0.9, false, FlxEase.quadOut);
				case 1: // DAD
	            PlayState.instance.tweenCameraZoom(PlayState.instance.stageZoom, 1.2, true, FlxEase.quadOut);
				default:

			}
		}
    }

    private function handleGeysers():Void
    {
        geyserL.animation.play('spout', true);
        geyserM.animation.play('spout', true);
        geyserR.animation.play('spout', true);
        geyserL.visible = true;
        geyserM.visible = true;
        geyserR.visible = true;
    }

    private function handleEruption(duration:Float):Void
    {
        inEruption = !inEruption;
        var targetY:Float = inEruption ? (LAVA_FG_Y - 120) : LAVA_FG_Y;
        tweens.push(FlxTween.tween(lavaFG, {y: targetY}, duration, {ease: FlxEase.linear}));
        sinkValue = 700;
        sinkMult = 0;
    }

    private function handleSink(duration:Float):Void
    {
        if (bfChar.characterId == 'playable-dozirc') return;
        FunkinSound.load(Paths.sound('sink'), 1, false, true, true);
        disableDadRockMovement = true;

        PlayState.instance.cameraFollowPoint.setPosition(600, 600);

        tweens.push(FlxTween.tween(dadChar, {y: dadChar.y + 700}, duration, {ease: FlxEase.cubeIn}));
        tweens.push(FlxTween.tween(ground_L, {y: ground_L.y + 700}, duration,
        {
            ease: FlxEase.cubeIn,
            onComplete: function(twn:FlxTween) { lavarockL.visible = false; }
        }));
    }

    override function onSongRetry(event:SongRetryEvent):Void
    {
        super.onSongRetry(event);

        resetTweens();
        resetFlags();

        lavaFG.y = LAVA_FG_Y;

        for (i in 0...sinkableSprites.length) {
            sinkableSprites[i].y = sinkableOriginalY[i];
        }

        debris1.visible = false;
        debris1.active = false;
        debris1.velocity.y = 400;
        debris2.visible = false;
        debris2.active = false;
        debris2.velocity.y = 450;
        debris3.visible = false;
        debris3.active = false;
        debris3.velocity.y = 450;

        geyserL.visible = false;
        geyserM.visible = false;
        geyserR.visible = false;

        lavarockL.visible = true;

        dadChar.x = dadBaseX;
        dadChar.y = dadBaseY;

        PlayState.instance.cameraFollowPoint.setPosition(getDad().cameraFocusPoint.x, getDad().cameraFocusPoint.y);
    }

    override function onDestroy(event:ScriptEvent):Void
    {
        super.onDestroy(event);
        resetTweens();
        resetFlags();

        hasCreatedStage = false;
        sinkableSprites = [];
        sinkableOriginalY = [];
        eruptionBaseY = new StringMap();
    }

    private function resetTweens()
    {
        for (tween in tweens)
        {
            if (tween != null)
              tween.cancel();
        }
        tweens = [];
        pausedTweens = [];
    }

    override function onResume(event)
    {
      super.onResume(event);
        for (tween in pausedTweens)
        {
            if (tween != null && !tween.finished)
            {
                tween.active = true;
            }
        }
        pausedTweens = [];
    }

    override function onPause(event)
    {
        super.onPause(event);
        pausedTweens = [];
        for (tween in tweens)
        {
            if (tween != null && !tween.finished)
            {
                tween.active = false;
                pausedTweens.push(tween);
            }
        }
    }

    private function resetFlags():Void
    {
        debrisFlag = false;
        inEruption = false;
        sinkValue = 0;
        sinkMult = 0;
        sineValue = 0;
        disableDadRockMovement = false;
    }
}
