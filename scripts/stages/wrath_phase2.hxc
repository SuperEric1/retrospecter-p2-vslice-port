  {
    // Apply the shader automatically to each character as it gets added.
    super.addCharacter(character, charType);
    if (character == null) return;
    trace('Applied stage shader to ' + character.characterName);

    /*var rim = new DropShadowShader();
    rim.setAdjustColor(-33, 0, -23, 0); // brilho, hue, contraste e saturação
    rim.color = 0xFF1ab635; // #1ab635ff
    character.shader = rim;
    rim.attachedSprite = character;
    rim.antialiasAmt = 0;*/

    switch (charType)
    {
      case CharacterType.BF:
        if (getBoyfriend().characterId == 'bf-retrospecter') {
          character.idleSuffix = '-alt';
          character.danceEvery = 1;
        }

        /*rim.angle = 90;
        character.animation.onFrameChange.add(function() {
          if (getBoyfriend() != null)
          {
            rim.updateFrameInfo(getBoyfriend().frame);
          }
        });

      case CharacterType.GF:
        rim.angle = 90;
        rim.threshold = -1;

        character.animation.onFrameChange.add(function() {
          rim.updateFrameInfo(getGirlfriend().frame);
        });*/

      case CharacterType.DAD:
        fixRetroPos();
        /*rim.angle = 90;
        //rim.threshold = 0.3;

        character.animation.onFrameChange.add(function() {
          if (getDad() == null) return;
          rim.updateFrameInfo(getDad().frame);
        });*/

      default:
    }
  }

  public function onGameOver(event:ScriptEvent)
  {
    super.onGameOver(event);
    getBoyfriend().shader = null;
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);

    // Overlay
    if (!hasCreatedStage) {
      overlay = FunkinSprite.create(0, 0);
      overlay.loadTexture('wrath/wrath_overlay');
      overlay.screenCenter();
      overlay.scrollFactor.set(0.6, 0.6);
      overlay.blend = 12;
      overlay.y += -128;
      overlay.x += 40;
      overlay.scale.set(1.1, 1);
      overlay.zIndex = 9000;
      add(overlay);

      // Borders for wide screens
      if (isWideScreen) {
        /*var overlay2 = FunkinSprite.create(overlay.x - overlay.width, overlay.y);
        overlay2.loadTexture('wrath/wrath_overlay');
        overlay2.scrollFactor.set(overlay.scrollFactor.x, overlay.scrollFactor.y);
        overlay2.blend = overlay.blend;
        overlay2.zIndex = overlay.zIndex;
        add(overlay2);

        var overlay3 = FunkinSprite.create(overlay.x + overlay.width, overlay.y);
        overlay3.loadTexture('wrath/wrath_overlay');
        overlay3.scrollFactor.set(overlay.scrollFactor.x, overlay.scrollFactor.y);
        overlay3.blend = overlay.blend;
        overlay3.zIndex = overlay.zIndex;
        add(overlay3);*/

        var camZoom = PlayState.instance.stageZoom;
        var w = 500;
        var h = Math.ceil((FlxG.height + 50) / camZoom);
        var color = 0xFF000f03; // #000f03

        var border1 = FlxGradient.createGradientFlxSprite(w, h, [color, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, FlxColor.TRANSPARENT], 1, 0);
        border1.x = -1000;
        border1.screenCenter(0x10);
        border1.scrollFactor.set(rocksLeft.scrollFactor.x, 0);
        border1.zIndex = rocksLeft.zIndex + 1;
        add(border1);
        var fillBorderLeft = FunkinSprite.create(border1.x, border1.y).makeSolidColor(w * 5, h, color);
        fillBorderLeft.zIndex = border1.zIndex;
        fillBorderLeft.x -= fillBorderLeft.width;
        fillBorderLeft.scrollFactor.set(border1.scrollFactor.x, border1.scrollFactor.y);
        add(fillBorderLeft);

        var border2 = FlxGradient.createGradientFlxSprite(w, h, [FlxColor.TRANSPARENT, FlxColor.TRANSPARENT, color, color], 1, 0);
        border2.x = wrathXAdjust + 1970;
        border2.screenCenter(0x10);
        border2.scrollFactor.set(rocks.scrollFactor.x, 0);
        border2.zIndex = rocks.zIndex + 1;
        add(border2);
        var fillBorderRight = FunkinSprite.create(border2.x + border2.width, border2.y).makeSolidColor(w * 5, h, color);
        fillBorderRight.zIndex = border2.zIndex;
        fillBorderRight.scrollFactor.set(border2.scrollFactor.x, border2.scrollFactor.y);
        add(fillBorderRight);
      }

      refresh();
    }

    hasCreatedStage = true;
  }

  override function onSongStart(event:ScriptEvent):Void
  {
    super.onSongStart(event);
    //ogStrumY = PlayState.instance.playerStrumline.y;
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (!PlayStatePlaylist.isStoryMode || PlayState.instance.isChartingMode) {
      hasPlayedInGameCutscene = true;
      hasPlayedOutroCutscene = true;
    }

    if (!hasPlayedInGameCutscene && isSpectral) {
      hasPlayedInGameCutscene = true;
      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camHUD.visible = false;

      ogRetroScale = getDad().scale.x;
      getDad().scale.set(1.1, 1.1);
      getDad().playAnimation('transformation-loop');

      buildProps(true);
      loadSounds();

      var zoomTime:Float = 0.5;

      var rd = ModuleHandler.getModule('RetroDialogue');
      rd.scriptCall('startDialogue', ['spectral story', 'pre', function() {
        introCutscene();
        //new FlxTimer().start(zoomTime, introCutscene);
      }]);

      var retro = PlayState.instance.currentStage.getDad();
      var retroPos:Array<Float> = [
        retro.cameraFocusPoint.x,
        retro.cameraFocusPoint.y
      ];

      PlayState.instance.tweenCameraZoom(0.85, zoomTime, true, FlxEase.circOut);
      PlayState.instance.tweenCameraToPosition(retroPos[0] + 100, retroPos[1] - 10, zoomTime, FlxEase.expoOut);
    }
  }

  override public function onUpdate(event):Void {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;
    var songPos = Conductor.instance.songPosition / 1000;

    //zindex here is still broken idk how to fix it
    if (hasCreatedStage && !hasRefreshedProps) {
      hasRefreshedProps = true;

      crack.x = getGirlfriend().x;
      crack.y = getBoyfriend().y + 120;
      if (crack_2 != null) {
        crack_2.x = getGirlfriend().x - (crack_2.width / 2) + 50;
        crack_2.y = getBoyfriend().y + 60;
      }
    }

    // Crystal floating animation
    if (crystals != null && crystals.length > 0) {
      for (i in 0...crystals.length) {
        if (crystals[i] == null || !hasPlayedInGameCutscene) continue;
        crystals[i].y += 50 * Math.sin(songPos + crystalFloatData[i][1]) * event.elapsed;

        // Move crystals after step 1536
        if (Conductor.instance.currentStep >= 1536 && isSpectral) {
          crystals[i].x -= crystalFloatData[i][0] * event.elapsed;
          if (crystals[i].x <= -1000) {
            crystals[i].x = 2500;
          }
        }
      }
    }
  }

  override public function onSongEvent(event:SongEventScriptEvent):Void
  {
    super.onSongEvent(event);

    var eventKind = event.eventData.eventKind;
    var value = event.eventData.value;

    if (eventKind == 'RetroChangeCharacter' && value.character == 'dad' && value.newchar == 'phase2-end') {
      if (hasPlayedOutroCutscene) return;

      var dad = getDad();

      if (!hasPlayedOutroCutscene) {
        hasPlayedOutroCutscene = true;
        isEnding = true;

        PlayState.instance.togglePauseButton(false);
        PlayState.instance.isInCutscene = true;
        PlayState.instance.mayPauseGame = false;

        PlayState.instance.camHUD.angle = 0;
        FlxG.camera.angle = 0;

        hideEndingHUD();

        PlayState.instance.cameraFollowPoint.setPosition(dad.cameraFocusPoint.x - 450, dad.cameraFocusPoint.y - 50);
        PlayState.instance.tweenCameraZoom(0.9, 0.5, false, FlxEase.quadIn);

        getDad().animation.onFrameChange.add(function(name:String, frameNumber:Int, frameIndex:Int) {
          endingCutsceneUpdate(frameNumber);
        });

        if (angyRoar != null) angyRoar.play();
      }
    }
  }

  function endingCutsceneUpdate(frame:Int):Void
  {
    var dad = getDad();
    if (dad == null) return;

    if (frame >= 29 && !endingSlammed) {
      endingSlammed = true;
      if (angySlam != null) angySlam.play();
      if (Preferences.flashingLights) {
        PlayState.instance.camCutscene.flash(0xFFFFFFFF, 0.5, null, true);
      }
      crack.visible = false;
      if (crack_2 != null) {
        crack_2.animation.play('bop');
        crack_2.active = true;
        crack_2.visible = true;
      }
      //FlxG.camera.shake(0.05, 0.5);
    } else if (endingSlammed && endingDebris == 0) {
      endingDebris++;
      if (debris1Sound != null) debris1Sound.play();
    }

    if (frame >= 58 && !endingShaderDestroyed) {
      endingShaderDestroyed = true;
      dad.shader = null;
    }

    if (!endingOnFire && frame >= 63) {
      endingOnFire = true;
      if (fireSound != null) fireSound.play();
    }

    if (!endingExploded && frame >= 74) {
      endingExploded = true;
      if (fireBoom != null) fireBoom.play();
    } else if (endingExploded && endingDebris == 1) {
      endingDebris++;
      if (debris2Sound != null) debris2Sound.play();
      if (fireRoarSound != null) fireRoarSound.play();
    }

    if (frame >= 79 && frame <= 116) {
      var perc = (116 - frame) / (116 - 79);
      var invi = (1 - perc) * 255;
      dad.colorTransform.redMultiplier = perc;
      dad.colorTransform.greenMultiplier = perc;
      dad.colorTransform.blueMultiplier = perc;
      dad.colorTransform.redOffset = invi;
      dad.colorTransform.greenOffset = invi;
      dad.colorTransform.blueOffset = invi;
    }

    if (frame >= 81 && frame < 121) {
      //endingShakeIntensity += event.elapsed * 0.025;
      //FlxG.camera.shake(endingShakeIntensity, 0.1);
    }

    if (frame >= 122 && !endingOutroFinished) {
      endingOutroFinished = true;
      if (debris3Sound != null) debris3Sound.play();

      whiteBG = FunkinSprite.create(0, 0);
      whiteBG.makeGraphic(FlxG.width, FlxG.height + 1, FlxColor.WHITE);
      whiteBG.scrollFactor.set(0, 0);
      whiteBG.cameras = [PlayState.instance.camCutscene];
      whiteBG.alpha = 0;
      PlayState.instance.add(whiteBG);

      tweens.push(FlxTween.tween(whiteBG, {alpha: 1}, 0.05, {ease: FlxEase.linear, onComplete: function(_) {
        new FlxTimer().start(6, function(tmr) {
          PlayState.instance.endSong();
        });
      }}));
    }

    if (!endingStoppedAnim && frame >= 122) {
      endingStoppedAnim = true;
      dad.active = false;
    }
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    resetTweens();

    hasCreatedStage = false;
    hasRefreshedProps = false;
    hasPlayedInGameCutscene = false;
    hasPlayedOutroCutscene = false;
    didSakuFadeIn = false;
    runesCanGlow = false;
    rockColor = false;
    ogStrumY = null;

    isEnding = false;
    endingSlammed = false;
    endingOnFire = false;
    endingExploded = false;
    endingShaderDestroyed = false;
    endingOutroFinished = false;
    endingStoppedAnim = false;
    endingDebris = 0;
    endingShakeIntensity = 0;
    whiteBG = null;
    tbcSprite = null;

    crystals = [];
    flashySteps = [640, 1024, 1536, 1856];
  }

  function changeColor(sprite:StageProp):Void
  {
    if (sprite == null) return;

    if (rockColor) {
      sprite.animation.play('cyan');
    } else {
      sprite.animation.play('green');
    }
  }

  function colorChangeStuff():Void
  {
    rockColor = !rockColor;

    changeColor(ground);
    changeColor(rocks);
    changeColor(rocksLeft);
    changeColor(gem1);
    changeColor(gem2);

    if (isEctospasm && flamesChange != null) {
      flamesChange.alpha = 1;
      FlxTween.tween(flamesChange, {alpha: 0}, 0.5, {ease: FlxEase.linear});
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);

    var curStep = event.step;

    // Ectospasm color changes
    if (isEctospasm) {
      if (curStep >= 128 && curStep % 8 == 0) {
        colorChangeStuff();
      }
    }

    // Spectral effects
    if (isSpectral) {
      if (curStep >= 1024 && !didSakuFadeIn) {
        didSakuFadeIn = true;
      }

      // Flash effects (removed)
      /*for (i in 0...flashySteps.length) {
        if (curStep >= flashySteps[i]) {
          PlayState.instance.camHUD.flash(0xFFFFFFFF, 0.25);
          flashySteps.splice(i, 1);
          break;
        }
      }*/
    }
  }

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);
    if (!hasCreatedStage) return;
    if (PlayState.instance.isGamePaused) return;
    if (PlayState.instance.isGameOverState) return;

    if (canBop && event.beat % 2 == 0) {
      crack.active = isCrackVisible;
      crack.animation.play('bop', true);

      if (runesCanGlow) {
        // Glow Left
        if (glowL1 != null) {
          glowL1.alpha = 1;
          FlxTween.tween(glowL1, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }
        if (glowL2 != null) {
          glowL2.alpha = 1;
          FlxTween.tween(glowL2, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }

        // Glow Right
        if (glowR1 != null) {
          glowR1.alpha = 1;
          FlxTween.tween(glowR1, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }
        if (glowR2 != null) {
          glowR2.alpha = 1;
          FlxTween.tween(glowR2, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }
      }
    }
  }

  override function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);

    rockColor = false;
    didSakuFadeIn = false;
    flashySteps = [640, 1024, 1536, 1856];

    hasPlayedInGameCutscene = true;
    hasPlayedOutroCutscene = false;
    isModcharting = false;
    PlayState.instance.camHUD.angle = 0;

    isEnding = false;
    endingSlammed = false;
    endingOnFire = false;
    endingExploded = false;
    endingShaderDestroyed = false;
    endingOutroFinished = false;
    endingStoppedAnim = false;
    endingDebris = 0;
    endingShakeIntensity = 0;

    // Reset crystals positions
    for (i in 0...8) {
      var crystal = crystals[i];
      if (crystal == null) continue;
      crystal.x = crystalPos[i][0];
      crystal.y = crystalPos[i][1];
    }
  }

  function buildProps(hide:Bool = false):Void
  {
    if (hide) {
      flames.y += 1000;
      if (vortex != null) vortex.visible = false;
      if (crack != null) crack.visible = false;
      for (crystal in crystals) {
        if (crystal == null) continue;
        crystal.visible = false;
      }
    } else {
      if (vortex != null) vortex.visible = true;
      if (crack != null) {
        crack.visible = true;
        crack.animation.play('bop');
      }
      for (crystal in crystals) {
        if (crystal == null) continue;
        crystal.visible = true;
      }
    }
  }

  function loadSounds():Void
  {
    growlSound = FunkinSound.load(Paths.sound("Growl"), true);
    groundShakeSound = FunkinSound.load(Paths.sound("groundShake"), true);
    firstSlam = FunkinSound.load(Paths.sound("fistSlam"), true);
    roarSound = FunkinSound.load(Paths.sound("roar"), true);

    growlSound.volume = 1;
    roarSound.volume = 1;
    groundShakeSound.volume = 1;
    firstSlam.volume = 1;

    angySlam = FunkinSound.load(Paths.sound("AngySlam"), true);
    debris1Sound = FunkinSound.load(Paths.sound("Debris1"), true);
    debris2Sound = FunkinSound.load(Paths.sound("Debris2"), true);
    fireRoarSound = FunkinSound.load(Paths.sound("FireRoar"), true);
    fireSound = FunkinSound.load(Paths.sound("fire"), true);
    fireBoom = FunkinSound.load(Paths.sound("FireBoom"), true);
    angyRoar = FunkinSound.load(Paths.sound("AngyRoar"), true);
    debris3Sound = FunkinSound.load(Paths.sound("Debris3"), true);

    angySlam.volume = 1;
    debris1Sound.volume = 1;
    debris2Sound.volume = 1;
    fireRoarSound.volume = 1;
    fireSound.volume = 1;
    fireBoom.volume = 1;
    angyRoar.volume = 1;
    debris3Sound.volume = 1;
  }

  function introCutscene():Void
  {
    PlayState.instance.togglePauseButton();
    PlayState.instance.isInCutscene = true;
    PlayState.instance.mayPauseGame = false;

    var retro = getDad();
    var retroPos:Array<Float> = [
      retro.cameraFocusPoint.x,
      retro.cameraFocusPoint.y
    ];

    /*characterStageShader = retro.shader;
    var rim = new DropShadowShader();
    rim.setAdjustColor(-33, 0, -23, 0);
    rim.color = 0xFF29c23e;
    rim.angle = 90;
    retro.shader = rim;
    rim.attachedSprite = retro;
    retro.animation.onFrameChange.add(function() {
      if (retro != null)
      {
        rim.updateFrameInfo(retro.frame);
      }
    });*/

    // Início
    retro.playAnimation('transformation', true);
    growlSound.play();
    groundShakeSound.play();
    //PlayState.instance.tweenCameraZoom(0.85, 0, true, FlxEase.linear);
    PlayState.instance.tweenCameraZoom(0.75, 1, true, FlxEase.quadInOut);
    //PlayState.instance.tweenCameraToPosition(retroPos[0] + 100, retroPos[1] - 10, 0, FlxEase.quadInOut);

    // smash ground + unzoom
    new FlxTimer().start(2, function(tmr) {
      firstSlam.play();
      PlayState.instance.tweenCameraZoom(0.7, 0.5, true, FlxEase.quadInOut);
    });

    new FlxTimer().start(2.3, function(tmr) {
      FlxG.camera.flash(0xFFFFFFFF, 0.4);
      buildProps();
      FlxG.camera.shake(0.075, 0.5);
      FlxG.camera.shake(0.025, 0.35);
    });

    // roar
    new FlxTimer().start(3.25, function(tmr) {
      if (flames != null) {
        tweens.push(FlxTween.tween(flames, {y: bgFlamesY}, 1.4, {ease: FlxEase.backOut}));
      }
      retro.playAnimation('roar', true);
      roarSound.play();
      FlxG.camera.shake(0.025, 0.35);
      PlayState.instance.tweenCameraZoom(PlayState.instance.stageZoom, 0.5, true, FlxEase.quadInOut);
    });

    /*new FlxTimer().start(4, function(tmr) {
      var rim = characterStageShader;
      retro.shader = rim;
      rim.attachedSprite = retro;
      retro.animation.onFrameChange.add(function() {
        if (retro != null)
        {
          rim.updateFrameInfo(retro.frame);
        }
      });
    });*/

    new FlxTimer().start(4.75, function(tmr) {
      retro.playAnimation('idle', true);
      getDad().scale.set(ogRetroScale, ogRetroScale);
    });

    // Cutscene acaba
    new FlxTimer().start(4.75, function(tmr) {
      var rd = ModuleHandler.getModule('RetroDialogue');
      rd.scriptCall('startDialogue', ['spectral story', 'post', function() {
        PlayState.instance.isInCutscene = false;
        PlayState.instance.startCountdown();
        new FlxTimer().start(0.2, function(tmr) {
          PlayState.instance.togglePauseButton(true);
          PlayState.instance.mayPauseGame = true;
        });
      }]);
    });
  }

  private function hideEndingHUD():Void
  {
    tweens.push(FlxTween.tween(PlayState.instance.camHUD, {alpha: 0}, 0.5, {ease: FlxEase.cubeInOut}));
    if (PlayState.instance.camControls != null) {
      tweens.push(FlxTween.tween(PlayState.instance.camControls, {alpha: 0}, 0.5, {ease: FlxEase.cubeInOut}));
    }
  }

  private function resetTweens():Void
  {
    for (tween in tweens)
    {
      if (tween != null)
        tween.cancel();
    }
    tweens = [];
    pausedTweens = [];
  }
}
