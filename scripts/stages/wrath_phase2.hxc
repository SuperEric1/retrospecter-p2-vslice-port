import flixel.FlxG;
import flixel.FlxSprite;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.math.FlxAngle;
import flixel.util.FlxTimer;
import flixel.util.FlxColor;
import funkin.Conductor;
import funkin.play.PlayState;
import funkin.play.stage.Stage;
import funkin.play.stage.StageProp;
import funkin.play.character.BaseCharacter;
import funkin.play.character.CharacterType;
import funkin.modding.events.ScriptEvent;
import funkin.graphics.shaders.DropShadowShader;
import openfl.display.BitmapData;
import flixel.graphics.FlxGraphic;
import StringTools;
import funkin.audio.FunkinSound;
import funkin.effects.IntervalShake;

class WrathPhase2Stage extends Stage
{
  // Constants
  static inline var HIDDEN:Float = 0.0001;

  // Variables
  var hasCreatedStage:Bool = false;
  var isSpectral:Bool = false;
  var isEctospasm:Bool = false;
  var optimize:Bool = false; // Lógica de otimização (false = criar todos os props)

  // Cutscene variables
  var hasPlayedInGameCutscene:Bool = false;
  var growlSound:FunkinSound;
  var groundShakeSound:FunkinSound;
  var roarSound:FunkinSound;
  var firstSlam:FunkinSound;
  var characterStageShader:DropShadowShader;
  var bgFlamesY:Float;
  var ogStrumY:Float;
  var tweens:Array<FlxTween> = [];
  var pausedTweens:Array<FlxTween> = [];

  // Crystal data
  var crystals:Array<StageProp> = [];
  var crystalPos:Array<Array<Float>> = [
    [1600, 200], [1200, -100], [1400, -500], [800, -150],
    [-900, 0], [550, -200], [-300, -300], [100, -200]
  ];
  var crystalFloatData:Array<Array<Float>> = [
    [1500, 1], [2000, 0], [1000, 2], [2500, 1.5],
    [3000, 4], [1000, 3], [2500, 6], [2000, 2.5]
  ];

  // Stage sprites
  var sky:StageProp;
  var vortex:StageProp;
  var gates:StageProp;
  var backrocks1:StageProp;
  var backrocks2:StageProp;
  var gem1:StageProp;
  var gem2:StageProp;
  var flames:StageProp;
  var flamesChange:StageProp;
  var caveL:StageProp;
  var runesL:StageProp;
  var glowL1:StageProp;
  var glowL2:StageProp;
  var caveR:StageProp;
  var runesR:StageProp;
  var glowR1:StageProp;
  var glowR2:StageProp;
  var ground:StageProp;
  var crack:StageProp;
  var crack_2:StageProp;
  var rocks:StageProp;
  var rocksLeft:StageProp;
  var overlay:StageProp;

  // State variables
  var runesCanGlow:Bool = false;
  var isCrackVisible:Bool = true;
  var rockColor:Bool = false; // false = green, true = cyan
  var didSakuFadeIn:Bool = false;
  var canBop:Bool = true;

  var wrathXAdjust:Float = 0;
  var wrathYAdjust:Float = -128;

  var flashySteps:Array<Int> = [640, 1024, 1536, 1856];

  function fixRetroPos():Void
  {
    var retro = getDad();
    if (retro != null)
    {
      retro.y += 125; // isso é estranho
    }
  }

  public function new()
  {
    super('wrath_phase2');
  }

  override function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    var songName = PlayState.instance?.currentChart?.songName ?? '';
    var lSongName = songName.toLowerCase();

    isSpectral = lSongName == 'spectral';
    isEctospasm = lSongName == 'ectospasm' || lSongName == 'ectogasm';

    // Inicializar variáveis de cutscene
    hasPlayedInGameCutscene = false;
    ogStrumY = PlayState.instance.playerStrumline.y;
    fixRetroPos();

    if (hasCreatedStage) return;

    if (!optimize) {
      // Sky
      sky = FunkinSprite.create(0, 0);
      sky.loadTexture('wrath/wrath_sky');
      sky.scrollFactor.set(0.5, 0.5);
      sky.screenCenter();
      sky.x += wrathXAdjust;
      sky.y += wrathYAdjust + 250;
      PlayState.instance.add(sky);

      // Gates
      gates = FunkinSprite.create(0, 0);
      gates.loadTexture('wrath/wrath_gates');
      gates.scrollFactor.set(0.55, 0.55);
      gates.scale.set(1.5, 1.5);
      gates.screenCenter();
      gates.x += wrathXAdjust - 0; // - 555
      gates.y += wrathYAdjust - 150 - 105;
      PlayState.instance.add(gates);

      // Vortex (backgroundLevel > 1)
      vortex = FunkinSprite.create(0, 0);
      vortex.loadSparrow('wrath/Vortex');
      vortex.animation.addByPrefix('speeen', 'Vortex', 24, true);
      vortex.animation.play('speeen');
      vortex.scale.set(1/0.5, 1/0.5);
      vortex.scrollFactor.set(0.5, 0.5);
      vortex.x = 300; //-100
      vortex.y = -550;
      // Se for story mode, começa invisível
      if (PlayState.instance.isStoryMode) vortex.alpha = HIDDEN;
      PlayState.instance.add(vortex);

      // Back rocks
      backrocks1 = FunkinSprite.create(0, 0);
      backrocks1.loadTexture('wrath/wrath_backrocks_01');
      backrocks1.scrollFactor.set(0.6, 0.6);
      backrocks1.screenCenter();
      backrocks1.x += wrathXAdjust - 1350;
      backrocks1.y += wrathYAdjust + 80;
      PlayState.instance.add(backrocks1);

      backrocks2 = FunkinSprite.create(0, 0);
      backrocks2.loadTexture('wrath/wrath_backrocks_02');
      backrocks2.scrollFactor.set(0.6, 0.6);
      backrocks2.screenCenter();
      backrocks2.x += wrathXAdjust + 925; //725
      backrocks2.y += wrathYAdjust + 65;
      PlayState.instance.add(backrocks2);

      // Gems
      gem1 = FunkinSprite.create(0, 0);
      gem1.loadSparrow('wrath/gem1');
      gem1.animation.addByPrefix('green', 'green', 0, false);
      gem1.animation.addByPrefix('cyan', 'cyan', 0, false);
      gem1.scrollFactor.set(0.6, 0.6);
      gem1.screenCenter();
      gem1.active = false;
      gem1.x += wrathXAdjust - 600 - 410;
      gem1.y += wrathYAdjust - 500 - 30;
      gem1.animation.play('green');
      PlayState.instance.add(gem1);

      gem2 = FunkinSprite.create(0, 0);
      gem2.loadSparrow('wrath/gem2');
      gem2.animation.addByPrefix('green', 'green', 0, false);
      gem2.animation.addByPrefix('cyan', 'cyan', 0, false);
      gem2.scrollFactor.set(0.7, 0.7);
      gem2.screenCenter();
      gem2.active = false;
      gem2.x += wrathXAdjust - 200 - 630;
      gem2.y += wrathYAdjust - 150 - 150;
      gem2.animation.play('green');
      PlayState.instance.add(gem2);

      // Flames (backgroundLevel > 1)
      flames = FunkinSprite.create(0, 0);
      flames.loadSparrow('wrath/flames_colorchange');
      flames.animation.addByPrefix('greenFlame', 'Symbol 1 Instanz 1', 24, true);
      flames.screenCenter();
      flames.scale.set(1.6, 1.5);
      flames.scrollFactor.set(0.7, 0.7);
      flames.x += wrathXAdjust - 250;
      flames.y += wrathYAdjust + 200;
      flames.animation.play('greenFlame');
      PlayState.instance.add(flames);

      // Flames change (se flashingLights estiver ativo)
      if (true) { // Pode verificar Preferences.flashingLights se necessário
        flamesChange = FunkinSprite.create(0, 0);
        flamesChange.loadSparrow('wrath/flames_colorchange');
        flamesChange.animation.addByPrefix('blueFlame', 'Symbol 2 Instanz 1', 24, true);
        flamesChange.screenCenter();
        flamesChange.scale.set(1.6, 1.5);
        flamesChange.scrollFactor.set(0.7, 0.7);
        flamesChange.x += wrathXAdjust - 250;
        flamesChange.y += wrathYAdjust + 200;
        flamesChange.alpha = HIDDEN;
        flamesChange.animation.play('blueFlame');
        PlayState.instance.add(flamesChange);
      }

      // Cave Left
      caveL = FunkinSprite.create(0, 0);
      caveL.loadTexture('wrath/runes/cave-left');
      caveL.scrollFactor.set(0.8, 0.8);
      caveL.screenCenter();
      caveL.x += wrathXAdjust - 317;
      caveL.y += wrathYAdjust + 81;
      caveL.flipX = true;
      PlayState.instance.add(caveL);

      // Runes Left (backgroundLevel > 1)
      runesCanGlow = true;

      var runesOffset:Array<Float, Float> = [405, 525];
      runesL = FunkinSprite.create(0, 0);
      runesL.loadTexture('wrath/runes/runes-left');
      runesL.scrollFactor.set(0.8, 0.8);
      runesL.flipX = true;
      runesL.screenCenter();
      runesL.x += wrathXAdjust - 686 - runesOffset[0];
      runesL.y += wrathYAdjust + 450 - runesOffset[1];
      runesL.scale.set(0.53, 0.53);
      PlayState.instance.add(runesL);

      // Glow Left
      for (i in 1...3) {
        var glowL = FunkinSprite.create(0, 0);
        glowL.loadTexture('wrath/runes/runeGlow-left');
        glowL.scrollFactor.set(0.8, 0.8);
        glowL.flipX = true;
        glowL.screenCenter();
        glowL.x += wrathXAdjust - 686 - runesOffset[0];
        glowL.y += wrathYAdjust + 450 - runesOffset[1];
        glowL.scale.set(0.53, 0.53);
        glowL.alpha = 0;
        PlayState.instance.add(glowL);

        if (i == 1) glowL1 = glowL;
        else glowL2 = glowL;
      }

      // Cave Right
      caveR = FunkinSprite.create(0, 0);
      caveR.loadTexture('wrath/runes/cave-right');
      caveR.scrollFactor.set(0.8, 0.8);
      caveR.screenCenter();
      caveR.x += wrathXAdjust + 126 - 1.5;
      caveR.y += wrathYAdjust + 25;
      PlayState.instance.add(caveR);

      // Runes Right (backgroundLevel > 1)
      runesOffset = [200, 265];
      runesR = FunkinSprite.create(0, 0);
      runesR.loadTexture('wrath/runes/runes-right');
      runesR.scrollFactor.set(0.8, 0.8);
      runesR.screenCenter();
      runesR.x += wrathXAdjust + 1246 + 115 - runesOffset[0];
      runesR.y += wrathYAdjust + -120 + 325 - runesOffset[1];
      runesR.scale.set(0.65, 0.65);
      PlayState.instance.add(runesR);

      // Glow Right
      for (i in 1...3) {
        var glowR = FunkinSprite.create(0, 0);
        glowR.loadTexture('wrath/runes/runeGlow-right');
        glowR.scrollFactor.set(0.8, 0.8);
        glowR.screenCenter();
        glowR.x += wrathXAdjust + 1246 + 115 - runesOffset[0];
        glowR.y += wrathYAdjust + -120 + 325 - runesOffset[1];
        glowR.scale.set(0.65, 0.65);
        glowR.alpha = 0;
        PlayState.instance.add(glowR);

        if (i == 1) glowR1 = glowR;
        else glowR2 = glowR;
      }

      // Crystals (backgroundLevel > 1)
      for (i in 0...8) {
        var crystal = FunkinSprite.create(0, 0);
        crystal.loadSparrow('wrath/Crystals');
        crystal.animation.addByPrefix('idle', 'Crystal' + i, 24, true);
        crystal.x = crystalPos[i][0];
        crystal.y = crystalPos[i][1];
        crystal.scrollFactor.set(0.9, 0.9);
        crystal.animation.play('idle');

        if (PlayState.instance.isStoryMode && !hasPlayedInGameCutscene) {
          crystal.alpha = HIDDEN;
          crystal.y += 1500;
        }

        PlayState.instance.add(crystal);
        crystals.push(crystal);
      }

      // Ground
      ground = FunkinSprite.create(0, 0);
      ground.loadSparrow('wrath/ground');
      ground.animation.addByPrefix('green', 'green', 0, false);
      ground.animation.addByPrefix('cyan', 'cyan', 0, false);
      ground.screenCenter();
      ground.active = false;
      ground.x += wrathXAdjust;
      ground.y += wrathYAdjust + 678;
      ground.animation.play('green');
      PlayState.instance.add(ground);

      // Crack
      var crackOffset = 35;
      crack = FunkinSprite.create(0, 0);
      crack.loadSparrow('wrath/HellCrack');
      crack.animation.addByPrefix('appear', 'HellcrackAppear', 24, false);
      crack.animation.addByPrefix('bop', 'HellcrackBop', 24, false);
      crack.screenCenter();
      crack.active = false;
      crack.x += 45;
      crack.y += 405 - 15 + crackOffset;
      crack.zIndex = 100; // Aproximadamente dadGroup order

      if (!(PlayState.instance.isStoryMode && !hasPlayedInGameCutscene)) {
        crack.animation.play('bop');
        crack.active = true;
      }

      PlayState.instance.add(crack);

      // Crack 2 (only for Spectral in story mode)
      if (isSpectral && PlayState.instance.isStoryMode) {
        crack_2 = FunkinSprite.create(0, 0);
        crack_2.loadSparrow('wrath/HellCrack_2');
        crack_2.animation.addByPrefix('bop', 'HellcrackBop', 24, false);
        crack_2.screenCenter();
        crack_2.active = false;
        crack_2.x += -100;
        crack_2.y += 600 + crackOffset;
        crack_2.zIndex = 50; // Aproximadamente gfGroup order
        crack_2.alpha = 0;
        PlayState.instance.add(crack_2);
      }

      // Front Rocks
      rocks = FunkinSprite.create(0, 0);
      rocks.loadSparrow('wrath/frontRocks_1');
      rocks.animation.addByPrefix('green', 'green', 0, false);
      rocks.animation.addByPrefix('cyan', 'cyan', 0, false);
      rocks.screenCenter();
      rocks.scrollFactor.set(1.1, 1.1);
      rocks.active = false;
      rocks.x += wrathXAdjust + 25;
      rocks.y += wrathYAdjust + 175;
      rocks.animation.play('green');
      rocks.zIndex = 300; // Boyfriend + 1

      rocksLeft = FunkinSprite.create(0, 0);
      rocksLeft.loadSparrow('wrath/frontRocks_0');
      rocksLeft.animation.addByPrefix('green', 'green', 0, false);
      rocksLeft.animation.addByPrefix('cyan', 'cyan', 0, false);
      rocksLeft.screenCenter();
      rocksLeft.scrollFactor.set(1.1, 1.1);
      rocksLeft.active = false;
      rocksLeft.x += wrathXAdjust + 25;
      rocksLeft.y += wrathYAdjust + 175;
      rocksLeft.animation.play('green');
      rocksLeft.zIndex = 300; // Boyfriend + 1

      PlayState.instance.add(rocks);
      PlayState.instance.add(rocksLeft);

      // Scale adjustment if not in cutscene
      if (!(PlayState.instance.isStoryMode && !hasPlayedInGameCutscene)) {
        rocks.scale.x += 0.1;
        rocks.scale.y += 0.1;
        rocksLeft.scale.x += 0.1;
        rocksLeft.scale.y += 0.1;

        //PlayState.instance.defaultCameraZoom = 0.525;
      }
    }

    hasCreatedStage = true;
    PlayState.instance.refresh();
  }

  override function addCharacter(character:BaseCharacter, charType:CharacterType):Void
  {
    // Apply the shader automatically to each character as it gets added.
    super.addCharacter(character, charType);
    trace('Applied stage shader to ' + character.characterName);

    var rim = new DropShadowShader();
    rim.setAdjustColor(-33, 0, -23, 0); // brilho, hue, contraste e saturação
    rim.color = 0xFF1ab635; // #1ab635ff
    character.shader = rim;
    rim.attachedSprite = character;

    switch (charType)
    {
      case CharacterType.BF:
        rim.angle = 90;
        character.idleSuffix = '-alt';
        character.danceEvery = 1;

        character.animation.onFrameChange.add(function() {
          if (getBoyfriend() != null)
          {
            rim.updateFrameInfo(getBoyfriend().frame);
          }
        });

      case CharacterType.GF:
        rim.angle = 90;
        rim.threshold = -1;

        character.animation.onFrameChange.add(function() {
          rim.updateFrameInfo(getGirlfriend().frame);
        });

      case CharacterType.DAD:
        rim.angle = 90;
        //rim.threshold = 0.3;

        character.animation.onFrameChange.add(function() {
          rim.updateFrameInfo(getDad().frame);
        });

      default:
    }
  }

  public override function onSongLoaded(event:ScriptEvent):Void
  {
    super.onSongLoaded(event);
  }

  public override function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (overlay == null) {
      // Overlay
      overlay = FunkinSprite.create(0, 0);
      overlay.loadTexture('wrath/wrath_overlay');
      overlay.screenCenter();
      overlay.scrollFactor.set(0.6, 0.6);
      overlay.blend = 'screen';
      overlay.y += -128;
      overlay.cameras = [PlayState.instance.camGame];
      PlayState.instance.add(overlay);
    }

    //if (!PlayState.instance.isStoryMode || PlayState.instance.isChartingMode) hasPlayedInGameCutscene = true;

    if (!hasPlayedInGameCutscene && isSpectral) {
      hasPlayedInGameCutscene = true;
      event.cancel(); // CANCEL THE COUNTDOWN!

      PlayState.instance.camHUD.visible = false;

      buildProps(true);
      loadSounds();
      introCutscene();
    }
  }

  override public function onUpdate(event):Void {
    super.onUpdate(event);
    if (PlayState.instance == null) return;
    var songPos = Conductor.instance.songPosition / 1000;

    // Crystal floating animation
    for (i in 0...crystals.length) {
      if (crystals[i] == null || !hasPlayedInGameCutscene) continue;
      crystals[i].y += 50 * Math.sin(songPos + crystalFloatData[i][1]) * event.elapsed;

      // Move crystals after step 1536
      if (Conductor.instance.currentStep >= 1536) {
        crystals[i].x -= crystalFloatData[i][0] * event.elapsed;
        if (crystals[i].x <= -1000) {
          crystals[i].x = 2500;
        }
      }
    }
  }

  override function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);
    resetTweens();
    hasCreatedStage = false;
  }

  function changeColor(sprite:StageProp):Void
  {
    if (sprite == null) return;

    if (rockColor) {
      sprite.animation.play('cyan');
    } else {
      sprite.animation.play('green');
    }
  }

  function colorChangeStuff():Void
  {
    rockColor = !rockColor;

    changeColor(ground);
    changeColor(rocks);
    changeColor(rocksLeft);
    changeColor(gem1);
    changeColor(gem2);

    if (isEctospasm && flamesChange != null) {
      flamesChange.alpha = 1;
      FlxTween.tween(flamesChange, {alpha: 0}, 0.5, {ease: FlxEase.linear});
    }
  }

  override function onStepHit(event:SongTimeScriptEvent):Void
  {
    super.onStepHit(event);

    var curStep = event.step;

    // Ectospasm color changes
    if (isEctospasm) {
      if (curStep >= 128 && curStep % 8 == 0) {
        colorChangeStuff();
      }
    }

    // Spectral effects
    if (isSpectral) {
      if (curStep >= 1024 && !didSakuFadeIn) {
        didSakuFadeIn = true;
      }

      // Flash effects
      for (i in 0...flashySteps.length) {
        if (curStep >= flashySteps[i]) {
          PlayState.instance.camHUD.flash(0xFFFFFFFF, 0.25);
          flashySteps.splice(i, 1);
          break;
        }
      }
    }
  }

  override function onBeatHit(event:SongTimeScriptEvent):Void
  {
    super.onBeatHit(event);

    if (canBop && event.beat % 2 == 0) {
      crack.active = isCrackVisible;
      crack.animation.play('bop', true);

      if (runesCanGlow) {
        // Glow Left
        if (glowL1 != null) {
          glowL1.alpha = 1;
          FlxTween.tween(glowL1, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }
        if (glowL2 != null) {
          glowL2.alpha = 1;
          FlxTween.tween(glowL2, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }

        // Glow Right
        if (glowR1 != null) {
          glowR1.alpha = 1;
          FlxTween.tween(glowR1, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }
        if (glowR2 != null) {
          glowR2.alpha = 1;
          FlxTween.tween(glowR2, {alpha: 0}, 13/24, {ease: FlxEase.linear});
        }
      }
    }
  }

  override function onSongRetry(event:ScriptEvent):Void
  {
    super.onSongRetry(event);

    rockColor = false;
    didSakuFadeIn = false;
    flashySteps = [640, 1024, 1536, 1856];

    hasPlayedInGameCutscene = true;
    isModcharting = false;
    PlayState.instance.camHUD.angle = 0;
    PlayState.instance.playerStrumline.y = ogStrumY;
    //fixRetroPos();
  }

  function buildProps(hide:Bool = false):Void
  {
    if (hide) {
      flames.y += 1000;
      if (vortex != null) vortex.visible = false;
      //if (crack != null) crack.visible = false;
      if (crack_2 != null) crack_2.visible = false;
      for (i in 0...crystals.length) {
        if (crystals[i] == null) continue;
        crystals[i].alpha = HIDDEN;
      }
    } else {
      if (vortex != null) vortex.visible = true;
      for (i in 0...crystals.length) {
        if (crystals[i] == null) continue;
        crystals[i].alpha = 1;
      }
    }
  }

  function loadSounds():Void
  {
    growlSound = FunkinSound.load(Paths.sound("Growl"), true);
    groundShakeSound = FunkinSound.load(Paths.sound("groundShake"), true);
    firstSlam = FunkinSound.load(Paths.sound("fistSlam"), true);
    roarSound = FunkinSound.load(Paths.sound("roar"), true);

    growlSound.volume = 1;
    roarSound.volume = 1;
    groundShakeSound.volume = 1;
    firstSlam.volume = 1;
  }

  function introCutscene():Void
  {
    PlayState.instance.togglePauseButton();
    PlayState.instance.isInCutscene = true;
    PlayState.instance.mayPauseGame = false;

    var retro = getDad();
    var retroPos:Array<Float> = [
      retro.cameraFocusPoint.x,
      retro.cameraFocusPoint.y
    ];

    characterStageShader = retro.shader;
    var rim = new DropShadowShader();
    rim.setAdjustColor(-33, 0, -23, 0);
    rim.color = 0xFF29c23e;
    rim.angle = 90;
    retro.shader = rim;
    rim.attachedSprite = retro;
    retro.animation.onFrameChange.add(function() {
      if (retro != null)
      {
        rim.updateFrameInfo(retro.frame);
      }
    });

    // Início
    retro.playAnimation('transformation', true);
    growlSound.play();
    groundShakeSound.play();
    PlayState.instance.tweenCameraZoom(0.8, 0, true, FlxEase.quadInOut);
    PlayState.instance.tweenCameraZoom(0.7, 1, true, FlxEase.quadInOut);
    PlayState.instance.tweenCameraToPosition(retroPos[0] + 70, retroPos[1] - 10, 0, FlxEase.quadInOut);

    // smash ground + unzoom
    new FlxTimer().start(2, function(tmr) {
      firstSlam.play();
      PlayState.instance.tweenCameraZoom(0.6, 0.5, true, FlxEase.quadInOut);
    });

    new FlxTimer().start(2.3, function(tmr) {
      FlxG.camera.flash(0xFFFFFFFF, 0.4);
      buildProps();
      FlxG.camera.shake(0.075, 0.5);
      FlxG.camera.shake(0.025, 0.35);
    });

    // roar
    new FlxTimer().start(3.25, function(tmr) {
      if (flames != null) {
        tweens.push(FlxTween.tween(flames, {y: bgFlamesY}, 1.4, {ease: FlxEase.backOut}));
      }
      retro.playAnimation('roar', true);
      roarSound.play();
      FlxG.camera.shake(0.025, 0.35);
      PlayState.instance.tweenCameraZoom(PlayState.instance.stageZoom, 0.5, true, FlxEase.quadInOut);
    });

    new FlxTimer().start(4, function(tmr) {
      var rim = characterStageShader;
      retro.shader = rim;
      rim.attachedSprite = retro;
      retro.animation.onFrameChange.add(function() {
        if (retro != null)
        {
          rim.updateFrameInfo(retro.frame);
        }
      });
    });

    new FlxTimer().start(4.75, function(tmr) {
      retro.playAnimation('idle', true);
      //if (crack != null) crack.visible = true;
      if (crack_2 != null) crack_2.visible = true;
    });

    // Cutscene acaba
    new FlxTimer().start(4.75, function(tmr) {
      PlayState.instance.isInCutscene = false;
      PlayState.instance.startCountdown();
      PlayState.instance.togglePauseButton(true);
      PlayState.instance.mayPauseGame = true;
    });
  }

  private function resetTweens():Void
  {
    for (tween in tweens)
    {
      if (tween != null)
        tween.cancel();
    }
    tweens = [];
    pausedTweens = [];
  }
}
